{
  "name": "@podbor/catalog-contract",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "version": "0.0.1",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./src/index.ts"
    },
    "./ambiguity": {
      "require": {
        "types": "./dist/cjs/ambiguity.d.ts",
        "default": "./dist/cjs/ambiguity.js"
      },
      "default": "./src/ambiguity.ts"
    },
    "./steering": {
      "require": {
        "types": "./dist/cjs/steering.d.ts",
        "default": "./dist/cjs/steering.js"
      },
      "default": "./src/steering.ts"
    },
    "./fingerprint": {
      "require": {
        "types": "./dist/cjs/fingerprint.d.ts",
        "default": "./dist/cjs/fingerprint.js"
      },
      "default": "./src/fingerprint.ts"
    },
    "./cart-wire": {
      "require": {
        "types": "./dist/cjs/cart-wire.d.ts",
        "default": "./dist/cjs/cart-wire.js"
      },
      "default": "./src/cart-wire.ts"
    },
    "./availability": {
      "require": {
        "types": "./dist/cjs/availability.d.ts",
        "default": "./dist/cjs/availability.js"
      },
      "default": "./src/availability.ts"
    },
    "./comment": {
      "require": {
        "types": "./dist/cjs/comment.d.ts",
        "default": "./dist/cjs/comment.js"
      },
      "default": "./src/comment.ts"
    },
    "./preview": {
      "require": {
        "types": "./dist/cjs/preview.d.ts",
        "default": "./dist/cjs/preview.js"
      },
      "default": "./src/preview.ts"
    },
    "./part-number": {
      "require": {
        "types": "./dist/cjs/partNumber.d.ts",
        "default": "./dist/cjs/partNumber.js"
      },
      "default": "./src/partNumber.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@podbor/lead-crm": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "3.2.6",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
