{
  "name": "@podbor/shop-catalog",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "version": "0.0.1",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./src/index.ts"
    },
    "./browser": {
      "require": {
        "types": "./dist/cjs/browser.d.ts",
        "default": "./dist/cjs/browser.js"
      },
      "default": "./src/browser.ts"
    },
    "./order-hook": {
      "require": {
        "types": "./dist/cjs/orderHook.d.ts",
        "default": "./dist/cjs/orderHook.js"
      },
      "default": "./src/orderHook.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "3.2.6",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
