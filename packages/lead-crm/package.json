{
  "name": "@podbor/lead-crm",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "version": "0.0.1",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./storage/vercel-blob": "./src/storage/vercelBlob.ts",
    "./storage/local": "./src/storage/localFiles.ts",
    "./contact-channel": {
      "require": {
        "types": "./dist/cjs/contactChannel.d.ts",
        "default": "./dist/cjs/contactChannel.js"
      },
      "default": "./src/contactChannel.ts"
    },
    "./limits": {
      "require": {
        "types": "./dist/cjs/limits.d.ts",
        "default": "./dist/cjs/limits.js"
      },
      "default": "./src/limits.ts"
    },
    "./fields": {
      "require": {
        "types": "./dist/cjs/fields.d.ts",
        "default": "./dist/cjs/fields.js"
      },
      "default": "./src/fields.ts"
    },
    "./parts-order-copy": {
      "require": {
        "types": "./dist/cjs/partsOrderCopy.d.ts",
        "default": "./dist/cjs/partsOrderCopy.js"
      },
      "default": "./src/partsOrderCopy.ts"
    },
    "./ad-text": "./src/adText.ts",
    "./phone": {
      "require": {
        "types": "./dist/cjs/phone.d.ts",
        "default": "./dist/cjs/phone.js"
      },
      "default": "./src/phone.ts"
    },
    "./compose-e164": "./src/composeE164.ts",
    "./phone-input": "./src/phoneInput.ts",
    "./phone-kit": "./src/phoneKit.ts",
    "./submit": "./src/submitLeadForm.ts",
    "./lead-form": "./src/leadForm.ts",
    "./telegram-client": "./src/telegram/client.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@podbor/brands": "workspace:*",
    "date-fns": "4.4.0",
    "grammy": "1.46.0",
    "libphonenumber-js": "1.13.12",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@vercel/blob": "2.8.0"
  },
  "devDependencies": {
    "@vercel/blob": "2.8.0",
    "@vitest/coverage-v8": "3.2.6",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
