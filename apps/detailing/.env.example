# Site
SITE=https://details.rs

# Public contact channels
PUBLIC_PHONE_NUMBER=381677210533
PUBLIC_WHATSAPP_NUMBER=381677210533
PUBLIC_VIBER_NUMBER=381677210533
PUBLIC_TG_MANAGER=details_studio
PUBLIC_INSTAGRAM=details.studio

# Analytics — optional. Without a counter id nothing is loaded and no request
# leaves the page. Each domain needs its own counter, not approved.rs's.
PUBLIC_YM_COUNTER_ID=
PUBLIC_GA_MEASUREMENT_ID=

# Telegram bot — the SAME bot as every other brand in this repo. This app only
# ever sends lead cards; the webhook that handles button presses is deployed by
# apps/approved-rs (Telegram allows one webhook URL per bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_OWNER_ID=
TELEGRAM_ADMIN_ID=
TELEGRAM_BOT_USERNAME=

# Lead storage — Vercel Blob. Connect the SAME Blob store as apps/approved-rs
# so every brand's leads land in one data/leads.json and the bot can act on
# them. Leads are separated by their `brand` field, not by file.

# Keystatic CMS (GitHub App)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
