---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import Gallery from '@/components/Gallery.astro';
import CompareSlider from '@/components/CompareSlider.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import SectionHead from '@/components/SectionHead.astro';
import FinalCta from '@/components/FinalCta.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { BCP47_BY_LOCALE } from '@/i18n/config';
import { content } from '@/i18n/content';
import { PathBuilder, withLocales } from '@/utils/paths';
import { localizedWork, publishedWorks, workExcerpt } from '@/utils/works';
import { articleSchema, safeMarkdown, relatedEntries } from '@podbor/site-kit';
import { SITE_URL } from '@/utils/constants';
import Icon from '@/components/Icon.astro';
import {
  DEPTH_DOOR_ATTRIBUTE,
  DEPTH_SLUG_ATTRIBUTE,
} from '@podbor/site-kit/browser';

export async function getStaticPaths() {
  const works = publishedWorks(await getCollection('works'));
  return withLocales(
    works.map((work) => ({
      params: { slug: work.id },
      props: {
        work,
        related: relatedEntries(works, work),
      },
    })),
  );
}

const { work, related } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const pages = content(locale).pages;
const services = content(locale).services;
const site = content(locale).site;
const { title, body, car } = localizedWork(work, locale);

const schema = articleSchema({
  headline: title,
  image: new URL(work.data.image.src, SITE_URL).href,
  datePublished: work.data.date,
  publisher: { '@id': `${SITE_URL}/#studio` },
  url: new URL(PathBuilder.work(locale, work.id), SITE_URL).href,
});

const dateLabel = new Intl.DateTimeFormat(BCP47_BY_LOCALE[locale], {
  year: 'numeric',
  month: 'long',
}).format(work.data.date);
---

<Shell
  title={`${title} — ${pages.works.detailMetaSuffix}`}
  description={workExcerpt(body) || `${car}. ${pages.works.metaDescription}`}
  jsonLd={[schema]}
>
  <PageHero
    eyebrow={car}
    heading={title}
    crumbs={[
      { href: PathBuilder.works(locale), label: site.nav.works },
      { href: PathBuilder.work(locale, work.id), label: title },
    ]}
  />

  <section class="wrap mt-10">
    <div class="flex flex-wrap items-center gap-2" data-reveal>
      {
        work.data.servicesApplied.map((slug) => (
          <a
            href={PathBuilder.service(locale, slug)}
            class="rounded-full border border-line px-3.5 py-1.5 text-[0.6875rem] uppercase tracking-[0.16em] text-mute transition-colors duration-400 hover:border-champagne hover:text-champagne"
          >
            {services[slug].name}
          </a>
        ))
      }
      <span class="text-xs text-mute-2">
        {work.data.year ? `${work.data.year} · ` : ''}{dateLabel}
      </span>
    </div>
  </section>

  <section class="wrap mt-10">
    {
      work.data.beforeImage ? (
        <CompareSlider
          before={work.data.beforeImage}
          after={work.data.image}
          alt={title}
        />
      ) : (
        <div class="shell" data-reveal>
          <Image
            src={work.data.image}
            alt={title}
            widths={[540, 760, 1080, 1440]}
            sizes="(min-width: 1024px) 80vw, calc(100vw - 2.5rem)"
            loading="eager"
            class="core block aspect-[4/3] w-full object-cover sm:aspect-[16/10]"
          />
        </div>
      )
    }
  </section>

  <aside
    {...{ [DEPTH_DOOR_ATTRIBUTE]: '' }}
    {...{ [DEPTH_SLUG_ATTRIBUTE]: work.id }}
    class="wrap mt-10 hidden data-[revealed=true]:block"
  >
    <div class="shell">
      <div
        class="core flex flex-col gap-6 p-6 sm:flex-row sm:items-center sm:justify-between sm:gap-10 sm:p-8"
      >
        <div>
          <h2
            class="font-display text-xl tracking-tight text-chalk sm:text-2xl"
          >
            {pages.works.doorHeading}
          </h2>
          <p class="mt-2 max-w-md text-base leading-relaxed text-mute">
            {pages.works.doorText}
          </p>
        </div>
        <a
          href="#lead"
          class="inline-flex shrink-0 items-center justify-center gap-3 self-start whitespace-nowrap rounded-full bg-chalk py-3 pl-6 pr-2.5 text-sm font-semibold text-void transition-colors duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-champagne active:scale-[0.98] sm:self-auto"
        >
          <span>{pages.works.doorButtonLabel}</span>
          <span
            class="flex h-8 w-8 items-center justify-center rounded-full bg-void/10"
            aria-hidden="true"
          >
            <Icon name="arrow" />
          </span>
        </a>
      </div>
    </div>
  </aside>

  {
    body.trim() && (
      <section class="wrap mt-20">
        <div class="prose-studio" data-reveal set:html={safeMarkdown(body)} />
      </section>
    )
  }

  {
    work.data.gallery.length > 0 && (
      <section class="wrap mt-20">
        <Gallery images={work.data.gallery} alt={title} />
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="wrap mt-32 sm:mt-40">
        <SectionHead
          eyebrow={pages.works.eyebrow}
          heading={site.common.backToWorks}
        />
        <WorkGrid works={related} />
      </section>
    )
  }

  <FinalCta
    eyebrow={pages.works.eyebrow}
    heading={pages.works.detailCtaHeading}
    body={pages.works.detailCtaBody}
    service={work.data.servicesApplied[0]}
  />
  <script>
    import { defineBrowsingDepth } from '@podbor/site-kit/browser';

    defineBrowsingDepth();
  </script>
</Shell>
