---
import { getCollection } from 'astro:content';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import EmptyState from '@/components/EmptyState.astro';
import FinalCta from '@/components/FinalCta.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { PathBuilder, localePaths } from '@/utils/paths';
import { SERVICE_SLUGS } from '@/utils/services';
import { publishedWorks } from '@/utils/works';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFrom(Astro.url.pathname);
const pages = content(locale).pages;
const services = content(locale).services;
const site = content(locale).site;
const works = publishedWorks(await getCollection('works'));

const CHIP =
  'rounded-full border border-line px-4 py-2 text-xs tracking-tight text-mute transition-colors duration-400 hover:border-line-strong hover:text-chalk aria-pressed:border-line-strong aria-pressed:bg-white/10 aria-pressed:text-chalk';
const usedSlugs = SERVICE_SLUGS.filter((slug) =>
  works.some((w) => w.data.servicesApplied.includes(slug)),
);
---

<Shell title={pages.works.metaTitle} description={pages.works.metaDescription}>
  <PageHero
    eyebrow={pages.works.eyebrow}
    heading={pages.works.heading}
    lead={pages.works.lead}
    crumbs={[{ href: PathBuilder.works(locale), label: site.nav.works }]}
  />

  {
    works.length === 0 ? (
      <section class="wrap">
        <EmptyState />
      </section>
    ) : (
      <chip-filter class="wrap mt-12 block">
        {usedSlugs.length > 1 && (
          <div
            class="flex flex-wrap gap-2"
            role="group"
            aria-label={pages.works.eyebrow}
            data-reveal
          >
            <button
              type="button"
              data-filter-chip
              aria-pressed="true"
              class={CHIP}
            >
              {pages.works.filterAll}
            </button>
            {usedSlugs.map((slug) => (
              <button
                type="button"
                data-filter-chip
                data-group={slug}
                aria-pressed="false"
                class={CHIP}
              >
                {services[slug].name}
              </button>
            ))}
          </div>
        )}

        <WorkGrid works={works} eager={3} class="mt-10" />
      </chip-filter>
    )
  }

  <FinalCta
    eyebrow={pages.works.eyebrow}
    heading={pages.works.detailCtaHeading}
    body={pages.works.detailCtaBody}
  />
</Shell>

<script>
  import { defineChipFilter } from '@podbor/site-kit/browser';

  defineChipFilter();
</script>
