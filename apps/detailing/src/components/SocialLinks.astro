---
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { SOCIAL_LINKS } from '@/utils/constants';

interface Props {
  class?: string;
}

const site = content(localeFrom(Astro.url.pathname)).site;
---

{
  SOCIAL_LINKS.length > 0 && (
    <div class:list={['flex flex-col gap-3', Astro.props.class]}>
      <span class="font-display text-xs font-medium text-mute">
        {site.channels.social}
      </span>
      <ul class="flex flex-wrap gap-2">
        {SOCIAL_LINKS.map((link) => (
          <li>
            <a
              href={link.url}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center rounded-full border border-line px-5 text-sm text-chalk transition-all duration-500 ease-spring hover:border-line-strong hover:bg-white/[0.05]"
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
