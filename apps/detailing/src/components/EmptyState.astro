---
import Cta from './Cta.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { content } from '@/i18n/content';

const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
---

<div class="shell mt-14" data-reveal>
  <div class="core flex flex-col items-start gap-6 p-10 sm:p-14">
    <p class="max-w-xl text-base leading-relaxed text-mute">
      {site.common.emptyWorks}
    </p>
    <Cta label={site.header.cta} openModal />
  </div>
</div>
