---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const gradientId = 'dt-wordmark';
---

<svg
  viewBox="0 0 95 16"
  role="img"
  aria-label="Details"
  class={className}
  fill="none"
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#9B8CFF"></stop>
      <stop offset="45%" stop-color="#6FD3E8"></stop>
      <stop offset="100%" stop-color="#E3C08A"></stop>
    </linearGradient>
  </defs>
  <path d="M8 0 16 16H0L8 0Z" fill={`url(#${gradientId})`}></path>
  <text
    x="26"
    y="13"
    font-family="'Unbounded Variable','Unbounded',sans-serif"
    font-size="13"
    font-weight="600"
    letter-spacing="1.6"
    fill="currentColor">Details</text
  >
</svg>
