---
import Icon from './Icon.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { getSiteContent } from '@/i18n/content/site';
import { CONTACT_LINKS } from '@/utils/contactLinks';
import { BRAND, PHONE_NUMBER } from '@/utils/constants';
import type { ServiceSlug } from '@/utils/services';
import {
  captureStartPayload,
  telegramBotLink,
} from '@podbor/site-kit/contact-links';
import { contactPlacement, type ContactPlacement } from '@podbor/site-kit';
import { formatPhone } from '@podbor/site-kit/format-phone';

interface Props {
  class?: string;
  placement?: Extract<ContactPlacement, 'bar' | 'thanks'>;
  service?: ServiceSlug;
}

const { class: className = '', placement = 'bar', service } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = getSiteContent(locale);

const channels = [
  {
    href: CONTACT_LINKS.phone,
    icon: 'phone',
    label: site.channels.call,
    track: 'phone',
  },
  {
    href: CONTACT_LINKS.whatsapp,
    icon: 'whatsapp',
    label: site.channels.whatsapp,
    track: 'whatsapp',
  },
  {
    href: CONTACT_LINKS.viber,
    icon: 'viber',
    label: site.channels.viber,
    track: 'viber',
  },
  {
    href: telegramBotLink(
      BRAND.captureBot,
      captureStartPayload(service, locale),
    ),
    icon: 'telegram',
    label: site.channels.telegram,
    track: 'telegram',
  },
] as const;

const CHANNEL_CLASS =
  'group flex min-h-11 items-center gap-3.5 rounded-2xl border border-line bg-white/[0.02] px-4 py-3 text-sm text-chalk transition-all duration-500 ease-spring hover:border-line-strong hover:bg-white/[0.05]';
---

<div
  class={`grid gap-2 sm:grid-cols-2 lg:grid-cols-1 ${className}`}
  data-contact-cta
  data-contact-order
  {...contactPlacement(placement)}
>
  {
    channels.map((channel) => (
      <>
        <a
          href={channel.href}
          data-channel={channel.track}
          data-contact-channel={channel.track}
          rel="noopener"
          class:list={[
            CHANNEL_CLASS,
            channel.track === 'phone' && 'pointer-fine:hidden!',
          ]}
        >
          <Icon
            name={channel.icon}
            size={18}
            class="shrink-0 text-mute transition-colors duration-500 ease-spring group-hover:text-champagne group-focus-visible:text-champagne"
          />
          {channel.label}
        </a>
        {channel.track === 'phone' && placement === 'thanks' && (
          <span class={`${CHANNEL_CLASS} pointer-coarse:hidden!`}>
            <Icon name="phone" size={18} class="shrink-0 text-mute" />
            <span class="whitespace-nowrap">{formatPhone(PHONE_NUMBER)}</span>
          </span>
        )}
      </>
    ))
  }
</div>
