---
import Icon from './Icon.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import ContactControl from './ContactControl.astro';
import type { ServiceSlug } from '@/utils/services';
import type { ContactPlacement } from '@podbor/site-kit';
import { contactRegion } from '@podbor/site-kit/contact-control';

interface Props {
  class?: string;
  placement?: Extract<ContactPlacement, 'bar' | 'thanks'>;
  service?: ServiceSlug;
}

const { class: className = '', placement = 'bar', service } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;

const channels = [
  { icon: 'phone', label: site.channels.call, track: 'phone' },
  { icon: 'whatsapp', label: site.channels.whatsapp, track: 'whatsapp' },
  { icon: 'viber', label: site.channels.viber, track: 'viber' },
  { icon: 'telegram', label: site.channels.telegram, track: 'telegram' },
] as const;

const CHANNEL_CLASS =
  'group flex min-h-11 items-center gap-3.5 rounded-2xl border border-line bg-white/[0.02] px-4 py-3 text-sm text-chalk transition-all duration-500 ease-spring hover:border-line-strong hover:bg-white/[0.05]';
---

<div
  class={`grid gap-2 sm:grid-cols-2 lg:grid-cols-1 ${className}`}
  data-contact-order
  {...contactRegion(placement)}
>
  {
    channels.map((channel) => (
      <ContactControl
        channel={channel.track}
        region="contacts"
        service={service}
        data-channel={channel.track}
        class={CHANNEL_CLASS}
      >
        <Icon
          name={channel.icon}
          size={18}
          class="shrink-0 text-mute transition-colors duration-500 ease-spring group-hover:text-champagne group-focus-visible:text-champagne"
        />
        {channel.label}
        <Icon slot="plain" name="phone" size={18} class="shrink-0 text-mute" />
      </ContactControl>
    ))
  }
</div>
