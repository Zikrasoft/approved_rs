---
import { localeFrom } from '@/i18n/currentLocale';
import { getSiteContent } from '@/i18n/content/site';
import { PathBuilder } from '@/utils/paths';
import { COOKIE_POLICY_VERSION } from '@/utils/constants';

const locale = localeFrom(Astro.url.pathname);
const cookie = getSiteContent(locale).cookie;
---

<cookie-consent
  data-policy-version={COOKIE_POLICY_VERSION}
  hidden
  class="fixed inset-x-4 bottom-4 z-40 rounded-shell border border-line bg-ink p-5 shadow-2xl sm:inset-x-auto sm:left-6 sm:bottom-6 sm:max-w-sm"
>
  <p class="text-sm leading-relaxed text-mute">
    {cookie.notice}{' '}{cookie.more}{' '}
    <a
      href={PathBuilder.privacy(locale)}
      class="underline transition-colors duration-400 hover:text-champagne"
      >{cookie.policyLink}</a
    >.
  </p>
  <div class="mt-4 flex gap-3">
    <button
      type="button"
      data-consent-decline
      class="rounded-full border border-line px-4 py-2 text-xs font-semibold text-mute transition-colors duration-400 hover:border-champagne hover:text-champagne"
    >
      {cookie.decline}
    </button>
    <button
      type="button"
      data-consent-accept
      class="rounded-full bg-champagne px-4 py-2 text-xs font-semibold text-void"
    >
      {cookie.accept}
    </button>
  </div>
</cookie-consent>

<script>
  import { defineCookieConsent } from '@podbor/site-kit/browser';
  defineCookieConsent();
</script>
