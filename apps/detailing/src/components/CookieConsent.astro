---
import { localeFrom } from '@/i18n/currentLocale';
import { getSiteContent } from '@/i18n/content/site';
import { PathBuilder } from '@/utils/paths';
import { COOKIE_POLICY_VERSION } from '@/utils/constants';

const locale = localeFrom(Astro.url.pathname);
const cookie = getSiteContent(locale).cookie;
---

<cookie-consent
  data-policy-version={COOKIE_POLICY_VERSION}
  hidden
  aria-live="polite"
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-ink sm:top-auto sm:bottom-0 sm:border-t sm:border-b-0"
>
  <div
    class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 pt-[max(0.5rem,env(safe-area-inset-top))] pb-2 sm:px-6 sm:pt-2 sm:pb-[max(0.5rem,env(safe-area-inset-bottom))]"
  >
    <p class="min-w-0 flex-1 text-xs leading-snug text-mute">
      {cookie.notice}{' '}{cookie.more}{' '}
      <a
        href={PathBuilder.privacy(locale)}
        class="underline transition-colors duration-400 hover:text-champagne"
        >{cookie.policyLink}</a
      >.
    </p>
    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        data-consent-decline
        class="rounded-full border border-line px-3 py-2 text-xs font-semibold text-mute transition-colors duration-400 hover:border-champagne hover:text-champagne"
      >
        {cookie.decline}
      </button>
      <button
        type="button"
        data-consent-accept
        class="rounded-full bg-champagne px-3 py-2 text-xs font-semibold text-void"
      >
        {cookie.accept}
      </button>
    </div>
  </div>
</cookie-consent>

<script>
  import { defineCookieConsent } from '@podbor/site-kit/browser';
  defineCookieConsent();
</script>
