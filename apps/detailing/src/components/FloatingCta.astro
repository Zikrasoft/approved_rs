---
import { CONTACT_CTA_SELECTOR } from '@podbor/site-kit/contact-control';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';

const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
---

<cta-reveal
  data-revealed="false"
  class="floating-cta"
  watch={CONTACT_CTA_SELECTOR}
>
  <button
    type="button"
    data-open-lead-modal
    class="inline-flex items-center rounded-full bg-chalk px-5 py-3.5 text-sm font-semibold tracking-tight text-void transition-colors duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-champagne active:scale-[0.98]"
  >
    {site.header.cta}
  </button>
</cta-reveal>

<style>
  .floating-cta {
    position: fixed;
    right: 1rem;
    bottom: calc(1.25rem + var(--cookie-consent-height, 0px));
    z-index: 10;
    transition:
      opacity 0.4s var(--ease-expo),
      transform 0.4s var(--ease-expo),
      visibility 0.4s;
  }
  @media (min-width: 640px) {
    .floating-cta {
      right: 1.75rem;
      bottom: calc(1.75rem + var(--cookie-consent-height, 0px));
    }
  }
  .floating-cta[data-revealed='false'] {
    opacity: 0;
    transform: translateY(1rem);
    visibility: hidden;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-cta {
      transition: none;
    }
  }
</style>

<script>
  import { defineCtaReveal } from '@podbor/site-kit/browser';

  defineCtaReveal();
</script>
