---
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { getSiteContent } from '@/i18n/content/site';

const locale = localeFrom(Astro.url.pathname);
const site = getSiteContent(locale);
---

<details-modal trigger="[data-open-lead-modal]">
  <dialog
    aria-label={site.form.modalTitle}
    class="m-0 h-dvh max-h-none w-full max-w-none rounded-none border-0 bg-ink p-0 text-chalk backdrop:bg-void/80 backdrop:backdrop-blur-md sm:m-auto sm:h-auto sm:max-h-[calc(100dvh-4rem)] sm:w-[min(34rem,calc(100vw-2rem))] sm:rounded-shell sm:border sm:border-line"
  >
    <div class="flex h-full flex-col sm:h-auto sm:max-h-[calc(100dvh-4rem)]">
      <div
        class="flex shrink-0 items-start justify-between gap-6 p-6 pb-4 sm:p-8 sm:pb-5"
      >
        <div class="flex flex-col gap-2">
          <h2 class="text-big">{site.form.heading}</h2>
          <p class="hidden text-sm leading-relaxed text-mute sm:block">
            {site.form.subheading}
          </p>
        </div>
        <button
          type="button"
          data-modal-close
          aria-label={site.common.closeLabel}
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-mute transition-colors duration-400 hover:border-champagne hover:text-champagne"
        >
          <Icon name="close" />
        </button>
      </div>
      <div class="min-h-0 flex-1 overflow-y-auto px-6 sm:px-8 sm:pb-8">
        <LeadForm compact />
      </div>
    </div>
  </dialog>
</details-modal>

<script>
  import { defineModalDialog } from '@podbor/site-kit/browser';

  defineModalDialog('details-modal');
</script>
