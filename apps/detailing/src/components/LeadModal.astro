---
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { getSiteContent } from '@/i18n/content/site';

const locale = localeFrom(Astro.url.pathname);
const site = getSiteContent(locale);
---

<dialog
  data-lead-modal
  aria-label={site.form.modalTitle}
  class="m-auto w-[min(34rem,calc(100vw-2rem))] rounded-shell border border-line bg-ink p-0 text-chalk backdrop:bg-void/80 backdrop:backdrop-blur-md"
>
  <div class="flex flex-col gap-6 p-6 sm:p-8">
    <div class="flex items-start justify-between gap-6">
      <div class="flex flex-col gap-2">
        <h2 class="text-big">{site.form.heading}</h2>
        <p class="text-sm leading-relaxed text-mute">{site.form.subheading}</p>
      </div>
      <button
        type="button"
        data-modal-close
        aria-label={site.common.closeLabel}
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-mute transition-colors duration-400 hover:border-champagne hover:text-champagne"
      >
        <Icon name="close" />
      </button>
    </div>
    <LeadForm compact />
  </div>
</dialog>

<script>
  const modal = document.querySelector<HTMLDialogElement>('[data-lead-modal]');
  if (modal) {
    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest(
        '[data-open-lead-modal]',
      );
      if (trigger) {
        event.preventDefault();
        modal.showModal();
        modal.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
        return;
      }
      if ((event.target as HTMLElement).closest('[data-modal-close]')) {
        modal.close();
      }
    });

    modal.addEventListener('click', (event) => {
      if (event.target === modal) modal.close();
    });
  }
</script>
