---
import Cta from './Cta.astro';
import Wordmark from './Wordmark.astro';
import { SUPPORTED_LOCALES, LOCALE_NAME } from '@/i18n/config';
import { localeFrom } from '@/i18n/currentLocale';
import { getSiteContent } from '@/i18n/content/site';
import { PathBuilder, swapLocale } from '@/utils/paths';
import { navCurrent } from '@/utils/navState';
import { LOCALE_CHOICE_ATTRIBUTE } from '@podbor/site-kit';

const locale = localeFrom(Astro.url.pathname);
const site = getSiteContent(locale);
const pathname = Astro.url.pathname;

const links = [
  { href: PathBuilder.services(locale), label: site.nav.services },
  { href: PathBuilder.works(locale), label: site.nav.works },
  { href: `${PathBuilder.home(locale)}#process`, label: site.nav.process },
  { href: PathBuilder.contact(locale), label: site.nav.contact },
].map((link) => ({ ...link, current: navCurrent(pathname, link.href) }));
---

<details-menu
  class="group contents"
  data-lock-scroll
  data-desktop-media="(min-width: 1024px)"
>
  <header class="pointer-events-none fixed inset-x-0 top-0 z-30">
    <div class="wrap pointer-events-auto pt-5 sm:pt-7">
      <div
        class="flex items-center justify-between gap-4 rounded-full border border-line bg-void/70 py-2.5 pl-5 pr-2.5 backdrop-blur-2xl"
      >
        <a
          href={PathBuilder.home(locale)}
          class="shrink-0 transition-opacity duration-500 hover:opacity-70"
          aria-label={site.common.homeLabel}
        >
          <Wordmark class="h-4 w-auto" />
        </a>

        <nav
          class="hidden items-center gap-7 lg:flex"
          aria-label={site.header.primaryNavLabel}
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                aria-current={link.current}
                class:list={[
                  'text-[0.8125rem] font-medium tracking-tight transition-colors duration-400',
                  link.current ? 'text-chalk' : 'text-mute hover:text-chalk',
                ]}
              >
                <span class="relative inline-block">
                  {link.label}
                  {link.current && (
                    <span
                      class="absolute -bottom-1.5 left-0 h-px w-full bg-champagne"
                      aria-hidden="true"
                    />
                  )}
                </span>
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-2">
          <details-lang class="hidden items-center gap-1 sm:flex">
            {
              SUPPORTED_LOCALES.map((code) => (
                <a
                  href={swapLocale(pathname, code)}
                  hreflang={code}
                  {...{ [LOCALE_CHOICE_ATTRIBUTE]: code }}
                  aria-current={code === locale ? 'true' : undefined}
                  title={LOCALE_NAME[code]}
                  class:list={[
                    'rounded-full px-2.5 py-1 text-[0.6875rem] font-semibold uppercase tracking-widest transition-colors duration-400',
                    code === locale
                      ? 'bg-white/10 text-chalk'
                      : 'text-mute-2 hover:text-chalk',
                  ]}
                >
                  {code}
                </a>
              ))
            }
          </details-lang>
          <span class="hidden sm:block">
            <Cta label={site.header.cta} openModal />
          </span>
          <button
            type="button"
            data-menu-button
            aria-expanded="false"
            aria-controls="site-menu"
            aria-label={site.header.menuOpenLabel}
            data-close-label={site.header.menuCloseLabel}
            class="flex h-10 w-10 items-center justify-center rounded-full border border-line text-chalk transition-colors duration-400 hover:border-champagne lg:hidden"
          >
            <span class="relative block h-3 w-4" aria-hidden="true">
              <span
                class="absolute left-0 top-0 h-px w-full bg-current transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-data-[open]:translate-y-[5.5px] group-data-[open]:rotate-45"
              ></span>
              <span
                class="absolute bottom-0 left-0 h-px w-full bg-current transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-data-[open]:-translate-y-[5.5px] group-data-[open]:-rotate-45"
              ></span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <div
    id="site-menu"
    class="invisible fixed inset-0 z-20 flex flex-col justify-between bg-void/90 px-6 pb-10 pt-28 opacity-0 backdrop-blur-3xl transition-[opacity,visibility] duration-500 group-data-[open]:visible group-data-[open]:opacity-100 lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label={site.header.mobileNavLabel}>
      {
        links.map((link, i) => (
          <a
            href={link.href}
            aria-current={link.current}
            style={`transition-delay:${60 + i * 55}ms`}
            class:list={[
              'translate-y-8 border-b border-line py-5 font-display text-3xl tracking-tight opacity-0 transition-all duration-600 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-[open]:translate-y-0 group-data-[open]:opacity-100',
              link.current ? 'text-chalk' : 'text-mute',
            ]}
          >
            <span class="relative inline-block">
              {link.label}
              {link.current && (
                <span
                  class="absolute -bottom-1 left-0 h-px w-full bg-champagne"
                  aria-hidden="true"
                />
              )}
            </span>
          </a>
        ))
      }
    </nav>

    <div class="flex flex-col gap-6">
      <details-lang class="flex items-center gap-2">
        <span class="text-[0.6875rem] uppercase tracking-[0.22em] text-mute-2"
          >{site.header.languageLabel}</span
        >
        {
          SUPPORTED_LOCALES.map((code) => (
            <a
              href={swapLocale(pathname, code)}
              hreflang={code}
              {...{ [LOCALE_CHOICE_ATTRIBUTE]: code }}
              class:list={[
                'rounded-full px-3 py-1.5 text-xs font-semibold uppercase tracking-widest transition-colors duration-400',
                code === locale
                  ? 'bg-white/10 text-chalk'
                  : 'text-mute-2 hover:text-chalk',
              ]}
            >
              {code}
            </a>
          ))
        }
      </details-lang>
      <Cta label={site.header.cta} openModal class="self-start" />
    </div>
  </div>
</details-menu>

<script>
  import {
    defineLocaleChoice,
    defineMenuToggle,
  } from '@podbor/site-kit/browser';

  defineLocaleChoice('details-lang');
  defineMenuToggle('details-menu');
</script>
