<language-suggestion
  hidden
  role="region"
  class="absolute top-full right-0 z-10 mt-2 w-[min(19rem,calc(100vw-2.5rem))] rounded-[1.25rem] border border-line-strong bg-ink-2 p-4 pt-3 pr-1.5 text-chalk shadow-2xl shadow-black/60 transition-[opacity,translate] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-[open]:hidden motion-safe:starting:-translate-y-1 motion-safe:starting:opacity-0 sm:right-auto sm:left-1/2 sm:mt-5 sm:-translate-x-1/2 print:hidden"
>
  <span
    aria-hidden="true"
    class="absolute -top-[7px] right-6 size-3 rotate-45 border-t border-l border-line-strong bg-ink-2 sm:right-auto sm:left-1/2 sm:-translate-x-1/2"
  ></span>
  <div class="flex items-start gap-1">
    <p data-lang-prompt class="flex-1 pt-2 text-sm text-mute text-pretty"></p>
    <button
      type="button"
      data-lang-dismiss
      class="-mt-1 flex size-11 shrink-0 items-center justify-center rounded-full text-lg leading-none text-mute transition-colors hover:text-chalk"
      >&times;</button
    >
  </div>
  <a
    data-lang-link
    href="#"
    class="mt-2 inline-flex rounded-full bg-chalk px-4 py-2 text-sm font-semibold text-void no-underline transition-opacity hover:opacity-90"
  ></a>
</language-suggestion>
