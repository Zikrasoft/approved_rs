---
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { getSiteContent } from '@/i18n/content/site';
import { getServicesContent } from '@/i18n/content/services';
import { PathBuilder } from '@/utils/paths';
import { SERVICE_SLUGS } from '@/utils/services';
import {
  INSTAGRAM,
  INSTAGRAM_ENABLED,
  SITE_NAME,
  STUDIO_ADDRESS,
  TELEGRAM_ENABLED,
} from '@/utils/constants';
import { CONTACT_LINKS } from '@/utils/contactLinks';

const locale = localeFrom(Astro.url.pathname);
const site = getSiteContent(locale);
const services = getServicesContent(locale);
const year = new Date().getFullYear();

const columnHeading = 'font-display text-xs font-medium text-mute';

const messengers = [
  {
    href: CONTACT_LINKS.whatsapp,
    icon: 'whatsapp',
    label: site.channels.whatsapp,
    track: 'whatsapp',
  },
  {
    href: CONTACT_LINKS.viber,
    icon: 'viber',
    label: site.channels.viber,
    track: 'viber',
  },
  ...(TELEGRAM_ENABLED
    ? ([
        {
          href: CONTACT_LINKS.telegram,
          icon: 'telegram',
          label: site.channels.telegram,
          track: 'telegram',
        },
      ] as const)
    : []),
] as const;
---

<footer class="mt-32 border-t border-line pb-10 pt-16 sm:mt-40">
  <div class="wrap">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="flex flex-col items-start gap-5">
        <Wordmark class="h-4 w-auto" />
        <p class="max-w-xs text-sm leading-relaxed text-mute">
          {site.footer.tagline}
        </p>
        {
          INSTAGRAM_ENABLED && (
            <a
              href={CONTACT_LINKS.instagram}
              rel="noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center gap-2.5 text-sm text-mute transition-colors duration-400 hover:text-champagne"
            >
              <Icon name="instagram" size={16} class="shrink-0" />
              <span class="sr-only">{site.channels.instagram}</span>@{INSTAGRAM}
            </a>
          )
        }
      </div>

      <nav class="flex flex-col gap-3" aria-label={site.nav.services}>
        <span class={columnHeading}>
          {site.nav.services}
        </span>
        {
          SERVICE_SLUGS.map((slug) => (
            <a
              href={PathBuilder.service(locale, slug)}
              class="text-sm text-mute transition-colors duration-400 hover:text-chalk"
            >
              {services[slug].name}
            </a>
          ))
        }
      </nav>

      <nav class="flex flex-col gap-3" aria-label={site.footer.navHeading}>
        <span class={columnHeading}>
          {site.footer.navHeading}
        </span>
        <a
          href={PathBuilder.works(locale)}
          class="text-sm text-mute transition-colors duration-400 hover:text-chalk"
          >{site.nav.works}</a
        >
        <a
          href={PathBuilder.contact(locale)}
          class="text-sm text-mute transition-colors duration-400 hover:text-chalk"
          >{site.nav.contact}</a
        >
        <a
          href={PathBuilder.privacy(locale)}
          class="text-sm text-mute transition-colors duration-400 hover:text-chalk"
          >{site.footer.privacyLabel}</a
        >
        <button
          type="button"
          data-cookie-settings
          class="w-fit text-left text-sm text-mute transition-colors duration-400 hover:text-chalk"
          >{site.cookie.settings}</button
        >
      </nav>

      <div class="flex flex-col items-start gap-3">
        <span class={columnHeading}>
          {site.footer.contactHeading}
        </span>
        <a
          href={CONTACT_LINKS.phone}
          data-contact-channel="phone"
          class="inline-flex min-h-11 items-center gap-2.5 text-sm text-chalk transition-colors duration-400 hover:text-champagne"
        >
          <Icon name="phone" size={16} class="shrink-0" />
          {site.channels.call}
        </a>
        <ul class="-ml-3.5 flex flex-wrap items-center">
          {
            messengers.map((messenger) => (
              <li>
                <a
                  href={messenger.href}
                  data-contact-channel={messenger.track}
                  rel="noopener"
                  class="flex size-11 items-center justify-center text-mute transition-colors duration-400 hover:text-champagne"
                >
                  <Icon name={messenger.icon} size={16} />
                  <span class="sr-only">{messenger.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <address class="text-sm not-italic leading-relaxed text-mute">
          {STUDIO_ADDRESS.street}<br />{
            `${STUDIO_ADDRESS.district}, ${STUDIO_ADDRESS.city}`
          }
        </address>
        <p class="text-sm leading-relaxed text-mute">
          <span class="block text-xs text-mute-2">
            {site.footer.hoursHeading}
          </span>
          {site.footer.hours}
        </p>
      </div>
    </div>

    <div class="hairline mt-14"></div>

    <p class="mt-6 text-xs text-mute-2">
      {`© ${year} ${SITE_NAME}. ${site.footer.rightsSuffix}`}
    </p>
  </div>
</footer>
