---
import Icon from './Icon.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { getServicesContent } from '@/i18n/content/services';
import { getSiteContent } from '@/i18n/content/site';
import { PathBuilder } from '@/utils/paths';
import { SERVICE_SLUGS } from '@/utils/services';

const locale = localeFrom(Astro.url.pathname);
const services = getServicesContent(locale);
const site = getSiteContent(locale);

const SPANS: Record<string, string> = {
  'zastitna-folija': 'md:col-span-7 md:row-span-2',
  'promena-boje': 'md:col-span-5',
  'poliranje-keramika': 'md:col-span-5',
  'restauracija-volana': 'md:col-span-12',
};

const GLOWS: Record<string, string> = {
  'zastitna-folija':
    'radial-gradient(120% 90% at 85% 0%, rgba(155,140,255,0.22), transparent 62%)',
  'promena-boje':
    'radial-gradient(120% 120% at 0% 0%, rgba(111,211,232,0.18), transparent 60%)',
  'poliranje-keramika':
    'radial-gradient(120% 120% at 100% 100%, rgba(227,192,138,0.2), transparent 60%)',
  'restauracija-volana':
    'radial-gradient(90% 220% at 50% 120%, rgba(227,192,138,0.14), transparent 60%)',
};
---

<div class="mt-14 grid gap-4 md:grid-cols-12">
  {
    SERVICE_SLUGS.map((slug, i) => {
      const service = services[slug];
      const featured = slug === 'zastitna-folija';
      return (
        <a
          href={PathBuilder.service(locale, slug)}
          class={`shell group block ${SPANS[slug]}`}
          data-reveal
          data-reveal-delay={i * 90}
        >
          <article class="core relative flex h-full flex-col justify-between gap-10 overflow-hidden p-7 sm:p-9">
            <div
              class="pointer-events-none absolute inset-0 opacity-70 transition-opacity duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:opacity-100"
              style={`background-image:${GLOWS[slug]}`}
              aria-hidden="true"
            />
            <div class="relative flex flex-col gap-4">
              <span class="text-[0.6875rem] uppercase tracking-[0.22em] text-champagne-dim">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3
                class={
                  featured
                    ? 'text-big max-w-md'
                    : 'text-2xl font-display tracking-tight'
                }
              >
                {service.name}
              </h3>
              <p class="max-w-md text-sm leading-relaxed text-mute">
                {service.short}
              </p>
            </div>
            <div class="relative flex items-center justify-between gap-6">
              <span class="text-sm text-champagne">{service.priceFrom}</span>
              <span class="flex items-center gap-2 text-[0.6875rem] uppercase tracking-[0.18em] text-mute-2 transition-colors duration-500 group-hover:text-chalk">
                {site.common.readMore}
                <Icon
                  name="arrowRight"
                  size={12}
                  class="transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-1"
                />
              </span>
            </div>
          </article>
        </a>
      );
    })
  }
</div>
