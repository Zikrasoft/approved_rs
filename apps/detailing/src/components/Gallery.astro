---
import Icon from './Icon.astro';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';

interface Props {
  images: ImageMetadata[];
  alt: string;
}

const { images, alt } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const LARGEST_WIDTH = 1300;
const views = await Promise.all(
  images.map((image) =>
    getImage({ src: image, width: Math.min(image.width, LARGEST_WIDTH) }),
  ),
);
---

<gallery-lightbox class="grid gap-4 sm:grid-cols-2">
  {
    images.map((image, i) => (
      <button
        type="button"
        class="shell group block text-left"
        data-lightbox-item
        data-src={views[i].src}
        data-alt={`${alt} — ${i + 1}`}
        data-reveal
        data-reveal-delay={(i % 2) * 80}
      >
        <span class="core block overflow-hidden">
          <Image
            src={image}
            alt={`${alt} — ${i + 1}`}
            widths={[420, 640, 900, LARGEST_WIDTH]}
            sizes="(min-width: 640px) 45vw, calc(100vw - 2.5rem)"
            loading="lazy"
            class="block aspect-[4/3] w-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]"
          />
        </span>
      </button>
    ))
  }
  <details-modal class="contents">
    <dialog
      class="m-0 h-full max-h-none w-full max-w-none bg-void/95 p-0 backdrop:bg-void/95"
    >
      <div class="relative flex h-full items-center justify-center p-4 sm:p-10">
        <img
          data-lightbox-image
          alt=""
          class="max-h-full max-w-full object-contain"
        />

        <button
          type="button"
          data-modal-close
          aria-label={site.common.closeLabel}
          class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full border border-line text-chalk transition-colors duration-400 hover:border-champagne hover:text-champagne"
        >
          <Icon name="close" size={16} />
        </button>

        <button
          type="button"
          data-prev
          aria-label={site.common.prevLabel}
          class="absolute left-4 flex h-11 w-11 items-center justify-center rounded-full border border-line text-chalk transition-colors duration-400 hover:border-champagne hover:text-champagne"
        >
          <Icon name="chevronLeft" size={16} />
        </button>

        <button
          type="button"
          data-next
          aria-label={site.common.nextLabel}
          class="absolute right-4 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-line text-chalk transition-colors duration-400 hover:border-champagne hover:text-champagne"
        >
          <Icon name="chevronRight" size={16} />
        </button>
      </div>
    </dialog>
  </details-modal>
</gallery-lightbox>

<script>
  import { defineLightbox, defineModalDialog } from '@podbor/site-kit/browser';

  defineModalDialog('details-modal');
  defineLightbox();
</script>
