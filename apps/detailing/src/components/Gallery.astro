---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { localeFrom } from '@/i18n/currentLocale';
import { getSiteContent } from '@/i18n/content/site';

interface Props {
  images: ImageMetadata[];
  alt: string;
}

const { images, alt } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = getSiteContent(locale);
---

<div class="grid gap-4 sm:grid-cols-2" data-gallery>
  {
    images.map((image, i) => (
      <button
        type="button"
        class="shell group block text-left"
        data-gallery-item={i}
        data-reveal
        data-reveal-delay={(i % 2) * 80}
      >
        <span class="core block overflow-hidden">
          <Image
            src={image}
            alt={`${alt} — ${i + 1}`}
            widths={[480, 900, 1600]}
            sizes="(min-width: 640px) 45vw, 100vw"
            loading="lazy"
            class="block aspect-[4/3] w-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]"
          />
        </span>
      </button>
    ))
  }
</div>

<dialog
  data-lightbox
  class="m-0 h-full max-h-none w-full max-w-none bg-void/95 p-0 backdrop:bg-void/95"
>
  <div class="relative flex h-full items-center justify-center p-4 sm:p-10">
    <img
      data-lightbox-image
      alt=""
      class="max-h-full max-w-full object-contain"
    />

    <button
      type="button"
      data-lightbox-close
      aria-label={site.common.closeLabel}
      class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full border border-line text-chalk transition-colors duration-400 hover:border-champagne hover:text-champagne"
    >
      <Icon name="close" size={16} />
    </button>

    <button
      type="button"
      data-lightbox-prev
      aria-label={site.common.prevLabel}
      class="absolute left-4 flex h-11 w-11 items-center justify-center rounded-full border border-line text-chalk transition-colors duration-400 hover:border-champagne hover:text-champagne"
    >
      <Icon name="chevronLeft" size={16} />
    </button>

    <button
      type="button"
      data-lightbox-next
      aria-label={site.common.nextLabel}
      class="absolute right-4 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-line text-chalk transition-colors duration-400 hover:border-champagne hover:text-champagne"
    >
      <Icon name="chevronRight" size={16} />
    </button>
  </div>
</dialog>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const view = lightbox?.querySelector<HTMLImageElement>(
    '[data-lightbox-image]',
  );

  if (gallery && lightbox && view) {
    const items = [...gallery.querySelectorAll<HTMLImageElement>('img')];
    let index = 0;

    const show = (next: number) => {
      index = (next + items.length) % items.length;
      const source = items[index];
      const srcset = source.srcset
        .split(',')
        .map((part) => part.trim().split(' ')[0])
        .filter(Boolean);
      view.src = srcset.at(-1) || source.currentSrc || source.src;
      view.alt = source.alt;
    };

    gallery.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>(
        '[data-gallery-item]',
      );
      if (!button) return;
      show(Number(button.dataset.galleryItem));
      lightbox.showModal();
    });

    lightbox.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('[data-lightbox-close]') || target === lightbox) {
        lightbox.close();
      } else if (target.closest('[data-lightbox-prev]')) {
        show(index - 1);
      } else if (target.closest('[data-lightbox-next]')) {
        show(index + 1);
      }
    });

    lightbox.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
  }
</script>
