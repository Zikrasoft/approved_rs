---
const PATHS = {
  arrow: 'M3 11 11 3M4.5 3H11v6.5',
  arrowRight: 'M2 7h10M8 3l4 4-4 4',
  check: 'm2.5 7.5 3 3 6-7',
  close: 'm3 3 8 8M11 3l-8 8',
  plus: 'M5 1v8M1 5h8',
  chevronDown: 'm2 4.5 4 4 4-4',
  chevronLeft: 'M9 2 4 7l5 5',
  chevronRight: 'm5 2 5 5-5 5',
  compare: 'M5 2 1 6l4 4M13 2l4 4-4 4',
} as const;

const VIEWBOXES: Record<keyof typeof PATHS, string> = {
  arrow: '0 0 14 14',
  arrowRight: '0 0 14 14',
  check: '0 0 14 14',
  close: '0 0 14 14',
  plus: '0 0 10 10',
  chevronDown: '0 0 12 12',
  chevronLeft: '0 0 14 14',
  chevronRight: '0 0 14 14',
  compare: '0 0 18 12',
};

interface Props {
  name: keyof typeof PATHS;
  size?: number;
  class?: string;
}

const { name, size = 14, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox={VIEWBOXES[name]}
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d={PATHS[name]}></path>
</svg>
