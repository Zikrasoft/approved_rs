---
import Icon from './Icon.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { BCP47_BY_LOCALE } from '@/i18n/config';
import { getSiteContent } from '@/i18n/content/site';
import { getServicesContent } from '@/i18n/content/services';
import { PathBuilder } from '@/utils/paths';
import { CONTACT_LINKS } from '@/utils/contactLinks';
import { PHONE_COUNTRY_SHORTLIST } from '@/utils/constants';
import { SERVICE_SLUGS, type ServiceSlug } from '@/utils/services';
import { phoneCountryOptions } from '@podbor/lead-crm/phone';
import { HONEYPOT_FIELD } from '@podbor/lead-crm';

interface Props {
  service?: ServiceSlug;
  compact?: boolean;
  class?: string;
}

const { service, compact = false, class: className = '' } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = getSiteContent(locale);
const services = getServicesContent(locale);

const DEFAULT_COUNTRY = 'RS';
const uid = `lf-${crypto.randomUUID().slice(0, 8)}`;
const errorId = {
  name: `${uid}-name`,
  telegram: `${uid}-telegram`,
  phone: `${uid}-phone`,
  consent: `${uid}-consent`,
};

const displayLocale = BCP47_BY_LOCALE[locale];
const countryOptions = phoneCountryOptions(displayLocale).filter(
  (country) =>
    PHONE_COUNTRY_SHORTLIST.includes(
      country.iso as (typeof PHONE_COUNTRY_SHORTLIST)[number],
    ) || country.iso === DEFAULT_COUNTRY,
);

const channels = [
  { value: 'whatsapp', icon: 'whatsapp', label: 'WhatsApp', panel: 'ph' },
  { value: 'viber', icon: 'viber', label: 'Viber', panel: 'ph' },
  { value: 'telegram', icon: 'telegram', label: 'Telegram', panel: 'tg' },
  { value: 'phone', icon: 'phone', label: site.form.channelPhone, panel: 'ph' },
] as const;

const field =
  'w-full rounded-2xl border border-white/35 bg-void px-4 py-3 text-base text-chalk shadow-[inset_0_-1px_0_rgba(255,255,255,0.06)] placeholder:text-mute transition-colors duration-400 focus:border-champagne';
const label =
  'mb-2 block text-[0.6875rem] uppercase tracking-[0.18em] text-mute-2';
const chip =
  'flex min-h-11 items-center justify-center gap-2 rounded-2xl border border-white/35 px-2 text-center text-xs text-mute transition-colors duration-400 peer-hover:border-line-strong peer-checked:border-champagne/60 peer-checked:bg-champagne/10 peer-checked:text-chalk peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-champagne';
const serviceChip =
  'flex min-h-11 items-center rounded-full border border-white/35 px-4 text-center text-xs leading-tight text-mute transition-colors duration-400 peer-hover:border-line-strong peer-checked:border-champagne/60 peer-checked:bg-champagne/10 peer-checked:text-chalk peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-champagne';
const errorText = 'mt-2 text-xs leading-relaxed text-[#e0876c]';
const noscriptLink =
  'inline-flex min-h-11 items-center gap-2 rounded-full border border-white/35 px-4 text-xs text-chalk transition-colors duration-400 hover:border-champagne';
---

<form
  method="POST"
  action="/api/leads"
  novalidate
  data-lead-form
  data-submitting-label={site.form.submitting}
  class={`ym-hide-content ym-disable-keys flex flex-col ${compact ? 'gap-4' : 'gap-5'} ${className}`}
>
  <input type="hidden" name="locale" value={locale} />
  <div class="hidden" aria-hidden="true">
    <label>
      {HONEYPOT_FIELD}
      <input
        type="text"
        name={HONEYPOT_FIELD}
        tabindex="-1"
        autocomplete="off"
      />
    </label>
  </div>

  <input type="hidden" name="source_url" data-source-url />
  <input type="hidden" name="visitor_id" data-visitor-id />
  <input type="hidden" name="contact" data-contact />

  <noscript>
    <div
      class="rounded-2xl border border-line bg-white/[0.03] p-4 text-sm leading-relaxed text-mute"
    >
      <p>{site.form.noscriptNote}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <a href={CONTACT_LINKS.phone} class={noscriptLink}>
          <Icon name="phone" size={14} />
          {site.channels.call}
        </a>
        <a href={CONTACT_LINKS.whatsapp} class={noscriptLink}>
          <Icon name="whatsapp" size={14} />
          {site.channels.whatsapp}
        </a>
      </div>
    </div>
  </noscript>

  <div>
    <label class="block">
      <span class={label}>{site.form.nameLabel}</span>
      <input
        name="name"
        data-field="name"
        type="text"
        autocomplete="name"
        placeholder={site.form.namePlaceholder}
        aria-describedby={errorId.name}
        class={field}
        data-name
      />
    </label>
    <p
      id={errorId.name}
      class={errorText}
      aria-live="polite"
      data-error-name
      hidden
    >
      {site.form.requiredError}
    </p>
  </div>

  <fieldset class="group m-0 border-0 p-0">
    <legend class={`${label} p-0`}>{site.form.contactChannelLabel}</legend>

    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" data-contact-order>
      {
        channels.map((channel, index) => (
          <label class="block" data-channel={channel.value}>
            <input
              type="radio"
              name="contact_channel"
              value={channel.value}
              checked={index === 0}
              class={`peer sr-only ch-${channel.panel}`}
            />
            <span class={chip}>
              <Icon name={channel.icon} size={14} />
              {channel.label}
            </span>
          </label>
        ))
      }
    </div>

    <div class="mt-3 hidden group-has-[.ch-tg:checked]:block">
      <label class="block">
        <span class="sr-only">Telegram</span>
        <input
          type="text"
          autocomplete="username"
          placeholder="@username"
          aria-describedby={errorId.telegram}
          class={field}
          data-telegram
          data-field="telegram"
        />
      </label>
      <p
        id={errorId.telegram}
        class={errorText}
        aria-live="polite"
        data-error-telegram
        hidden
      >
        {site.form.errorTelegram}
      </p>
    </div>

    <div class="mt-3 hidden group-has-[.ch-ph:checked]:block">
      <div class="flex gap-2">
        <div class="relative min-w-0 max-w-[min(14rem,45%)] shrink-0">
          <select
            aria-label={site.form.countryLabel}
            class={`${field} max-w-full appearance-none overflow-hidden text-ellipsis px-3 pr-8 [&>option]:bg-ink [&>option]:text-chalk`}
            data-country
            data-display-locale={displayLocale}
          >
            {
              countryOptions.map((country) => (
                <option
                  value={country.iso}
                  data-dial={country.dial}
                  data-dial-primary={country.primary ? '' : undefined}
                  selected={country.iso === DEFAULT_COUNTRY}
                >
                  {country.flag} +{country.dial} {country.name}
                </option>
              ))
            }
          </select>
          <Icon
            name="chevronDown"
            size={12}
            class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-mute"
          />
        </div>
        <label class="min-w-0 flex-1">
          <span class="sr-only">{site.form.contactLabel}</span>
          <input
            type="tel"
            inputmode="tel"
            autocomplete="tel-national"
            placeholder={site.form.contactPlaceholder}
            aria-describedby={errorId.phone}
            class={field}
            data-phone
            data-field="phone"
          />
        </label>
      </div>
      <p
        id={errorId.phone}
        class={errorText}
        aria-live="polite"
        data-error-phone
        hidden
      >
        {site.form.errorPhone}
      </p>
    </div>
  </fieldset>

  <details class="group/svc" open={!compact}>
    <summary
      class={`${field} flex cursor-pointer list-none items-center justify-between gap-2 [&::-webkit-details-marker]:hidden`}
    >
      {site.form.serviceLabel}
      <Icon
        name="chevronDown"
        size={14}
        class="shrink-0 transition-transform duration-400 group-open/svc:rotate-180"
      />
    </summary>
    <div
      class="mt-2 flex flex-wrap gap-2"
      role="group"
      aria-label={site.form.serviceLabel}
    >
      {
        SERVICE_SLUGS.map((slug) => (
          <label class="block">
            <input
              type="checkbox"
              name="service"
              value={slug}
              checked={slug === service}
              class="peer sr-only"
            />
            <span class={serviceChip}>{services[slug].name}</span>
          </label>
        ))
      }
    </div>
    <p class="mt-2 text-xs text-mute-2">{site.form.servicePlaceholder}</p>
  </details>

  <label class="block">
    <span class={label}>{site.form.commentLabel}</span>
    <textarea
      name="comment"
      rows={compact ? 2 : 3}
      placeholder={site.form.commentPlaceholder}
      class={`${field} resize-none`}></textarea>
  </label>

  <div class="lead-submit">
    <div>
      <label class="flex items-start gap-3 py-1.5">
        <input
          type="checkbox"
          name="consent"
          value="1"
          aria-describedby={errorId.consent}
          class="peer sr-only"
          data-consent
          data-field="consent"
        />
        <span
          class="mt-px flex h-5 w-5 shrink-0 items-center justify-center rounded-md border border-white/35 text-void transition-colors duration-400 peer-checked:border-champagne peer-checked:bg-champagne peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-champagne [&>svg]:opacity-0 peer-checked:[&>svg]:opacity-100"
        >
          <Icon name="check" size={10} />
        </span>
        <span class="text-xs leading-relaxed text-mute">
          {site.form.privacyNote}{' '}
          <a
            href={PathBuilder.privacy(locale)}
            target="_blank"
            class="text-mute underline underline-offset-4 transition-colors duration-400 hover:text-champagne"
            >{site.form.privacyLinkText}</a
          >
        </span>
      </label>
      <p
        id={errorId.consent}
        class={errorText}
        aria-live="polite"
        data-error-consent
        hidden
      >
        {site.form.errorConsent}
      </p>
    </div>

    <button
      type="submit"
      class="group/btn inline-flex items-center justify-center gap-3 rounded-full bg-chalk py-3.5 pl-6 pr-2.5 text-sm font-semibold text-void transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-champagne active:scale-[0.98] disabled:opacity-60"
    >
      <span data-submit-label>{site.form.submit}</span>
      <span
        class="flex h-8 w-8 items-center justify-center rounded-full bg-void/10 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-px"
        aria-hidden="true"
      >
        <Icon name="arrow" />
      </span>
    </button>
  </div>
</form>

<script>
  import {
    getOrCreateVisitorId,
    markFieldValidity,
  } from '@podbor/site-kit/browser';
  import { composeE164 } from '@podbor/lead-crm/compose-e164';
  import {
    bindPhoneCountry,
    fillCountrySelect,
  } from '@podbor/lead-crm/phone-input';
  import {
    deferSubmitUntilKit,
    loadPhoneKit,
    phoneKit,
  } from '@podbor/lead-crm/phone-kit';
  import type { CountryCode } from 'libphonenumber-js/min';
  import type { TrackedContactChannel } from '@podbor/lead-crm/contact-channel';

  document
    .querySelectorAll<HTMLFormElement>('[data-lead-form]')
    .forEach(initLeadForm);

  function initLeadForm(form: HTMLFormElement) {
    const pick = <T extends HTMLElement>(selector: string) =>
      form.querySelector<T>(selector)!;

    const source = pick<HTMLInputElement>('[data-source-url]');
    const visitor = pick<HTMLInputElement>('[data-visitor-id]');
    source.value = location.href;

    const contact = pick<HTMLInputElement>('[data-contact]');
    const name = pick<HTMLInputElement>('[data-name]');
    const telegram = pick<HTMLInputElement>('[data-telegram]');
    const country = pick<HTMLSelectElement>('[data-country]');
    const phone = pick<HTMLInputElement>('[data-phone]');
    const consent = pick<HTMLInputElement>('[data-consent]');

    bindPhoneCountry(country, phone);

    const errors = {
      name: pick('[data-error-name]'),
      telegram: pick('[data-error-telegram]'),
      phone: pick('[data-error-phone]'),
      consent: pick('[data-error-consent]'),
    };

    const mark = (error: HTMLElement, control: HTMLElement, valid: boolean) => {
      error.hidden = valid;
      markFieldValidity(control, valid);
    };

    const controlled: [HTMLElement, HTMLElement][] = [
      [errors.name, name],
      [errors.telegram, telegram],
      [errors.phone, phone],
      [errors.consent, consent],
    ];

    const expandCountries = () =>
      loadPhoneKit().then(() => {
        const kit = phoneKit();
        if (kit)
          fillCountrySelect(
            country,
            kit.countryOptions(country.dataset.displayLocale ?? 'sr-RS'),
          );
      });

    form.addEventListener('focusin', expandCountries, { once: true });
    form.addEventListener('pointerenter', () => void expandCountries(), {
      once: true,
    });
    form.addEventListener('input', () => {
      controlled.forEach(([error, control]) => mark(error, control, true));
    });

    form.addEventListener('submit', (event) => {
      if (deferSubmitUntilKit(form)) {
        event.preventDefault();
        return;
      }
      const kit = phoneKit();
      visitor.value = getOrCreateVisitorId();

      const channel = pick<HTMLInputElement>('[name="contact_channel"]:checked')
        .value as TrackedContactChannel;
      const viaTelegram = channel === 'telegram';
      const input = viaTelegram ? telegram : phone;
      const typed = input.value.trim();
      const dial = country.selectedOptions[0]?.dataset.dial ?? '';
      contact.value = viaTelegram
        ? typed.replace(/^@?/, '@')
        : (kit?.parse(typed, country.value as CountryCode)?.number ??
          composeE164(typed, dial));

      const contactError = viaTelegram ? errors.telegram : errors.phone;
      mark(errors.name, name, name.value.trim().length > 0);
      mark(
        contactError,
        input,
        typed.length > 0 &&
          (!kit || kit.isValidContact(contact.value, channel)),
      );
      mark(errors.consent, consent, consent.checked);

      const invalid: [HTMLElement, HTMLElement][] = [
        [errors.name, name],
        [contactError, input],
        [errors.consent, consent],
      ];
      const firstInvalid = invalid.find(([error]) => !error.hidden);
      if (firstInvalid) {
        event.preventDefault();
        firstInvalid[1].focus();
        return;
      }

      const button = pick<HTMLButtonElement>('button[type="submit"]');
      const submitLabel = pick('[data-submit-label]');
      button.disabled = true;
      if (form.dataset.submittingLabel) {
        submitLabel.textContent = form.dataset.submittingLabel;
      }
    });
  }
</script>
