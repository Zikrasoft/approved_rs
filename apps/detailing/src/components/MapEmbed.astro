---
import { mapEmbedSrc } from '@podbor/site-kit';
import { STUDIO_ADDRESS } from '@/utils/constants';

interface Props {
  title: string;
}

const { title } = Astro.props;
const src = mapEmbedSrc({ lat: STUDIO_ADDRESS.lat, lon: STUDIO_ADDRESS.lon });
---

<details-map
  class="block h-72 w-full bg-white/[0.02]"
  data-src={src}
  data-title={title}
  data-iframe-class="block h-full w-full border-0 grayscale"></details-map>

<script>
  import { defineLazyMapEmbed } from '@podbor/site-kit/browser';
  defineLazyMapEmbed('details-map');
</script>
