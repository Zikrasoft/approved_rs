{
  "name": "@podbor/parts-backend",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').writeFileSync('dist/package.json','{\\\"type\\\":\\\"module\\\"}')\"",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate"
  },
  "dependencies": {
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "3.2.6",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
