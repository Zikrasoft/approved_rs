{
  "name": "@podbor/medusa",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "medusa build",
    "start": "cd .medusa/server && medusa start",
    "develop": "medusa develop",
    "db:migrate": "medusa db:migrate",
    "typecheck": "tsc --noEmit",
    "test": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --coverage --coverageProvider=v8 --silent --runInBand --forceExit --passWithNoTests",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=4096\" jest --silent=false --maxWorkers=2 --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/admin-shared": "2.19.0",
    "@medusajs/caching": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/dashboard": "2.19.0",
    "@medusajs/draft-order": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/icons": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@podbor/brands": "workspace:*",
    "@podbor/i18n": "workspace:*",
    "@podbor/shop-catalog": "workspace:*",
    "slugify": "1.6.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.19.0",
    "@swc/core": "1.16.1",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jest": "29.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
