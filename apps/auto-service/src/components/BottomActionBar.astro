---
import BottomBar from './BottomBar.astro';
---

<BottomBar>
  <div class="wrap flex min-h-14 items-center justify-between gap-4 py-1.5">
    <span class="flex min-w-0 flex-col">
      <span class="truncate text-xs text-muted"><slot name="caption" /></span>
      <span class="spec font-semibold text-ink"><slot name="value" /></span>
    </span>
    <slot />
  </div>
</BottomBar>
