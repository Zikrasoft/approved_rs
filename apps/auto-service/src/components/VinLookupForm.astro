---
import { MY_GARAGE_VIN_ATTRIBUTE } from '@podbor/site-kit/browser';
import Icon from './Icon.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';

const locale = localeFrom(Astro.url.pathname);
const copy = content(locale).partsCar.vin;
---

<form
  method="POST"
  action="/api/vin-lookup"
  class="card flex flex-col gap-4 border-ink p-5 sm:p-6"
>
  <input type="hidden" name="locale" value={locale} />
  <div class="flex flex-col gap-1">
    <h2 class="text-section">{copy.heading}</h2>
    <p class="max-w-2xl text-sm leading-relaxed text-ink-2">{copy.lead}</p>
  </div>
  <my-garage class="flex flex-col gap-3 sm:flex-row sm:items-end">
    <label class="block flex-1">
      <span class="field-label">{copy.label}</span>
      <input
        type="text"
        name="vin"
        required
        minlength="17"
        pattern="[A-HJ-NPR-Za-hj-npr-z0-9]{17}"
        autocomplete="off"
        spellcheck="false"
        placeholder={copy.placeholder}
        class="field spec uppercase tracking-wider placeholder:normal-case placeholder:tracking-normal"
        {...{ [MY_GARAGE_VIN_ATTRIBUTE]: '' }}
      />
    </label>
    <button type="submit" class="btn btn-primary">
      {copy.submitLabel}
      <Icon name="arrowRight" />
    </button>
  </my-garage>
</form>

<script>
  import { defineMyGarage } from '@podbor/site-kit/browser';

  defineMyGarage();
</script>
