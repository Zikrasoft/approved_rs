---
import { localeFrom } from '@/i18n/currentLocale';
import { SHOP_STATUS } from '@/utils/shopStatus';
import { content } from '@/i18n/content';

const shop = content(localeFrom(Astro.url.pathname)).shop;
---

{
  SHOP_STATUS === 'preview' ? (
    <>
      <div data-dev-only>
        <slot />
      </div>
      <section data-dev-hidden class="wrap py-band md:py-band-lg">
        <div class="card flex flex-col gap-2 p-6">
          <h1 class="text-block font-semibold text-ink">
            {shop.previewHeading}
          </h1>
          <p class="text-base leading-relaxed text-muted">{shop.previewBody}</p>
        </div>
      </section>
    </>
  ) : (
    <slot />
  )
}
