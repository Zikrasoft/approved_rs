---
import SnapRow from './SnapRow.astro';
import WorkCard from './WorkCard.astro';
import type { Work } from '@/utils/works';

interface Props {
  works: Work[];
  desktop?: number;
  class?: string;
}

const { works, desktop = works.length, class: className } = Astro.props;
---

<SnapRow class:list={['lg:grid-cols-3', className]}>
  {
    works.map((work, i) => (
      <li class:list={[i >= desktop && 'lg:hidden']}>
        <WorkCard
          work={work}
          tags={false}
          sizes="(min-width: 1224px) 368px, (min-width: 1024px) calc(33vw - 1.5rem), (min-width: 640px) 46vw, 78vw"
        />
      </li>
    ))
  }
</SnapRow>
