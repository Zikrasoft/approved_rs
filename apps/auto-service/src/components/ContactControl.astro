---
import type { HTMLAttributes } from 'astro/types';
import type { TrackedContactChannel } from '@podbor/lead-crm/contact-channel';
import { navCurrent } from '@podbor/site-kit';
import { localeFrom } from '@/i18n/config';
import { contactControl } from '@/utils/contactLinks';
import { PathBuilder } from '@/utils/paths';
import type { ServiceSlug } from '@/utils/services';
import PhoneNumber from './PhoneNumber.astro';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  channel: TrackedContactChannel;
  region?: 'contacts';
  showNumber?: boolean;
  service?: ServiceSlug;
  prefill?: string;
  plainClass?: string;
  listItem?: boolean;
}

const {
  channel,
  region,
  showNumber,
  service,
  prefill,
  plainClass,
  listItem = false,
  class: className,
  ...rest
} = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const control = contactControl({
  channel,
  onThanks: Boolean(navCurrent(Astro.url.pathname, PathBuilder.thanks(locale))),
  showNumber,
  region,
  locale,
  service,
  prefill,
});
const coarseOnly = control.pointer === 'coarse-only';
const Item = listItem ? 'li' : Fragment;
const itemAttrs = listItem
  ? {
      'data-channel': channel,
      class:
        coarseOnly && !control.plainNumber ? 'pointer-fine:hidden!' : undefined,
    }
  : {};
---

<Item {...itemAttrs}>
  <a
    {...rest}
    href={control.href}
    {...control.attrs}
    class:list={[className, coarseOnly && 'pointer-fine:hidden!']}
  >
    <slot />
  </a>
  {
    control.plainNumber && (
      <span class:list={[plainClass, 'pointer-coarse:hidden!']}>
        <slot name="plain" />
        <PhoneNumber copy {...control.attrs} />
      </span>
    )
  }
</Item>
