---
import type { HTMLAttributes } from 'astro/types';
import type { TrackedContactChannel } from '@podbor/lead-crm/contact-channel';
import { navCurrent, type ContactPlacement } from '@podbor/site-kit';
import { formatPhone } from '@podbor/site-kit/format-phone';
import { localeFrom } from '@/i18n/currentLocale';
import { contactControl } from '@/utils/contactLinks';
import { PathBuilder } from '@/utils/paths';
import type { ServiceSlug } from '@/utils/services';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  channel: TrackedContactChannel;
  placement: ContactPlacement;
  service?: ServiceSlug;
  plainClass?: string;
  listItem?: boolean;
}

const {
  channel,
  placement,
  service,
  plainClass,
  listItem = false,
  class: className,
  ...rest
} = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const control = contactControl({
  channel,
  placement,
  onThanks:
    navCurrent(Astro.url.pathname, PathBuilder.thanks(locale)) === 'page',
  locale,
  service,
});
const coarseOnly = control.pointer === 'coarse-only';
const Item = listItem ? 'li' : Fragment;
const itemAttrs = listItem
  ? {
      'data-channel': channel,
      class:
        coarseOnly && !control.plainNumber ? 'pointer-fine:hidden!' : undefined,
    }
  : {};
---

<Item {...itemAttrs}>
  <a
    {...rest}
    href={control.href}
    {...control.attrs}
    class:list={[className, coarseOnly && 'pointer-fine:hidden!']}
  >
    <slot />
  </a>
  {
    control.plainNumber && (
      <span class:list={[plainClass, 'pointer-coarse:hidden!']}>
        <slot name="plain" />
        <span class="spec whitespace-nowrap text-sm text-ink">
          {formatPhone(control.plainNumber)}
        </span>
      </span>
    )
  }
</Item>
