---
import type { HTMLAttributes } from 'astro/types';
import type { TrackedContactChannel } from '@podbor/lead-crm/contact-channel';
import type { ContactPlacement } from '@podbor/site-kit';
import { formatPhone } from '@podbor/site-kit/format-phone';
import { localeFrom } from '@/i18n/currentLocale';
import { contactControl } from '@/utils/contactLinks';
import type { ServiceSlug } from '@/utils/services';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  channel: TrackedContactChannel;
  placement: ContactPlacement;
  service?: ServiceSlug;
  plainClass?: string;
}

const {
  channel,
  placement,
  service,
  plainClass,
  class: className,
  ...rest
} = Astro.props;
const control = contactControl({
  channel,
  placement,
  locale: localeFrom(Astro.url.pathname),
  service,
});
const coarseOnly = control.pointer === 'coarse-only';
---

<a
  {...rest}
  href={control.href}
  {...control.attrs}
  class:list={[className, coarseOnly && 'pointer-fine:hidden!']}
>
  <slot />
</a>
{
  control.plainNumber && (
    <span class:list={[plainClass, 'pointer-coarse:hidden!']}>
      <slot name="plain" />
      <span class="spec whitespace-nowrap text-sm text-ink">
        {formatPhone(control.plainNumber)}
      </span>
    </span>
  )
}
