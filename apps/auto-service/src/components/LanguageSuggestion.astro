<language-suggestion
  hidden
  class="relative z-20 block h-0 max-lg:in-[body:has(cookie-consent:not([hidden]))]:hidden print:hidden"
>
  <div class="absolute inset-x-0 top-0 bg-ink text-paper shadow-lg">
    <div class="wrap flex items-center gap-3 py-2">
      <a
        data-lang-link
        href="#"
        class="spec rounded-control bg-paper px-3.5 py-2 text-sm font-semibold text-ink no-underline transition-opacity hover:opacity-90"
      ></a>
      <button
        type="button"
        data-lang-dismiss
        class="-my-1 ml-auto flex size-11 shrink-0 items-center justify-center rounded-control text-xl leading-none opacity-55 transition-opacity hover:opacity-100"
        >&times;</button
      >
    </div>
  </div>
</language-suggestion>
