---
import { mapPlaceUrl } from '@podbor/site-kit';
import Icon from './Icon.astro';
import { localeFrom } from '@/i18n/config';
import { GARAGE_ADDRESS } from '@/utils/constants';
import { googleRatingLabel } from '@/utils/googleRating';

interface Props {
  tone: 'panel' | 'card';
  class?: string;
}

const { tone, class: className } = Astro.props;
const label = googleRatingLabel(localeFrom(Astro.url.pathname));
const TONE = {
  panel: 'text-panel-fg decoration-panel-line hover:decoration-panel-fg',
  card: 'text-ink decoration-line-strong hover:decoration-ink',
}[tone];
---

<a
  href={mapPlaceUrl(GARAGE_ADDRESS.googleMapsCid)}
  target="_blank"
  rel="noopener"
  class:list={[
    'inline-flex w-fit items-center gap-1.5 underline underline-offset-2 transition-colors duration-150 pointer-coarse:min-h-11',
    TONE,
    className,
  ]}
>
  <Icon name="star" size={13} class="shrink-0 fill-current text-signal" />
  {label}
</a>
