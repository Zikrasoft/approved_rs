---
import { contactCta } from '@podbor/site-kit/contact-control';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { shopOpen } from '@/utils/catalogueEnv';
import { PathBuilder } from '@/utils/paths';
import { PARTS_INQUIRY_OPEN_ATTRIBUTE } from '@/scripts/partsList';
import PartsInquiryModal from './PartsInquiryModal.astro';

interface Props {
  class?: string;
  topic?: string;
}

const { class: className, topic } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const copy = content(locale).partsSearch;
const href = PathBuilder.partsInquiry(locale);
const opensModal = topic ? { [PARTS_INQUIRY_OPEN_ATTRIBUTE]: '' } : {};
---

{
  shopOpen() ? (
    <p class:list={['text-sm leading-relaxed text-muted', className]}>
      {copy.notFoundQuestion}{' '}
      <a
        href={href}
        class="link inline-flex min-h-11 items-center font-semibold"
        {...opensModal}
      >
        {copy.notFoundLink}
      </a>
    </p>
  ) : (
    <div
      class:list={[
        'card flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:p-6',
        className,
      ]}
      {...contactCta}
    >
      <div class="flex flex-col gap-1">
        <p class="text-block font-semibold">{copy.pickHeading}</p>
        <p class="text-sm leading-relaxed text-ink-2">{copy.pickBody}</p>
      </div>
      <a
        href={href}
        class="btn btn-primary w-full shrink-0 sm:w-auto"
        {...opensModal}
      >
        {copy.pickCta}
      </a>
    </div>
  )
}
{topic && <PartsInquiryModal comment={`${topic}: `} />}
