---
import { MY_GARAGE_VIN_ATTRIBUTE } from '@podbor/site-kit/browser';

interface Props {
  label: string;
  placeholder: string;
  note?: string;
  value?: string;
}

const { label, placeholder, note, value } = Astro.props;
---

<my-garage class="block">
  <label class="block">
    <span class="field-label">{label}</span>
    <input
      name="vin"
      type="text"
      autocomplete="off"
      placeholder={placeholder}
      value={value}
      class="field"
      {...{ [MY_GARAGE_VIN_ATTRIBUTE]: '' }}
    />
    {note && <p class="mt-1.5 text-xs text-muted">{note}</p>}
  </label>
</my-garage>

<script>
  import { defineMyGarage } from '@podbor/site-kit/browser';

  defineMyGarage();
</script>
