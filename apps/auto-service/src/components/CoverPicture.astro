---
import type { CoverImage } from '@/utils/coverImages';

interface Props {
  cover: CoverImage;
  sizes: string;
  alt: string;
  eager?: boolean;
  class: string;
}

const { cover, sizes, alt, eager = false, class: className } = Astro.props;
---

<picture class="contents">
  <source type="image/avif" srcset={cover.avifSrcset} sizes={sizes} />
  <img
    src={cover.src}
    srcset={cover.srcset}
    sizes={sizes}
    width={cover.width}
    height={cover.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class={className}
  />
</picture>
