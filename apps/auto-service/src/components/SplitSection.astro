---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    'grid gap-8 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:gap-x-14',
    className,
  ]}
>
  <div class="lg:col-start-1 lg:row-start-1">
    <slot name="head" />
  </div>
  <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
    <slot />
  </div>
  {
    Astro.slots.has('aside') && (
      <div class="lg:col-start-1 lg:row-start-2 lg:self-start">
        <slot name="aside" />
      </div>
    )
  }
</div>
