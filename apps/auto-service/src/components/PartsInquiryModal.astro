---
import ModalSheet from './ModalSheet.astro';
import PartsInquiry from './PartsInquiry.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { PARTS_INQUIRY_OPEN_ATTRIBUTE } from '@/scripts/partsList';

interface Props {
  comment?: string;
}

const { comment } = Astro.props;
const { formHeading: heading, formNote } = content(
  localeFrom(Astro.url.pathname),
).pages.partsInquiry;
---

<ModalSheet
  trigger={`[${PARTS_INQUIRY_OPEN_ATTRIBUTE}]`}
  label={heading}
  heading={heading}
>
  <p class="pb-4 text-sm leading-relaxed text-ink-2">{formNote}</p>
  <PartsInquiry comment={comment} />
</ModalSheet>
