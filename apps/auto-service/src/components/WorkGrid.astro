---
import WorkCard from './WorkCard.astro';
import { makeGroup, type Work } from '@/utils/works';

interface Props {
  works: Work[];
  eager?: number;
  class?: string;
  original?: boolean;
}

const {
  works,
  eager = 0,
  class: className = 'mt-8',
  original = false,
} = Astro.props;
---

<ul class={`${className} grid gap-4 md:grid-cols-2 lg:grid-cols-3`}>
  {
    works.map((work, i) => (
      <li data-filter-item data-group={makeGroup(work)}>
        <WorkCard work={work} eager={i < eager} original={original} />
      </li>
    ))
  }
</ul>
