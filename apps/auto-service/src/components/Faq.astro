---
import DisclosureCard from './DisclosureCard.astro';

interface Props {
  items: { q: string; a: string }[];
  class?: string;
}
const { items, class: className = 'mt-8' } = Astro.props;
---

<div class:list={[className, 'flex flex-col gap-3']}>
  {
    items.map((item) => (
      <DisclosureCard name="faq">
        <span slot="summary">{item.q}</span>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted sm:text-base">
          {item.a}
        </p>
      </DisclosureCard>
    ))
  }
</div>
