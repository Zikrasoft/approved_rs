---
import Icon from './Icon.astro';

interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="mt-8 divide-y divide-line border-y border-line">
  {
    items.map((item) => (
      <details name="faq" class="group py-5">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-base font-medium text-ink marker:hidden">
          {item.q}
          <span
            class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded border border-line text-muted transition-colors duration-150 group-open:border-signal group-open:text-signal"
            aria-hidden="true"
          >
            <Icon name="plus" size={12} class="group-open:hidden" />
            <Icon name="minus" size={12} class="hidden group-open:block" />
          </span>
        </summary>
        <p class="mt-3 max-w-3xl pr-10 text-sm leading-relaxed text-muted sm:text-base">
          {item.a}
        </p>
      </details>
    ))
  }
</div>
