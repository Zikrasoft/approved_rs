---
import { Image } from 'astro:assets';
import { formatPrice } from '@podbor/shop-catalog/browser';
import { localeFrom, BCP47_BY_LOCALE } from '@/i18n/config';
import type { CatalogProduct } from '@/lib/catalog';
import { typeView } from '@/lib/typeView';
import { PathBuilder } from '@/utils/paths';
import { content } from '@/i18n/content';

interface Props {
  product: CatalogProduct;
  eager?: boolean;
}

const { product, eager = false } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const shop = content(locale).shop;
const bcp47 = BCP47_BY_LOCALE[locale];
const lines = typeView(product.type, locale).specLines(product.spec, 'card');
const href = PathBuilder.shopProduct(locale, product.type.key, product.handle);
---

<article class="card flex h-full flex-col overflow-hidden">
  <a href={href} class="block bg-shade" tabindex="-1" aria-hidden="true">
    {
      product.image ? (
        <Image
          src={product.image}
          inferSize
          alt=""
          widths={[260, 400, 560]}
          sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, calc(100vw - 2.5rem)"
          loading={eager ? 'eager' : 'lazy'}
          class="aspect-[4/3] w-full object-contain p-5"
        />
      ) : (
        <div class="aspect-[4/3] w-full" />
      )
    }
  </a>
  <div class="flex flex-1 flex-col gap-3 border-t border-line p-4">
    <a href={href} class="text-base font-semibold leading-snug text-ink">
      {product.title}
    </a>
    <dl class="grid grid-cols-1 gap-y-1 text-xs text-muted">
      {
        lines.map((line) => (
          <div class="flex justify-between gap-3">
            <dt>{line.label}</dt>
            <dd class="spec text-right text-ink">{line.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="mt-auto flex items-center justify-between gap-3 pt-2">
      <span class="spec text-lg font-medium text-ink">
        {formatPrice(product.price, bcp47)}
      </span>
      {
        !product.inStock && (
          <span class="spec rounded-full bg-shade px-2.5 py-0.5 text-[0.6875rem] text-muted">
            {shop.outOfStock}
          </span>
        )
      }
    </div>
  </div>
</article>
