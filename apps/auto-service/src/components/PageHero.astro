---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';
import HeroContacts from './HeroContacts.astro';
import type { ServiceSlug } from '@/utils/services';

interface Props {
  eyebrow: string;
  heading: string;
  lead?: string;
  crumbs?: Crumb[];
  service?: ServiceSlug;
  actions?: boolean;
  compact?: boolean;
  desktopLead?: boolean;
}

const {
  eyebrow,
  heading,
  lead,
  crumbs = [],
  service,
  actions = true,
  compact = false,
  desktopLead = false,
} = Astro.props;
---

<section class="border-b border-line bg-card">
  <div
    class:list={[
      'wrap flex flex-col gap-4 pt-6 md:pt-band',
      compact ? 'pb-6 md:pb-band' : 'pb-band md:pb-band-lg',
    ]}
  >
    <Breadcrumbs crumbs={crumbs} />
    {!compact && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="text-hero max-w-3xl break-words" data-hero-heading>
      {heading}
    </h1>
    {
      lead && (
        <p
          class:list={[
            'max-w-2xl text-base leading-relaxed text-muted sm:text-lg',
            desktopLead && 'max-sm:hidden',
          ]}
        >
          {lead}
        </p>
      )
    }
    {
      actions && (
        <HeroContacts tone="card" service={service} class="max-w-xl pt-2" />
      )
    }
    <slot />
  </div>
</section>
