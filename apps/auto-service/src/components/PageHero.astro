---
import { breadcrumbListSchema, jsonLdText } from '@podbor/site-kit';
import { SITE_URL } from '@/utils/constants';
import { localeFrom } from '@/i18n/config';
import { PathBuilder } from '@/utils/paths';
import ContactChannels from './ContactChannels.astro';
import type { ServiceSlug } from '@/utils/services';
import { content } from '@/i18n/content';

interface Props {
  eyebrow: string;
  heading: string;
  lead?: string;
  crumbs?: { href: string; label: string }[];
  service?: ServiceSlug;
  actions?: boolean;
  compact?: boolean;
  clampLead?: boolean;
}

const {
  eyebrow,
  heading,
  lead,
  crumbs = [],
  service,
  actions = true,
  compact = false,
  clampLead = false,
} = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const trail = [
  { href: PathBuilder.home(locale), label: site.common.homeLabel },
  ...crumbs,
];
const breadcrumbSchema = breadcrumbListSchema(SITE_URL, trail);
---

<script type="application/ld+json" set:html={jsonLdText(breadcrumbSchema)} />

<section class="border-b border-line bg-card">
  <div
    class:list={[
      'wrap flex flex-col gap-4',
      compact ? 'py-6 md:py-band' : 'py-band md:py-band-lg',
    ]}
  >
    <nav aria-label={site.common.breadcrumbLabel}>
      <ol class="flex flex-wrap items-center gap-2 text-xs text-muted">
        {
          trail.map((crumb, i) => (
            <li class="flex items-center gap-2">
              {i > 0 && <span aria-hidden="true">/</span>}
              <a
                href={crumb.href}
                class="transition-colors duration-150 hover:text-signal-ink"
              >
                {crumb.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    {!compact && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="text-hero max-w-3xl break-words" data-hero-heading>
      {heading}
    </h1>
    {
      lead && (
        <p
          class:list={[
            'max-w-2xl text-base leading-relaxed text-muted sm:text-lg',
            clampLead && 'max-sm:line-clamp-2',
          ]}
        >
          {lead}
        </p>
      )
    }
    {
      actions && (
        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap sm:items-center">
          <button type="button" data-open-lead-modal class="btn btn-primary">
            {site.header.cta}
          </button>
          <ContactChannels placement="hero" service={service} />
        </div>
      )
    }
    <slot />
  </div>
</section>
