---
interface Props {
  steps: { title: string; text: string }[];
  titlesOnly?: boolean;
}
const { steps, titlesOnly = false } = Astro.props;
---

<ol class="mt-8 grid gap-6 lg:grid-cols-4 lg:gap-8">
  {
    steps.map((step, i) => (
      <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-3 lg:flex lg:flex-col lg:gap-2 lg:border-t lg:border-line-strong lg:pt-5">
        <span class="spec text-sm font-semibold text-muted lg:text-base">
          {i + 1}
        </span>
        <div class="flex flex-col gap-1">
          <h3 class="font-semibold text-ink">{step.title}</h3>
          {!titlesOnly && (
            <p class="text-sm leading-relaxed text-muted">{step.text}</p>
          )}
          {i === 0 && <slot name="first" />}
        </div>
      </li>
    ))
  }
</ol>
