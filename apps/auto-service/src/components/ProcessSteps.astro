---
interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
---

<ol class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  {
    steps.map((step, i) => (
      <li class="card flex flex-col gap-2 p-5">
        <span class="spec text-sm font-medium text-signal-ink">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="text-base font-semibold text-ink">{step.title}</h3>
        <p class="text-sm leading-relaxed text-muted">{step.text}</p>
      </li>
    ))
  }
</ol>
