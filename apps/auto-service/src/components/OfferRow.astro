---
import Icon from '@/components/Icon.astro';
import type { PartOffer } from '@podbor/catalog-contract';
import { BCP47_BY_LOCALE, localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { offerAvailability } from '@/utils/leadTime';
import { formatMoney } from '@/utils/money';
import { contactCta } from '@podbor/site-kit/contact-control';

interface Props {
  offer?: PartOffer;
  secondary?: boolean;
  inFlow?: boolean;
  askHref: string;
}

const locale = localeFrom(Astro.url.pathname);
const { offer, secondary = false, inFlow = false, askHref } = Astro.props;
const localeTag = BCP47_BY_LOCALE[locale];
const copy = content(locale).shopPart;
const { stock, lead, buyable } = offer
  ? offerAvailability(offer, copy.leadTime, localeTag)
  : { stock: null, lead: null, buyable: false };
---

<li
  class="flex flex-wrap items-center gap-x-5 gap-y-3 py-4 first:pt-0 last:pb-0"
>
  <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
    <span class="spec text-2xl font-semibold text-ink" data-price>
      {offer && formatMoney(offer.price, offer.currency, localeTag)}
    </span>
    <span
      class="hidden h-4 w-28 animate-pulse rounded-pill bg-shade offers-pending:inline-block motion-reduce:animate-none"
      aria-hidden="true"></span>
    <span
      class="text-sm text-ink-2 offers-pending:hidden!"
      data-stock
      hidden={!stock}
    >
      {stock}
    </span>
    <span
      class="rounded-pill border border-line px-2 py-0.5 text-xs text-ink-2 offers-pending:hidden!"
      data-out
      hidden={!offer || buyable}
    >
      {copy.outOfStock}
    </span>
    <span
      class="text-sm text-muted offers-pending:hidden!"
      data-lead
      hidden={!lead}
    >
      {lead}
    </span>
  </div>
  <div class="flex w-full flex-col" {...inFlow && contactCta}>
    <span
      class="hidden h-11 w-full animate-pulse rounded-control bg-shade offers-pending:block motion-reduce:animate-none"
      aria-hidden="true"></span>
    <button
      type="button"
      class:list={[
        'btn w-full offers-pending:hidden! noscript:hidden! aria-busy:cursor-progress aria-busy:opacity-60',
        secondary ? 'btn-secondary' : 'btn-primary',
      ]}
      data-buy
      data-offer-id={offer?.id}
      hidden={!buyable}
    >
      <span data-label>{copy.buyButtonLabel}</span>
    </button>
    <a
      href={askHref}
      class:list={[
        'btn btn-secondary w-full offers-pending:hidden! noscript:inline-flex!',
        buyable && 'hidden',
      ]}
      data-ask
    >
      {copy.askSupplyCta}
      <Icon name="arrowRight" />
    </a>
  </div>
</li>
