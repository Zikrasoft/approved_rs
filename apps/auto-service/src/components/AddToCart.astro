<script>
  import { readCart, writeCart, addLine } from '@/utils/cart';

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      '[data-add-to-cart]',
    );
    if (!button) return;

    const slug = button.dataset.slug;
    const title = button.dataset.title;
    const price = Number(button.dataset.price);
    if (!slug || !title || !Number.isFinite(price)) return;

    writeCart(addLine(readCart(), { slug, title, price }));

    const label = button.dataset.addedLabel;
    const labelEl = button.querySelector<HTMLElement>(
      '[data-add-to-cart-label]',
    );
    if (!label || !labelEl) return;
    labelEl.dataset.idleLabel ??= labelEl.textContent ?? '';
    window.clearTimeout(Number(button.dataset.resetTimer));
    labelEl.textContent = label;
    button.dataset.resetTimer = String(
      window.setTimeout(() => {
        labelEl.textContent = labelEl.dataset.idleLabel ?? '';
      }, 1600),
    );
  });
</script>
