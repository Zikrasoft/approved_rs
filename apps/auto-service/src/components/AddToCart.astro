---
import Icon from './Icon.astro';
import { formatPrice } from '@podbor/shop-catalog/browser';
import { BCP47_BY_LOCALE } from '@/i18n/config';
import { localeFrom } from '@/i18n/currentLocale';
import { getShopContent } from '@/i18n/content/shop';
import type { CatalogProduct, Installation } from '@/lib/catalog';
import { PathBuilder } from '@/utils/paths';
import { SHOP_STATUS } from '@/utils/shopStatus';

interface Props {
  product: CatalogProduct;
  installation?: Installation;
  regionId: string;
}

const { product, installation, regionId } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const shop = getShopContent(locale);
const installCopy = installation
  ? shop.installations[installation.handle]
  : undefined;
---

<add-to-cart
  data-region={regionId}
  data-variant={product.variantId}
  data-type={product.typeKey}
  data-locale={locale}
  data-install-variant={installation?.variantId}
  data-added-label={shop.inCart}
  data-error-label={shop.addError}
  data-sold-out-label={shop.soldOutError}
  data-install-error-label={shop.installError}
  {...SHOP_STATUS === 'preview' ? { 'data-preview': '' } : {}}
  class="flex flex-col gap-3"
>
  {
    installation && installCopy && (
      <label class="card flex min-h-11 items-start gap-3 p-4">
        <input
          type="checkbox"
          data-install-toggle
          class="mt-0.5 size-4 shrink-0 accent-signal"
        />
        <span class="flex flex-col gap-0.5">
          <span class="text-sm font-medium text-ink">
            {installCopy.name}
            <span class="spec text-muted">
              {` +${formatPrice(installation.price, BCP47_BY_LOCALE[locale])}`}
            </span>
          </span>
          <span class="text-xs leading-relaxed text-muted">
            {installCopy.note}
          </span>
        </span>
      </label>
    )
  }
  <button
    type="button"
    data-add
    class="btn btn-primary w-full sm:w-auto"
    disabled={!product.inStock}
  >
    <Icon name="cart" />
    <span data-label>{shop.addToCart}</span>
  </button>
  <p data-message aria-live="polite" hidden class="text-sm text-signal-dark">
  </p>
  <a
    data-go-cart
    hidden
    href={PathBuilder.cart(locale)}
    class="btn btn-secondary w-full sm:w-auto"
  >
    {shop.goToCart}
    <Icon name="arrowRight" />
  </a>
</add-to-cart>

<script>
  import { defineAddToCart } from '@/scripts/shop/addToCart';

  defineAddToCart();
</script>
