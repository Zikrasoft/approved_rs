---
import { jsonLdText } from '@podbor/site-kit';
import type { FitmentIndex } from '@podbor/shop-catalog/browser';
import { localeFrom } from '@/i18n/currentLocale';
import { getShopContent } from '@/i18n/content/shop';

interface Props {
  index: FitmentIndex;
}

const { index } = Astro.props;
const shop = getShopContent(localeFrom(Astro.url.pathname));
const selects = [
  { name: 'make', label: shop.makeLabel, options: index.makes },
  { name: 'model', label: shop.modelLabel, options: [] as string[] },
  { name: 'year', label: shop.yearLabel, options: [] as string[] },
];
---

<car-picker data-any={shop.anyOption} class="card flex flex-col gap-4 p-5">
  <div class="flex flex-col gap-1">
    <h2 class="text-block font-semibold text-ink">{shop.fitmentHeading}</h2>
    <p class="text-sm leading-relaxed text-muted">{shop.carLead}</p>
  </div>
  <script
    type="application/json"
    data-index
    is:inline
    set:html={jsonLdText(index)}
  />
  <div class="grid gap-3 sm:grid-cols-3">
    {
      selects.map((select) => (
        <label class="block">
          <span class="field-label">{select.label}</span>
          <select
            data-car={select.name}
            class="field"
            disabled={select.options.length === 0}
          >
            <option value="">{shop.anyOption}</option>
            {select.options.map((value) => (
              <option value={value}>{value}</option>
            ))}
          </select>
        </label>
      ))
    }
  </div>
  <button
    type="button"
    data-car-clear
    class="min-h-11 self-start text-sm text-muted underline underline-offset-2 hover:text-signal-ink"
  >
    {shop.carClear}
  </button>
</car-picker>

<script>
  import { defineCarPicker } from '@/scripts/shop/carPicker';

  defineCarPicker();
</script>
