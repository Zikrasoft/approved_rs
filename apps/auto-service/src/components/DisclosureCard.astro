---
import Chevron from './Chevron.astro';

interface Props {
  name?: string;
}

const { name } = Astro.props;
---

<details name={name} class="card group">
  <summary
    class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-base font-semibold text-ink marker:hidden group-open:pb-0 [&::-webkit-details-marker]:hidden"
  >
    <slot name="summary" />
    <Chevron />
  </summary>
  <div class="px-5 pb-5">
    <slot />
  </div>
</details>
