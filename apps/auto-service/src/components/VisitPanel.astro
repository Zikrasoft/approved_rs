---
import { mapRouteUrl } from '@podbor/site-kit';
import { contactRegion } from '@podbor/site-kit/contact-control';
import CallAction from './CallAction.astro';
import GarageAddress from './GarageAddress.astro';
import GoogleRating from './GoogleRating.astro';
import Icon from './Icon.astro';
import MapEmbed from './MapEmbed.astro';
import PanelPicture from './PanelPicture.astro';
import facade from '@/assets/workshop-facade.jpg';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { GARAGE_ADDRESS } from '@/utils/constants';
import { visitPhoto } from '@/utils/panelPhoto';

interface Props {
  heading: string;
  as?: 'h1' | 'h2';
  class?: string;
  mediaFirst?: boolean;
}

const {
  heading,
  as: Heading = 'h2',
  class: className,
  mediaFirst = true,
} = Astro.props;
const { site, pages } = content(localeFrom(Astro.url.pathname));
const photo = await visitPhoto({ image: facade, alt: site.photos.facade });
const action = 'btn min-h-12 w-full sm:w-auto sm:px-7';
---

<section class:list={['wrap', className]} {...contactRegion('visit')}>
  <div
    class="grid overflow-hidden rounded-block bg-panel text-panel-fg lg:grid-cols-2"
  >
    <div class="flex flex-col gap-5 p-5 pb-6 sm:p-8 lg:p-12">
      <Heading class="text-section">{heading}</Heading>
      <GarageAddress layout="block" tone="panel" />
      <GoogleRating tone="panel" class="text-sm" />
      {
        site.visit.facts.length > 0 && (
          <ul class="flex flex-col gap-1.5 text-sm text-panel-ink">
            {site.visit.facts.map((fact) => (
              <li class="flex gap-2">
                <Icon name="check" size={12} class="mt-1 shrink-0" />
                {fact}
              </li>
            ))}
          </ul>
        )
      }
      <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
        <CallAction class={`${action} btn-primary`} />
        <a
          href={mapRouteUrl(GARAGE_ADDRESS.lat, GARAGE_ADDRESS.lon)}
          target="_blank"
          rel="noopener"
          class={`${action} btn-on-panel`}
        >
          <Icon name="route" size={16} class="shrink-0" />
          {site.visit.route}
        </a>
      </div>
      <slot name="channels" />
    </div>
    <PanelPicture
      photo={photo}
      class={mediaFirst ? 'max-lg:order-first' : undefined}
    />
    <MapEmbed
      title={pages.contact.mapHeading}
      class="h-64 border-t border-panel-line/60 bg-panel-2 sm:h-80 lg:col-span-2"
    />
  </div>
</section>
