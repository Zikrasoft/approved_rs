---
import Icon from './Icon.astro';

interface Props {
  href?: string;
  label?: string;
}

const { href, label } = Astro.props;
---

<a
  href={href}
  data-search-href
  class="group flex min-h-12 items-center justify-between gap-3 rounded-control border border-line bg-paper px-4 py-2.5 text-base leading-snug font-semibold wrap-anywhere text-ink transition-colors duration-150 hover:border-ink motion-reduce:transition-none"
>
  <span data-search-name>{label}</span>
  <Icon
    name="chevronRight"
    size={14}
    class="shrink-0 text-muted transition-colors duration-150 group-hover:text-ink motion-reduce:transition-none"
  />
</a>
