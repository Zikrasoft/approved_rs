---
import LeadForm from './LeadForm.astro';
import ModalSheet from './ModalSheet.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import type { ServiceSlug } from '@/utils/services';

interface Props {
  trigger?: string;
  service?: ServiceSlug;
  comment?: string;
}

const { trigger = '[data-open-lead-modal]', service, comment } = Astro.props;
const form = content(localeFrom(Astro.url.pathname)).site.form;
---

<ModalSheet
  trigger={trigger}
  label={form.modalTitle}
  heading={form.heading}
  subheading={form.subheading}
>
  <LeadForm compact service={service} comment={comment} />
</ModalSheet>
