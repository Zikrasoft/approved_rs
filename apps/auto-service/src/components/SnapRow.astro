---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ul
  class:list={[
    '-mx-5 flex snap-x snap-mandatory scroll-px-5 gap-3 overflow-x-auto px-5 pb-1 [scrollbar-width:none] *:w-[78%] *:shrink-0 *:snap-start sm:*:w-[46%] lg:mx-0 lg:grid lg:gap-4 lg:overflow-visible lg:px-0 lg:*:w-auto',
    className,
  ]}
>
  <slot />
</ul>
