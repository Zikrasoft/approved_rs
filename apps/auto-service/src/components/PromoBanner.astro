---
import Icon from './Icon.astro';
import { pickRandomBanner } from '@podbor/site-kit';

interface Props {
  label: string;
  banners: string[];
}

const { label, banners } = Astro.props;
const banner = pickRandomBanner(banners);
---

<div class="wrap border-t border-line py-8">
  <p
    class="flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-signal-ink"
  >
    <Icon name="info" size={14} class="shrink-0" />
    {label}
  </p>
  <p
    class="mt-3 text-sm leading-relaxed text-ink-2 [&_strong]:font-semibold [&_strong]:text-ink"
    set:html={banner}
  />
</div>
