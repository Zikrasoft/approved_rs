---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import CartButton from './CartButton.astro';
import { SUPPORTED_LOCALES, LOCALE_NAME } from '@/i18n/config';
import { localeFrom } from '@/i18n/currentLocale';
import { getSiteContent } from '@/i18n/content/site';
import { PathBuilder, swapLocale } from '@/utils/paths';
import { navCurrent, LOCALE_CHOICE_ATTRIBUTE } from '@podbor/site-kit';
import { CONTACT_LINKS } from '@/utils/contactLinks';
import { SHOP_ENABLED } from '@/utils/constants';

const locale = localeFrom(Astro.url.pathname);
const site = getSiteContent(locale);
const pathname = Astro.url.pathname;

const links = [
  { href: PathBuilder.services(locale), label: site.nav.services },
  { href: PathBuilder.works(locale), label: site.nav.works },
  ...(SHOP_ENABLED
    ? [{ href: PathBuilder.shop(locale), label: site.nav.shop }]
    : []),
  { href: `${PathBuilder.home(locale)}#process`, label: site.nav.process },
  { href: PathBuilder.contact(locale), label: site.nav.contact },
].map((link) => ({ ...link, current: navCurrent(pathname, link.href) }));
---

<carlab-menu
  class="group contents"
  data-lock-scroll
  data-desktop-media="(min-width: 768px)"
>
  <header
    class="sticky top-0 z-30 border-b border-line bg-paper/90 backdrop-blur"
  >
    <div class="wrap flex h-[4.5rem] items-center justify-between gap-4">
      <a
        href={PathBuilder.home(locale)}
        class="shrink-0"
        aria-label={site.common.homeLabel}
      >
        <Wordmark />
      </a>

      <nav
        class="hidden items-center gap-6 md:flex"
        aria-label={site.common.primaryNavLabel}
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={link.current}
              class:list={[
                'relative text-sm font-medium transition-colors duration-150',
                link.current
                  ? 'text-ink after:absolute after:inset-x-0 after:-bottom-1.5 after:h-0.5 after:bg-signal'
                  : 'text-muted hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <carlab-lang class="hidden items-center gap-1 lg:flex">
          {
            SUPPORTED_LOCALES.map((code) => (
              <a
                href={swapLocale(pathname, code)}
                hreflang={code}
                {...{ [LOCALE_CHOICE_ATTRIBUTE]: code }}
                title={LOCALE_NAME[code]}
                aria-current={code === locale ? 'true' : undefined}
                class:list={[
                  'spec rounded-full px-2.5 py-1 text-[0.6875rem] uppercase tracking-widest transition-colors duration-150',
                  code === locale
                    ? 'bg-shade text-ink'
                    : 'text-muted hover:text-ink',
                ]}
              >
                {code}
              </a>
            ))
          }
        </carlab-lang>

        {SHOP_ENABLED && <CartButton />}

        <a
          href={CONTACT_LINKS.phone}
          data-contact-channel="phone"
          class="btn btn-secondary hidden h-10 py-0 lg:inline-flex"
        >
          <Icon name="phone" />
          <span class="spec text-xs">{site.header.phoneLabel}</span>
        </a>

        <button
          type="button"
          data-open-lead-modal
          class="btn btn-primary h-10 py-0"
        >
          {site.header.cta}
        </button>

        <button
          type="button"
          data-menu-button
          aria-expanded="false"
          aria-controls="site-menu"
          aria-label={site.header.menuOpenLabel}
          data-close-label={site.header.menuCloseLabel}
          class="flex h-10 w-10 items-center justify-center rounded-control border border-line-strong text-ink md:hidden"
        >
          <span class="relative block h-3 w-4" aria-hidden="true">
            <span
              class="absolute left-0 top-0 h-0.5 w-full bg-current transition-transform duration-200 group-data-[open]:translate-y-[5px] group-data-[open]:rotate-45"
            ></span>
            <span
              class="absolute bottom-0 left-0 h-0.5 w-full bg-current transition-transform duration-200 group-data-[open]:-translate-y-[5px] group-data-[open]:-rotate-45"
            ></span>
          </span>
        </button>
      </div>
    </div>
  </header>

  <div
    id="site-menu"
    data-menu
    class="invisible fixed inset-0 z-20 flex flex-col justify-between overflow-y-auto bg-paper/95 px-5 pb-28 pt-24 opacity-0 backdrop-blur-xl transition-[opacity,visibility] duration-200 group-data-[open]:visible group-data-[open]:opacity-100 md:hidden"
    inert
  >
    <nav class="flex flex-col" aria-label={site.common.mobileNavLabel}>
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={link.current}
            class:list={[
              'border-b border-line py-5 text-2xl font-semibold tracking-tight',
              link.current ? 'text-ink' : 'text-ink-2',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-col gap-4">
      <a
        href={CONTACT_LINKS.phone}
        data-contact-channel="phone"
        class="btn btn-secondary w-full"
      >
        <Icon name="phone" />
        <span class="spec">{site.header.phoneLabel}</span>
      </a>
      <carlab-lang class="flex items-center gap-2">
        <span class="text-xs text-muted">{site.header.languageLabel}</span>
        {
          SUPPORTED_LOCALES.map((code) => (
            <a
              href={swapLocale(pathname, code)}
              hreflang={code}
              {...{ [LOCALE_CHOICE_ATTRIBUTE]: code }}
              class:list={[
                'spec rounded-full px-3 py-1 text-xs uppercase tracking-widest',
                code === locale
                  ? 'bg-shade text-ink'
                  : 'text-muted hover:text-ink',
              ]}
            >
              {code}
            </a>
          ))
        }
      </carlab-lang>
    </div>
  </div>
</carlab-menu>

<script>
  import {
    defineLocaleChoice,
    defineMenuToggle,
  } from '@podbor/site-kit/browser';

  defineLocaleChoice('carlab-lang');
  defineMenuToggle('carlab-menu');
</script>
