---
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import CartAddonToggle from './CartAddonToggle.astro';
import Icon from './Icon.astro';
import LineItem from './LineItem.astro';

const copy = content(localeFrom(Astro.url.pathname)).shopCart;
const stepper =
  'flex size-11 items-center justify-center text-ink-2 transition-colors duration-150 hover:text-ink focus-visible:outline-2 focus-visible:outline-ink disabled:cursor-not-allowed disabled:opacity-40 aria-busy:cursor-progress aria-busy:opacity-60';
---

<template data-line>
  <LineItem variant="editable" class="group py-4 pr-3 pl-5 sm:pl-6">
    <span slot="status" class="text-sm text-ink-2" data-ready hidden></span>
    <button
      slot="aside"
      type="button"
      class="-my-2 flex size-11 shrink-0 items-center justify-center text-ink-2 transition-colors duration-150 hover:text-signal-ink focus-visible:outline-2 focus-visible:outline-ink aria-busy:opacity-40"
      aria-label={copy.removeLabel}
      data-remove
    >
      <Icon name="close" size={16} />
    </button>
    <p
      class="flex items-start gap-2 text-sm leading-relaxed text-danger"
      data-unavailable
      hidden
    >
      <Icon name="warning" size={16} class="mt-0.5 shrink-0" />
      <span>{copy.unavailableTag}</span>
    </p>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center rounded-control border border-line-field">
        <button
          type="button"
          class={stepper}
          aria-label={copy.decreaseLabel}
          data-decrease
        >
          <Icon name="minus" />
        </button>
        <span
          class="spec min-w-8 text-center text-sm font-semibold text-ink"
          data-quantity></span>
        <button
          type="button"
          class={stepper}
          aria-label={copy.increaseLabel}
          data-increase
        >
          <Icon name="plus" />
        </button>
      </div>
      <div class="flex flex-col items-end text-right">
        <span
          class="spec font-semibold text-ink transition-opacity group-aria-busy:opacity-40"
          data-price></span>
        <span class="text-xs text-muted" data-unit></span>
      </div>
    </div>
    <CartAddonToggle hook="data-addon" />
    <CartAddonToggle hook="data-installation" />
    <button type="button" class="btn btn-secondary btn-block" data-lower hidden
    ></button>
    <button
      type="button"
      class="btn btn-secondary btn-block"
      data-to-inquiry
      hidden
    >
      {copy.toInquiryLabel}
    </button>
  </LineItem>
</template>
