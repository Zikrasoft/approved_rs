---
import type { PartOffer } from '@podbor/catalog-contract';
import { BCP47_BY_LOCALE, localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { bestPrice } from '@/utils/bestPrice';
import { formatLeadTime } from '@/utils/leadTime';
import { formatMoney } from '@/utils/money';

interface Props {
  pages: { offers: PartOffer[] }[];
  exact?: boolean;
  class?: string;
}

const locale = localeFrom(Astro.url.pathname);
const localeTag = BCP47_BY_LOCALE[locale];
const copy = content(locale).shopPart;
const { pages, exact = false, class: className } = Astro.props;
const best = bestPrice(pages);
const price = best ? formatMoney(best.price, best.currency, localeTag) : '';
const availability =
  best &&
  (best.inStock
    ? copy.columns.stock
    : best.leadDays > 0
      ? `${copy.columns.leadTimeShort} ${formatLeadTime(best.leadDays, copy.leadTime, localeTag)}`
      : copy.outOfStock);
---

{
  best ? (
    <span class:list={['flex flex-col items-end text-right', className]}>
      <span class="spec text-sm font-semibold whitespace-nowrap text-ink">
        {exact ? price : copy.fromPrice.replace('{price}', price)}
      </span>
      <span class="text-xs text-ink-2">{availability}</span>
    </span>
  ) : (
    <span class:list={['text-right text-xs text-muted', className]}>
      {copy.priceOnRequestTag}
    </span>
  )
}
