---
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';

interface Props {
  hook: 'data-addon' | 'data-installation';
}

const { hook } = Astro.props;
const { addonPickup } = content(localeFrom(Astro.url.pathname)).shopCart;
---

<label
  class="flex cursor-pointer items-start gap-3 rounded-control border border-line bg-shade px-3 py-2.5 text-sm leading-snug text-ink has-checked:border-signal aria-busy:cursor-progress aria-busy:opacity-60"
  {...{ [hook]: '' }}
  hidden
>
  <input
    type="checkbox"
    class="mt-0.5 size-4 shrink-0 accent-signal-ink"
    data-addon-toggle
  />
  <span class="flex min-w-0 flex-1 flex-col gap-0.5">
    <span data-addon-label></span>
    <span class="text-xs text-muted">{addonPickup}</span>
  </span>
  <span class="flex shrink-0 flex-col items-end text-right">
    <span class="spec font-semibold whitespace-nowrap text-ink" data-addon-price
    ></span>
    <span class="text-xs text-muted" data-addon-unit></span>
  </span>
</label>
