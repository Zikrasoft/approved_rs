---
import { translated } from '@podbor/catalog-contract';
import { BCP47_BY_LOCALE, localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { shopOpen } from '@/utils/catalogueEnv';
import type { PartPageEntry } from '@/utils/catalogueSnapshot';
import { addonDataset } from '@/utils/categoryAddon';
import { PathBuilder } from '@/utils/paths';
import { PARTS_INQUIRY_OPEN_ATTRIBUTE } from '@/scripts/partsList';
import { contactCta } from '@podbor/site-kit/contact-control';
import { mapPlaceUrl } from '@podbor/site-kit';
import { GARAGE_ADDRESS } from '@/utils/constants';
import Icon from './Icon.astro';
import OfferRow from './OfferRow.astro';
import { formatMoney } from '@/utils/money';
import { moreOffersLabel, offerSummary } from '@/utils/bestPrice';

interface Props {
  page: PartPageEntry;
  demoted?: boolean;
}

const { page, demoted = false } = Astro.props;
const ownHeading = Astro.slots.has('heading');
const locale = localeFrom(Astro.url.pathname);
const copy = content(locale).shopPart;
const { pickupMethod } = content(locale).shopCart;
const status = 'flex flex-col gap-3 text-sm leading-relaxed text-ink-2';
const part = {
  'data-slug': page.slug,
  'data-brand': page.brand.name,
  'data-number': page.value,
  'data-name': translated(page.part, 'name', locale),
  ...addonDataset(page.category),
};
const closed = !shopOpen();
const priced = page.offers.length > 0 && !closed;
const summary = offerSummary(page.offers);
const { best, others } = summary;
const localeTag = BCP47_BY_LOCALE[locale];
const askHref = PathBuilder.partsInquiry(
  locale,
  `${page.brand.name} ${page.value}`,
);
---

{
  (priced || closed) && (
    <part-offers
      class="card flex flex-col gap-4 border-transparent bg-shade p-5 sm:p-6"
      {...(priced ? {} : { hidden: '' })}
      data-preview={closed ? '' : undefined}
      data-id={page.id}
      data-locale-tag={localeTag}
      data-availability={JSON.stringify(copy.leadTime)}
      data-added-label={copy.addedLabel}
      data-cart-href={PathBuilder.partsCart(locale)}
      data-more-label={copy.moreOffers}
      data-more-cheaper-label={copy.moreOffersCheaper}
      {...part}
    >
      <h2 class="text-block font-semibold">
        <slot name="heading">{copy.offersHeading}</slot>
      </h2>
      <ul class="flex flex-col" data-offers>
        {best && <OfferRow offer={best} inFlow askHref={askHref} />}
      </ul>
      <p class="flex flex-col text-sm leading-relaxed text-ink-2">
        <span>{pickupMethod}</span>
        <a
          href={mapPlaceUrl(GARAGE_ADDRESS.googleMapsCid)}
          target="_blank"
          rel="noopener"
          class="self-start font-semibold text-ink underline underline-offset-2 hover:text-signal-ink"
        >
          {GARAGE_ADDRESS.street}, {GARAGE_ADDRESS.district}
        </a>
      </p>
      <details class="group/more" data-more hidden={others.length === 0}>
        <summary class="inline-flex min-h-11 list-none items-center gap-1.5 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden">
          <span data-more-count>
            {moreOffersLabel(summary, copy, (offer) =>
              formatMoney(offer.price, offer.currency, localeTag),
            )}
          </span>
          <Icon
            name="chevronDown"
            size={16}
            class="transition-transform duration-150 group-open/more:rotate-180 motion-reduce:transition-none"
          />
        </summary>
        <ul
          class="mt-2 flex flex-col divide-y divide-line border-t border-line pt-4"
          data-more-offers
        >
          {others.map((offer) => (
            <OfferRow offer={offer} secondary askHref={askHref} />
          ))}
        </ul>
      </details>
      <template data-offer>
        <OfferRow askHref={askHref} />
      </template>
      <div aria-live="polite">
        <div data-status="added" hidden class={status}>
          <p>{copy.addedNotice}</p>
          <a
            href={PathBuilder.partsCart(locale)}
            class="btn btn-primary w-full sm:w-auto sm:self-start"
          >
            {copy.addedCta}
            <Icon name="arrowRight" />
          </a>
        </div>
        <p data-status="stock-limit" hidden class={status}>
          {copy.stockLimitNotice}
        </p>
        <p data-status="inquiry" hidden class={status}>
          <span>
            {copy.inquiryNotice}{' '}
            <a
              href={PathBuilder.partsInquiry(locale)}
              class="font-semibold text-signal-ink underline underline-offset-2"
            >
              {copy.inquiryCta}
            </a>
          </span>
        </p>
      </div>
    </part-offers>
  )
}
{
  !priced && (
    <div
      class:list={[
        'card flex flex-col gap-3 p-5 sm:p-6',
        !demoted && 'border-transparent bg-shade',
      ]}
    >
      <h2 class="text-block font-semibold">
        <slot name="heading">{copy.priceOnRequestHeading}</slot>
      </h2>
      {ownHeading && (
        <p class="font-semibold text-ink">{copy.priceOnRequestHeading}</p>
      )}
      <p class="text-sm leading-relaxed text-ink-2">{copy.orderBody}</p>
      <parts-list-add class="mt-1 block" {...part} {...contactCta}>
        <a
          href={askHref}
          {...{ [PARTS_INQUIRY_OPEN_ATTRIBUTE]: '' }}
          class:list={[
            'btn w-full sm:w-auto',
            demoted ? 'btn-secondary' : 'btn-primary',
          ]}
        >
          {copy.priceOnRequestCta}
        </a>
      </parts-list-add>
    </div>
  )
}
