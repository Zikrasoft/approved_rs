---
import SectionHead from './SectionHead.astro';
import WorkSnapRow from './WorkSnapRow.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { PathBuilder } from '@/utils/paths';
import type { Work } from '@/utils/works';

interface Props {
  works: Work[];
  eyebrow: string;
  heading: string;
}

const { works, eyebrow, heading } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const allWorks = PathBuilder.works(locale);
---

{
  works.length > 0 && (
    <section class="bg-shade">
      <div class="wrap py-band md:py-band-lg">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <SectionHead eyebrow={eyebrow} heading={heading} />
          <a href={allWorks} class="btn btn-secondary w-fit max-sm:hidden">
            {site.common.allWorks}
          </a>
        </div>
        <WorkSnapRow works={works.slice(0, 6)} desktop={3} class="mt-8" />
        <a href={allWorks} class="btn btn-secondary mt-5 w-full sm:hidden">
          {site.common.allWorks}
        </a>
      </div>
    </section>
  )
}
