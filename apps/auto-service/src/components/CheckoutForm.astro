---
import Icon from './Icon.astro';
import PhoneInput from './PhoneInput.astro';
import { CART_METADATA } from '@podbor/shop-catalog/browser';
import { localeFrom } from '@/i18n/currentLocale';
import { PathBuilder } from '@/utils/paths';
import { content } from '@/i18n/content';

const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const shop = content(locale).shop;
const channels = [
  { value: 'phone', label: site.form.channelPhone },
  { value: 'whatsapp', label: 'WhatsApp' },
  { value: 'viber', label: 'Viber' },
  { value: 'telegram', label: 'Telegram' },
] as const;
const errorText = 'mt-1.5 text-xs leading-relaxed text-signal-dark';
const chip =
  'flex min-h-11 items-center justify-center rounded-control border border-line-field bg-card px-3 text-center text-[0.8125rem] font-medium text-ink-2 transition-colors duration-150 peer-checked:border-signal peer-checked:bg-signal peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-signal';
---

<checkout-form
  data-errors={JSON.stringify(shop.cart.errors)}
  data-submitting={shop.cart.submitting}
>
  <form novalidate class="ym-hide-content ym-disable-keys flex flex-col gap-4">
    <div class="hidden" aria-hidden="true">
      <label>
        {CART_METADATA.honeypot}
        <input
          type="text"
          name={CART_METADATA.honeypot}
          tabindex="-1"
          autocomplete="off"
        />
      </label>
    </div>
    <div>
      <label class="block">
        <span class="field-label">{site.form.nameLabel}</span>
        <input
          name="name"
          type="text"
          autocomplete="name"
          required
          maxlength={200}
          placeholder={site.form.namePlaceholder}
          aria-describedby="checkout-name-hint checkout-name-error"
          class="field"
        />
      </label>
      <span id="checkout-name-hint" class="mt-1 block text-xs text-muted">
        {shop.cart.nameRequired}
      </span>
      <p
        id="checkout-name-error"
        data-error="name"
        class={errorText}
        aria-live="polite"
        hidden
      >
        {shop.cart.errorName}
      </p>
    </div>
    <div>
      <label class="block">
        <span class="field-label">{shop.cart.emailLabel}</span>
        <input
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          required
          placeholder={shop.cart.emailPlaceholder}
          aria-describedby="checkout-email-error"
          class="field"
        />
      </label>
      <p
        id="checkout-email-error"
        data-error="email"
        class={errorText}
        aria-live="polite"
        hidden
      >
        {shop.cart.errorEmail}
      </p>
    </div>
    <div>
      <span class="field-label">{site.form.contactLabel}</span>
      <PhoneInput name="phone" errorId="checkout-phone-error" />
      <p
        id="checkout-phone-error"
        data-error="phone"
        class={errorText}
        aria-live="polite"
        hidden
      >
        {site.form.errorPhone}
      </p>
    </div>
    <fieldset class="m-0 border-0 p-0">
      <legend class="field-label p-0">{site.form.contactChannelLabel}</legend>
      <div
        class:list={[
          'grid gap-2',
          channels.length === 4 ? 'grid-cols-2 sm:grid-cols-4' : 'grid-cols-3',
        ]}
      >
        {
          channels.map((channel, index) => (
            <label class="block">
              <input
                type="radio"
                name="contact_channel"
                value={channel.value}
                checked={index === 0}
                class="peer sr-only"
              />
              <span class={chip}>{channel.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <label class="block">
      <span class="field-label">{shop.cart.commentLabel}</span>
      <textarea
        name="comment"
        rows={2}
        maxlength={2000}
        class="field resize-none"></textarea>
    </label>
    <label class="flex min-h-11 items-start gap-3 py-1.5">
      <input
        type="checkbox"
        required
        data-consent
        class="mt-1 size-4 shrink-0 accent-signal"
      />
      <span class="text-xs leading-relaxed text-muted">
        {site.form.privacyNote}{' '}
        <a
          href={PathBuilder.privacy(locale)}
          target="_blank"
          class="underline underline-offset-2"
        >
          {site.form.privacyLinkText}
        </a>.
      </span>
    </label>
    <p data-error="consent" class={errorText} aria-live="polite" hidden>
      {site.form.errorConsent}
    </p>
    <p
      data-form-error
      class="text-sm text-signal-dark"
      aria-live="polite"
      hidden
    >
    </p>
    <button type="submit" class="btn btn-primary w-full">
      <span data-submit-label>{shop.cart.submit}</span>
      <Icon name="arrowRight" />
    </button>
  </form>
</checkout-form>

<script>
  import { defineCheckoutForm } from '@/scripts/shop/checkoutForm';

  defineCheckoutForm();
</script>
