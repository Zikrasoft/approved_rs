---
import Icon from './Icon.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { PathBuilder } from '@/utils/paths';
import { content } from '@/i18n/content';

const locale = localeFrom(Astro.url.pathname);
const shop = content(locale).shop;
---

<a
  href={PathBuilder.cart(locale)}
  class="relative flex h-10 items-center gap-2 rounded-control border border-line-strong px-3 text-sm font-medium text-ink transition-colors duration-150 hover:border-ink"
  aria-label={shop.cart.heading}
>
  <Icon name="cart" />
  <cart-count
    data-locale={locale}
    data-label={shop.cart.badgeLabel}
    class="spec text-xs tabular-nums"
    aria-live="polite"
    hidden>0</cart-count
  >
</a>

<script>
  import { defineCartCount } from '@/scripts/shop/cartCount';

  defineCartCount();
</script>
