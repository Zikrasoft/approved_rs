---
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import type { Thumbnail } from '@/utils/partImages';
import Icon from './Icon.astro';
import PartImage from './PartImage.astro';

interface Props {
  thumb: Thumbnail | null;
  class?: string;
}

const { thumb, class: className } = Astro.props;
const box =
  'flex size-14 shrink-0 items-center justify-center overflow-hidden rounded-control bg-shade sm:size-16';
const label = content(localeFrom(Astro.url.pathname)).shopPart
  .illustrationLabel;
---

{
  thumb ? (
    <PartImage
      frame={['relative', box, className].filter(Boolean).join(' ')}
      icon={22}
      src={thumb.src}
      alt=""
      width="64"
      height="64"
      loading="lazy"
      decoding="async"
      class={thumb.illustration ? 'opacity-80' : undefined}
    >
      {thumb.illustration && <span class="sr-only">{label}</span>}
    </PartImage>
  ) : (
    <span class:list={[box, className]}>
      <Icon name="part" size={22} class="text-line-field" />
    </span>
  )
}
