---
import Icon from './Icon.astro';

interface Props {
  src: string | null;
  class?: string;
}

const { src, class: className } = Astro.props;
const box =
  'flex size-14 shrink-0 items-center justify-center overflow-hidden rounded-field bg-shade sm:size-16';
---

{
  src ? (
    <part-image class:list={['group/image', box, className]}>
      <img
        src={src}
        alt=""
        width="64"
        height="64"
        loading="lazy"
        decoding="async"
        class="size-full object-contain mix-blend-multiply group-data-broken/image:hidden"
      />
      <Icon
        name="part"
        size={22}
        class="hidden text-line-field group-data-broken/image:block"
      />
    </part-image>
  ) : (
    <span class:list={[box, className]}>
      <Icon name="part" size={22} class="text-line-field" />
    </span>
  )
}

<script>
  import { definePartImage } from '@/scripts/partImage';

  definePartImage();
</script>
