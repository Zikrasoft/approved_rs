---
import Icon from './Icon.astro';

interface Props {
  src: string | null;
  class?: string;
}

const { src, class: className } = Astro.props;
---

<span
  class:list={[
    'flex size-14 shrink-0 items-center justify-center overflow-hidden rounded-field bg-shade sm:size-16',
    className,
  ]}
>
  {
    src ? (
      <img
        src={src}
        alt=""
        width="64"
        height="64"
        loading="lazy"
        decoding="async"
        class="size-full object-contain mix-blend-multiply"
      />
    ) : (
      <Icon name="part" size={22} class="text-line-field" />
    )
  }
</span>
