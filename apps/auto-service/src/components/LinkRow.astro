---
interface Props {
  href: string;
  label: string;
  detail?: string;
}

const { href, label, detail } = Astro.props;
---

<li>
  <a
    href={href}
    class="flex flex-col gap-1 px-5 py-4 transition-colors duration-150 hover:text-signal-ink sm:px-6"
  >
    <span class="font-semibold">{label}</span>
    {detail && <span class="text-sm text-muted">{detail}</span>}
  </a>
</li>
