---
import Icon from './Icon.astro';
import ContactControl from './ContactControl.astro';
import { localeFrom } from '@/i18n/currentLocale';
import type { ServiceSlug } from '@/utils/services';
import type { ContactPlacement } from '@podbor/site-kit';
import { contactRegion } from '@podbor/site-kit/contact-control';
import type { TrackedContactChannel } from '@podbor/lead-crm/contact-channel';
import { content } from '@/i18n/content';

interface Props {
  class?: string;
  placement?: Extract<ContactPlacement, 'bar' | 'thanks' | 'hero'>;
  tone?: 'card' | 'panel';
  service?: ServiceSlug;
}

const {
  class: className = '',
  placement = 'bar',
  tone = 'card',
  service,
} = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;

type Variant = {
  channels: readonly TrackedContactChannel[];
  list: string;
  tile: string;
  iconSize: number;
  label: string;
};
const FULL: Variant = {
  channels: ['phone', 'whatsapp', 'viber', 'telegram'],
  list: 'grid gap-2 sm:grid-cols-2',
  tile: 'min-h-11 gap-3 px-4 py-3',
  iconSize: 18,
  label: 'text-sm',
};
const VARIANT: Record<NonNullable<Props['placement']>, Variant> = {
  bar: FULL,
  thanks: FULL,
  hero: {
    channels: ['phone', 'whatsapp', 'telegram'],
    list: 'grid grid-cols-3 gap-2 pointer-fine:grid-cols-2 sm:flex sm:flex-wrap',
    tile: 'min-h-11 justify-center gap-1.5 px-1.5 py-2.5 sm:gap-2 sm:px-5',
    iconSize: 16,
    label: 'text-xs sm:text-[0.8125rem]',
  },
};
const TONE = {
  card: {
    surface: 'border-line bg-card text-ink hover:border-ink',
    icon: 'text-muted',
  },
  panel: {
    surface:
      'border-panel-line text-white hover:border-panel-line-strong hover:bg-panel-2',
    icon: 'text-panel-ink',
  },
};
const CHANNEL = {
  phone: { icon: 'phone', label: site.channels.call },
  whatsapp: { icon: 'whatsapp', label: site.channels.whatsapp },
  viber: { icon: 'viber', label: site.channels.viber },
  telegram: { icon: 'telegram', label: site.channels.telegram },
} as const;

const variant = VARIANT[placement];
const { surface, icon: iconTone } = TONE[tone];
---

<ul
  class={`${variant.list} ${className}`}
  data-contact-order
  {...contactRegion(placement)}
>
  {
    variant.channels.map((channel) => (
      <ContactControl
        channel={channel}
        region="contacts"
        service={service}
        listItem
        class={`group flex items-center rounded-control border transition-colors duration-150 ${variant.tile} ${surface}`}
        plainClass="flex min-h-11 items-center gap-3 rounded-control border border-line bg-card px-4 py-3"
      >
        <Icon
          name={CHANNEL[channel].icon}
          size={variant.iconSize}
          class={`shrink-0 transition-colors duration-150 group-hover:text-signal group-focus-visible:text-signal ${iconTone}`}
        />
        <span class:list={['spec whitespace-nowrap', variant.label]}>
          {CHANNEL[channel].label}
        </span>
        <Icon slot="plain" name="phone" size={18} class="shrink-0 text-muted" />
      </ContactControl>
    ))
  }
</ul>
