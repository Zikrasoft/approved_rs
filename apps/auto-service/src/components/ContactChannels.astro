---
import Icon from './Icon.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { contactChannels } from '@/utils/contactLinks';
import type { ServiceSlug } from '@/utils/services';
import { contactPlacement, type ContactPlacement } from '@podbor/site-kit';
import type { TrackedContactChannel } from '@podbor/lead-crm/contact-channel';
import { formatPhone } from '@podbor/site-kit/format-phone';
import { PHONE_NUMBER } from '@/utils/constants';
import { content } from '@/i18n/content';

interface Props {
  class?: string;
  placement?: Extract<ContactPlacement, 'bar' | 'thanks' | 'hero'>;
  tone?: 'card' | 'panel';
  service?: ServiceSlug;
}

const {
  class: className = '',
  placement = 'bar',
  tone = 'card',
  service,
} = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;

type Variant = {
  channels: readonly TrackedContactChannel[];
  list: string;
  tile: string;
  iconSize: number;
  label: string;
};
const FULL: Variant = {
  channels: ['phone', 'whatsapp', 'viber', 'telegram'],
  list: 'grid gap-2 sm:grid-cols-2',
  tile: 'min-h-11 gap-3 px-4 py-3',
  iconSize: 18,
  label: 'text-sm',
};
const VARIANT: Record<NonNullable<Props['placement']>, Variant> = {
  bar: FULL,
  thanks: FULL,
  hero: {
    channels: ['phone', 'whatsapp', 'telegram'],
    list: 'grid grid-cols-3 gap-2 pointer-fine:grid-cols-2 sm:flex sm:flex-wrap',
    tile: 'min-h-11 justify-center gap-1.5 px-1.5 py-2.5 sm:gap-2 sm:px-5',
    iconSize: 16,
    label: 'text-xs sm:text-[0.8125rem]',
  },
};
const TONE = {
  card: {
    surface: 'border-line bg-card text-ink hover:border-ink',
    icon: 'text-muted',
  },
  panel: {
    surface:
      'border-panel-line text-white hover:border-panel-line-strong hover:bg-panel-2',
    icon: 'text-panel-ink',
  },
};

const variant = VARIANT[placement];
const { surface, icon: iconTone } = TONE[tone];
const channels = contactChannels(site, locale, service).filter((channel) =>
  variant.channels.includes(channel.track),
);
---

<ul
  class={`${variant.list} ${className}`}
  data-contact-cta
  data-contact-order
  {...contactPlacement(placement)}
>
  {
    channels.map((channel) => (
      <li
        data-channel={channel.track}
        class:list={[
          channel.track === 'phone' &&
            placement !== 'thanks' &&
            'pointer-fine:hidden!',
        ]}
      >
        <a
          href={channel.href}
          data-contact-channel={channel.track}
          rel="noopener"
          class:list={[
            'group flex items-center rounded-control border transition-colors duration-150',
            variant.tile,
            surface,
            channel.track === 'phone' && 'pointer-fine:hidden!',
          ]}
        >
          <Icon
            name={channel.icon}
            size={variant.iconSize}
            class={`shrink-0 transition-colors duration-150 group-hover:text-signal group-focus-visible:text-signal ${iconTone}`}
          />
          <span class:list={['spec whitespace-nowrap', variant.label]}>
            {channel.label}
          </span>
        </a>
        {channel.track === 'phone' && placement === 'thanks' && (
          <span class="flex min-h-11 items-center gap-3 rounded-control border border-line bg-card px-4 py-3 pointer-coarse:hidden!">
            <Icon name="phone" size={18} class="shrink-0 text-muted" />
            <span class="spec whitespace-nowrap text-sm text-ink">
              {formatPhone(PHONE_NUMBER)}
            </span>
          </span>
        )}
      </li>
    ))
  }
</ul>
