---
import LeadForm from './LeadForm.astro';
import ContactChannels from './ContactChannels.astro';
import SocialLinks from './SocialLinks.astro';
import { contactCta } from '@podbor/site-kit/contact-control';
import type { ServiceSlug } from '@/utils/services';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';

interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  service?: ServiceSlug;
  commentPlaceholder?: string;
}
const { eyebrow, heading, body, service, commentPlaceholder } = Astro.props;
const site = content(localeFrom(Astro.url.pathname)).site;
---

<section id="lead" class="wrap scroll-mt-24 mt-band" {...contactCta}>
  <div class="card grid gap-8 p-6 lg:grid-cols-[1fr_1.1fr] lg:gap-12 lg:p-10">
    <div class="flex flex-col gap-4">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="text-section">{heading}</h2>
      <p class="max-w-md text-base leading-relaxed text-muted">{body}</p>
      <div class="mt-1 flex flex-wrap items-center gap-x-4">
        <span class="text-sm text-muted">{site.common.writeInstead}</span>
        <ContactChannels look="links" service={service} />
      </div>
      <SocialLinks class="mt-2" />
    </div>
    <slot name="form">
      <LeadForm service={service} commentPlaceholder={commentPlaceholder} />
    </slot>
  </div>
</section>
