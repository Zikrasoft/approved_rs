---
import { localeFrom } from '@/i18n/currentLocale';
import { BCP47_BY_LOCALE } from '@/i18n/config';
import { getSiteContent } from '@/i18n/content/site';
import { getServicesContent } from '@/i18n/content/services';
import Icon from './Icon.astro';
import { PathBuilder } from '@/utils/paths';
import {
  SERVICE_SLUGS,
  SHOP_SERVICE,
  type ServiceSlug,
} from '@/utils/services';
import { phoneCountryOptions } from '@podbor/lead-crm/phone';
import { HONEYPOT_FIELD } from '@podbor/lead-crm';
import { TELEGRAM_ENABLED } from '@/utils/constants';

interface Props {
  service?: ServiceSlug | typeof SHOP_SERVICE;
  fixedService?: boolean;
  compact?: boolean;
  comment?: string;
  class?: string;
}

const {
  service,
  fixedService = false,
  compact = false,
  comment = '',
  class: className = '',
} = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = getSiteContent(locale);
const services = getServicesContent(locale);

const DEFAULT_COUNTRY = 'RS';
const uid = crypto.randomUUID().slice(0, 8);

const countryOptions = phoneCountryOptions(BCP47_BY_LOCALE[locale]);

const channels = (
  [
    {
      value: 'phone',
      icon: 'phone',
      label: site.form.channelPhone,
      panel: 'ph',
    },
    { value: 'whatsapp', icon: 'whatsapp', label: 'WhatsApp', panel: 'ph' },
    { value: 'viber', icon: 'viber', label: 'Viber', panel: 'ph' },
    { value: 'telegram', icon: 'telegram', label: 'Telegram', panel: 'tg' },
  ] as const
).filter((channel) => TELEGRAM_ENABLED || channel.value !== 'telegram');

const chip =
  'flex min-h-11 items-center justify-center gap-2 rounded-control border border-line-field bg-card px-3 text-center text-[0.8125rem] font-medium leading-tight text-ink-2 transition-colors duration-150 peer-hover:border-ink peer-checked:border-signal peer-checked:bg-signal peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-signal';
const errorText = 'mt-1.5 text-xs leading-relaxed text-signal-dark';
---

<form
  method="POST"
  action="/api/leads"
  data-lead-form
  data-submitting-label={site.form.submitting}
  class={`ym-hide-content ym-disable-keys flex flex-col gap-4 ${className}`}
>
  <input type="hidden" name="locale" value={locale} />
  <div class="hidden" aria-hidden="true">
    <label>
      {HONEYPOT_FIELD}
      <input
        type="text"
        name={HONEYPOT_FIELD}
        tabindex="-1"
        autocomplete="off"
      />
    </label>
  </div>

  <input type="hidden" name="source_url" data-source-url />
  <input type="hidden" name="visitor_id" data-visitor-id />

  <div class={compact ? 'flex flex-col gap-4' : 'grid gap-4 sm:grid-cols-2'}>
    <div>
      <label class="block">
        <span class="field-label">{site.form.nameLabel}</span>
        <input
          name="name"
          type="text"
          required
          autocomplete="name"
          placeholder={site.form.namePlaceholder}
          aria-describedby={`name-error-${uid}`}
          class="field"
          data-name
        />
      </label>
      <p
        id={`name-error-${uid}`}
        class={errorText}
        aria-live="polite"
        data-error-name
        hidden
      >
        {site.form.requiredError}
      </p>
    </div>
    <label class="block">
      <span class="field-label">{site.form.carLabel}</span>
      <input
        name="car"
        type="text"
        placeholder={site.form.carPlaceholder}
        class="field"
      />
    </label>
  </div>

  <fieldset class="group m-0 border-0 p-0">
    <legend class="field-label p-0">{site.form.contactChannelLabel}</legend>

    <div
      data-contact-order
      class:list={[
        'grid gap-2',
        channels.length === 4
          ? 'grid-cols-2 sm:grid-cols-4'
          : 'grid-cols-3 sm:grid-cols-3',
      ]}
    >
      {
        channels.map((channel, index) => (
          <label class="block" data-channel={channel.value}>
            <input
              type="radio"
              name="contact_channel"
              value={channel.value}
              checked={index === 0}
              class={`peer sr-only ch-${channel.panel}`}
            />
            <span class={chip}>
              <Icon name={channel.icon} size={14} />
              {channel.label}
            </span>
          </label>
        ))
      }
    </div>

    <div class="mt-3 hidden group-has-[.ch-tg:checked]:block">
      <label class="block">
        <span class="sr-only">Telegram</span>
        <input
          type="text"
          autocomplete="username"
          placeholder="@username"
          aria-describedby={`telegram-error-${uid}`}
          class="field"
          data-telegram
        />
      </label>
      <p
        id={`telegram-error-${uid}`}
        class={errorText}
        aria-live="polite"
        data-error-telegram
        hidden
      >
        {site.form.errorTelegram}
      </p>
    </div>

    <div class="mt-3 hidden group-has-[.ch-ph:checked]:block">
      <div class="flex gap-2">
        <div class="relative min-w-0 max-w-[min(14rem,45%)] shrink-0">
          <select
            aria-label={site.form.countryLabel}
            class="field spec max-w-full appearance-none overflow-hidden text-ellipsis pr-8"
            data-country
          >
            {
              countryOptions.map((country) => (
                <option
                  value={country.iso}
                  data-dial={country.dial}
                  data-dial-primary={country.primary ? '' : undefined}
                  selected={country.iso === DEFAULT_COUNTRY}
                >
                  {country.flag} +{country.dial} {country.name}
                </option>
              ))
            }
          </select>
          <Icon
            name="chevronDown"
            size={12}
            class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-muted"
          />
        </div>
        <label class="min-w-0 flex-1">
          <span class="sr-only">{site.form.contactLabel}</span>
          <input
            name="contact"
            type="tel"
            inputmode="tel"
            required
            autocomplete="tel-national"
            placeholder={site.form.contactPlaceholder}
            aria-describedby={`phone-error-${uid}`}
            class="field"
            data-phone
          />
        </label>
      </div>
      <p
        id={`phone-error-${uid}`}
        class={errorText}
        aria-live="polite"
        data-error-phone
        hidden
      >
        {site.form.errorPhone}
      </p>
    </div>
  </fieldset>

  {fixedService && <input type="hidden" name="service" value={service} />}

  {
    !fixedService && (
      <details class="group/svc" open={!compact}>
        <summary class="field flex cursor-pointer list-none items-center justify-between gap-2 [&::-webkit-details-marker]:hidden">
          {site.form.serviceLabel}
          <Icon
            name="chevronDown"
            size={14}
            class="shrink-0 text-muted transition-transform duration-150 group-open/svc:rotate-180"
          />
        </summary>
        <div
          class="mt-2 flex flex-wrap gap-2"
          role="group"
          aria-label={site.form.serviceLabel}
        >
          {SERVICE_SLUGS.map((slug) => (
            <label class="block">
              <input
                type="checkbox"
                name="service"
                value={slug}
                checked={slug === service}
                class="peer sr-only"
              />
              <span class={chip}>{services[slug].name}</span>
            </label>
          ))}
        </div>
        <p class="mt-2 text-xs text-muted">{site.form.servicePlaceholder}</p>
      </details>
    )
  }

  <label class="block">
    <span class="field-label">{site.form.commentLabel}</span>
    <textarea
      name="comment"
      rows={compact ? 2 : 3}
      placeholder={site.form.commentPlaceholder}
      class="field resize-none">{comment}</textarea
    >
  </label>

  <div class="lead-submit">
    <div>
      <label class="flex min-h-11 items-start gap-3 py-1.5">
        <input
          type="checkbox"
          name="consent"
          value="1"
          required
          aria-describedby={`consent-error-${uid}`}
          class="peer sr-only"
          data-consent
        />
        <span
          class="mt-px flex h-5 w-5 shrink-0 items-center justify-center rounded-[3px] border border-line-field bg-card text-white transition-colors duration-150 peer-checked:border-signal peer-checked:bg-signal peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-signal [&>svg]:opacity-0 peer-checked:[&>svg]:opacity-100"
        >
          <Icon name="check" size={10} />
        </span>
        <span class="text-xs leading-relaxed text-muted">
          {site.form.privacyNote}{' '}
          <a
            href={PathBuilder.privacy(locale)}
            target="_blank"
            class="underline underline-offset-2 transition-colors duration-150 hover:text-signal-ink"
            >{site.form.privacyLinkText}</a
          >.
        </span>
      </label>
      <p
        id={`consent-error-${uid}`}
        class={errorText}
        aria-live="polite"
        data-error-consent
        hidden
      >
        {site.form.errorConsent}
      </p>
    </div>

    <button type="submit" class="btn btn-primary w-full sm:w-auto">
      <span data-submit-label>{site.form.submit}</span>
      <Icon name="arrowRight" />
    </button>
  </div>
</form>

<script>
  import { getOrCreateVisitorId } from '@podbor/site-kit/browser';
  import { composeE164 } from '@podbor/lead-crm/compose-e164';
  import { bindPhoneCountry } from '@podbor/lead-crm/phone-input';
  import {
    deferSubmitUntilKit,
    loadPhoneKit,
    phoneKit,
  } from '@podbor/lead-crm/phone-kit';
  import type { CountryCode } from 'libphonenumber-js/min';
  import type { TrackedContactChannel } from '@podbor/lead-crm/contact-channel';

  document
    .querySelectorAll<HTMLFormElement>('[data-lead-form]')
    .forEach(initLeadForm);

  function setInvalid(
    error: HTMLElement,
    field: HTMLElement,
    invalid: boolean,
  ) {
    error.hidden = !invalid;
    if (invalid) field.setAttribute('aria-invalid', 'true');
    else field.removeAttribute('aria-invalid');
  }

  function initLeadForm(form: HTMLFormElement) {
    const pick = <T extends HTMLElement>(selector: string) =>
      form.querySelector<T>(selector)!;

    form.noValidate = true;
    pick<HTMLInputElement>('[data-source-url]').value = location.href;
    const visitor = pick<HTMLInputElement>('[data-visitor-id]');

    const name = pick<HTMLInputElement>('[data-name]');
    const telegram = pick<HTMLInputElement>('[data-telegram]');
    const country = pick<HTMLSelectElement>('[data-country]');
    const phone = pick<HTMLInputElement>('[data-phone]');
    const consent = pick<HTMLInputElement>('[data-consent]');

    bindPhoneCountry(country, phone);

    const fields: Record<string, [HTMLElement, HTMLElement]> = {
      name: [pick('[data-error-name]'), name],
      telegram: [pick('[data-error-telegram]'), telegram],
      phone: [pick('[data-error-phone]'), phone],
      consent: [pick('[data-error-consent]'), consent],
    };

    form.addEventListener('focusin', loadPhoneKit, { once: true });
    form.addEventListener('input', () => {
      Object.values(fields).forEach(([error, field]) =>
        setInvalid(error, field, false),
      );
    });

    form.addEventListener('submit', (event) => {
      if (deferSubmitUntilKit(form)) {
        event.preventDefault();
        return;
      }
      const kit = phoneKit();
      visitor.value = getOrCreateVisitorId();

      const channel = pick<HTMLInputElement>('[name="contact_channel"]:checked')
        .value as TrackedContactChannel;
      const viaTelegram = channel === 'telegram';
      const input = viaTelegram ? telegram : phone;
      const typed = input.value.trim();
      const dial = country.selectedOptions[0]?.dataset.dial ?? '';
      const value = viaTelegram
        ? typed.replace(/^@?/, '@')
        : (kit?.parse(typed, country.value as CountryCode)?.number ??
          composeE164(typed, dial));

      const checks: [HTMLElement, HTMLElement, boolean][] = [
        [...fields.name, name.value.trim().length === 0],
        [
          ...(viaTelegram ? fields.telegram : fields.phone),
          typed.length === 0 || (!!kit && !kit.isValidContact(value, channel)),
        ],
        [...fields.consent, !consent.checked],
      ];
      checks.forEach(([error, field, invalid]) =>
        setInvalid(error, field, invalid),
      );

      const firstInvalid = checks.find(([, , invalid]) => invalid);
      if (firstInvalid) {
        event.preventDefault();
        firstInvalid[1].focus();
        return;
      }

      phone.value = value;

      const button = pick<HTMLButtonElement>('button[type="submit"]');
      button.disabled = true;
      if (form.dataset.submittingLabel) {
        pick('[data-submit-label]').textContent = form.dataset.submittingLabel;
      }
    });
  }
</script>
