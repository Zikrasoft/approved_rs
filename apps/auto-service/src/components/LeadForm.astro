---
import { localeFrom } from '@/i18n/currentLocale';
import Icon from './Icon.astro';
import PhoneInput from './PhoneInput.astro';
import { PathBuilder } from '@/utils/paths';
import { SHOP_SERVICE, type ServiceSlug } from '@/utils/services';
import { HONEYPOT_FIELD, SERVICE_FIELD } from '@podbor/lead-crm';
import { content } from '@/i18n/content';

interface Props {
  service?: ServiceSlug | typeof SHOP_SERVICE;
  compact?: boolean;
  comment?: string;
  class?: string;
}

const {
  service,
  compact = false,
  comment = '',
  class: className = '',
} = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;

const uid = crypto.randomUUID().slice(0, 8);

const channels = [
  {
    value: 'phone',
    icon: 'phone',
    label: site.form.channelPhone,
    panel: 'phone',
  },
  { value: 'whatsapp', icon: 'whatsapp', label: 'WhatsApp', panel: 'phone' },
  { value: 'viber', icon: 'viber', label: 'Viber', panel: 'phone' },
  { value: 'telegram', icon: 'telegram', label: 'Telegram', panel: 'telegram' },
] as const;

const channelLabelId = `channel-${uid}`;
const panelId = {
  telegram: `panel-telegram-${uid}`,
  phone: `panel-phone-${uid}`,
};

const chip =
  'flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-control border border-line-field bg-card px-3 text-center text-[0.8125rem] font-medium leading-tight text-ink-2 transition-colors duration-150 hover:border-ink aria-selected:border-signal-ink aria-selected:bg-signal-ink aria-selected:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal';
const errorText = 'mt-1.5 text-xs leading-relaxed text-signal-dark';
---

<lead-form class="contents">
  <form
    method="POST"
    action="/api/leads"
    data-lead-form
    data-submitting-label={site.form.submitting}
    class={`ym-hide-content ym-disable-keys flex flex-col gap-4 ${className}`}
  >
    <input type="hidden" name="locale" value={locale} />
    <div class="hidden" aria-hidden="true">
      <label>
        {HONEYPOT_FIELD}
        <input
          type="text"
          name={HONEYPOT_FIELD}
          tabindex="-1"
          autocomplete="off"
        />
      </label>
    </div>

    <input type="hidden" name="source_url" data-source-url />
    <input type="hidden" name="visitor_id" data-visitor-id />

    <input type="hidden" name="contact" />
    <input type="hidden" name="contact_channel" value={channels[0].value} />

    <div>
      <p id={channelLabelId} class="field-label">
        {site.form.contactChannelLabel}
      </p>

      <div
        class="grid grid-cols-2 gap-2 sm:grid-cols-4"
        role="tablist"
        aria-labelledby={channelLabelId}
      >
        {
          channels.map((channel, index) => (
            <button
              type="button"
              role="tab"
              class={chip}
              data-tab={channel.value}
              data-panel={channel.panel}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={panelId[channel.panel]}
            >
              <Icon name={channel.icon} size={14} />
              {channel.label}
            </button>
          ))
        }
      </div>

      <div
        id={panelId.telegram}
        class="mt-3"
        role="tabpanel"
        data-panel="telegram"
        hidden
      >
        <label class="block">
          <span class="sr-only">Telegram</span>
          <input
            type="text"
            autocomplete="username"
            placeholder={site.form.telegramPlaceholder}
            aria-describedby={`telegram-error-${uid}`}
            class="field"
            data-telegram
            data-field="telegram"
          />
        </label>
        <p
          id={`telegram-error-${uid}`}
          class={errorText}
          aria-live="polite"
          data-error-telegram
          hidden
        >
          {site.form.errorTelegram}
        </p>
      </div>

      <div id={panelId.phone} class="mt-3" role="tabpanel" data-panel="phone">
        <PhoneInput name="phone_number" errorId={`phone-error-${uid}`} />
        <p
          id={`phone-error-${uid}`}
          class={errorText}
          aria-live="polite"
          data-error-phone
          hidden
        >
          {site.form.errorPhone}
        </p>
      </div>
    </div>

    <label class="block">
      <span class="field-label">{site.form.nameLabel}</span>
      <input
        name="name"
        type="text"
        autocomplete="name"
        placeholder={site.form.namePlaceholder}
        class="field"
      />
    </label>

    {service && <input type="hidden" name={SERVICE_FIELD} value={service} />}

    <label class="block">
      <span class="field-label">{site.form.commentLabel}</span>
      <textarea
        name="comment"
        rows={compact ? 2 : 3}
        placeholder={site.form.commentPlaceholder}
        class="field resize-none">{comment}</textarea
      >
    </label>

    <div class="lead-submit">
      <div>
        <label class="flex min-h-11 items-start gap-3 py-1.5">
          <input
            type="checkbox"
            name="consent"
            value="1"
            required
            aria-describedby={`consent-error-${uid}`}
            class="peer sr-only"
            data-consent
            data-field="consent"
          />
          <span
            class="mt-px flex h-5 w-5 shrink-0 items-center justify-center rounded-[3px] border border-line-field bg-card text-white transition-colors duration-150 peer-checked:border-signal peer-checked:bg-signal peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-signal [&>svg]:opacity-0 peer-checked:[&>svg]:opacity-100"
          >
            <Icon name="check" size={10} />
          </span>
          <span class="text-xs leading-relaxed text-muted">
            {site.form.privacyNote}{' '}
            <a
              href={PathBuilder.privacy(locale)}
              target="_blank"
              class="underline underline-offset-2 transition-colors duration-150 hover:text-signal-ink"
              >{site.form.privacyLinkText}</a
            >.
          </span>
        </label>
        <p
          id={`consent-error-${uid}`}
          class={errorText}
          aria-live="polite"
          data-error-consent
          hidden
        >
          {site.form.errorConsent}
        </p>
        <p class={errorText} role="alert" data-error-submit hidden>
          {site.form.errorSubmit}
        </p>
      </div>

      <button
        type="submit"
        class="btn btn-primary w-full aria-busy:cursor-progress aria-busy:opacity-60 sm:w-auto"
      >
        <span data-submit-label>{site.form.submit}</span>
        <Icon name="arrowRight" />
      </button>
    </div>
  </form>
</lead-form>
