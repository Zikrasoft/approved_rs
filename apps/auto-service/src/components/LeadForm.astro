---
import { METRIKA_MASK_CLASS } from '@podbor/site-kit/browser';
import { localeFrom } from '@/i18n/config';
import LeadFormHidden from './LeadFormHidden.astro';
import ContactChannelField from './ContactChannelField.astro';
import ConsentField from './ConsentField.astro';
import VinField from './VinField.astro';
import type { ServiceSlug } from '@/utils/services';
import { SERVICE_FIELD } from '@podbor/lead-crm';
import { content } from '@/i18n/content';

interface Props {
  service?: ServiceSlug;
  compact?: boolean;
  comment?: string;
  commentLabel?: string;
  commentPlaceholder?: string;
  commentNote?: string;
  vin?: { label: string; placeholder: string; note?: string; value?: string };
  defaultChannel?: 'phone' | 'whatsapp' | 'viber' | 'telegram';
  action?: string;
  submitLabel?: string;
  class?: string;
}

const {
  service,
  compact = false,
  comment = '',
  commentLabel,
  commentPlaceholder,
  commentNote,
  vin,
  defaultChannel = 'phone',
  action = '/api/leads',
  submitLabel,
  class: className = '',
} = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;

const uid = crypto.randomUUID().slice(0, 8);
---

<lead-form class="contents">
  <form
    method="POST"
    action={action}
    data-lead-form
    data-submitting-label={site.form.submitting}
    class={`${METRIKA_MASK_CLASS} flex flex-col gap-4 ${className}`}
  >
    <LeadFormHidden />

    <ContactChannelField uid={uid} defaultChannel={defaultChannel} />

    {vin && <VinField {...vin} />}

    <label class="block">
      <span class="field-label">{site.form.nameLabel}</span>
      <input
        name="name"
        type="text"
        autocomplete="name"
        placeholder={site.form.namePlaceholder}
        class="field"
      />
    </label>

    {service && <input type="hidden" name={SERVICE_FIELD} value={service} />}

    <label class="block">
      <span class="field-label">{commentLabel ?? site.form.commentLabel}</span>
      <textarea
        name="comment"
        rows={compact ? 2 : 3}
        placeholder={commentPlaceholder ?? site.form.commentPlaceholder}
        class="field resize-none">{comment}</textarea
      >
      {commentNote && <p class="mt-1.5 text-xs text-muted">{commentNote}</p>}
    </label>

    <div class="lead-submit">
      <ConsentField uid={uid} />

      <button
        type="submit"
        class="btn btn-primary w-full disabled:cursor-not-allowed disabled:bg-line-strong disabled:text-ink-2 aria-busy:cursor-progress aria-busy:opacity-60 sm:w-auto"
      >
        <span data-submit-label>{submitLabel ?? site.form.submit}</span>
      </button>
    </div>
  </form>
</lead-form>
