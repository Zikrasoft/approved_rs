---
import type { Thumbnail } from '@/utils/partImages';
import PartThumb from './PartThumb.astro';

interface Props {
  thumb: Thumbnail | null;
  class?: string;
}

const { thumb, class: className } = Astro.props;
---

<div class="flex items-start gap-3 sm:gap-4">
  <PartThumb thumb={thumb} />
  <div class:list={['flex min-w-0 flex-1 flex-col', className ?? 'gap-1.5']}>
    <slot />
  </div>
</div>
