---
import ContactControl from './ContactControl.astro';
import Icon from './Icon.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import PhoneNumber from './PhoneNumber.astro';

interface Props {
  class: string;
  callbackClass?: string;
  showNumber?: boolean;
}

const { class: className, callbackClass = className, showNumber } = Astro.props;
const site = content(localeFrom(Astro.url.pathname)).site;
---

<ContactControl
  channel="phone"
  class={className}
  {showNumber}
  plainClass="flex min-h-11 items-center gap-2 text-ink"
>
  <Icon name="phone" size={16} class="shrink-0" />
  {showNumber ? <PhoneNumber /> : site.channels.call}
  {showNumber && <Icon slot="plain" name="phone" size={16} class="shrink-0" />}
</ContactControl>
<slot />
<a
  href="#lead"
  data-open-lead-modal="phone"
  class:list={[callbackClass, 'pointer-coarse:hidden!']}
>
  {site.header.callback}
</a>
