---
import { formatPhone } from '@podbor/site-kit/format-phone';
import ContactControl from './ContactControl.astro';
import Icon from './Icon.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { PHONE_NUMBER } from '@/utils/constants';

interface Props {
  class: string;
  callbackClass?: string;
  number?: boolean;
}

const {
  class: className,
  callbackClass = className,
  number = true,
} = Astro.props;
const site = content(localeFrom(Astro.url.pathname)).site;
---

<ContactControl channel="phone" class={className}>
  <Icon name="phone" size={16} class="shrink-0" />
  {site.channels.call}
  {
    number && (
      <Fragment>
        {' '}
        <span class="spec whitespace-nowrap">{formatPhone(PHONE_NUMBER)}</span>
      </Fragment>
    )
  }
</ContactControl>
<slot />
<a
  href="#lead"
  data-open-lead-modal="phone"
  class:list={[callbackClass, 'pointer-coarse:hidden!']}
>
  {site.header.callback}
</a>
