---
import type { PartPageEntry } from '@/utils/catalogueSnapshot';
import { CONTACT_CTA_SELECTOR } from '@podbor/site-kit/contact-control';
import { BCP47_BY_LOCALE, localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { bestPrice } from '@/utils/bestPrice';
import { shopOpen } from '@/utils/catalogueEnv';
import { formatMoney } from '@/utils/money';

interface Props {
  page: PartPageEntry;
  target: string;
}

const { page, target } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const copy = content(locale).shopPart;
const best = shopOpen() ? bestPrice([page]) : null;
const price =
  best && formatMoney(best.price, best.currency, BCP47_BY_LOCALE[locale]);
---

<cta-reveal
  data-revealed="false"
  watch={CONTACT_CTA_SELECTOR}
  class="fixed inset-x-0 bottom-[var(--cookie-consent-height,0px)] z-40 border-t border-line bg-paper/95 backdrop-blur-sm transition-[translate,visibility] duration-250 data-[revealed=false]:invisible data-[revealed=false]:translate-y-full motion-reduce:transition-none lg:hidden"
>
  <div class="wrap flex min-h-14 items-center justify-between gap-4 py-1.5">
    <span class="flex min-w-0 flex-col">
      <span class="truncate text-xs text-muted">
        {page.brand.name}{' '}
        <span class="spec">{page.value}</span>
      </span>
      <span class="spec font-semibold text-ink">
        {
          price
            ? best.startsFrom
              ? copy.fromPrice.replace('{price}', price)
              : price
            : copy.priceOnRequestHeading
        }
      </span>
    </span>
    <part-cta-forward
      class="shrink-0"
      data-to={best
        ? `#${target} [data-buy][data-offer-id="${best.id}"]`
        : `#${target} parts-list-add a`}
    >
      <a href={`#${target}`} class="btn btn-primary">
        {price ? copy.buyButtonLabel : copy.priceOnRequestCta}
      </a>
    </part-cta-forward>
  </div>
</cta-reveal>

<script>
  import { defineCtaReveal } from '@podbor/site-kit/browser';

  defineCtaReveal();

  if (!customElements.get('part-cta-forward')) {
    customElements.define(
      'part-cta-forward',
      class extends HTMLElement {
        connectedCallback(): void {
          this.addEventListener('click', (event) => {
            const to = document.querySelector<HTMLElement>(
              this.dataset.to ?? '',
            );
            if (!to || to.hidden) return;
            event.preventDefault();
            to.scrollIntoView({ block: 'center' });
            to.click();
          });
        }
      },
    );
  }
</script>
