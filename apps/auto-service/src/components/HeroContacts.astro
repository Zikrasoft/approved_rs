---
import { contactRegion } from '@podbor/site-kit/contact-control';
import CallAction from './CallAction.astro';
import ContactChannels from './ContactChannels.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import type { ServiceSlug } from '@/utils/services';

interface Props {
  service?: ServiceSlug;
  bookLabel?: string;
  bookModal?: boolean;
}

const { home } = content(localeFrom(Astro.url.pathname));
const {
  service,
  bookLabel = home.hero.ctaPrimary,
  bookModal = true,
} = Astro.props;
const button = 'btn min-h-12 w-full lg:px-5';
---

<div
  class="flex flex-col gap-2 lg:grid lg:grid-cols-2"
  {...contactRegion('hero')}
>
  <CallAction
    class={`${button} btn-primary`}
    callbackClass={`${button} btn-on-panel`}
  >
    <a
      href="#lead"
      data-open-lead-modal={bookModal ? '' : undefined}
      class={`${button} btn-on-panel pointer-fine:border-signal-ink pointer-fine:bg-signal-ink pointer-fine:text-white pointer-fine:hover:border-signal-dark pointer-fine:hover:bg-signal-dark`}
    >
      {bookLabel}
    </a>
  </CallAction>
  <ContactChannels
    placement="hero"
    tone="panel"
    service={service}
    only={['whatsapp', 'viber', 'telegram']}
    class="lg:col-span-2 lg:grid!"
  />
</div>
