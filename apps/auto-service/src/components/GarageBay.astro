---
import { Image } from 'astro:assets';
import garageBay from '@/content/works/audi-q7/image.jpg';
---

<Image
  src={garageBay}
  alt=""
  widths={[480, 720, 1080, 1280]}
  sizes="(min-width: 1224px) 572px, (min-width: 1024px) calc(50vw - 20px), calc(100vw - 2.5rem)"
  loading="lazy"
  class="block aspect-[2/1] w-full object-cover lg:absolute lg:inset-0 lg:aspect-auto lg:h-full"
/>
