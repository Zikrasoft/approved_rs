---
import Icon from '@/components/Icon.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { getSiteContent } from '@/i18n/content/site';
import { CONTACT_LINKS } from '@/utils/contactLinks';

const locale = localeFrom(Astro.url.pathname);
const site = getSiteContent(locale);
---

<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-paper/95 backdrop-blur-sm lg:hidden"
>
  <div class="grid grid-cols-3 items-stretch">
    <a
      href={CONTACT_LINKS.phone}
      data-contact-channel="phone"
      class="flex min-h-14 flex-col items-center justify-center gap-1 border-r border-line text-ink"
    >
      <Icon name="phone" />
      <span class="spec text-[0.6875rem]">{site.channels.call}</span>
    </a>

    <a
      href={CONTACT_LINKS.viber}
      data-contact-channel="viber"
      class="flex min-h-14 flex-col items-center justify-center gap-1 border-r border-line text-ink"
    >
      <Icon name="chat" />
      <span class="spec text-[0.6875rem]">{site.channels.viber}</span>
    </a>

    <button
      type="button"
      data-open-lead-modal
      class="flex min-h-14 flex-col items-center justify-center gap-1 bg-signal text-paper"
    >
      <Icon name="calendar" />
      <span class="spec text-[0.6875rem]">{site.header.cta}</span>
    </button>
  </div>
</div>
