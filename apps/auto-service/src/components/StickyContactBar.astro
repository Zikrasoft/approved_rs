---
import Icon from '@/components/Icon.astro';
import { localeFrom } from '@/i18n/config';
import BottomBar from '@/components/BottomBar.astro';
import ContactControl from '@/components/ContactControl.astro';
import type { ServiceSlug } from '@/utils/services';
import { content } from '@/i18n/content';

interface Props {
  service?: ServiceSlug;
}

const { service } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;

const cell =
  'flex min-h-14 flex-col items-center justify-center gap-1 border-r border-line text-ink';
---

<BottomBar region="floating">
  <div class="grid grid-cols-3 items-stretch pointer-fine:grid-cols-2">
    <ContactControl channel="phone" class={cell}>
      <Icon name="phone" size={16} />
      <span class="spec text-xs">{site.channels.call}</span>
    </ContactControl>

    <div data-primary-contact class="contents">
      <ContactControl
        channel="telegram"
        service={service}
        data-primary-channel="telegram"
        class={cell}
      >
        <Icon name="telegram" size={16} />
        <span class="spec text-xs">{site.channels.telegram}</span>
      </ContactControl>
      <ContactControl
        channel="whatsapp"
        service={service}
        data-primary-channel="whatsapp"
        hidden
        class={cell}
      >
        <Icon name="whatsapp" size={16} />
        <span class="spec text-xs">{site.channels.whatsapp}</span>
      </ContactControl>
    </div>

    <a
      href="#lead"
      data-open-lead-modal
      class="flex min-h-14 flex-col items-center justify-center gap-1 bg-signal text-ink"
    >
      <Icon name="calendar" />
      <span class="spec text-xs">{site.header.cta}</span>
    </a>
  </div>
</BottomBar>
