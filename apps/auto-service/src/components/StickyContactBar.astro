---
import Icon from '@/components/Icon.astro';
import { localeFrom } from '@/i18n/config';
import ContactControl from '@/components/ContactControl.astro';
import type { ServiceSlug } from '@/utils/services';
import {
  contactRegion,
  CONTACT_CTA_SELECTOR,
} from '@podbor/site-kit/contact-control';
import { content } from '@/i18n/content';

interface Props {
  service?: ServiceSlug;
}

const { service } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;

const cell =
  'flex min-h-14 flex-col items-center justify-center gap-1 border-r border-line text-ink';
---

<cta-reveal
  data-revealed="false"
  class="sticky-contact fixed inset-x-0 bottom-0 z-40 border-t border-line bg-paper/95 backdrop-blur-sm lg:hidden"
  watch={CONTACT_CTA_SELECTOR}
  {...contactRegion('floating')}
>
  <div class="grid grid-cols-3 items-stretch pointer-fine:grid-cols-2">
    <ContactControl channel="phone" class={cell}>
      <Icon name="phone" size={16} />
      <span class="spec text-[0.6875rem]">{site.channels.call}</span>
    </ContactControl>

    <div data-primary-contact class="contents">
      <ContactControl
        channel="telegram"
        service={service}
        data-primary-channel="telegram"
        class={cell}
      >
        <Icon name="telegram" size={16} />
        <span class="spec text-[0.6875rem]">{site.channels.telegram}</span>
      </ContactControl>
      <ContactControl
        channel="whatsapp"
        service={service}
        data-primary-channel="whatsapp"
        hidden
        class={cell}
      >
        <Icon name="whatsapp" size={16} />
        <span class="spec text-[0.6875rem]">{site.channels.whatsapp}</span>
      </ContactControl>
    </div>

    <button
      type="button"
      data-open-lead-modal
      class="flex min-h-14 flex-col items-center justify-center gap-1 bg-signal text-paper"
    >
      <Icon name="calendar" />
      <span class="spec text-[0.6875rem]">{site.header.cta}</span>
    </button>
  </div>
</cta-reveal>

<style>
  .sticky-contact {
    transition:
      transform 0.25s,
      visibility 0.25s;
  }
  .sticky-contact[data-revealed='false'] {
    transform: translateY(100%);
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-contact {
      transition: none;
    }
  }
</style>

<script>
  import { defineCtaReveal } from '@podbor/site-kit/browser';

  defineCtaReveal();
</script>
