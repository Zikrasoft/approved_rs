---
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { SOCIAL_LINKS } from '@/utils/constants';

interface Props {
  class?: string;
}

const site = content(localeFrom(Astro.url.pathname)).site;
---

{
  SOCIAL_LINKS.length > 0 && (
    <div class:list={['flex flex-col gap-2', Astro.props.class]}>
      <span class="text-sm text-muted">{site.common.socialHeading}</span>
      <ul class="flex flex-wrap gap-2">
        {SOCIAL_LINKS.map((link) => (
          <li>
            <a
              href={link.url}
              target="_blank"
              rel="noopener"
              class="chip min-h-11"
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
