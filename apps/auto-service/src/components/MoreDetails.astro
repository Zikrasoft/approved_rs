---
import Icon from './Icon.astro';

interface Props {
  label: string;
  open?: boolean;
}

const { label, open = false } = Astro.props;
---

<details class="group rounded-control border border-line" open={open}>
  <summary
    class="flex min-h-11 cursor-pointer list-none items-center gap-2 px-3.5 text-sm font-semibold text-ink-2 hover:text-ink [&::-webkit-details-marker]:hidden"
  >
    <Icon
      name="plus"
      size={14}
      class="shrink-0 transition-transform duration-150 group-open:rotate-45"
    />
    {label}
  </summary>
  <div class="flex flex-col gap-4 border-t border-line p-3.5">
    <slot />
  </div>
</details>
