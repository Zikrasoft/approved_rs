---
import Icon from './Icon.astro';

interface Props {
  label: string;
  open?: boolean;
}

const { label, open = false } = Astro.props;
---

<details class="group/more" open={open}>
  <summary
    class="inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 text-sm font-semibold text-signal-ink group-open/more:hidden hover:text-signal-dark [&::-webkit-details-marker]:hidden"
  >
    {label}
    <Icon name="chevronDown" size={12} />
  </summary>
  <slot />
</details>
