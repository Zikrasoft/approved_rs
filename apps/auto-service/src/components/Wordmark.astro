---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`inline-flex items-baseline gap-1.5 ${className}`}>
  <span
    class="spec text-[0.9375rem] font-medium uppercase tracking-[0.18em] text-ink"
    >Car</span
  >
  <span
    class="spec rounded-sm bg-signal px-1.5 py-0.5 text-[0.9375rem] font-medium uppercase tracking-[0.18em] text-white"
    >Lab</span
  >
</span>
