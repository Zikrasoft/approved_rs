---
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { PathBuilder } from '@/utils/paths';

interface Props {
  pages: {
    slug: string;
    value: string;
    brand: { name: string };
    superseded?: boolean;
  }[];
}

const { pages } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const copy = content(locale).shopPart;
---

<ul class="flex flex-wrap gap-x-4 gap-y-1">
  {
    pages.map((page) => (
      <li>
        <a
          href={PathBuilder.partNumber(locale, page.slug)}
          class="inline-flex items-baseline gap-1.5 text-ink underline-offset-2 hover:text-signal-ink hover:underline"
        >
          <span class="text-sm font-semibold">{page.brand.name}</span>
          <span class="spec text-sm">{page.value}</span>
          {page.superseded && (
            <span class="rounded-sm border border-line px-1.5 py-px text-xs text-ink-2">
              {copy.supersededTag}
            </span>
          )}
        </a>
      </li>
    ))
  }
</ul>
