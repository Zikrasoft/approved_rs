---
import { localeFrom } from '@/i18n/config';
import { PathBuilder } from '@/utils/paths';

interface Props {
  pages: { slug: string; value: string; brand: { name: string } }[];
}

const { pages } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
---

<ul class="flex flex-wrap gap-x-4 gap-y-1">
  {
    pages.map((page) => (
      <li>
        <a
          href={PathBuilder.partNumber(locale, page.slug)}
          class="inline-flex items-baseline gap-1.5 text-signal-ink hover:underline"
        >
          <span class="text-sm font-semibold">{page.brand.name}</span>
          <span class="spec text-sm">{page.value}</span>
        </a>
      </li>
    ))
  }
</ul>
