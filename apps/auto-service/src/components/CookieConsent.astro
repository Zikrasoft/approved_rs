---
import { localeFrom } from '@/i18n/currentLocale';
import { getSiteContent } from '@/i18n/content/site';
import { PathBuilder } from '@/utils/paths';
import { COOKIE_POLICY_VERSION } from '@/utils/constants';

const locale = localeFrom(Astro.url.pathname);
const cookie = getSiteContent(locale).cookie;
---

<cookie-consent
  data-policy-version={COOKIE_POLICY_VERSION}
  hidden
  aria-live="polite"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-paper"
>
  <div
    class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] sm:px-6"
  >
    <p class="min-w-0 flex-1 text-xs leading-snug text-ink-2">
      {cookie.notice}{' '}{cookie.more}{' '}
      <a href={PathBuilder.privacy(locale)} class="link-muted underline"
        >{cookie.policyLink}</a
      >.
    </p>
    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        data-consent-decline
        class="btn btn-secondary px-3 py-2 text-xs"
      >
        {cookie.decline}
      </button>
      <button
        type="button"
        data-consent-accept
        class="btn btn-primary px-3 py-2 text-xs"
      >
        {cookie.accept}
      </button>
    </div>
  </div>
</cookie-consent>

<script>
  import { defineCookieConsent } from '@podbor/site-kit/browser';
  defineCookieConsent();
</script>
