---
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { pageWindow } from '@podbor/site-kit/pagination';
import Icon from './Icon.astro';

interface Props {
  label: string;
  prev?: string | null;
  next?: string | null;
  numbered?: {
    current: number;
    count: number;
    href: (number: number) => string;
  };
}

const { label, prev, next, numbered } = Astro.props;
const copy = content(localeFrom(Astro.url.pathname)).partsSearch;
const step =
  'flex min-h-11 items-center gap-1.5 rounded-control px-3 font-semibold text-ink hover:bg-shade hover:text-signal-ink';
---

<nav aria-label={label} class="flex flex-wrap items-center gap-2 text-sm">
  {
    prev && (
      <a href={prev} rel="prev" class={step}>
        <Icon name="chevronRight" size={16} class="rotate-180" />
        {copy.previous}
      </a>
    )
  }
  {
    numbered && (
      <ol class="flex flex-wrap items-center gap-1 max-sm:order-first max-sm:w-full">
        {pageWindow(numbered.current, numbered.count).map((slot) =>
          slot === 'gap' ? (
            <li aria-hidden="true" class="px-1 text-muted">
              …
            </li>
          ) : (
            <li>
              <a
                href={numbered.href(slot)}
                aria-current={slot === numbered.current ? 'page' : undefined}
                class="spec flex size-11 items-center justify-center rounded-control text-ink hover:bg-shade hover:text-signal-ink aria-[current=page]:bg-ink aria-[current=page]:font-semibold aria-[current=page]:text-paper"
              >
                {slot}
              </a>
            </li>
          ),
        )}
      </ol>
    )
  }
  {
    next && (
      <a
        href={next}
        rel="next"
        class:list={[step, numbered ? 'max-sm:ml-auto' : 'ml-auto']}
      >
        {copy.next}
        <Icon name="chevronRight" size={16} />
      </a>
    )
  }
</nav>
