---
import { jsonLdText, localBusinessSchema, mapPlaceUrl } from '@podbor/site-kit';
import '@/styles/global.css';
import latinFontUrl from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import cyrillicFontUrl from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import LeadModal from '@/components/LeadModal.astro';
import StickyContactBar from '@/components/StickyContactBar.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import { BCP47_BY_LOCALE } from '@/i18n/config';
import { pageHead } from '@/utils/pageHead';
import { BUSINESS_ID } from '@/utils/schema';
import { localeFrom } from '@/i18n/currentLocale';
import {
  GARAGE_ADDRESS,
  OPENING_HOURS,
  PHONE_NUMBER,
  SITE_LEGAL_NAME,
  SITE_NAME,
  SITE_URL,
  SOCIAL_SAME_AS,
} from '@/utils/constants';
import { DEV_MODE_INLINE } from '@/scripts/devMode';
import { SHOP_STATUS } from '@/utils/shopStatus';
import type { ServiceSlug } from '@/utils/services';
import { content } from '@/i18n/content';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  stickyContact?: boolean;
  service?: ServiceSlug;
  preloadImage?: { src: string; srcset: string; sizes: string };
}

const {
  title,
  description,
  preloadImage,
  noindex = false,
  jsonLd = [],
  stickyContact = true,
  service,
} = Astro.props;

const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const { canonical, alternates, ogLocale, ogImage } = pageHead(
  locale,
  Astro.url.pathname,
  { title, description },
);
const fontUrl = locale === 'ru' ? cyrillicFontUrl : latinFontUrl;

const googleMapsUrl = mapPlaceUrl(GARAGE_ADDRESS.googleMapsCid);

const businessSchema = localBusinessSchema({
  type: 'AutoRepair',
  id: BUSINESS_ID,
  name: SITE_NAME,
  legalName: SITE_LEGAL_NAME,
  url: SITE_URL,
  image: ogImage,
  logo: new URL('/icon-512.png', SITE_URL).href,
  description: site.footer.tagline,
  telephone: `+${PHONE_NUMBER}`,
  address: GARAGE_ADDRESS,
  hasMap: googleMapsUrl,
  areaServed: 'Beograd',
  currenciesAccepted: 'RSD, EUR',
  openingHours: OPENING_HOURS,
  sameAs: [googleMapsUrl, ...SOCIAL_SAME_AS],
});
---

<!doctype html>
<html lang={BCP47_BY_LOCALE[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      SHOP_STATUS === 'preview' && (
        <script is:inline set:html={DEV_MODE_INLINE} />
      )
    }
    <meta name="theme-color" content="#ffffff" />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.src}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={fontUrl}
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script
      type="application/ld+json"
      is:inline
      set:html={jsonLdText(businessSchema)}
    />
    {
      jsonLd.map((schema) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={jsonLdText(schema)}
        />
      ))
    }
  </head>
  <body
    class:list={[
      'flex min-h-screen flex-col lg:pb-0',
      stickyContact && 'pb-[calc(3.5rem+1px)]',
    ]}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-signal focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
      >{site.common.skipToContent}</a
    >
    <SiteHeader />
    <language-suggestion hidden>
      <div class="bg-ink text-paper">
        <div class="wrap flex items-center gap-3 py-2">
          <a
            data-lang-link
            href="#"
            class="spec rounded-control bg-paper px-3.5 py-2 text-sm font-semibold text-ink no-underline transition-opacity hover:opacity-90"
          ></a>
          <button
            type="button"
            data-lang-dismiss
            class="ml-auto flex size-9 shrink-0 items-center justify-center rounded-control text-xl leading-none opacity-55 transition-opacity hover:opacity-100"
            >&times;</button
          >
        </div>
      </div>
    </language-suggestion>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    {stickyContact && <StickyContactBar service={service} />}
    <LeadModal />
    <CookieConsent />

    <script>
      import { isTrackedContactChannel } from '@podbor/lead-crm/contact-channel';
      import { defineLeadForm } from '@podbor/lead-crm/lead-form';
      import {
        defineAnalytics,
        defineContactClickTracking,
        defineFunnelTracking,
        defineLanguageSuggestion,
        getOrCreateVisitorId,
        markFieldValidity,
      } from '@podbor/site-kit/browser';
      import {
        applyContactPreference,
        detectVisitorCountry,
        visitorChannel,
      } from '@podbor/site-kit/contact-preference';
      import { YM_COUNTER_ID } from '@/utils/metrika';

      if (!import.meta.env.DEV) defineAnalytics({ ymCounterId: YM_COUNTER_ID });
      defineContactClickTracking(isTrackedContactChannel);
      applyContactPreference();
      defineLanguageSuggestion();
      defineFunnelTracking();
      defineLeadForm({
        visitorId: getOrCreateVisitorId,
        markFieldValidity,
        preferredChannel: visitorChannel,
        visitorCountry: detectVisitorCountry,
      });
    </script>
  </body>
</html>
