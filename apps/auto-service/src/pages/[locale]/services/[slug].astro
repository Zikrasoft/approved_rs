---
import BulletList from '@/components/BulletList.astro';
import { getCollection } from 'astro:content';
import { withPlaceholder } from '@podbor/i18n';
import Shell from '@/layouts/Shell.astro';
import Icon from '@/components/Icon.astro';
import PanelHero from '@/components/PanelHero.astro';
import HeroContacts from '@/components/HeroContacts.astro';
import GarageAddress from '@/components/GarageAddress.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import WorksRow from '@/components/WorksRow.astro';
import FinalCta from '@/components/FinalCta.astro';
import PartsInquiry from '@/components/PartsInquiry.astro';
import { localeFrom } from '@/i18n/config';
import { featuredWorks, servicePhoto } from '@/utils/works';
import { panelPhoto } from '@/utils/panelPhoto';
import { PathBuilder, withLocales } from '@/utils/paths';
import {
  partsCategoryFor,
  SERVICE_SLUGS,
  VIN_INQUIRY_SERVICE,
} from '@/utils/services';
import { categoryPagesForBuild } from '@/utils/catalogueEnv';
import { safeMarkdown } from '@podbor/site-kit';
import { servicePageSchema } from '@/utils/schema';
import { content } from '@/i18n/content';

export function getStaticPaths() {
  return withLocales(
    SERVICE_SLUGS.map((slug) => ({ params: { slug }, props: { slug } })),
  );
}

const { slug } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
const { services, site, pages, home } = content(locale);
const service = services[slug];
const parts = slug === VIN_INQUIRY_SERVICE;
const works = await getCollection('works');
const related = featuredWorks(works).filter((work) =>
  work.data.servicesApplied.includes(slug),
);
const image = servicePhoto(slug, works);
const photo = image && (await panelPhoto(image));

const partsCategory = partsCategoryFor(slug, await categoryPagesForBuild());
const partsHref = partsCategory
  ? PathBuilder.partsCategory(locale, partsCategory)
  : slug === 'servicing' && PathBuilder.parts(locale);
const name = (template: string) =>
  withPlaceholder(template, 'name', service.name);
const finalCta = {
  eyebrow: home.finalCta.eyebrow,
  heading: name(
    parts ? services.partsCtaHeadingTemplate : services.ctaHeadingTemplate,
  ),
  body: services.ctaBody,
  service: slug,
};
const asideCards = [
  { heading: service.signsHeading, items: service.signs, marker: 'dot' },
  {
    heading: service.includesHeading,
    items: service.includes,
    marker: 'check',
  },
] satisfies { heading: string; items: string[]; marker: 'dot' | 'check' }[];
---

<Shell
  title={service.metaTitle}
  description={service.metaDescription}
  jsonLd={[servicePageSchema(service)]}
  service={slug}
  preloadImage={photo}
>
  <PanelHero
    heading={name(services.heroHeadingTemplate)}
    hook={service.heroTitle}
    lead={service.heroLead}
    photo={photo}
    crumbs={[
      { href: PathBuilder.services(locale), label: site.nav.services },
      { href: PathBuilder.service(locale, slug), label: service.name },
    ]}
  >
    <dl class="flex flex-col gap-0.5 border-y border-panel-line/60 py-3.5">
      <dt class="text-xs text-panel-ink">{services.specsDurationLabel}</dt>
      <dd class="spec text-lg leading-tight font-semibold">
        {service.duration}
      </dd>
    </dl>
    <HeroContacts service={slug} bookLabel={service.cta} bookModal={!parts} />
    <GarageAddress layout="line" tone="panel" class="text-sm" />
  </PanelHero>

  <section
    class="wrap grid gap-10 py-band md:py-band-lg lg:grid-cols-[1.2fr_1fr]"
  >
    <div class="flex flex-col gap-5">
      <h2 class="text-section">{service.bodyHeading}</h2>
      <div class="prose-shop" set:html={safeMarkdown(service.body)} />
      {
        partsHref && (
          <a
            href={partsHref}
            class="link-underlined inline-flex min-h-11 items-center gap-1.5 self-start text-sm font-semibold text-ink"
          >
            {services.partsLink}
            <Icon name="chevronRight" size={14} />
          </a>
        )
      }
    </div>

    <aside class="flex flex-col gap-4 max-lg:order-first">
      {
        asideCards.map((card) => (
          <div class="card flex flex-col gap-3 p-5">
            <h2 class="text-block font-semibold">{card.heading}</h2>
            <BulletList items={card.items} marker={card.marker} />
          </div>
        ))
      }
    </aside>
  </section>

  <section class="wrap">
    <div class="card border-transparent bg-shade p-5">
      <h2 class="mb-2 text-block font-semibold">
        {service.honestHeading}
      </h2>
      <p class="max-w-3xl text-sm leading-relaxed text-ink-2 sm:text-base">
        {service.honest}
      </p>
    </div>
  </section>

  <section class="wrap py-band md:py-band-lg">
    <h2 class="text-section">{services.processHeading}</h2>
    <ProcessSteps steps={home.process.steps} titlesOnly />
  </section>

  <WorksRow
    works={related}
    eyebrow={pages.works.eyebrow}
    heading={service.name}
  />

  {
    parts ? (
      <FinalCta {...finalCta}>
        <PartsInquiry slot="form" />
      </FinalCta>
    ) : (
      <FinalCta {...finalCta} />
    )
  }
</Shell>
