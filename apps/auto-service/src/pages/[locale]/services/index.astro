---
import { getCollection } from 'astro:content';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import PriceTable from '@/components/PriceTable.astro';
import SectionHead from '@/components/SectionHead.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import FinalCta from '@/components/FinalCta.astro';
import { publishedWorks } from '@/utils/works';
import { localeFrom } from '@/i18n/config';
import { localePaths, PathBuilder } from '@/utils/paths';
import { content } from '@/i18n/content';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFrom(Astro.url.pathname);
const services = content(locale).services;
const home = content(locale).home;
const site = content(locale).site;
const pages = content(locale).pages;
const latestWorks = publishedWorks(await getCollection('works')).slice(0, 3);
---

<Shell
  title={services.indexMetaTitle}
  description={services.indexMetaDescription}
>
  <PageHero
    eyebrow={services.indexEyebrow}
    heading={services.indexHeading}
    lead={services.indexLead}
    crumbs={[{ href: PathBuilder.services(locale), label: site.nav.services }]}
  />

  <section class="wrap py-band md:py-band-lg">
    <PriceTable />
  </section>

  <section class="wrap py-band md:py-band-lg">
    <SectionHead
      eyebrow={home.process.eyebrow}
      heading={home.process.heading}
      body={home.process.body}
    />
    <ProcessSteps steps={home.process.steps} />
  </section>

  {
    latestWorks.length > 0 && (
      <section class="bg-shade">
        <div class="wrap py-band md:py-band-lg">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHead
              eyebrow={pages.works.eyebrow}
              heading={pages.works.heading}
            />
            <a href={PathBuilder.works(locale)} class="btn btn-secondary w-fit">
              {site.common.allWorks}
            </a>
          </div>
          <WorkGrid works={latestWorks} />
        </div>
      </section>
    )
  }

  <FinalCta
    eyebrow={home.finalCta.eyebrow}
    heading={home.finalCta.heading}
    body={home.finalCta.body}
  />
</Shell>
