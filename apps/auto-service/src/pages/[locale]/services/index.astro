---
import { getCollection } from 'astro:content';
import Shell from '@/layouts/Shell.astro';
import PanelHero from '@/components/PanelHero.astro';
import HeroContacts from '@/components/HeroContacts.astro';
import GarageAddress from '@/components/GarageAddress.astro';
import ServiceList from '@/components/ServiceList.astro';
import WorksRow from '@/components/WorksRow.astro';
import FinalCta from '@/components/FinalCta.astro';
import { featuredWorks } from '@/utils/works';
import { panelPhoto } from '@/utils/panelPhoto';
import workshopBay from '@/assets/workshop-bay.jpg';
import { localeFrom } from '@/i18n/config';
import { localePaths, PathBuilder } from '@/utils/paths';
import { content } from '@/i18n/content';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFrom(Astro.url.pathname);
const { services, home, site, pages } = content(locale);
const photo = await panelPhoto({
  image: workshopBay,
  alt: site.photos.workshopBay,
});
---

<Shell
  title={services.indexMetaTitle}
  description={services.indexMetaDescription}
  preloadImage={photo}
>
  <PanelHero
    heading={services.indexHeading}
    hook={services.indexLead}
    photo={photo}
    crumbs={[{ href: PathBuilder.services(locale), label: site.nav.services }]}
  >
    <HeroContacts />
    <GarageAddress layout="line" tone="panel" class="text-sm" />
  </PanelHero>

  <section class="wrap py-band md:py-band-lg">
    <ServiceList />
  </section>

  <WorksRow
    works={featuredWorks(await getCollection('works'))}
    eyebrow={pages.works.eyebrow}
    heading={home.worksHeading}
  />

  <FinalCta
    eyebrow={home.finalCta.eyebrow}
    heading={home.finalCta.heading}
    body={home.finalCta.body}
  />
</Shell>
