---
export const prerender = false;

import { facetFilter, type SearchFacet } from '@podbor/catalog-contract';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';
import Icon from '@/components/Icon.astro';
import PartsSearchForm from '@/components/PartsSearchForm.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { catalogueFromEnv } from '@/utils/catalogue';
import { PathBuilder } from '@/utils/paths';
import { VIN_INQUIRY_SERVICE } from '@/utils/services';

const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const copy = content(locale).partsSearch;
const partsInquiry = content(locale).pages.partsInquiry;

const params = Astro.url.searchParams;
const q = (params.get('q') ?? '').trim().slice(0, 200);
const chosen = params.getAll('facets');
const offset = Math.max(
  0,
  Number.parseInt(params.get('offset') ?? '0', 10) || 0,
);

const catalogue = catalogueFromEnv({
  MEDUSA_BACKEND_URL: import.meta.env.MEDUSA_BACKEND_URL,
  MEDUSA_PUBLISHABLE_KEY: import.meta.env.MEDUSA_PUBLISHABLE_KEY,
});
const found =
  q && catalogue
    ? await catalogue.search({ q, locale, facets: chosen, offset })
    : null;
const unavailable = Boolean(q) && !found;

const valueLabel = (
  facet: SearchFacet,
  value: { value: string; label: string },
) => {
  if (value.label !== value.value) {
    return value.label;
  }
  if (value.value === 'true') {
    return copy.booleanTrue;
  }
  if (value.value === 'false') {
    return copy.booleanFalse;
  }
  return facet.unit ? `${value.value} ${facet.unit}` : value.value;
};

const searchHref = (facets: string[], nextOffset = 0) => {
  const next = new URLSearchParams({ q });
  for (const facet of facets) {
    next.append('facets', facet);
  }
  if (nextOffset) {
    next.set('offset', String(nextOffset));
  }
  return `${PathBuilder.partsSearch(locale)}?${next}`;
};
---

<Shell title={copy.metaTitle} description={copy.metaDescription} noindex>
  <PageHero
    eyebrow={copy.eyebrow}
    heading={copy.heading}
    lead={copy.lead}
    crumbs={[
      { href: PathBuilder.parts(locale), label: site.nav.parts },
      { href: PathBuilder.partsSearch(locale), label: copy.heading },
    ]}
  />

  <section class="wrap flex flex-col gap-6 py-band md:py-band-lg">
    <div class="card border-ink p-5 sm:p-6">
      <PartsSearchForm query={q} />
    </div>

    {
      found && (
        <div
          class:list={[
            'grid gap-6',
            found.facets.length > 0 &&
              'lg:grid-cols-[16rem_1fr] lg:items-start',
          ]}
        >
          {found.facets.length > 0 && (
            <form
              method="GET"
              action={PathBuilder.partsSearch(locale)}
              class="card p-5 lg:sticky lg:top-24"
            >
              <input type="hidden" name="q" value={q} />
              <details class="group" open={chosen.length > 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-ink marker:hidden [&::-webkit-details-marker]:hidden">
                  {copy.filtersHeading}
                  <Icon
                    name="chevronDown"
                    size={16}
                    class="text-muted transition-transform duration-150 group-open:rotate-180 motion-reduce:transition-none"
                  />
                </summary>
                <div class="mt-4 flex flex-col gap-5">
                  {found.facets.map((facet) => (
                    <fieldset class="flex flex-col gap-2">
                      <legend class="mb-1 text-sm font-semibold text-ink">
                        {facet.label}
                      </legend>
                      {facet.values.map((value) => (
                        <label class="flex items-center gap-2 text-sm text-ink-2">
                          <input
                            type="checkbox"
                            name="facets"
                            value={facetFilter(facet.key, value.value)}
                            checked={chosen.includes(
                              facetFilter(facet.key, value.value),
                            )}
                            class="size-4 accent-signal"
                          />
                          <span class="flex-1">{valueLabel(facet, value)}</span>
                          <span class="spec text-xs text-muted">
                            {value.count}
                          </span>
                        </label>
                      ))}
                    </fieldset>
                  ))}
                  <div class="flex flex-wrap items-center gap-3">
                    <button type="submit" class="btn btn-primary">
                      {copy.applyFilters}
                    </button>
                    {chosen.length > 0 && (
                      <a
                        href={searchHref([])}
                        class="text-sm underline underline-offset-2 hover:text-signal-ink"
                      >
                        {copy.resetFilters}
                      </a>
                    )}
                  </div>
                </div>
              </details>
            </form>
          )}

          <div class="flex min-w-0 flex-col gap-3">
            <p class="text-sm text-muted" aria-live="polite">
              {copy.found.replace('{count}', String(found.count))}
            </p>

            {found.results.length === 0 ? (
              <p class="max-w-2xl text-base leading-relaxed text-ink-2">
                {copy.noResults.replace('{q}', q)}
              </p>
            ) : (
              <ol class="flex flex-col divide-y divide-line border-y border-line">
                {found.results.map((result) => (
                  <li>
                    <a
                      href={PathBuilder.partNumber(locale, result.slug)}
                      class="flex flex-col gap-1 py-4 transition-colors duration-150 hover:bg-card sm:flex-row sm:items-baseline sm:gap-6 sm:px-3"
                    >
                      <span class="spec shrink-0 text-lg font-semibold tracking-wide text-ink sm:w-64">
                        <span class="text-muted">{result.brand.name}</span>{' '}
                        {result.value}
                      </span>
                      <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                        <span class="text-base text-ink">
                          {result.part.name}
                        </span>
                        {result.part.category && (
                          <span class="text-sm text-muted">
                            {result.part.category.name}
                          </span>
                        )}
                      </span>
                      {result.superseded && (
                        <span class="w-fit rounded-sm border border-line px-2 py-0.5 text-xs text-ink-2">
                          {copy.superseded}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
              </ol>
            )}

            {(offset > 0 || offset + found.limit < found.count) && (
              <nav class="flex justify-between gap-4 pt-2 text-sm">
                {offset > 0 ? (
                  <a
                    href={searchHref(chosen, Math.max(0, offset - found.limit))}
                    class="underline underline-offset-2 hover:text-signal-ink"
                  >
                    {copy.previous}
                  </a>
                ) : (
                  <span />
                )}
                {offset + found.limit < found.count && (
                  <a
                    href={searchHref(chosen, offset + found.limit)}
                    class="underline underline-offset-2 hover:text-signal-ink"
                  >
                    {copy.next}
                  </a>
                )}
              </nav>
            )}
          </div>
        </div>
      )
    }

    {
      unavailable && (
        <p class="max-w-2xl text-base leading-relaxed text-ink-2">
          {copy.unavailable}
        </p>
      )
    }

    {
      (unavailable || found?.results.length === 0) && (
        <div id="lead" class="card flex max-w-2xl flex-col gap-4 p-5 sm:p-6">
          <h2 class="text-block font-semibold">{copy.formHeading}</h2>
          <LeadForm
            service={VIN_INQUIRY_SERVICE}
            vin={{
              label: partsInquiry.vinLabel,
              placeholder: partsInquiry.vinPlaceholder,
            }}
            comment={`${q}: `}
            commentLabel={partsInquiry.commentLabel}
            commentPlaceholder={partsInquiry.commentPlaceholder}
            commentNote={partsInquiry.commentNote}
            defaultChannel="whatsapp"
          />
        </div>
      )
    }
  </section>
</Shell>
