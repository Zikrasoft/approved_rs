---
import { translated } from '@podbor/catalog-contract';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import InquiryLink from '@/components/InquiryLink.astro';
import FitLine from '@/components/FitLine.astro';
import InkLink from '@/components/InkLink.astro';
import FittedPart from '@/components/FittedPart.astro';
import ListingBar from '@/components/ListingBar.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { carName, seriesName, vehicleVariant } from '@/utils/carName';
import { makeHubsForBuild } from '@/utils/catalogueEnv';
import { cacheKey } from '@/utils/cacheKey';
import type {
  SeriesCategoryEntry,
  SeriesHubEntry,
} from '@/utils/catalogueSnapshot';
import { keySpecs } from '@/utils/attributeRows';
import { paragraphs } from '@podbor/site-kit';
import { PathBuilder, withLocales } from '@/utils/paths';

export async function getStaticPaths() {
  const hubs = await makeHubsForBuild();
  return withLocales(
    hubs.flatMap((hub) =>
      hub.series.flatMap((series) =>
        series.categories.map((entry) => ({
          params: {
            make: hub.make.slug,
            series: series.series.slug,
            category: entry.category.slug,
          },
          props: { hub: series, entry },
          cacheKey: cacheKey({
            make: series.make,
            series: series.series,
            entry,
          }),
        })),
      ),
    ),
  );
}

const { hub, entry } = Astro.props as {
  hub: SeriesHubEntry;
  entry: SeriesCategoryEntry;
};
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const copy = content(locale).partsCar.hubs.modelCategory;
const { make, series } = hub;
const { category } = entry;
const name = seriesName(series, make, locale);
const listingAttributes = entry.parts.map(({ part }) => part.attributes);
const categoryName = translated(category, 'name', locale);
const [lead, ...body] = paragraphs(translated(category, 'text', locale));
const listed = entry.parts.flatMap(({ pages }) =>
  pages.filter(({ superseded }) => !superseded),
);
const fill = (template: string) =>
  template.replace('{category}', categoryName).replace('{model}', name);
const SAID_BY_FIT = ['axle'];
---

<Shell title={fill(copy.metaTitle)} description={fill(copy.metaDescription)}>
  <PageHero
    actions={false}
    eyebrow={fill(copy.eyebrow)}
    heading={categoryName}
    lead={lead}
    crumbs={[
      { href: PathBuilder.parts(locale), label: site.nav.parts },
      { href: PathBuilder.partsMake(locale, make.slug), label: make.name },
      {
        href: PathBuilder.partsSeries(locale, make.slug, series.slug),
        label: name,
      },
      {
        href: PathBuilder.partsSeriesCategory(
          locale,
          make.slug,
          series.slug,
          category.slug,
        ),
        label: categoryName,
      },
    ]}
  />

  <section class="wrap grid gap-6 py-band md:py-band-lg lg:items-start">
    <div class="flex min-w-0 flex-col gap-8">
      <div class="flex flex-col gap-3">
        <h2 class="text-section">{copy.partsHeading}</h2>
        <ListingBar
          count={listed.length}
          filters={false}
          found={content(locale).partsSearch.foundNumbers}
        />
        <ul class="flex flex-col gap-4">
          {
            entry.parts.map(({ part, pages, fits }) => (
              <li class="card flex flex-col gap-3 p-5">
                <FittedPart
                  pages={pages}
                  name={translated(part, 'name', locale)}
                  specs={keySpecs(
                    category,
                    part.attributes,
                    locale,
                    listingAttributes,
                    SAID_BY_FIT,
                  )}
                  heading
                />
                {fits.length > 0 && (
                  <ul class="flex flex-col gap-3 border-t border-line pt-3">
                    {fits.map((fit) => (
                      <li>
                        <FitLine
                          fit={fit}
                          car={{
                            href: null,
                            label: `${carName(fit.vehicle.model, locale)}, ${vehicleVariant(fit.vehicle, locale)}`,
                          }}
                        />
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
        <InquiryLink topic={`${name}, ${categoryName}`} />
      </div>

      {
        body.length > 0 && (
          <div class="flex max-w-2xl flex-col gap-4 text-base leading-relaxed text-ink-2">
            {body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )
      }

      <InkLink
        href={PathBuilder.partsCategory(locale, category.slug)}
        class="self-start"
      >
        {content(locale).shopPart.categoryLink}
      </InkLink>
    </div>
  </section>
</Shell>
