---
export const prerender = false;

import MakeHubPage from '@/components/MakeHubPage.astro';
import SeriesPage from '@/components/SeriesPage.astro';
import { loadCataloguePage } from '@/utils/cataloguePage';
import { loadMakeHub, makeHubPageNumber } from '@/utils/makeHub';

const hubPage = makeHubPageNumber(Astro.params.series ?? '');
const hub = hubPage === null ? null : await loadMakeHub(Astro, hubPage);
if (hub instanceof Response) return hub;
const series = hub
  ? null
  : await loadCataloguePage(Astro, (catalogue, catalogueLocale) =>
      catalogue.seriesPage(
        Astro.params.make ?? '',
        Astro.params.series ?? '',
        catalogueLocale,
      ),
    );
if (series instanceof Response) return series;
---

{hub ? <MakeHubPage {...hub} /> : series && <SeriesPage page={series} />}
