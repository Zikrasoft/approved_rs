---
export const prerender = false;

import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import InquiryLink from '@/components/InquiryLink.astro';
import FitLine from '@/components/FitLine.astro';
import InkLink from '@/components/InkLink.astro';
import FittedPart from '@/components/FittedPart.astro';
import ListingBar from '@/components/ListingBar.astro';
import ListingPager from '@/components/ListingPager.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { carName, seriesName, vehicleVariant } from '@/utils/carName';
import { loadCataloguePage } from '@/utils/cataloguePage';
import { keySpecs } from '@/utils/attributeRows';
import { paragraphs } from '@podbor/site-kit';
import { PathBuilder } from '@/utils/paths';
import {
  listingHeading,
  neighbours,
  requestedListingPage,
} from '@/utils/listing';
import { withPlaceholder } from '@podbor/i18n';

const requested = requestedListingPage(Astro.params.page);
const loaded = await loadCataloguePage(
  Astro,
  async (catalogue, catalogueLocale) => {
    const found = requested
      ? await catalogue.seriesCategoryPage(
          Astro.params.make ?? '',
          Astro.params.series ?? '',
          Astro.params.category ?? '',
          requested,
          catalogueLocale,
        )
      : null;
    return found?.page === requested ? found : null;
  },
);
if (loaded instanceof Response) return loaded;
const { series, category, parts, page: number, pages: pageCount } = loaded;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const copy = content(locale).partsCar.hubs.modelCategory;
const { make } = series;
const name = seriesName(series, make, locale);
const listingAttributes = parts.map(({ part }) => part.attributes);
const categoryName = category.name;
const [lead, ...body] = paragraphs(category.text);
const listed = parts.flatMap(({ pages }) =>
  pages.filter(({ superseded }) => !superseded),
);
const listingCopy = content(locale).pages.partsInquiry.category;
const listing = { number, count: pageCount };
const firstPage = number === 1;
const pageHref = (target: number) =>
  PathBuilder.partsSeriesCategory(
    locale,
    make.slug,
    series.slug,
    category.slug,
    target,
  );
const { prev, next } = neighbours(listing, pageHref);
const heading = listingHeading(number, {
  heading: categoryName,
  pageName: withPlaceholder(listingCopy.pageName, 'name', categoryName),
});
const fill = (template: string) =>
  template.replace('{category}', heading).replace('{model}', name);
const SAID_BY_FIT = ['axle'];
---

<Shell title={fill(copy.metaTitle)} description={fill(copy.metaDescription)}>
  {prev && <link slot="head" rel="prev" href={prev} />}
  {next && <link slot="head" rel="next" href={next} />}
  <PageHero
    actions={false}
    eyebrow={fill(copy.eyebrow)}
    heading={heading}
    lead={firstPage ? lead : undefined}
    crumbs={[
      { href: PathBuilder.parts(locale), label: site.nav.parts },
      { href: PathBuilder.partsMake(locale, make.slug), label: make.name },
      {
        href: PathBuilder.partsSeries(locale, make.slug, series.slug),
        label: name,
      },
      { href: pageHref(1), label: categoryName },
    ]}
  />

  <section class="wrap grid gap-6 py-band md:py-band-lg lg:items-start">
    <div class="flex min-w-0 flex-col gap-8">
      <div class="flex flex-col gap-3">
        <h2 class="text-section">{copy.partsHeading}</h2>
        <ListingBar
          count={listed.length}
          filters={false}
          found={content(locale).partsSearch.foundNumbers}
        />
        <ul class="flex flex-col gap-4">
          {
            parts.map(({ part, pages, fits, more }) => (
              <li class="card flex flex-col gap-3 p-5">
                <FittedPart
                  pages={pages}
                  name={part.name}
                  specs={keySpecs(
                    category,
                    part.attributes,
                    locale,
                    listingAttributes,
                    SAID_BY_FIT,
                  )}
                  heading
                />
                {fits.length > 0 && (
                  <ul class="flex flex-col gap-3 border-t border-line pt-3">
                    {fits.map((fit) => (
                      <li>
                        <FitLine
                          fit={fit}
                          car={{
                            href: null,
                            label: `${carName(fit.vehicle.model, locale)}, ${vehicleVariant(fit.vehicle, locale)}`,
                          }}
                        />
                      </li>
                    ))}
                    {more > 0 && (
                      <li>
                        <a
                          href={PathBuilder.partNumber(locale, pages[0].slug)}
                          class="text-sm text-ink-2 link-underlined pointer-coarse:inline-flex pointer-coarse:min-h-11 pointer-coarse:items-center"
                        >
                          {content(locale).shopPart.fitsMore.replace(
                            '{count}',
                            String(more),
                          )}
                        </a>
                      </li>
                    )}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
        <ListingPager
          label={listingCopy.pagination}
          listing={listing}
          href={pageHref}
        />
        <InquiryLink topic={`${name}, ${categoryName}`} />
      </div>

      {
        firstPage && body.length > 0 && (
          <div class="flex max-w-2xl flex-col gap-4 text-base leading-relaxed text-ink-2">
            {body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )
      }

      <InkLink
        href={PathBuilder.partsCategory(locale, category.slug)}
        class="self-start"
      >
        {content(locale).shopPart.categoryLink}
      </InkLink>
    </div>
  </section>
</Shell>
