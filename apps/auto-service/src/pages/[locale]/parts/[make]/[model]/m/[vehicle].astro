---
import DisclosureCard from '@/components/DisclosureCard.astro';
import { contactCta } from '@podbor/site-kit/contact-control';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import InquiryLink from '@/components/InquiryLink.astro';
import VinInquiryCard from '@/components/VinInquiryCard.astro';
import { BCP47_BY_LOCALE, localeFrom } from '@/i18n/config';
import { formatMoney } from '@/utils/money';
import { content } from '@/i18n/content';
import FitLine from '@/components/FitLine.astro';
import CardSectionHead from '@/components/CardSectionHead.astro';
import { unconditionalFirst } from '@/utils/fitmentLabels';
import AddonNote from '@/components/AddonNote.astro';
import FittedPart from '@/components/FittedPart.astro';
import PriceTag from '@/components/PriceTag.astro';
import LineItem from '@/components/LineItem.astro';
import { pagesThumbnail } from '@/utils/partImages';
import { translated } from '@podbor/catalog-contract';
import { carName, vehicleVariant } from '@/utils/carName';
import { cataloguePagesForBuild, carPagesForBuild } from '@/utils/catalogueEnv';
import { cacheKey } from '@/utils/cacheKey';
import type { CarPageEntry } from '@/utils/catalogueSnapshot';
import {
  catalogueLinks,
  modelKey,
  PathBuilder,
  vehiclePath,
  withLocales,
  type CataloguePages,
} from '@/utils/paths';
import { kitPick, kitTotal, nameRepeatsCategory } from '@/utils/kitPick';
import { plural } from '@/utils/leadTime';
import { PARTS_INQUIRY_OPEN_ATTRIBUTE } from '@/scripts/partsList';

export async function getStaticPaths() {
  const [cars, places] = await Promise.all([
    carPagesForBuild(),
    cataloguePagesForBuild(),
  ]);
  return withLocales(
    cars.map((car) => ({
      params: {
        make: car.vehicle.model.chassis.series.make.slug,
        model: car.vehicle.model.slug,
        vehicle: car.vehicle.slug ?? car.vehicle.id,
      },
      props: { car, places },
      cacheKey: cacheKey({
        car,
        categoryPages: [...places.categories].filter((key) =>
          key.startsWith(`${modelKey(car.vehicle.model)}/`),
        ),
      }),
    })),
  );
}

const { car, places } = Astro.props as {
  car: CarPageEntry;
  places: CataloguePages;
};
const { vehicle } = car;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const copy = content(locale).partsCar.car;
const shopPart = content(locale).shopPart;
const { fitment } = content(locale).partsCar;
const quantity = (count: number) =>
  plural(
    count,
    { one: fitment.quantityOne, other: fitment.quantity },
    BCP47_BY_LOCALE[locale],
  ).replace('{count}', count.toLocaleString(BCP47_BY_LOCALE[locale]));
const variant = vehicleVariant(vehicle, locale);
const name = `${carName(vehicle.model, locale)}, ${variant}`;
const { engine, model } = vehicle;
const { make } = model.chassis.series;
const byCategory = new Map<string, CarPageEntry['groups']>();
for (const group of car.groups) {
  const key = group.category?.id ?? '';
  byCategory.set(key, [...(byCategory.get(key) ?? []), group]);
}
const links = catalogueLinks(locale, places);
const blocks = [...byCategory.values()].map((groups) => ({
  name: groups[0].category
    ? translated(groups[0].category, 'name', locale)
    : copy.otherParts,
  href:
    groups[0].category && links.modelCategory(model, groups[0].category.slug),
  groups,
}));

const kit = car.kit.map((item) => ({ ...item, ...kitPick(item.pages) }));
const kitBuyable = kit.length > 0 && kit.every(({ offer }) => offer);
const kitPrice =
  kitBuyable &&
  formatMoney(
    kitTotal(
      kit.map(({ offer, quantity }) => ({ price: offer!.price, quantity })),
    ),
    kit[0].offer!.currency,
    BCP47_BY_LOCALE[locale],
  );

const empty =
  kit.length === 0 && blocks.length === 0 && car.matches.length === 0;

const years =
  vehicle.year_from &&
  `${vehicle.year_from}–${vehicle.year_to ?? copy.yearsOngoing}`;

const specs = [
  { label: copy.engineLabel, value: `${engine.code} (${engine.family})` },
  { label: copy.fuelLabel, value: engine.fuel && copy.fuel[engine.fuel] },
  {
    label: copy.displacementLabel,
    value:
      engine.displacement_cc &&
      `${engine.displacement_cc} ${copy.displacementUnit}`,
  },
  {
    label: copy.powerLabel,
    value: vehicle.power_kw && `${vehicle.power_kw} ${copy.powerUnit}`,
  },
  { label: copy.driveLabel, value: vehicle.drive && copy.drive[vehicle.drive] },
  {
    label: copy.bodyLabel,
    value: model.chassis.body_style && copy.body[model.chassis.body_style],
  },
  { label: copy.yearsLabel, value: years },
  {
    label: copy.steeringLabel,
    value: vehicle.steering && copy.steering[vehicle.steering],
  },
  {
    label: copy.typeCodeLabel,
    value: vehicle.identifiers.map(({ value }) => value).join(', '),
  },
].filter((spec): spec is { label: string; value: string } =>
  Boolean(spec.value),
);
const specsSummary = [
  engine.code,
  vehicle.power_kw && `${vehicle.power_kw} ${copy.powerUnit}`,
  years,
]
  .filter(Boolean)
  .join(', ');
---

<Shell
  title={copy.metaTitle.replace('{car}', name)}
  description={copy.metaDescription.replace('{car}', name)}
>
  <PageHero
    actions={false}
    compact
    eyebrow={copy.eyebrow}
    heading={carName(model, locale)}
    lead={variant}
    crumbs={[
      { href: PathBuilder.parts(locale), label: site.nav.parts },
      { href: PathBuilder.partsMake(locale, make.slug), label: make.name },
      {
        href: PathBuilder.partsModel(locale, make.slug, model.slug),
        label: carName(model, locale),
      },
      { href: vehiclePath(locale, vehicle), label: variant },
    ]}
  >
    <p
      class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-2"
      data-vin-matched
      hidden
    >
      <span class="inline-flex items-center gap-1.5 font-semibold text-ink">
        <Icon name="check" size={16} />
        <span data-template={copy.vinMatched}></span>
      </span>
      <a
        href={PathBuilder.parts(locale)}
        class="link-underlined"
        data-forget-vin
      >
        {copy.notYourCarLink}
      </a>
    </p>
  </PageHero>

  <car-facts
    data-car={name}
    class:list={[
      'wrap grid gap-6 pt-6 pb-band md:pt-band md:pb-band-lg',
      empty && 'lg:grid-cols-[1.2fr_1fr] lg:items-start',
    ]}
  >
    <div class="flex min-w-0 flex-col gap-6">
      {
        kit.length > 0 && (
          <parts-list-add-all
            class="card flex flex-col gap-4 border-transparent bg-shade p-5"
            data-car={name}
          >
            <div class="flex flex-col gap-1">
              <h2 class="text-block font-semibold">{copy.kitHeading}</h2>
              <p class="text-sm leading-relaxed text-ink-2">{copy.kitLead}</p>
            </div>
            <ul class="flex flex-col divide-y divide-line">
              {kit.map((item) => (
                <LineItem
                  variant="kit"
                  class="py-3 first:pt-0"
                  name={translated(item.part, 'name', locale)}
                  href={PathBuilder.partNumber(locale, item.page.slug)}
                  number={`${item.page.brand.name} ${item.page.value}`}
                  eyebrow={
                    nameRepeatsCategory(
                      translated(item.part, 'name', locale),
                      translated(item.category, 'name', locale),
                    )
                      ? undefined
                      : translated(item.category, 'name', locale)
                  }
                  quantity={quantity(item.quantity)}
                  thumb={pagesThumbnail(item.pages)}
                  data-kit-part={item.part.id}
                  data-slug={item.page.slug}
                  data-brand={item.page.brand.name}
                  data-number={item.page.value}
                  data-name={translated(item.part, 'name', locale)}
                  data-offer-id={item.offer?.id}
                  data-quantity={item.quantity}
                >
                  <PriceTag slot="price" pages={item.pages} kit />
                </LineItem>
              ))}
            </ul>
            <div
              class="flex flex-col gap-3 sm:flex-row sm:flex-wrap"
              {...contactCta}
            >
              <kit-cart
                class="contents noscript:hidden!"
                {...(kitBuyable ? { 'data-buyable': '' } : { hidden: '' })}
                data-cart-href={PathBuilder.partsCart(locale)}
                data-locale-tag={BCP47_BY_LOCALE[locale]}
              >
                <button
                  type="button"
                  class="btn btn-primary w-full aria-busy:cursor-progress sm:w-auto"
                >
                  <span class="hidden in-aria-busy:inline">
                    {copy.kitAdding}
                  </span>
                  <span class="in-aria-busy:hidden">
                    {copy.kitCart}
                    <span class="spec whitespace-nowrap" data-kit-total>
                      {kitPrice && ` · ${kitPrice}`}
                    </span>
                  </span>
                </button>
              </kit-cart>
              <div
                data-kit-added
                hidden
                class="flex w-full flex-col gap-3 text-sm leading-relaxed text-ink-2"
              >
                <p>{shopPart.addedNotice}</p>
                <a
                  href={PathBuilder.partsCart(locale)}
                  class="btn btn-primary btn-block"
                >
                  {shopPart.addedCta}
                </a>
              </div>
              <a
                href={PathBuilder.partsInquiry(locale)}
                class="btn btn-after-kit w-full sm:w-auto"
                data-add-all
                {...{ [PARTS_INQUIRY_OPEN_ATTRIBUTE]: '' }}
              >
                {copy.kitAdd}
              </a>
            </div>
          </parts-list-add-all>
        )
      }

      <div class="flex flex-col gap-4">
        <h2 class="text-section">{copy.partsHeading}</h2>
        <p
          class="text-sm leading-relaxed text-ink-2"
          data-vin-steering
          data-template={copy.vinSteering}
          data-left={copy.steering.left}
          data-right={copy.steering.right}
          hidden
        >
        </p>
        {
          blocks.length === 0 ? (
            <p class="card p-5 text-sm leading-relaxed text-ink-2 sm:p-6">
              {copy.partsLead}
            </p>
          ) : (
            blocks.map((block) => (
              <section class="card overflow-hidden">
                <CardSectionHead href={block.href}>
                  {block.name}
                </CardSectionHead>
                <AddonNote
                  category={block.groups[0].category}
                  pages={block.groups.flatMap(({ fitments }) =>
                    fitments.flatMap(({ pages }) => pages),
                  )}
                  class="mx-5 mt-4 mb-1 sm:mx-6 lg:max-w-[calc(var(--container-2xl)+5rem)]"
                />
                <ul class="divide-y divide-line">
                  {block.groups.map((group) => (
                    <li
                      class="group flex flex-col gap-3 px-5 py-4 sm:px-6"
                      data-position-group
                      data-ambiguous={group.ambiguous || undefined}
                    >
                      <p class="hidden items-start gap-2 rounded-control bg-shade p-3 text-sm leading-relaxed text-ink-2 group-data-ambiguous:flex">
                        <Icon
                          name="warning"
                          size={16}
                          class="mt-1 shrink-0 text-ink"
                        />
                        <span>
                          <strong class="font-semibold text-ink">
                            {copy.confirmVariantLead}
                          </strong>{' '}
                          {copy.confirmVariant}
                        </span>
                      </p>
                      <ul class="flex flex-col gap-4">
                        {unconditionalFirst(group.fitments).map((fit) => (
                          <li
                            data-fitment
                            data-part-id={fit.part.id}
                            data-steering={fit.steering ?? undefined}
                            data-note={fit.note ?? undefined}
                          >
                            <FittedPart
                              pages={fit.pages}
                              name={translated(fit.part, 'name', locale)}
                              quantity={quantity(fit.quantity)}
                            >
                              <FitLine fit={fit} quantity={false} />
                            </FittedPart>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          )
        }
      </div>

      {
        car.matches.length > 0 && (
          <div class="flex flex-col gap-4">
            <div class="flex flex-col gap-1">
              <h2 class="text-section">{copy.matchesHeading}</h2>
              <p class="max-w-2xl text-sm leading-relaxed text-ink-2">
                {copy.matchesLead}
              </p>
            </div>
            {car.matches.map((match) => (
              <section class="card overflow-hidden">
                <CardSectionHead
                  href={links.modelCategory(model, match.category.slug)}
                >
                  {translated(match.category, 'name', locale)}
                </CardSectionHead>
                <AddonNote
                  category={match.category}
                  pages={match.parts.flatMap(({ pages }) => pages)}
                  class="mx-5 mt-4 mb-1 sm:mx-6 lg:max-w-[calc(var(--container-2xl)+5rem)]"
                />
                <ul class="divide-y divide-line">
                  {match.parts.map(({ part, pages }) => (
                    <li class="px-5 py-4 sm:px-6">
                      <FittedPart
                        pages={pages}
                        name={translated(part, 'name', locale)}
                        quantity={quantity(match.quantity)}
                      />
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        )
      }

      {!empty && <InquiryLink topic={name} />}

      <DisclosureCard>
        <span slot="summary" class="flex flex-col gap-0.5">
          {copy.specsHeading}
          <span class="spec text-sm font-normal text-muted">{specsSummary}</span
          >
        </span>
        <dl class="mt-4 grid gap-x-6 gap-y-3 sm:grid-cols-2">
          {
            specs.map((spec) => (
              <div class="flex flex-col gap-0.5 border-b border-line pb-3">
                <dt class="text-xs text-muted">{spec.label}</dt>
                <dd class="spec text-sm text-ink">{spec.value}</dd>
              </div>
            ))
          }
        </dl>
      </DisclosureCard>

      <p class="text-sm leading-relaxed text-muted" data-not-your-car>
        <a
          href={PathBuilder.parts(locale)}
          class="link-underlined"
          data-forget-vin
        >
          {copy.notYourCar}
        </a>
      </p>
    </div>

    {
      empty && (
        <VinInquiryCard
          id="lead"
          heading={copy.formHeading}
          comment={`${name}: `}
        />
      )
    }
  </car-facts>
</Shell>

<script>
  import { defineCarFacts } from '@/scripts/carFacts';
  import { definePartsListAddAll } from '@/scripts/partsList';
  import { defineKitCart } from '@/scripts/kitCart';

  defineCarFacts();
  definePartsListAddAll();
  defineKitCart();
</script>
