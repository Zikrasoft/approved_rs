---
import { translated } from '@podbor/catalog-contract';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { carName, vehicleVariant } from '@/utils/carName';
import { makeHubsForBuild, type ModelHubEntry } from '@/utils/catalogue';
import { paragraphs } from '@podbor/site-kit';
import { PathBuilder, withLocales } from '@/utils/paths';
import { VIN_INQUIRY_SERVICE } from '@/utils/services';

export async function getStaticPaths() {
  const hubs = await makeHubsForBuild();
  return withLocales(
    hubs.flatMap((hub) =>
      hub.models.map((model) => ({
        params: { make: hub.make.slug, model: model.model.slug },
        props: { hub: model },
      })),
    ),
  );
}

const { hub } = Astro.props as { hub: ModelHubEntry };
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const inquiry = content(locale).pages.partsInquiry;
const copy = content(locale).partsCar.hubs.model;
const { make, model } = hub;
const name = carName(model, locale);
---

<Shell
  title={copy.metaTitle.replace('{model}', name)}
  description={copy.metaDescription.replace('{model}', name)}
>
  <PageHero
    eyebrow={copy.eyebrow}
    heading={name}
    crumbs={[
      { href: PathBuilder.parts(locale), label: site.nav.parts },
      { href: PathBuilder.partsMake(locale, make.slug), label: make.name },
      {
        href: PathBuilder.partsModel(locale, make.slug, model.slug),
        label: name,
      },
    ]}
  />

  <section
    class="wrap grid gap-6 py-band md:py-band-lg lg:grid-cols-[1.2fr_1fr] lg:items-start"
  >
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-3">
        <h2 class="text-section">{copy.categoriesHeading}</h2>
        {
          hub.categories.length > 0 ? (
            <ul class="card divide-y divide-line">
              {hub.categories.map(({ category }) => {
                const [lead] = paragraphs(translated(category, 'text', locale));
                return (
                  <li>
                    <a
                      href={PathBuilder.partsModelCategory(
                        locale,
                        make.slug,
                        model.slug,
                        category.slug,
                      )}
                      class="flex flex-col gap-1 px-5 py-4 transition-colors duration-150 hover:text-signal-ink sm:px-6"
                    >
                      <span class="font-semibold">
                        {translated(category, 'name', locale)}
                      </span>
                      {lead && <span class="text-sm text-muted">{lead}</span>}
                    </a>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="max-w-2xl text-muted">{copy.noCategories}</p>
          )
        }
      </div>

      <div class="flex flex-col gap-3">
        <h2 class="text-section">{copy.carsHeading}</h2>
        <p class="max-w-2xl text-sm text-ink-2">{copy.carsLead}</p>
        <ul class="card divide-y divide-line">
          {
            hub.vehicles.map((vehicle) => (
              <li>
                <a
                  href={PathBuilder.partsCar(locale, vehicle.id)}
                  class="block px-5 py-4 transition-colors duration-150 hover:text-signal-ink sm:px-6"
                >
                  <span class="spec text-sm">
                    {vehicleVariant(vehicle, locale)}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="card flex h-fit flex-col gap-4 p-5 sm:p-6">
      <h2 class="text-block font-semibold">{inquiry.formHeading}</h2>
      <LeadForm
        service={VIN_INQUIRY_SERVICE}
        vin={{ label: inquiry.vinLabel, placeholder: inquiry.vinPlaceholder }}
        comment={`${name}: `}
        commentLabel={inquiry.commentLabel}
        commentPlaceholder={inquiry.commentPlaceholder}
        commentNote={inquiry.commentNote}
        defaultChannel="whatsapp"
      />
    </div>
  </section>
</Shell>
