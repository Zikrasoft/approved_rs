---
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';
import Icon from '@/components/Icon.astro';
import { BCP47_BY_LOCALE, localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { localePaths, PathBuilder } from '@/utils/paths';

export const getStaticPaths = localePaths;

const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const copy = content(locale).shopCart;
const inquiry = content(locale).pages.partsInquiry;
const panel = 'card flex max-w-2xl flex-col gap-3 p-5 sm:p-6';
const notice =
  'card mb-4 flex items-start gap-3 border-l-4 border-l-signal p-4 text-sm leading-relaxed text-ink';
const notices = [
  { key: 'price-changed', text: copy.notices.priceChanged },
  { key: 'unavailable', text: copy.notices.unavailable },
  { key: 'cart-changed', text: copy.notices.cartChanged },
  { key: 'repriced', text: copy.notices.repriced },
  { key: 'stock-limit', text: copy.notices.stockLimit },
  { key: 'unreachable', text: copy.notices.unreachable },
  { key: 'offline', text: copy.notices.offline },
  { key: 'expired', text: copy.notices.expired },
  { key: 'invalid', text: copy.notices.invalid },
];
const stepper =
  'flex size-11 items-center justify-center text-ink-2 transition-colors duration-150 hover:text-ink focus-visible:outline-2 focus-visible:outline-signal disabled:cursor-not-allowed disabled:opacity-40 aria-busy:cursor-progress aria-busy:opacity-60';
---

<Shell title={copy.metaTitle} description={copy.metaDescription} noindex>
  <PageHero
    actions={false}
    eyebrow={site.nav.parts}
    heading={copy.heading}
    compact
    crumbs={[
      { href: PathBuilder.parts(locale), label: site.nav.parts },
      { href: PathBuilder.partsCart(locale), label: copy.heading },
    ]}
  />

  <section class="wrap py-6 md:py-band-lg">
    <offer-cart
      class="block"
      data-locale-tag={BCP47_BY_LOCALE[locale]}
      data-locale={locale}
      data-addon-template={copy.addonTemplate}
      data-unit-template={copy.unitTemplate}
      data-part-href={PathBuilder.partNumber(locale, '{slug}')}
      data-ordered-heading={copy.orderedHeading}
      data-order-template={copy.orderNumberTemplate}
      data-blocked-template={copy.checkoutBlocked}
      data-inquiry-href={PathBuilder.partsInquiry(locale)}
    >
      <p data-state="loading" class="text-sm text-muted" role="status">
        {copy.loading}
      </p>

      <div data-state="empty" hidden class={panel}>
        <h2 class="text-block font-semibold">{copy.emptyHeading}</h2>
        <p
          data-empty-notice="expired"
          hidden
          class="text-sm leading-relaxed text-signal-dark"
        >
          {copy.notices.expired}
        </p>
        <p class="text-sm leading-relaxed text-ink-2">{copy.emptyBody}</p>
        <a
          href={PathBuilder.parts(locale)}
          class="btn btn-primary mt-1 w-full sm:w-auto sm:self-start"
        >
          {copy.emptyCta}
        </a>
      </div>

      <div
        data-state="ordered"
        hidden
        class={`${panel} border-l-4 border-l-signal`}
      >
        <p class="spec text-lg font-semibold text-ink" data-order-number hidden>
        </p>
        <p class="text-sm leading-relaxed text-ink-2">{copy.orderedBody}</p>
        <a
          href={PathBuilder.parts(locale)}
          class="btn btn-primary mt-1 w-full sm:w-auto sm:self-start"
        >
          {copy.orderedCta}
        </a>
      </div>

      <div data-state="fallback" hidden class={panel}>
        <h2 class="text-block font-semibold">{copy.fallbackHeading}</h2>
        <p class="text-sm leading-relaxed text-ink-2">{copy.fallbackBody}</p>
        <div class="mt-1 flex flex-col gap-3 sm:flex-row">
          <button type="button" class="btn btn-primary" data-retry>
            {copy.fallbackRetry}
          </button>
          <button type="button" class="btn btn-secondary" data-send-inquiry>
            {copy.fallbackCta}
          </button>
        </div>
      </div>

      <div
        data-state="cart"
        hidden
        class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-start"
      >
        <div class="flex flex-col">
          <div aria-live="polite">
            {
              notices.map(({ key, text }) => (
                <p data-notice={key} hidden class={notice}>
                  <Icon
                    name="warning"
                    size={16}
                    class="mt-0.5 shrink-0 text-signal-ink"
                  />
                  <span>{text}</span>
                </p>
              ))
            }
            <p data-notice="moved" hidden class={notice}>
              <Icon
                name="warning"
                size={16}
                class="mt-0.5 shrink-0 text-signal-ink"
              />
              <span>
                {copy.notices.moved}{' '}
                <a
                  href={PathBuilder.partsInquiry(locale)}
                  class="font-semibold text-signal-ink underline underline-offset-2"
                >
                  {copy.notices.movedCta}
                </a>
              </span>
            </p>
          </div>

          <ul class="card divide-y divide-line" data-lines></ul>
          <template data-line>
            <li class="group flex flex-col gap-3 py-4 pr-3 pl-5 sm:pl-6">
              <div class="flex items-start gap-3">
                <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <a
                    class="leading-snug font-semibold text-ink underline-offset-2 hover:text-signal-ink hover:underline"
                    data-part-link></a>
                  <span class="spec text-sm text-muted" data-number></span>
                </div>
                <button
                  type="button"
                  class="-my-2 flex size-11 shrink-0 items-center justify-center text-ink-2 transition-colors duration-150 hover:text-signal-ink focus-visible:outline-2 focus-visible:outline-signal aria-busy:opacity-40"
                  aria-label={copy.removeLabel}
                  data-remove
                >
                  <Icon name="close" size={16} />
                </button>
              </div>
              <p
                class="flex items-start gap-2 text-sm leading-relaxed text-signal-dark"
                data-unavailable
                hidden
              >
                <Icon name="warning" size={16} class="mt-0.5 shrink-0" />
                <span>{copy.unavailableTag}</span>
              </p>
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div
                  class="flex items-center rounded-control border border-line-field"
                >
                  <button
                    type="button"
                    class={stepper}
                    aria-label={copy.decreaseLabel}
                    data-decrease
                  >
                    <Icon name="minus" />
                  </button>
                  <span
                    class="spec min-w-8 text-center text-sm font-semibold text-ink"
                    data-quantity></span>
                  <button
                    type="button"
                    class={stepper}
                    aria-label={copy.increaseLabel}
                    data-increase
                  >
                    <Icon name="plus" />
                  </button>
                </div>
                <div class="flex flex-col items-end text-right">
                  <span
                    class="spec font-semibold text-ink transition-opacity group-aria-busy:opacity-40"
                    data-price></span>
                  <span class="text-xs text-muted" data-unit></span>
                </div>
              </div>
              <label
                class="flex cursor-pointer items-start gap-3 rounded-field border border-line bg-shade px-3 py-2.5 text-sm leading-snug text-ink has-checked:border-signal has-disabled:cursor-progress has-disabled:opacity-60"
                data-addon
                hidden
              >
                <input
                  type="checkbox"
                  class="mt-0.5 size-4 shrink-0 accent-signal-ink"
                  data-addon-toggle
                />
                <span data-addon-label></span>
              </label>
              <button
                type="button"
                class="btn btn-secondary w-full sm:w-auto sm:self-start"
                data-to-inquiry
                hidden
              >
                {copy.toInquiryLabel}
              </button>
            </li>
          </template>

          <div
            class="mt-4 flex items-baseline justify-between gap-4 border-t-2 border-ink pt-4"
          >
            <span class="text-block font-semibold">{copy.totalLabel}</span>
            <span class="spec text-2xl font-semibold text-ink" data-total
            ></span>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-muted">
            {copy.pickupNotice}
          </p>
        </div>

        <div class="card flex flex-col gap-4 p-5 sm:p-6">
          <div class="flex flex-col gap-1">
            <h2 class="text-block font-semibold">{copy.checkoutHeading}</h2>
            <p class="text-sm leading-relaxed text-ink-2">
              {copy.checkoutLead}
            </p>
          </div>
          <p
            class="border-l-4 border-l-signal pl-3 text-sm leading-relaxed text-signal-dark"
            data-blocked
            hidden
          >
          </p>
          <LeadForm
            action="/api/order"
            vin={{
              label: inquiry.vinLabel,
              placeholder: inquiry.vinPlaceholder,
            }}
            commentLabel={copy.commentLabel}
            commentPlaceholder={copy.commentPlaceholder}
            submitLabel={copy.submitLabel}
            defaultChannel="whatsapp"
          />
        </div>
      </div>
    </offer-cart>
  </section>
</Shell>

<script>
  import { defineOfferCart } from '@/scripts/offerCart';

  defineOfferCart();
</script>
