---
export const prerender = false;

import Shell from '@/layouts/Shell.astro';
import IndexLink from '@/components/IndexLink.astro';
import ListSearchField from '@/components/ListSearchField.astro';
import ListSearchIndex from '@/components/ListSearchIndex.astro';
import PageHero from '@/components/PageHero.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { loadCataloguePage } from '@/utils/cataloguePage';
import { LONG_LIST } from '@/utils/listing';
import { makesByLetter } from '@/utils/makeIndex';
import { PathBuilder } from '@/utils/paths';

const loaded = await loadCataloguePage(
  Astro,
  async (catalogue, catalogueLocale) =>
    makesByLetter(await catalogue.makesList(catalogueLocale)),
);
if (loaded instanceof Response) return loaded;
const letters = loaded;
const locale = localeFrom(Astro.url.pathname);
const { site, pages } = content(locale);
const hubs = content(locale).partsCar.hubs;
const copy = hubs.makes;
const anchor = (index: number) => `makes-${index}`;
const makes = letters.flatMap(({ makes: own }) => own);
const searchable = makes.length > LONG_LIST;
---

<Shell title={copy.metaTitle} description={copy.metaDescription}>
  <PageHero
    actions={false}
    eyebrow={hubs.make.eyebrow}
    heading={copy.heading}
    lead={copy.lead}
    crumbs={[
      { href: PathBuilder.parts(locale), label: site.nav.parts },
      { href: PathBuilder.partsMakes(locale), label: copy.heading },
    ]}
  />

  <list-search class="wrap flex flex-col gap-8 py-band md:py-band-lg">
    {
      searchable && (
        <>
          <ListSearchField
            label={pages.cars.searchLabel}
            placeholder={pages.cars.searchPlaceholder}
          />
          <ul
            data-search-results
            hidden
            class="-mt-4 grid gap-2 sm:grid-cols-2 sm:gap-3 lg:grid-cols-3"
          />
          <template data-search-template>
            <li>
              <IndexLink />
            </li>
          </template>
          <ListSearchIndex
            entries={makes.map((make) => ({
              name: make.name,
              href: PathBuilder.partsMake(locale, make.slug),
            }))}
          />
          <p
            data-search-empty
            hidden
            class="-mt-4 card p-6 text-base text-muted"
          >
            {pages.cars.noMatch}
          </p>
          <p data-search-status aria-live="polite" class="sr-only" />
        </>
      )
    }

    {
      letters.length > 1 && (
        <nav data-search-idle aria-label={copy.lettersLabel}>
          <ul class="flex flex-wrap gap-1">
            {letters.map(({ letter }, index) => (
              <li>
                <a
                  href={`#${anchor(index)}`}
                  class="spec flex h-11 min-w-11 items-center justify-center rounded-control px-2 text-base text-ink transition-colors duration-150 hover:bg-shade hover:text-signal-ink"
                >
                  {letter}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      letters.map(({ letter, makes }, index) => (
        <section
          data-search-idle
          id={anchor(index)}
          class="flex scroll-mt-24 flex-col gap-3 border-t border-line pt-4"
        >
          <h2 class="text-section">{letter}</h2>
          <ul class="columns-2 gap-x-6 sm:columns-3 lg:columns-4">
            {makes.map((make) => (
              <li class="break-inside-avoid">
                <a
                  href={PathBuilder.partsMake(locale, make.slug)}
                  class="flex min-h-11 items-center py-2 text-base leading-snug wrap-anywhere text-ink link-quiet pointer-fine:min-h-9 pointer-fine:py-1.5"
                >
                  {make.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </list-search>
</Shell>

<script>
  import { defineListSearch } from '@podbor/site-kit/list-search';

  defineListSearch();
</script>
