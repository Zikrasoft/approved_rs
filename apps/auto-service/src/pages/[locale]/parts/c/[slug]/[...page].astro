---
export const prerender = false;

import { localizedUnit } from '@podbor/catalog-contract';
import { withPlaceholder } from '@podbor/i18n';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import VinInquiryCard from '@/components/VinInquiryCard.astro';
import ListingPager from '@/components/ListingPager.astro';
import InquiryLink from '@/components/InquiryLink.astro';
import PartRow from '@/components/PartRow.astro';
import FacetFilters from '@/components/FacetFilters.astro';
import CarPicker from '@/components/CarPicker.astro';
import ListingBar from '@/components/ListingBar.astro';
import ListingSort from '@/components/ListingSort.astro';
import PopularParts from '@/components/PopularParts.astro';
import CatalogueSearch from '@/components/CatalogueSearch.astro';
import { popularListingHref } from '@/utils/searchPage';
import { BCP47_BY_LOCALE, localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { loadCataloguePage } from '@/utils/cataloguePage';
import { keySpecs } from '@/utils/attributeRows';
import { paragraphs } from '@podbor/site-kit';
import { PARTS_INQUIRY_ANCHOR, PathBuilder } from '@/utils/paths';
import { partThumbnail } from '@/utils/partImages';
import { partSuccessor } from '@/utils/partSuccessor';
import { rangeText, withFacetCopy } from '@/utils/partsSearch';
import {
  LONG_LIST,
  listingHeading,
  neighbours,
  requestedListingPage,
} from '@/utils/listing';

const { slug = '', page: pageParam } = Astro.params;
const requested = requestedListingPage(pageParam);
const loaded = await loadCataloguePage(Astro, (catalogue, catalogueLocale) =>
  requested
    ? catalogue.categoryPage(slug, requested, catalogueLocale)
    : Promise.resolve(null),
);
if (loaded instanceof Response) return loaded;
const {
  category,
  page: number,
  pages: pageCount,
  count,
  entries,
  popular,
  facets: wireFacets,
  ranges,
  uniform,
  demanded,
  cars,
} = loaded;
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const inquiry = content(locale).pages.partsInquiry;
const copy = inquiry.category;
const name = category.name;
const [lead, ...body] = paragraphs(category.text);
const empty = count === 0;
const firstPage = number === 1;
const listing = { number, count: pageCount };
const pageHref = (target: number) =>
  PathBuilder.partsCategory(locale, category.slug, target);
const { prev, next } = neighbours(listing, pageHref);
const pageTitle = listingHeading(number, {
  heading: name,
  pageName: withPlaceholder(copy.pageName, 'name', name),
});
const bySlug = new Map(entries.map((page) => [page.slug, page]));
const searchCopy = content(locale).partsSearch;
const facets = withFacetCopy(wireFacets, searchCopy);
const filtered = !empty && facets.length > 0;
const fields = category.fields
  .map((field) => {
    const range = ranges.find(({ key }) => key === field.key);
    return {
      key: field.key,
      label: [field.label, localizedUnit(field.unit, locale)]
        .filter(Boolean)
        .join(', '),
      values:
        field.type === 'number'
          ? range
            ? rangeText(
                { min: range.min, max: range.max },
                null,
                searchCopy,
                (value) => value.toLocaleString(BCP47_BY_LOCALE[locale]),
              )
            : ''
          : field.options.map((option) => option.label).join(', '),
    };
  })
  .filter(({ values }) => values);
---

<Shell
  title={withPlaceholder(copy.metaTitleTemplate, 'name', pageTitle)}
  description={lead ?? inquiry.metaDescription}
>
  {prev && <link slot="head" rel="prev" href={prev} />}
  {next && <link slot="head" rel="next" href={next} />}
  <PageHero
    actions={false}
    compact
    desktopLead
    eyebrow={copy.eyebrow}
    heading={pageTitle}
    lead={firstPage ? lead : undefined}
    crumbs={[
      { href: PathBuilder.parts(locale), label: site.nav.parts },
      { href: pageHref(1), label: name },
    ]}
  />

  <section
    class:list={[
      'wrap grid gap-6 pt-6 md:pt-band-lg lg:items-start',
      empty
        ? 'pb-6 md:pb-10 lg:grid-cols-[1.2fr_1fr]'
        : 'pb-band md:pb-band-lg',
      filtered &&
        'max-lg:gap-y-0 lg:grid-cols-[17rem_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:gap-10',
    ]}
  >
    {
      !empty && cars.length > 0 && (
        <CarPicker
          category={category.slug}
          cars={cars}
          class={filtered ? 'max-lg:mb-4 lg:col-start-2' : undefined}
        />
      )
    }

    {
      filtered && (
        <FacetFilters
          action={PathBuilder.partsSearch(locale)}
          hidden={{ category: category.slug }}
          facets={facets}
          count={count}
          class="lg:col-start-1 lg:row-span-2 lg:row-start-1"
        />
      )
    }

    <div
      class:list={[
        'flex min-w-0 flex-col gap-10',
        filtered && 'lg:col-start-2',
      ]}
    >
      {firstPage && <PopularParts pages={popular} />}

      {
        !empty && (
          <div class="flex flex-col gap-3">
            <h2 class="text-section max-sm:sr-only">{copy.partsHeading}</h2>
            {count > LONG_LIST && (
              <CatalogueSearch
                category={category.slug}
                secondary
                class="max-w-xl"
              />
            )}
            <ListingBar count={count} filters={filtered} />
            {demanded && (
              <ListingSort
                current={null}
                hrefs={{
                  default: pageHref(number),
                  popular: popularListingHref(locale, {
                    category: category.slug,
                  }),
                }}
              />
            )}
            <ul class="card divide-y divide-line">
              {entries.map((page) => (
                <PartRow
                  thumb={partThumbnail(page, category)}
                  slug={page.slug}
                  brand={page.brand.name}
                  value={page.value}
                  name={page.part.name}
                  specs={keySpecs(
                    category,
                    page.part.attributes,
                    locale,
                    [],
                    uniform,
                  )}
                  superseded={page.superseded}
                  current={partSuccessor(page, bySlug)}
                  priced={page}
                  demand={page.demand}
                />
              ))}
            </ul>
            <ListingPager
              label={copy.pagination}
              listing={listing}
              href={pageHref}
            />
            <InquiryLink topic={name} />
          </div>
        )
      }

      {
        firstPage && (lead || body.length > 0 || empty) && (
          <div class="flex max-w-2xl flex-col gap-4 text-base leading-relaxed text-ink-2">
            {lead && <p class="sm:hidden">{lead}</p>}
            {body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {empty && <p>{copy.noParts}</p>}
          </div>
        )
      }

      {
        firstPage && fields.length > 0 && (
          <div class="flex flex-col gap-3">
            <h2 class="text-section">{copy.fieldsHeading}</h2>
            <dl class="card divide-y divide-line">
              {fields.map((field) => (
                <div class="flex flex-col gap-1 px-5 py-4 sm:px-6">
                  <dt class="font-semibold text-ink">{field.label}</dt>
                  <dd class="spec text-sm text-muted">{field.values}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
    </div>

    {
      empty && (
        <VinInquiryCard
          id={PARTS_INQUIRY_ANCHOR}
          class="h-fit scroll-mt-24"
          comment={`${name}: `}
        />
      )
    }
  </section>
</Shell>
