---
import { contactCta } from '@podbor/site-kit/contact-control';
export const prerender = false;

import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import VinInquiryCard from '@/components/VinInquiryCard.astro';
import Icon from '@/components/Icon.astro';
import CatalogueSearch from '@/components/CatalogueSearch.astro';
import CatalogueListing from '@/components/CatalogueListing.astro';
import { BCP47_BY_LOCALE, localeFrom } from '@/i18n/config';
import { catalogueFor, shopOpen } from '@/utils/catalogueEnv';
import { loadPartsHub } from '@/utils/partsHub';
import { inquiryTopic } from '@/utils/catalogueSearch';
import { chosenFilters, withFacetCopy } from '@/utils/partsSearch';
import { planSearch } from '@/utils/searchPage';
import {
  PARTS_BROWSE_ANCHOR,
  PARTS_INQUIRY_ANCHOR,
  PathBuilder,
} from '@/utils/paths';
import { content } from '@/i18n/content';

const locale = localeFrom(Astro.url.pathname);
const params = Astro.url.searchParams;
if (['q', 'category', 'make', 'model'].some((name) => params.has(name))) {
  return Astro.redirect(
    `${PathBuilder.partsSearch(locale)}${Astro.url.search}`,
    302,
  );
}
const catalogue = catalogueFor(Astro.request);
const plan = await planSearch({
  params,
  locale,
  catalogue,
  path: PathBuilder.parts(locale),
  anchor: PARTS_BROWSE_ANCHOR,
});
if ('redirect' in plan) {
  return Astro.redirect(plan.redirect, plan.status);
}
const { view } = plan;
const { found, chosen, ranges, offset, sort } = view;
const hub = await loadPartsHub(Astro, catalogue, Boolean(found));
const pages = content(locale).pages;
const site = content(locale).site;
const copy = pages.partsInquiry;
const hubsCopy = content(locale).partsCar.hubs;
const searchCopy = content(locale).partsSearch;
const { makes } = hub;
const categories = hub.categories.map((category) => ({
  slug: category.slug,
  empty: category.empty,
  name: category.name[locale],
  lead: category.lead[locale],
}));
const facets = withFacetCopy(view.sheetFacets, searchCopy);
const chips = chosenFilters(facets, chosen, ranges, searchCopy, (value) =>
  value.toLocaleString(BCP47_BY_LOCALE[locale]),
);
const browsed = Boolean(
  found && (found.results.length > 0 || chips.length > 0),
);
const narrowed = chosen.length > 0 || ranges.length > 0 || offset > 0 || sort;
const action = `${PathBuilder.parts(locale)}#${PARTS_BROWSE_ANCHOR}`;
---

<Shell
  title={copy.metaTitle}
  description={copy.metaDescription}
  noindex={Boolean(narrowed)}
>
  <PageHero
    actions={false}
    desktopLead
    heading={copy.heading}
    lead={copy.lead}
    crumbs={[{ href: PathBuilder.parts(locale), label: site.nav.parts }]}
  >
    <div class="max-w-3xl pt-2" {...contactCta}>
      <CatalogueSearch large hint={false} />
    </div>
    <p class="max-w-2xl text-sm leading-relaxed text-muted">
      {copy.sourcingNote}
    </p>
  </PageHero>

  {
    found && browsed && (
      <parts-browse
        id={PARTS_BROWSE_ANCHOR}
        class="wrap flex scroll-mt-16 flex-col gap-4 pt-8 md:pt-10"
      >
        <h2 tabindex="-1" class="scroll-mt-24 text-section outline-none">
          {searchCopy.allHeading}
        </h2>
        <p class="sr-only" aria-live="polite" />
        <CatalogueListing
          view={view}
          found={found}
          action={action}
          hidden={sort ? { sort } : {}}
          facets={facets}
          chips={chips}
          emptyMessage={
            chips.length > 0
              ? searchCopy.noFilteredResults
              : copy.category.noParts
          }
          inquiryTopic={inquiryTopic({
            filters: found.count === 0 ? chips.map(({ label }) => label) : [],
          })}
        />
      </parts-browse>
    )
  }

  <section
    class="wrap flex flex-col gap-12 pt-12 pb-band md:gap-16 md:pt-16 md:pb-band-lg"
  >
    <cart-badge
      class="self-start"
      hidden
      data-reveal-when-filled
      {...shopOpen() ? {} : { 'data-preview-only': '' }}
    >
      <a
        href={PathBuilder.partsCart(locale)}
        class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-ink link-quiet"
      >
        {content(locale).shopCart.cartLink}
        <Icon name="chevronRight" />
      </a>
    </cart-badge>

    {
      makes.length > 0 && (
        <div class="flex flex-col gap-3">
          <h2 class="text-section">{hubsCopy.indexHeading}</h2>
          <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
            {makes.map((make) => (
              <li>
                <a
                  href={PathBuilder.partsMake(locale, make.slug)}
                  class="card flex h-full min-h-14 items-center justify-between gap-2 p-4 text-lg leading-tight font-semibold wrap-anywhere text-ink transition-colors duration-150 hover:border-ink sm:p-5"
                >
                  {make.name}
                  <Icon name="chevronRight" class="shrink-0 text-muted" />
                </a>
              </li>
            ))}
          </ul>
          <a
            href={PathBuilder.partsMakes(locale)}
            class="inline-flex min-h-11 items-center gap-2 self-start text-sm font-semibold text-ink link-quiet"
          >
            {hubsCopy.allMakesLink}
            <Icon name="chevronRight" />
          </a>
        </div>
      )
    }

    {
      categories.length > 0 && (
        <div class="flex flex-col gap-3">
          <div class="flex flex-col gap-1">
            <h2 class="text-section">{copy.categoriesHeading}</h2>
            <p class="max-w-2xl text-sm leading-relaxed text-muted">
              {copy.categoriesLead}
            </p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {categories.map((category) => (
              <a
                href={`${PathBuilder.partsCategory(locale, category.slug)}${category.empty ? `#${PARTS_INQUIRY_ANCHOR}` : ''}`}
                class="card group flex flex-col gap-2 p-5 transition-colors duration-150 hover:border-ink"
              >
                <h3 class="font-semibold text-ink">{category.name}</h3>
                {category.lead && (
                  <p class="text-sm leading-relaxed text-ink-2">
                    {category.lead}
                  </p>
                )}
                <span class="mt-auto inline-flex items-center gap-2 pt-2 text-sm font-semibold text-ink group-hover:text-signal-ink">
                  {category.empty ? copy.categoryOrderCta : copy.categoryCta}
                  <Icon name="chevronRight" />
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <div class="grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:items-start">
      <div class="card flex flex-col gap-3 p-5">
        <h2 class="text-block font-semibold">{copy.stepsHeading}</h2>
        <ol class="flex flex-col gap-4">
          {
            copy.steps.map((step, i) => (
              <li class="flex gap-3">
                <span class="spec mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-pill bg-shade text-xs">
                  {i + 1}
                </span>
                <div class="flex flex-col gap-0.5">
                  <span class="text-sm font-semibold text-ink">
                    {step.heading}
                  </span>
                  <span class="text-sm leading-relaxed text-ink-2">
                    {step.body}
                  </span>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <VinInquiryCard id={PARTS_INQUIRY_ANCHOR} class="scroll-mt-24" list />
    </div>
  </section>
</Shell>

<script>
  import { definePartsBrowse } from '@/scripts/partsBrowse';

  definePartsBrowse();
</script>
