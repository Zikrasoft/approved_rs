---
import { translated, type Category } from '@podbor/catalog-contract';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';
import Icon from '@/components/Icon.astro';
import PartsSearchForm from '@/components/PartsSearchForm.astro';
import VinLookupForm from '@/components/VinLookupForm.astro';
import { localeFrom } from '@/i18n/config';
import { categoriesForBuild, makeHubsForBuild } from '@/utils/catalogue';
import { paragraphs } from '@podbor/site-kit';
import { localePaths, PARTS_INQUIRY_ANCHOR, PathBuilder } from '@/utils/paths';
import { VIN_INQUIRY_SERVICE } from '@/utils/services';
import { content } from '@/i18n/content';

export async function getStaticPaths() {
  const categories = await categoriesForBuild();
  const makes = (await makeHubsForBuild()).map(({ make }) => make);
  return localePaths().map((path) => ({
    ...path,
    props: { categories, makes },
  }));
}

const locale = localeFrom(Astro.url.pathname);
const pages = content(locale).pages;
const site = content(locale).site;
const copy = pages.partsInquiry;
const vinCopy = content(locale).partsCar.vin;
const props = Astro.props as {
  categories: Category[];
  makes: { slug: string; name: string }[];
};
const hubsCopy = content(locale).partsCar.hubs;
const categories = props.categories.map((category) => ({
  slug: category.slug,
  name: translated(category, 'name', locale),
  lead: paragraphs(translated(category, 'text', locale))[0],
}));
---

<Shell title={copy.metaTitle} description={copy.metaDescription}>
  <PageHero
    eyebrow={copy.eyebrow}
    heading={copy.heading}
    lead={copy.lead}
    crumbs={[{ href: PathBuilder.parts(locale), label: site.nav.parts }]}
  />

  <section class="wrap flex flex-col gap-6 py-band md:py-band-lg">
    <div class="card p-5 sm:p-6">
      <PartsSearchForm />
    </div>

    <VinLookupForm />

    <p class="max-w-2xl text-base leading-relaxed text-ink-2">
      {copy.sourcingNote}
    </p>

    <a
      href={PathBuilder.partsCart(locale)}
      class="inline-flex min-h-11 items-center gap-2 self-start text-sm font-semibold text-signal-ink underline-offset-2 hover:underline"
    >
      {content(locale).shopCart.cartLink}
      <Icon name="arrowRight" />
    </a>

    {
      categories.length > 0 && (
        <div class="flex flex-col gap-3">
          <div class="flex flex-col gap-1">
            <h2 class="text-section">{copy.categoriesHeading}</h2>
            <p class="max-w-2xl text-sm leading-relaxed text-muted">
              {copy.categoriesLead}
            </p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {categories.map((category) => (
              <a
                href={PathBuilder.partsCategory(locale, category.slug)}
                class="card group flex flex-col gap-2 p-5 transition-colors duration-150 hover:border-ink"
              >
                <h3 class="text-base font-semibold text-ink">
                  {category.name}
                </h3>
                {category.lead && (
                  <p class="text-sm leading-relaxed text-ink-2">
                    {category.lead}
                  </p>
                )}
                <span class="spec mt-auto pt-2 text-xs text-signal-ink">
                  {copy.categoryCta} →
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    {
      props.makes.length > 0 && (
        <div class="flex flex-col gap-3">
          <h2 class="text-section">{hubsCopy.indexHeading}</h2>
          <ul class="flex flex-wrap gap-3">
            {props.makes.map((make) => (
              <li>
                <a
                  href={PathBuilder.partsMake(locale, make.slug)}
                  class="btn btn-secondary"
                >
                  {make.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:items-start">
      <div class="card flex flex-col gap-3 p-5">
        <h2 class="text-base font-semibold text-ink">{copy.stepsHeading}</h2>
        <ol class="flex flex-col gap-4">
          {
            copy.steps.map((step, i) => (
              <li class="flex gap-3">
                <span class="spec mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-shade text-xs">
                  {i + 1}
                </span>
                <div class="flex flex-col gap-0.5">
                  <span class="text-sm font-semibold text-ink">
                    {step.heading}
                  </span>
                  <span class="text-sm leading-relaxed text-ink-2">
                    {step.body}
                  </span>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div
        id={PARTS_INQUIRY_ANCHOR}
        class="card flex scroll-mt-24 flex-col gap-4 p-5 sm:p-6"
      >
        <p
          id="vin-unresolved"
          role="status"
          class="hidden scroll-mt-24 rounded-md bg-shade p-4 text-sm leading-relaxed text-ink target:block"
        >
          {vinCopy.unresolved}
        </p>
        <h2 class="text-block font-semibold">{copy.formHeading}</h2>
        <parts-inquiry
          class="flex flex-col gap-4"
          data-more-template={copy.listMoreTemplate}
          data-part-href={PathBuilder.partNumber(locale, '{slug}')}
        >
          <div
            class="rounded-field border border-line bg-shade px-4 pt-3 pb-1"
            data-parts-list-block
            hidden
          >
            <p class="field-label">{copy.listHeading}</p>
            <ul class="divide-y divide-line" data-parts-list></ul>
            <template data-parts-item>
              <li class="flex items-center justify-between gap-2">
                <a
                  class="py-2 text-sm leading-snug text-ink underline-offset-2 hover:text-signal-ink hover:underline"
                  data-part-link></a>
                <button
                  type="button"
                  class="-mr-2 flex size-11 shrink-0 items-center justify-center text-muted transition-colors duration-150 hover:text-signal-ink focus-visible:outline-2 focus-visible:outline-signal"
                  aria-label={copy.listRemoveLabel}
                  data-part-remove
                >
                  <Icon name="close" size={12} />
                </button>
              </li>
            </template>
          </div>
          <LeadForm
            service={VIN_INQUIRY_SERVICE}
            vin={{ label: copy.vinLabel, placeholder: copy.vinPlaceholder }}
            commentLabel={copy.commentLabel}
            commentPlaceholder={copy.commentPlaceholder}
            commentNote={copy.commentNote}
            defaultChannel="whatsapp"
          />
        </parts-inquiry>
      </div>
    </div>
  </section>
</Shell>

<script>
  import { definePartsInquiry } from '@/scripts/partsList';

  definePartsInquiry();
</script>
