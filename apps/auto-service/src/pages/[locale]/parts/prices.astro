---
export const prerender = false;

import { z } from 'zod';
import { CATALOG_KEY_PATTERN } from '@podbor/catalog-contract';
import AddonNote from '@/components/AddonNote.astro';
import FacetFilters from '@/components/FacetFilters.astro';
import PriceTag from '@/components/PriceTag.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { previewRequested } from '@/utils/shopPreview';
import { catalogueIdSchema } from '@/utils/catalogue';
import { catalogueFromEnv, shopOpen, siteEnv } from '@/utils/catalogueEnv';
import { PathBuilder } from '@/utils/paths';
import { withFacetCopy } from '@/utils/partsSearch';

const MAX_IDS = 1000;

const idsSchema = z
  .string()
  .max(5000)
  .transform((ids) => ids.split(',').filter(Boolean))
  .pipe(z.array(catalogueIdSchema).max(100));
const classSchema = z.string().max(300).optional();
const keySchema = z.string().regex(CATALOG_KEY_PATTERN);

const slotSchema = z.discriminatedUnion('kind', [
  z.object({
    kind: z.literal('tag'),
    ids: idsSchema,
    kit: z.literal('1').optional(),
    class: classSchema,
  }),
  z.object({
    kind: z.literal('addon'),
    category: catalogueIdSchema.optional(),
    ids: idsSchema,
    installation: catalogueIdSchema.optional(),
    class: classSchema,
  }),
  z.object({
    kind: z.literal('facets'),
    hidden: z
      .string()
      .max(500)
      .transform((text, context) => {
        try {
          return JSON.parse(text);
        } catch {
          context.addIssue({ code: 'custom', message: 'invalid hidden' });
          return z.NEVER;
        }
      })
      .pipe(
        z.object({ category: keySchema, model: keySchema.optional() }).strict(),
      ),
    count: z.coerce.number().int().nonnegative().optional(),
  }),
]);

const bodySchema = z
  .object({ slots: z.array(slotSchema).min(1).max(500) })
  .refine(
    ({ slots }) =>
      new Set(slots.flatMap((slot) => ('ids' in slot ? slot.ids : []))).size <=
      MAX_IDS,
  );

Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('x-robots-tag', 'noindex');

const locale = localeFrom(Astro.url.pathname);
const preview = previewRequested(Astro.request);
const body =
  Astro.request.method === 'POST'
    ? bodySchema.safeParse(await Astro.request.json().catch(() => null))
    : null;
if (!body?.success) {
  return new Response(null, { status: 400 });
}
const catalogue =
  preview || shopOpen() ? catalogueFromEnv(siteEnv(), { preview }) : null;
if (!catalogue) {
  return new Response(null, { status: 204 });
}

const { slots } = body.data;
const ids = [
  ...new Set(slots.flatMap((slot) => ('ids' in slot ? slot.ids : []))),
];
const loaded = await Promise.all([
  catalogue.offersFor(ids),
  slots.some(({ kind }) => kind === 'addon') ? catalogue.categories() : [],
  Promise.all(
    slots.map((slot) =>
      slot.kind === 'facets'
        ? catalogue.search({
            ...slot.hidden,
            locale,
            facets: [],
          })
        : null,
    ),
  ),
]).catch(() => null);
if (!loaded) {
  return new Response(null, { status: 503 });
}
const [{ offers, installation }, categories, searches] = loaded;
const pages = (pageIds: string[]) =>
  pageIds.map((id) => ({ id, offers: offers[id] ?? [] }));
const searchCopy = content(locale).partsSearch;
---

{
  slots.map((slot, index) => (
    <template data-slot={index}>
      {slot.kind === 'tag' && (
        <PriceTag
          pages={pages(slot.ids)}
          kit={Boolean(slot.kit)}
          class={slot.class}
          live
        />
      )}
      {slot.kind === 'addon' && (
        <AddonNote
          category={categories.find(({ id }) => id === slot.category) ?? null}
          pages={pages(slot.ids)}
          installation={
            slot.installation
              ? {
                  id: slot.installation,
                  price: installation[slot.installation] ?? null,
                }
              : undefined
          }
          class={slot.class}
          live
        />
      )}
      {slot.kind === 'facets' && searches[index] && (
        <FacetFilters
          action={PathBuilder.partsSearch(locale)}
          hidden={slot.hidden}
          facets={withFacetCopy(searches[index].facets, searchCopy)}
          count={slot.count}
          live
        />
      )}
    </template>
  ))
}
