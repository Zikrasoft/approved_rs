---
import { partPageSlug, translated } from '@podbor/catalog-contract';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import FitLine from '@/components/FitLine.astro';
import { carName, vehicleVariant } from '@/utils/carName';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { attributeRows } from '@/utils/attributeRows';
import { partPagesForBuild, type PartPageEntry } from '@/utils/catalogue';
import { paragraphs } from '@/utils/paragraphs';
import { PARTS_INQUIRY_ANCHOR, PathBuilder, withLocales } from '@/utils/paths';

export async function getStaticPaths() {
  const pages = await partPagesForBuild();
  return withLocales(
    pages.map((page) => ({ params: { slug: page.slug }, props: { page } })),
  );
}

const { page } = Astro.props as { page: PartPageEntry };
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const copy = content(locale).shopPart;
const heading = `${page.brand.name} ${page.value}`;
const replacement = page.part.replaced_by;
const category = page.category;
const attributes = category
  ? attributeRows(category, page.part.attributes, locale, {
      yes: copy.attributeYes,
      no: copy.attributeNo,
    })
  : [];
const categoryText = category
  ? paragraphs(translated(category, 'text', locale))
  : [];
---

<Shell
  title={`${heading}, ${page.part.name} - ${copy.metaTitleSuffix}`}
  description={copy.metaDescription}
  noindex={!page.indexable}
>
  <PageHero
    eyebrow={copy.eyebrow}
    heading={heading}
    lead={page.part.name}
    crumbs={[
      { href: PathBuilder.parts(locale), label: site.nav.parts },
      ...(category
        ? [
            {
              href: PathBuilder.partsCategory(locale, category.slug),
              label: translated(category, 'name', locale),
            },
          ]
        : []),
      { href: PathBuilder.partNumber(locale, page.slug), label: heading },
    ]}
  />

  {
    (replacement || page.superseded) && (
      <section class="wrap pt-band md:pt-band-lg">
        <div class="card flex max-w-2xl flex-col gap-3 border-l-4 border-l-signal p-5 sm:p-6">
          {page.superseded && (
            <p class="font-semibold">{copy.supersededNotice}</p>
          )}
          {replacement && (
            <>
              <h2 class="text-block font-semibold">{copy.replacedHeading}</h2>
              <p class="text-sm leading-relaxed text-ink-2">
                {copy.replacedLead}
              </p>
              <a
                href={PathBuilder.partNumber(
                  locale,
                  partPageSlug(
                    replacement.brand_number.brand.slug,
                    replacement.brand_number.normalized_value,
                  ),
                )}
                class="flex flex-wrap items-baseline gap-x-3 font-semibold text-signal-ink hover:text-signal-dark"
              >
                <span>
                  {replacement.brand_number.brand.name}{' '}
                  {replacement.brand_number.value}
                </span>
                <span class="text-sm font-normal text-muted">
                  {replacement.name}
                </span>
              </a>
            </>
          )}
        </div>
      </section>
    )
  }

  {
    page.priceOnRequest && (
      <section class="wrap pt-band md:pt-band-lg">
        <div class="card flex max-w-2xl flex-col gap-3 border-l-4 border-l-signal p-5 sm:p-6">
          <h2 class="text-block font-semibold">{copy.priceOnRequestHeading}</h2>
          <p class="text-sm leading-relaxed text-ink-2">
            {copy.priceOnRequestBody}
          </p>
          <parts-list-add
            class="mt-1 block"
            data-slug={page.slug}
            data-brand={page.brand.name}
            data-number={page.value}
            data-name={page.part.name}
          >
            <a
              href={`${PathBuilder.parts(locale)}#${PARTS_INQUIRY_ANCHOR}`}
              class="btn btn-primary w-full sm:w-auto"
            >
              {copy.priceOnRequestCta}
              <Icon name="arrowRight" />
            </a>
          </parts-list-add>
        </div>
      </section>
    )
  }

  {
    category && (
      <section class="wrap grid gap-6 pt-band md:pt-band-lg lg:grid-cols-[1fr_1.2fr] lg:items-start">
        {attributes.length > 0 && (
          <div class="flex flex-col gap-3">
            <h2 class="text-section">{copy.attributesHeading}</h2>
            <dl class="card divide-y divide-line">
              {attributes.map((row) => (
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 px-5 py-3 sm:px-6">
                  <dt class="text-sm text-muted">{row.label}</dt>
                  <dd class="spec font-semibold text-ink">{row.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
        <div class="flex flex-col gap-3">
          <h2 class="text-section">{translated(category, 'name', locale)}</h2>
          <div class="flex max-w-2xl flex-col gap-3 text-base leading-relaxed text-ink-2">
            {categoryText.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <a
            href={PathBuilder.partsCategory(locale, category.slug)}
            class="text-sm font-semibold text-signal-ink hover:underline"
          >
            {copy.categoryLink}
          </a>
        </div>
      </section>
    )
  }

  {
    page.fits.length > 0 && (
      <section class="wrap pt-band md:pt-band-lg">
        <h2 class="text-section mb-6">
          {content(locale).partsCar.fitment.partFitsHeading}
        </h2>
        <ul class="card divide-y divide-line">
          {page.fits.map((fit) => (
            <li class="px-5 py-4 sm:px-6">
              <FitLine
                fit={fit}
                car={{
                  href: PathBuilder.partsCar(locale, fit.vehicle.id),
                  label: `${carName(fit.vehicle.model, locale)}, ${vehicleVariant(fit.vehicle, locale)}`,
                }}
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="wrap py-band md:py-band-lg">
    <h2 class="text-section mb-6">{copy.equivalentsHeading}</h2>
    {
      page.equivalents.length > 0 ? (
        <ul class="card divide-y divide-line">
          {page.equivalents.map((equivalent) => (
            <li>
              <a
                href={PathBuilder.partNumber(
                  locale,
                  partPageSlug(
                    equivalent.brand.slug,
                    equivalent.normalized_value,
                  ),
                )}
                class="flex flex-wrap items-baseline gap-x-3 px-5 py-4 transition-colors duration-150 hover:text-signal-ink sm:px-6"
              >
                <span class="font-semibold">{equivalent.brand.name}</span>
                <span class="spec text-sm text-muted">{equivalent.value}</span>
                {equivalent.superseded && (
                  <span class="text-sm text-muted">{copy.supersededTag}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="max-w-2xl text-muted">{copy.noEquivalents}</p>
      )
    }
  </section>
</Shell>

<script>
  import { definePartsListAdd } from '@/scripts/partsList';

  definePartsListAdd();
</script>
