---
import { partPageSlug } from '@podbor/catalog-contract';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { partPagesForBuild, type PartPageEntry } from '@/utils/catalogue';
import { PathBuilder, withLocales } from '@/utils/paths';

export async function getStaticPaths() {
  const pages = await partPagesForBuild({
    MEDUSA_BACKEND_URL: import.meta.env.MEDUSA_BACKEND_URL,
    MEDUSA_PUBLISHABLE_KEY: import.meta.env.MEDUSA_PUBLISHABLE_KEY,
  });
  return withLocales(
    pages.map((page) => ({ params: { slug: page.slug }, props: { page } })),
  );
}

const { page } = Astro.props as { page: PartPageEntry };
const locale = localeFrom(Astro.url.pathname);
const site = content(locale).site;
const copy = content(locale).shopPart;
const heading = `${page.brand.name} ${page.value}`;
const replacement = page.part.replaced_by;
---

<Shell
  title={`${heading}, ${page.part.name} - ${copy.metaTitleSuffix}`}
  description={copy.metaDescription}
  noindex={!page.indexable}
>
  <PageHero
    eyebrow={copy.eyebrow}
    heading={heading}
    lead={page.part.name}
    crumbs={[
      { href: PathBuilder.parts(locale), label: site.nav.parts },
      { href: PathBuilder.partNumber(locale, page.slug), label: heading },
    ]}
  />

  {
    (replacement || page.superseded) && (
      <section class="wrap pt-band md:pt-band-lg">
        <div class="card flex max-w-3xl flex-col gap-3 border-l-4 border-l-signal p-6">
          {page.superseded && (
            <p class="font-semibold">{copy.supersededNotice}</p>
          )}
          {replacement && (
            <>
              <h2 class="text-xl font-semibold">{copy.replacedHeading}</h2>
              <p class="text-muted">{copy.replacedLead}</p>
              <a
                href={PathBuilder.partNumber(
                  locale,
                  partPageSlug(
                    replacement.brand_number.brand.slug,
                    replacement.brand_number.normalized_value,
                  ),
                )}
                class="flex flex-wrap items-baseline gap-x-3 font-semibold text-signal-ink hover:text-signal-dark"
              >
                <span>
                  {replacement.brand_number.brand.name}{' '}
                  {replacement.brand_number.value}
                </span>
                <span class="text-sm font-normal text-muted">
                  {replacement.name}
                </span>
              </a>
            </>
          )}
        </div>
      </section>
    )
  }

  <section class="wrap py-band md:py-band-lg">
    <h2 class="text-section mb-6">{copy.equivalentsHeading}</h2>
    {
      page.equivalents.length > 0 ? (
        <ul class="card divide-y divide-line">
          {page.equivalents.map((equivalent) => (
            <li>
              <a
                href={PathBuilder.partNumber(
                  locale,
                  partPageSlug(
                    equivalent.brand.slug,
                    equivalent.normalized_value,
                  ),
                )}
                class="flex flex-wrap items-baseline gap-x-3 px-5 py-4 transition-colors duration-150 hover:text-signal-ink sm:px-6"
              >
                <span class="font-semibold">{equivalent.brand.name}</span>
                <span class="spec text-sm text-muted">{equivalent.value}</span>
                {equivalent.superseded && (
                  <span class="text-sm text-muted">{copy.supersededTag}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="max-w-2xl text-muted">{copy.noEquivalents}</p>
      )
    }
  </section>
</Shell>
