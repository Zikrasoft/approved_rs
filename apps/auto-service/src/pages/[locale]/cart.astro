---
import Shell from '@/layouts/Shell.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import ShopGate from '@/components/ShopGate.astro';
import CheckoutForm from '@/components/CheckoutForm.astro';
import { BCP47_BY_LOCALE } from '@/i18n/config';
import { localeFrom } from '@/i18n/currentLocale';
import { GARAGE_ADDRESS } from '@/utils/constants';
import { localePaths, PathBuilder } from '@/utils/paths';
import { shopBuilt } from '@/utils/shopStatus';
import { content } from '@/i18n/content';

export function getStaticPaths() {
  return shopBuilt() ? localePaths() : [];
}

const locale = localeFrom(Astro.url.pathname);
const shop = content(locale).shop;
const services = Object.fromEntries(
  Object.entries(shop.installations).map(([handle, copy]) => [
    handle,
    copy.name,
  ]),
);
---

<Shell
  title={shop.cart.metaTitle}
  description={shop.cart.metaDescription}
  noindex
>
  <ShopGate>
    <PageHero
      eyebrow={shop.cart.eyebrow}
      heading={shop.cart.heading}
      lead={shop.cart.lead}
      crumbs={[{ href: PathBuilder.cart(locale), label: shop.cart.heading }]}
    />
    <cart-view
      data-locale={locale}
      data-bcp47={BCP47_BY_LOCALE[locale]}
      data-services={JSON.stringify(services)}
      data-errors={JSON.stringify(shop.cart.errors)}
      class="wrap grid gap-8 py-band md:py-band-lg lg:grid-cols-[1.2fr_1fr]"
    >
      <div class="flex flex-col gap-4">
        <ul data-lines class="flex flex-col gap-3"></ul>
        <template data-line>
          <li
            class="card flex flex-wrap items-center justify-between gap-4 p-4"
          >
            <span class="flex min-w-[10rem] flex-1 flex-col gap-1">
              <span data-line-title class="text-base font-semibold text-ink"
              ></span>
              <span data-line-price class="spec text-sm text-muted"></span>
            </span>
            <span class="flex items-center gap-3">
              <label class="flex items-center gap-2">
                <span class="text-xs text-muted">{shop.cart.quantityLabel}</span
                >
                <input
                  type="number"
                  min="0"
                  inputmode="numeric"
                  data-line-quantity
                  class="field spec w-20 py-1.5 text-center"
                />
              </label>
              <button
                type="button"
                data-line-remove
                class="min-h-11 text-xs text-muted underline underline-offset-2 hover:text-signal-ink"
              >
                {shop.cart.removeLabel}
              </button>
            </span>
          </li>
        </template>
        <div data-empty hidden class="card flex flex-col items-start gap-3 p-6">
          <p class="text-base text-muted">{shop.cart.empty}</p>
          <a href={PathBuilder.shop(locale)} class="btn btn-secondary">
            {shop.cart.emptyCta}
            <Icon name="arrowRight" />
          </a>
        </div>
        <div data-summary hidden class="card flex flex-col gap-2 p-5">
          <div class="flex items-center justify-between gap-4">
            <span class="text-base font-semibold text-ink"
              >{shop.cart.totalLabel}</span
            >
            <span data-total class="spec text-2xl font-medium text-ink"></span>
          </div>
          <p class="text-xs text-muted">{shop.cart.totalNote}</p>
        </div>
        <p
          data-cart-error
          hidden
          aria-live="polite"
          class="text-sm text-signal-dark"
        >
        </p>
      </div>
      <div data-checkout hidden class="card flex flex-col gap-4 p-6">
        <h2 class="text-block font-semibold">{shop.cart.checkoutHeading}</h2>
        <div class="flex flex-col gap-1 rounded-field bg-shade p-4">
          <span class="text-sm font-semibold text-ink"
            >{shop.cart.pickupHeading}</span
          >
          <span class="text-sm text-muted"
            >{
              `${GARAGE_ADDRESS.street}, ${GARAGE_ADDRESS.district}, ${GARAGE_ADDRESS.city}`
            }</span
          >
          <span class="text-xs text-muted">{shop.cart.pickupNote}</span>
        </div>
        <CheckoutForm />
      </div>
      <div
        data-placed
        hidden
        class="card flex flex-col items-start gap-3 p-6 lg:col-span-2"
      >
        <h2
          data-placed-heading
          data-template={shop.cart.successHeading}
          class="text-section"
        >
        </h2>
        <p class="text-base leading-relaxed text-muted">
          {shop.cart.successBody}
        </p>
        <a href={PathBuilder.shop(locale)} class="btn btn-secondary">
          {shop.cart.successCta}
          <Icon name="arrowRight" />
        </a>
      </div>
    </cart-view>
  </ShopGate>
</Shell>

<script>
  import { defineCartView } from '@/scripts/shop/cartView';

  defineCartView();
</script>
