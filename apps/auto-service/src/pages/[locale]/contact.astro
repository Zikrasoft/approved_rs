---
import BulletList from '@/components/BulletList.astro';
import Shell from '@/layouts/Shell.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import VisitPanel from '@/components/VisitPanel.astro';
import FinalCta from '@/components/FinalCta.astro';
import ContactChannels from '@/components/ContactChannels.astro';
import { localeFrom } from '@/i18n/config';
import { localePaths, PathBuilder } from '@/utils/paths';
import { content } from '@/i18n/content';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFrom(Astro.url.pathname);
const { pages, site, home } = content(locale);
const cards = [
  { heading: pages.contact.mapHeading, items: [pages.contact.mapNote] },
  { heading: pages.contact.arrivalHeading, items: pages.contact.arrival },
];
---

<Shell
  title={pages.contact.metaTitle}
  description={pages.contact.metaDescription}
  stickyContact={false}
>
  <div class="wrap pt-4 sm:pt-6">
    <Breadcrumbs
      crumbs={[{ href: PathBuilder.contact(locale), label: site.nav.contact }]}
    />
  </div>
  <VisitPanel
    heading={pages.contact.heading}
    as="h1"
    class="pt-3"
    mediaFirst={false}
  >
    <ContactChannels
      slot="channels"
      placement="hero"
      tone="panel"
      only={['telegram', 'whatsapp', 'viber']}
    />
  </VisitPanel>

  <section class="wrap grid gap-4 pt-band md:grid-cols-2 md:pt-band-lg">
    {
      cards.map((card) => (
        <div class="card flex flex-col gap-3 p-5">
          <h2 class="text-block font-semibold">{card.heading}</h2>
          <BulletList items={card.items} />
        </div>
      ))
    }
  </section>

  <FinalCta
    eyebrow={home.finalCta.eyebrow}
    heading={site.form.heading}
    body={site.form.subheading}
  />
</Shell>
