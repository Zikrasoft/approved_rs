---
import BulletList from '@/components/BulletList.astro';
import { mapPlaceUrl } from '@podbor/site-kit';
import { contactCta } from '@podbor/site-kit/contact-control';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';
import ContactChannels from '@/components/ContactChannels.astro';
import MapEmbed from '@/components/MapEmbed.astro';
import { localeFrom } from '@/i18n/config';
import { localePaths, PathBuilder } from '@/utils/paths';
import { GARAGE_ADDRESS } from '@/utils/constants';
import { content } from '@/i18n/content';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFrom(Astro.url.pathname);
const pages = content(locale).pages;
const site = content(locale).site;

const mapLink = mapPlaceUrl(GARAGE_ADDRESS.googleMapsCid);
---

<Shell
  title={pages.contact.metaTitle}
  description={pages.contact.metaDescription}
  stickyContact={false}
>
  <PageHero
    eyebrow={pages.contact.eyebrow}
    heading={pages.contact.heading}
    lead={pages.contact.lead}
    crumbs={[{ href: PathBuilder.contact(locale), label: site.nav.contact }]}
  />

  <section
    class="wrap grid gap-6 py-band md:py-band-lg lg:grid-cols-[1fr_1.1fr]"
  >
    <div class="flex flex-col gap-4">
      <div class="card flex flex-col gap-4 p-5">
        <div class="flex flex-col gap-1">
          <span class="text-xs text-muted">{pages.contact.addressLabel}</span>
          <address class="text-base not-italic leading-relaxed text-ink">
            {GARAGE_ADDRESS.street}<br />{
              `${GARAGE_ADDRESS.district}, ${GARAGE_ADDRESS.city}`
            }
          </address>
        </div>
        <div class="h-px bg-line"></div>
        <div class="flex flex-col gap-1">
          <span class="text-xs text-muted">{pages.contact.hoursLabel}</span>
          <span class="text-base text-ink">{site.footer.hours}</span>
        </div>
      </div>

      <ContactChannels />

      <div class="card flex flex-col gap-3 p-5">
        <h2 class="text-block font-semibold">
          {pages.contact.arrivalHeading}
        </h2>
        <BulletList items={pages.contact.arrival} />
      </div>
    </div>

    <div class="flex flex-col gap-4">
      <div
        id="lead"
        class="card flex scroll-mt-24 flex-col gap-4 p-5"
        {...contactCta}
      >
        <div class="flex flex-col gap-1.5">
          <h2 class="text-block font-semibold">{site.form.heading}</h2>
          <p class="text-sm leading-relaxed text-muted">
            {site.form.subheading}
          </p>
        </div>
        <LeadForm />
      </div>

      <div class="card overflow-hidden">
        <div class="flex flex-col gap-1 p-5">
          <h2 class="text-block font-semibold">
            {pages.contact.mapHeading}
          </h2>
          <p class="text-sm text-muted">{pages.contact.mapNote}</p>
        </div>
        <MapEmbed title={pages.contact.mapHeading} />
        <a
          href={mapLink}
          target="_blank"
          rel="noopener"
          class="block p-5 text-sm text-signal-ink transition-colors duration-150 hover:text-ink"
        >
          {GARAGE_ADDRESS.street}, {GARAGE_ADDRESS.district}, {
            GARAGE_ADDRESS.city
          }
        </a>
      </div>
    </div>
  </section>
</Shell>
