---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import FinalCta from '@/components/FinalCta.astro';
import PromoBanner from '@/components/PromoBanner.astro';
import { localeFrom, BCP47_BY_LOCALE } from '@/i18n/config';
import { PathBuilder, withLocales } from '@/utils/paths';
import {
  localizedWork,
  publishedWorks,
  sourcedParts,
  PARTS_SOURCING,
  workLeadService,
  workPrice,
} from '@/utils/works';
import { partPagesForBuild } from '@/utils/catalogueEnv';
import { formatMoney } from '@/utils/money';
import Icon from '@/components/Icon.astro';
import { safeMarkdown, relatedEntries } from '@podbor/site-kit';
import { workSchema } from '@/utils/schema';
import {
  DEPTH_DOOR_ATTRIBUTE,
  DEPTH_SLUG_ATTRIBUTE,
} from '@podbor/site-kit/browser';
import { content } from '@/i18n/content';

export async function getStaticPaths() {
  const works = publishedWorks(await getCollection('works'));
  const pages = await partPagesForBuild().catch(() => []);
  return withLocales(
    works.map((work) => ({
      params: { slug: work.id },
      props: {
        work,
        related: relatedEntries(works, work),
        parts: sourcedParts(work, pages),
      },
    })),
  );
}

const { work, related, parts } = Astro.props;
const price = workPrice(work);
const locale = localeFrom(Astro.url.pathname);
const pages = content(locale).pages;
const site = content(locale).site;
const services = content(locale).services;
const { title, body, car } = localizedWork(work, locale);

const schema = workSchema(work, title);

const ctaVariantIndex =
  [...work.id].reduce((sum, char) => sum + char.charCodeAt(0), 0) %
  pages.works.detailCtaVariants.length;
const leadService = workLeadService(work);
const ctaVariant =
  leadService === PARTS_SOURCING
    ? pages.works.sourcingCta
    : pages.works.detailCtaVariants[ctaVariantIndex];

const dateLabel = new Intl.DateTimeFormat(BCP47_BY_LOCALE[locale], {
  year: 'numeric',
  month: 'long',
}).format(work.data.date);
---

<Shell
  title={`${title} — ${pages.works.detailMetaSuffix}`}
  description={`${title}. ${pages.works.metaDescription}`}
  jsonLd={[schema]}
>
  <PageHero
    eyebrow={car}
    heading={title}
    crumbs={[
      { href: PathBuilder.works(locale), label: site.nav.works },
      { href: PathBuilder.work(locale, work.id), label: title },
    ]}
  />

  <section class="wrap py-band">
    <p class="spec text-xs text-muted">
      {work.data.year ? `${work.data.year} · ` : ''}{dateLabel}
    </p>
    <Image
      src={work.data.image}
      alt={title}
      widths={[560, 760, 1080, 1440]}
      sizes="(min-width: 1024px) 70vw, calc(100vw - 2.5rem)"
      loading="eager"
      class="card mt-4 aspect-[4/3] w-full object-cover sm:aspect-[16/10]"
    />
  </section>

  <div class="wrap" {...{ [DEPTH_SLUG_ATTRIBUTE]: work.id }}>
    <aside
      {...{ [DEPTH_DOOR_ATTRIBUTE]: '' }}
      class="card hidden data-[revealed=true]:flex mb-8 flex-col gap-5 border-transparent bg-shade p-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8"
    >
      <div>
        <h2 class="text-block font-semibold text-ink">
          {pages.works.doorHeading}
        </h2>
        <p class="mt-1.5 text-base leading-relaxed text-muted">
          {pages.works.doorText}
        </p>
      </div>
      <a
        href="#lead"
        class="btn btn-primary w-full shrink-0 whitespace-nowrap sm:w-fit"
      >
        {pages.works.doorButtonLabel}
        <Icon name="arrowRight" />
      </a>
    </aside>
  </div>

  {
    body.trim() && (
      <section class="wrap pb-8">
        <div class="prose-shop" set:html={safeMarkdown(body)} />
      </section>
    )
  }

  {
    work.data.gallery.length > 0 && (
      <section class="wrap pb-8">
        <ul class="grid gap-4 sm:grid-cols-2">
          {work.data.gallery.map((image, i) => (
            <li>
              <Image
                src={image}
                alt={`${title} — ${i + 1}`}
                widths={[400, 600, 900]}
                sizes="(min-width: 640px) 45vw, calc(100vw - 2.5rem)"
                loading="lazy"
                class="card aspect-[4/3] w-full object-cover"
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    (parts.length > 0 || price !== null) && (
      <section class="wrap pb-8">
        <div class="flex max-w-2xl flex-col gap-3">
          {parts.length > 0 && (
            <>
              <h2 class="text-section">{pages.works.partsHeading}</h2>
              <ul class="card divide-y divide-line">
                {parts.map((part) =>
                  part.slug ? (
                    <li>
                      <a
                        href={PathBuilder.partNumber(locale, part.slug)}
                        class="group flex min-h-11 items-center justify-between gap-3 px-5 py-3 text-ink hover:text-signal-ink sm:px-6"
                      >
                        <span>
                          {part.brand}{' '}
                          <span class="spec font-semibold">{part.number}</span>
                        </span>
                        <Icon
                          name="chevronRight"
                          size={16}
                          class="shrink-0 text-muted group-hover:text-signal-ink"
                        />
                      </a>
                    </li>
                  ) : (
                    <li class="flex min-h-11 items-center px-5 py-3 text-ink sm:px-6">
                      <span>
                        {part.brand}{' '}
                        <span class="spec font-semibold">{part.number}</span>
                      </span>
                    </li>
                  ),
                )}
              </ul>
            </>
          )}
          {price !== null && (
            <p class="flex flex-wrap items-baseline justify-between gap-x-4 text-base">
              <span class="text-muted">{pages.works.priceLabel}</span>
              <span class="spec font-semibold text-ink">
                {formatMoney(price, 'RSD', BCP47_BY_LOCALE[locale])}
              </span>
            </p>
          )}
        </div>
      </section>
    )
  }

  {
    work.data.servicesApplied.length > 0 && (
      <section class="wrap pb-8">
        <p class="spec text-xs text-muted">{site.nav.services}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {work.data.servicesApplied.map((slug) => (
            <li>
              <a
                href={PathBuilder.service(locale, slug)}
                class="btn btn-secondary w-fit"
              >
                {services[slug].name}
                <Icon name="arrowRight" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="wrap pb-12">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <span class="eyebrow">{pages.works.eyebrow}</span>
          <a href={PathBuilder.works(locale)} class="btn btn-secondary w-fit">
            {site.common.allWorks}
            <Icon name="arrowRight" />
          </a>
        </div>
        <WorkGrid works={related} />
      </section>
    )
  }

  <PromoBanner
    label={pages.works.usefulInfoLabel}
    banners={content(locale).promoBanners.works}
  />

  <FinalCta
    eyebrow={pages.works.eyebrow}
    heading={ctaVariant.heading}
    body={ctaVariant.body}
    service={leadService}
  />
  <script>
    import { defineBrowsingDepth } from '@podbor/site-kit/browser';

    defineBrowsingDepth();
  </script>
</Shell>
