---
import { getCollection } from 'astro:content';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import FinalCta from '@/components/FinalCta.astro';
import { localeFrom } from '@/i18n/config';
import { localePaths, PathBuilder, WORKS_MAKE_PARAM } from '@/utils/paths';
import { featuredWorks, sharedMakes } from '@/utils/works';
import { content } from '@/i18n/content';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFrom(Astro.url.pathname);
const pages = content(locale).pages;
const site = content(locale).site;
const works = featuredWorks(await getCollection('works'));
const makes = sharedMakes(works);
const CHIP = 'chip shrink-0 aria-pressed:bg-ink aria-pressed:text-white';
---

<Shell title={pages.works.metaTitle} description={pages.works.lead}>
  <PageHero
    eyebrow={pages.works.eyebrow}
    heading={pages.works.heading}
    lead={pages.works.lead}
    compact
    desktopLead
    crumbs={[{ href: PathBuilder.works(locale), label: site.nav.works }]}
  />

  <section class="wrap pt-6 pb-band md:py-band-lg">
    {
      works.length === 0 ? (
        <p class="card p-6 text-base text-muted">{site.common.emptyWorks}</p>
      ) : (
        <chip-filter class="block" data-param={WORKS_MAKE_PARAM}>
          {makes.length > 0 && (
            <div
              role="group"
              aria-label={pages.works.filterLabel}
              class="-mx-5 mb-6 flex gap-2 overflow-x-auto px-5 [scrollbar-width:none] sm:mx-0 sm:flex-wrap sm:px-0"
            >
              <button
                type="button"
                data-filter-chip
                aria-pressed="true"
                class={CHIP}
              >
                {pages.works.filterAll}
              </button>
              {makes.map((make) => (
                <button
                  type="button"
                  data-filter-chip
                  data-group={make.group}
                  aria-pressed="false"
                  class={CHIP}
                >
                  {make.label}
                </button>
              ))}
            </div>
          )}
          <WorkGrid works={works} eager={3} class="mt-0" />
        </chip-filter>
      )
    }
  </section>

  <FinalCta
    eyebrow={pages.works.eyebrow}
    heading={pages.works.detailCtaHeading}
    body={pages.works.detailCtaBody}
  />
</Shell>

<script>
  import { defineChipFilter } from '@podbor/site-kit/browser';

  defineChipFilter();
</script>
