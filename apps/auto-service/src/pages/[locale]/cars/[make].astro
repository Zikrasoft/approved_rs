---
export const prerender = false;

import { getCollection } from 'astro:content';
import CarMakePage from '@/components/CarMakePage.astro';
import CarsListPage from '@/components/CarsListPage.astro';
import { answerPage, loadCataloguePage } from '@/utils/cataloguePage';
import { CARS_PAGE_NUMBER, carMakePage, carsListingPage } from '@/utils/works';

const segment = Astro.params.make ?? '';
const written = {
  works: await getCollection('works'),
  articles: await getCollection('articles'),
};
const listing = CARS_PAGE_NUMBER.test(segment)
  ? answerPage(Astro, carsListingPage(segment, written))
  : null;
if (listing instanceof Response) return listing;
const make = listing
  ? null
  : await loadCataloguePage(Astro, (catalogue, catalogueLocale) =>
      carMakePage(segment, written, (slug) =>
        catalogue.carMakeParts(slug, catalogueLocale),
      ),
    );
if (make instanceof Response) return make;
---

{
  listing ? (
    <CarsListPage listing={listing.listing} cards={listing.cards} />
  ) : (
    make && <CarMakePage page={make} />
  )
}
