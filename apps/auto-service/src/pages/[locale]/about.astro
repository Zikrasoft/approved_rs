---
import { getCollection } from 'astro:content';
import { DEVELOPER } from '@podbor/brands';
import { aboutPageSchema } from '@podbor/site-kit';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import SplitSection from '@/components/SplitSection.astro';
import BulletList from '@/components/BulletList.astro';
import VisitPanel from '@/components/VisitPanel.astro';
import GarageBay from '@/components/GarageBay.astro';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { PathBuilder, localePaths } from '@/utils/paths';
import { makesOf, publishedWorks } from '@/utils/works';
import { SITE_NAME, SITE_URL } from '@/utils/constants';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFrom(Astro.url.pathname);
const { pages, site } = content(locale);
const about = pages.about;
const makes = makesOf(publishedWorks(await getCollection('works')));

const schema = (canonical: string) =>
  aboutPageSchema({
    name: about.heading,
    url: canonical,
    website: { name: SITE_NAME, url: SITE_URL, creator: DEVELOPER },
  });
const block = 'py-8 first:pt-0 lg:py-10';
---

<Shell
  title={about.metaTitle}
  description={about.metaDescription}
  jsonLd={[schema]}
>
  <PageHero
    eyebrow={site.footer.aboutLabel}
    heading={about.heading}
    lead={about.lead}
    actions={false}
    compact
    crumbs={[
      { href: PathBuilder.about(locale), label: site.footer.aboutLabel },
    ]}
  />

  <div class="wrap divide-y divide-line py-band md:py-band-lg">
    {
      about.team.length > 0 && (
        <SplitSection class={block}>
          <h2 slot="head" class="text-section">
            {about.teamHeading}
          </h2>
          <div class="flex max-w-2xl flex-col gap-3 text-base leading-relaxed text-ink-2">
            {about.team.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </SplitSection>
      )
    }

    <SplitSection class={block}>
      <h2 slot="head" class="text-section">{about.equipmentHeading}</h2>
      <BulletList items={about.equipment} marker="check" />
    </SplitSection>

    {
      makes.length > 0 && (
        <SplitSection class={block}>
          <div slot="head" class="flex flex-col gap-3">
            <h2 class="text-section">{about.makesHeading}</h2>
            <p class="text-base leading-relaxed text-muted">
              {about.makesLead}
            </p>
          </div>
          <div class="flex flex-col gap-5">
            <ul class="flex flex-wrap gap-2">
              {makes.map((make) => (
                <li class="chip">{make}</li>
              ))}
            </ul>
            <p class="flex flex-wrap gap-x-6 gap-y-1">
              <a
                href={PathBuilder.bmw(locale)}
                class="link-underlined inline-flex min-h-11 items-center font-semibold text-ink"
              >
                {pages.bmw.heading}
              </a>
              <a
                href={PathBuilder.works(locale)}
                class="link-underlined inline-flex min-h-11 items-center font-semibold text-ink"
              >
                {site.common.allWorks}
              </a>
            </p>
          </div>
        </SplitSection>
      )
    }

    <SplitSection class={block}>
      <h2 slot="head" class="text-section">{about.ownerHeading}</h2>
      <p class="max-w-2xl text-base leading-relaxed text-ink-2">
        {about.ownerText}{' '}
        <a href={PathBuilder.privacy(locale)} class="link-underlined">
          {site.footer.privacyLabel}
        </a>.
      </p>
    </SplitSection>
  </div>

  <VisitPanel heading={site.visit.heading} class="pb-band md:pb-band-lg">
    <GarageBay slot="media" />
  </VisitPanel>
</Shell>
