---
import { getCollection } from 'astro:content';
import { DEVELOPER } from '@podbor/brands';
import { aboutPageSchema } from '@podbor/site-kit';
import Shell from '@/layouts/Shell.astro';
import { Image } from 'astro:assets';
import PanelHero from '@/components/PanelHero.astro';
import SplitSection from '@/components/SplitSection.astro';
import BulletList from '@/components/BulletList.astro';
import VisitPanel from '@/components/VisitPanel.astro';
import workshopBay from '@/assets/workshop-bay-open-hood.jpg';
import wallSign from '@/assets/workshop-wall-sign.jpg';
import loungeSofas from '@/assets/client-lounge-sofas.jpg';
import loungeCoffee from '@/assets/client-lounge-coffee.jpg';
import { coverScale, coverSizes } from '@/utils/coverSizes';
import { panelPhoto } from '@/utils/panelPhoto';
import { localeFrom } from '@/i18n/config';
import { content } from '@/i18n/content';
import { PathBuilder, localePaths } from '@/utils/paths';
import { makesOf, publishedWorks } from '@/utils/works';
import { SITE_NAME, SITE_URL } from '@/utils/constants';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFrom(Astro.url.pathname);
const { pages, site } = content(locale);
const about = pages.about;
const makes = makesOf(publishedWorks(await getCollection('works')));

const schema = (canonical: string) =>
  aboutPageSchema({
    name: about.heading,
    url: canonical,
    website: { name: SITE_NAME, url: SITE_URL, creator: DEVELOPER },
  });
const block = 'py-8 first:pt-0 lg:py-10';
const signSizes = coverSizes(
  '(min-width: 1224px) 1144px, calc(100vw - 2.5rem)',
  coverScale(wallSign, 3),
);
const lounge = [
  { image: loungeSofas, alt: site.photos.loungeSofas },
  { image: loungeCoffee, alt: site.photos.loungeCoffee },
];
const loungeSizes =
  '(min-width: 1224px) 378px, (min-width: 1024px) calc(50vw - 214px), calc(50vw - 26px)';
const photo = await panelPhoto({
  image: workshopBay,
  alt: site.photos.workshopBay,
});
---

<Shell
  title={about.metaTitle}
  description={about.metaDescription}
  jsonLd={[schema]}
  preloadImage={photo}
>
  <PanelHero
    heading={about.heading}
    hook={about.lead}
    photo={photo}
    crumbs={[
      { href: PathBuilder.about(locale), label: site.footer.aboutLabel },
    ]}
  />

  <div class="wrap divide-y divide-line py-band md:py-band-lg">
    {
      about.team.length > 0 && (
        <SplitSection class={block}>
          <h2 slot="head" class="text-section">
            {about.teamHeading}
          </h2>
          <div class="flex max-w-2xl flex-col gap-3 text-base leading-relaxed text-ink-2">
            {about.team.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </SplitSection>
      )
    }

    <SplitSection class={block}>
      <h2 slot="head" class="text-section">{about.equipmentHeading}</h2>
      <BulletList items={about.equipment} marker="check" />
    </SplitSection>

    <div class={block}>
      <Image
        src={wallSign}
        alt={site.photos.wallSign}
        widths={[640, 960, 1280, 1920, 2400]}
        sizes={signSizes}
        loading="lazy"
        class="block aspect-[2/1] w-full rounded-block object-cover object-right sm:aspect-[3/1] sm:object-center"
      />
    </div>

    {
      makes.length > 0 && (
        <SplitSection class={block}>
          <div slot="head" class="flex flex-col gap-3">
            <h2 class="text-section">{about.makesHeading}</h2>
            <p class="text-base leading-relaxed text-muted">
              {about.makesLead}
            </p>
          </div>
          <div class="flex flex-col gap-5">
            <p class="text-lg leading-relaxed font-semibold text-ink">
              {makes.map((make, index) => (
                <>
                  {index > 0 && ', '}
                  <a
                    href={PathBuilder.carsMake(locale, make.slug)}
                    class="link-underlined"
                  >
                    {make.name}
                  </a>
                </>
              ))}
            </p>
            <p class="flex flex-wrap gap-x-6 gap-y-1">
              <a
                href={PathBuilder.works(locale)}
                class="link-underlined inline-flex min-h-11 items-center font-semibold text-ink"
              >
                {site.common.allWorks}
              </a>
            </p>
          </div>
        </SplitSection>
      )
    }

    <SplitSection class={block}>
      <div slot="head" class="flex flex-col gap-3">
        <h2 class="text-section">{about.loungeHeading}</h2>
        <p class="text-base leading-relaxed text-ink-2">{about.loungeText}</p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        {
          lounge.map(({ image, alt }) => (
            <Image
              src={image}
              alt={alt}
              widths={[320, 480, 720, 960, 1440]}
              sizes={coverSizes(loungeSizes, coverScale(image, 4 / 5))}
              loading="lazy"
              class="block aspect-[4/5] w-full rounded-block object-cover"
            />
          ))
        }
      </div>
    </SplitSection>

    <SplitSection class={block}>
      <h2 slot="head" class="text-section">{about.ownerHeading}</h2>
      <p class="max-w-2xl text-base leading-relaxed text-ink-2">
        {about.ownerText}{' '}
        <a href={PathBuilder.privacy(locale)} class="link-underlined">
          {site.footer.privacyLabel}
        </a>.
      </p>
    </SplitSection>
  </div>

  <VisitPanel heading={site.visit.heading} class="pb-band md:pb-band-lg" />
</Shell>
