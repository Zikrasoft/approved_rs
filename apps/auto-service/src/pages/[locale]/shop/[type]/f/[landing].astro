---
import { withPlaceholder } from '@podbor/i18n';
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import ShopGate from '@/components/ShopGate.astro';
import ShopFilter from '@/components/ShopFilter.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import Icon from '@/components/Icon.astro';
import { localeFrom, PRIMARY_LOCALE } from '@/i18n/config';
import { shopCatalog } from '@/lib/catalog';
import { landingProducts, landingsFor, shopTypes } from '@/lib/shopPages';
import { typeView } from '@/lib/typeView';
import { PathBuilder, withLocales } from '@/utils/paths';
import { shopBuilt, shopIndexed } from '@/utils/shopStatus';
import { content } from '@/i18n/content';

export async function getStaticPaths() {
  if (!shopBuilt()) return [];
  const { products } = await shopCatalog().catalog(PRIMARY_LOCALE);
  return withLocales(
    shopTypes(products).flatMap((type) =>
      landingsFor(products, type).map((landing) => ({
        params: { type: type.key, landing: landing.slug },
        props: { key: landing.key, value: landing.value },
      })),
    ),
  );
}

const { key, value } = Astro.props;
const landingSlug = Astro.params.landing!;
const locale = localeFrom(Astro.url.pathname);
const shop = content(locale).shop;
const site = content(locale).site;
const view = typeView(Astro.params.type!, locale);
const { type, copy } = view;
const label = view.formatValue(key, value);
const fill = (template: string) => withPlaceholder(template, 'value', label);
const { products: all } = await shopCatalog().catalog(locale);
const products = landingProducts(all, type, { key, value });
const heading = fill(copy.landing.heading);
---

<Shell
  title={fill(copy.landing.metaTitle)}
  description={fill(copy.landing.metaDescription)}
  noindex={!shopIndexed()}
>
  <ShopGate>
    <PageHero
      eyebrow={copy.name}
      heading={heading}
      lead={fill(copy.landing.lead)}
      crumbs={[
        { href: PathBuilder.shop(locale), label: site.nav.shop },
        { href: PathBuilder.shopType(locale, type.key), label: copy.name },
        {
          href: PathBuilder.shopLanding(locale, type.key, landingSlug),
          label: heading,
        },
      ]}
    />
    <section class="wrap flex flex-col gap-6 py-band md:py-band-lg">
      <ShopFilter type={type} products={products} omit={key}>
        <ProductGrid products={products} />
      </ShopFilter>
      <a
        href={PathBuilder.shopType(locale, type.key)}
        class="btn btn-secondary w-full sm:w-fit"
      >
        {withPlaceholder(shop.allOfType, 'type', copy.name)}
        <Icon name="arrowRight" />
      </a>
    </section>
  </ShopGate>
</Shell>
