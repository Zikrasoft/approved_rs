---
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import ShopGate from '@/components/ShopGate.astro';
import ShopFilter from '@/components/ShopFilter.astro';
import ShopSearch from '@/components/ShopSearch.astro';
import ProductGrid from '@/components/ProductGrid.astro';
import { localeFrom, PRIMARY_LOCALE } from '@/i18n/config';
import { shopCatalog } from '@/lib/catalog';
import { landingsFor, productsOfType, shopTypes } from '@/lib/shopPages';
import { typeView } from '@/lib/typeView';
import { PathBuilder, withLocales } from '@/utils/paths';
import { shopBuilt, shopIndexed } from '@/utils/shopStatus';
import { content } from '@/i18n/content';

export async function getStaticPaths() {
  if (!shopBuilt()) return [];
  const { products } = await shopCatalog().catalog(PRIMARY_LOCALE);
  return withLocales(
    shopTypes(products).map((type) => ({ params: { type: type.key } })),
  );
}

const locale = localeFrom(Astro.url.pathname);
const shop = content(locale).shop;
const site = content(locale).site;
const view = typeView(Astro.params.type!, locale);
const { type, copy } = view;
const { products: all } = await shopCatalog().catalog(locale);
const products = productsOfType(all, type);
const landings = landingsFor(all, type).map((landing) => ({
  href: PathBuilder.shopLanding(locale, type.key, landing.slug),
  label: view.formatValue(landing.key, landing.value),
}));
---

<Shell
  title={copy.metaTitle}
  description={copy.metaDescription}
  noindex={!shopIndexed()}
>
  <ShopGate>
    <PageHero
      eyebrow={shop.eyebrow}
      heading={copy.heading}
      lead={copy.lead}
      crumbs={[
        { href: PathBuilder.shop(locale), label: site.nav.shop },
        { href: PathBuilder.shopType(locale, type.key), label: copy.name },
      ]}
    />
    <section class="wrap flex flex-col gap-6 py-band md:py-band-lg">
      <ShopSearch />
      {
        landings.length > 0 && (
          <nav aria-label={shop.landingsLabel} class="flex flex-wrap gap-2">
            {landings.map((landing) => (
              <a
                href={landing.href}
                class="spec flex min-h-11 items-center rounded-full border border-line bg-card px-3.5 text-xs text-ink-2 hover:border-ink"
              >
                {landing.label}
              </a>
            ))}
          </nav>
        )
      }
      <ShopFilter type={type} products={products}>
        <ProductGrid products={products} />
      </ShopFilter>
    </section>
  </ShopGate>
</Shell>
