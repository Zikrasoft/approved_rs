---
export const prerender = false;

import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import { localeFrom } from '@/i18n/config';
import { PathBuilder } from '@/utils/paths';
import { content } from '@/i18n/content';
import { fetchShopSearch } from '@/utils/shopPart';

const locale = localeFrom(Astro.url.pathname);
const copy = content(locale).shopSearch;

const q = Astro.url.searchParams.get('q')?.trim() ?? '';

const backendUrl = import.meta.env.MEDUSA_BACKEND_URL;
const publishableKey = import.meta.env.MEDUSA_PUBLISHABLE_KEY;

const part = q
  ? await fetchShopSearch(q, { backendUrl, publishableKey })
  : null;

if (part) {
  return Astro.redirect(PathBuilder.shopPart(locale, part.id));
}
---

<Shell
  title={`${copy.heading} ${copy.metaTitleSuffix}`}
  description={copy.metaDescription}
>
  <PageHero eyebrow={copy.eyebrow} heading={copy.heading} />

  <section class="wrap py-band md:py-band-lg">
    <form method="get" class="flex flex-wrap gap-3">
      <input
        type="text"
        name="q"
        value={q}
        placeholder={copy.placeholder}
        class="input flex-1"
        required
      />
      <button type="submit" class="btn btn-primary">{copy.submitLabel}</button>
    </form>

    {
      q && !part && (
        <div class="card mt-8 p-6">
          <h2 class="text-section mb-2">{copy.notFoundHeading}</h2>
          <p class="mb-4 text-muted">{copy.notFoundBody}</p>
          <a href={PathBuilder.contact(locale)} class="btn btn-primary">
            {copy.notFoundCta}
          </a>
        </div>
      )
    }
  </section>
</Shell>
