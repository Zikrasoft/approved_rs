---
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import ShopGate from '@/components/ShopGate.astro';
import CarPicker from '@/components/CarPicker.astro';
import { BCP47_BY_LOCALE } from '@/i18n/config';
import { localeFrom } from '@/i18n/currentLocale';
import { getShopContent } from '@/i18n/content/shop';
import { getSiteContent } from '@/i18n/content/site';
import { shopCatalog } from '@/lib/catalog';
import { productsOfType, shopTypeKeys } from '@/lib/shopPages';
import { localePaths, PathBuilder } from '@/utils/paths';
import { pluralLabel } from '@/utils/plural';
import { shopBuilt, shopIndexed } from '@/utils/shopStatus';

export function getStaticPaths() {
  return shopBuilt() ? localePaths() : [];
}

const locale = localeFrom(Astro.url.pathname);
const shop = getShopContent(locale);
const site = getSiteContent(locale);
const { products } = await shopCatalog().catalog(locale);
const vehicles = await shopCatalog().vehicles();
const types = shopTypeKeys(products).map((key) => ({
  key,
  copy: shop.types[key],
  count: productsOfType(products, key).length,
}));
---

<Shell
  title={shop.metaTitle}
  description={shop.metaDescription}
  noindex={!shopIndexed()}
>
  <ShopGate>
    <PageHero
      eyebrow={shop.eyebrow}
      heading={shop.heading}
      lead={shop.lead}
      crumbs={[{ href: PathBuilder.shop(locale), label: site.nav.shop }]}
    />
    <section class="wrap flex flex-col gap-8 py-band md:py-band-lg">
      <CarPicker index={vehicles} />
      <div class="flex flex-col gap-4">
        <h2 class="text-section">{shop.typesHeading}</h2>
        <ul class="grid gap-4 sm:grid-cols-2">
          {
            types.map((type) => (
              <li>
                <a
                  href={PathBuilder.shopType(locale, type.key)}
                  class="card flex h-full flex-col gap-2 p-5 transition-colors duration-150 hover:border-ink"
                >
                  <span class="text-block font-semibold text-ink">
                    {type.copy.name}
                  </span>
                  <span class="text-sm leading-relaxed text-muted">
                    {type.copy.lead}
                  </span>
                  <span class="spec mt-auto text-xs text-muted">
                    {pluralLabel(
                      shop.productCount,
                      BCP47_BY_LOCALE[locale],
                      type.count,
                    )}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </ShopGate>
</Shell>
