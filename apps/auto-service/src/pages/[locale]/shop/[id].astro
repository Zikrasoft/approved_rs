---
export const prerender = false;

import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import { localeFrom } from '@/i18n/config';
import { PathBuilder } from '@/utils/paths';
import { content } from '@/i18n/content';
import { fetchShopPart, formatLeadTime } from '@/utils/shopPart';

const { id } = Astro.params;
const locale = localeFrom(Astro.url.pathname);
const copy = content(locale).shopPart;

const backendUrl = import.meta.env.MEDUSA_BACKEND_URL;
const publishableKey = import.meta.env.MEDUSA_PUBLISHABLE_KEY;

const part = id
  ? await fetchShopPart(id, { backendUrl, publishableKey })
  : null;

if (!part) {
  Astro.response.status = 404;
}
---

{
  part ? (
    <Shell
      title={`${part.name} ${copy.metaTitleSuffix}`}
      description={copy.metaDescription}
    >
      <PageHero
        eyebrow={copy.eyebrow}
        heading={part.name}
        crumbs={[
          {
            href: PathBuilder.shopPart(locale, part.id),
            label: part.name,
          },
        ]}
      />

      <section class="wrap py-band md:py-band-lg">
        <h2 class="text-section mb-6">{copy.variantsHeading}</h2>
        <div class="card divide-y divide-line overflow-hidden">
          {part.identifiers.map((identifier, index) => (
            <details open={index === 0} class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 [&::-webkit-details-marker]:hidden sm:px-6">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="font-semibold text-ink">{identifier.brand}</span>
                  <span class="spec text-sm text-muted">
                    {identifier.value}
                  </span>
                </div>
                <span
                  class="shrink-0 text-sm text-muted transition-transform duration-150 group-open:rotate-180"
                  aria-hidden="true"
                >
                  &#9662;
                </span>
              </summary>
              <div class="overflow-x-auto border-t border-line px-5 pb-5 sm:px-6">
                <table class="spec w-full min-w-[32rem] text-left text-sm">
                  <thead>
                    <tr class="text-xs text-muted">
                      <th class="py-2 pr-3 font-medium">
                        {copy.columns.supplier}
                      </th>
                      <th class="py-2 pr-3 font-medium">
                        {copy.columns.supplierArticle}
                      </th>
                      <th class="py-2 pr-3 font-medium">
                        {copy.columns.price}
                      </th>
                      <th class="py-2 pr-3 font-medium">
                        {copy.columns.stock}
                      </th>
                      <th class="py-2 font-medium">{copy.columns.leadTime}</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-line">
                    {identifier.offers.map((offer) => (
                      <tr>
                        <td class="py-2 pr-3 text-ink">{offer.supplier}</td>
                        <td class="py-2 pr-3 text-muted">
                          {offer.supplier_article_id}
                        </td>
                        <td class="py-2 pr-3 font-semibold text-ink">
                          {offer.price.toLocaleString('sr-RS')}{' '}
                          {copy.currencyLabel}
                        </td>
                        <td class="py-2 pr-3 text-ink-2">
                          {offer.stock_quantity}
                        </td>
                        <td class="py-2 text-ink-2">
                          {formatLeadTime(offer.lead_time, copy.leadTime)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          ))}
        </div>
      </section>
    </Shell>
  ) : (
    <Shell
      title={copy.notFoundHeading}
      description={copy.metaDescription}
      noindex
    >
      <PageHero
        eyebrow={copy.eyebrow}
        heading={copy.notFoundHeading}
        lead={copy.notFoundBody}
      />
      <section class="wrap py-band">
        <a href={PathBuilder.contact(locale)} class="btn btn-primary">
          {copy.notFoundCta}
        </a>
      </section>
    </Shell>
  )
}
