---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import heroImage from '@/assets/hero-workshop.jpg';
import Shell from '@/layouts/Shell.astro';
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import ServiceChips from '@/components/ServiceChips.astro';
import PriceTable from '@/components/PriceTable.astro';
import Faq from '@/components/Faq.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import FinalCta from '@/components/FinalCta.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { getHomeContent } from '@/i18n/content/home';
import { getSiteContent } from '@/i18n/content/site';
import { getPagesContent } from '@/i18n/content/pages';
import { publishedWorks } from '@/utils/works';
import { localePaths, PathBuilder } from '@/utils/paths';
import { SHOP_ENABLED } from '@/utils/constants';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFrom(Astro.url.pathname);
const home = getHomeContent(locale);
const site = getSiteContent(locale);
const pages = getPagesContent(locale);
const latestWorks = publishedWorks(await getCollection('works')).slice(0, 3);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: home.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Shell
  title={home.meta.title}
  description={home.meta.description}
  jsonLd={[faqSchema]}
>
  <ServiceChips />

  <section class="wrap">
    <div
      class="grid overflow-hidden rounded-block bg-panel text-white lg:grid-cols-[1.3fr_0.7fr]"
    >
      <div class="flex flex-col gap-5 p-6 sm:p-8 lg:p-12">
        <h1 class="text-hero max-w-[16ch]">{home.hero.heading}</h1>
        <p class="max-w-xl leading-relaxed text-panel-ink sm:text-lg">
          {home.hero.lead}
        </p>
        <div class="flex flex-wrap gap-3 pt-1" data-contact-cta>
          <button type="button" data-open-lead-modal class="btn btn-primary">
            {home.hero.ctaPrimary}
          </button>
          <a href={PathBuilder.services(locale)} class="btn btn-on-panel">
            {home.hero.ctaSecondary}
          </a>
        </div>
        <ul class="flex flex-wrap gap-x-5 gap-y-2 pt-2">
          {
            home.hero.badges.map((badge) => (
              <li class="flex items-center gap-1.5 text-sm text-panel-ink">
                <Icon name="check" size={12} class="text-signal" />
                {badge}
              </li>
            ))
          }
        </ul>
      </div>

      <Image
        src={heroImage}
        alt=""
        widths={[480, 960]}
        sizes="(min-width: 1024px) 35vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[16/10] w-full object-cover lg:aspect-auto lg:h-full"
      />
    </div>

    <ul class="mt-3 grid gap-3 sm:grid-cols-3">
      {
        home.trust.map((item) => (
          <li class="flex flex-col gap-1 rounded-block bg-shade p-5">
            <span class="spec text-2xl font-extrabold tracking-tight text-ink">
              {item.value}
            </span>
            <span class="text-sm leading-snug text-muted">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="services" class="wrap scroll-mt-20 py-band md:py-band-lg">
    <SectionHead
      eyebrow={home.servicesHead.eyebrow}
      heading={home.servicesHead.heading}
      body={home.servicesHead.body}
    />
    <PriceTable />
  </section>

  <section class="bg-shade">
    <div class="wrap py-band md:py-band-lg">
      <SectionHead
        eyebrow={home.why.eyebrow}
        heading={home.why.heading}
        body={home.why.body}
      />
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          home.why.points.map((point) => (
            <li class="flex gap-3">
              <Icon name="check" size={16} class="mt-1 shrink-0 text-go" />
              <div class="flex flex-col gap-1">
                <h3 class="text-base font-semibold text-ink">{point.title}</h3>
                <p class="text-sm leading-relaxed text-muted">{point.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="process" class="wrap scroll-mt-20 py-band md:py-band-lg">
    <SectionHead
      eyebrow={home.process.eyebrow}
      heading={home.process.heading}
      body={home.process.body}
    />
    <ProcessSteps steps={home.process.steps} />
  </section>

  <section class="wrap pb-band md:pb-band-lg">
    <div
      class:list={[
        'card grid gap-6 p-6 lg:p-8',
        SHOP_ENABLED && 'lg:grid-cols-2',
      ]}
    >
      {
        SHOP_ENABLED && (
          <div class="flex flex-col gap-3">
            <span class="eyebrow">{home.shopTeaser.eyebrow}</span>
            <h2 class="text-section">{home.shopTeaser.heading}</h2>
            <p class="text-base leading-relaxed text-muted">
              {home.shopTeaser.body}
            </p>
            <a
              href={PathBuilder.shop(locale)}
              class="btn btn-primary mt-2 w-fit"
            >
              {home.shopTeaser.cta}
            </a>
          </div>
        )
      }
      <div
        class:list={[
          'flex flex-col gap-3',
          SHOP_ENABLED &&
            'border-t border-line pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0',
        ]}
      >
        <span class="eyebrow">{home.accident.eyebrow}</span>
        <h2 class="text-section">{home.accident.heading}</h2>
        <p class="text-base leading-relaxed text-muted">{home.accident.body}</p>
        <ul class="flex flex-col gap-1.5 pt-1">
          {
            home.accident.points.map((point) => (
              <li class="flex gap-2 text-sm text-ink-2">
                <Icon name="check" size={12} class="mt-1 shrink-0 text-go" />
                {point}
              </li>
            ))
          }
        </ul>
        <a
          href={PathBuilder.service(locale, 'bodywork-painting')}
          class="btn btn-secondary mt-2 w-fit"
        >
          {home.accident.cta}
        </a>
      </div>
    </div>
  </section>

  {
    latestWorks.length > 0 && (
      <section class="bg-shade">
        <div class="wrap py-band md:py-band-lg">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHead
              eyebrow={pages.works.eyebrow}
              heading={pages.works.heading}
            />
            <a href={PathBuilder.works(locale)} class="btn btn-secondary w-fit">
              {site.common.allWorks}
            </a>
          </div>
          <WorkGrid works={latestWorks} />
        </div>
      </section>
    )
  }

  <section class="bg-shade">
    <div class="wrap py-band md:py-band-lg">
      <SectionHead eyebrow="FAQ" heading={site.common.faqHeading} />
      <Faq items={home.faq} />
    </div>
  </section>

  <FinalCta
    eyebrow={home.finalCta.eyebrow}
    heading={home.finalCta.heading}
    body={home.finalCta.body}
  />
</Shell>
