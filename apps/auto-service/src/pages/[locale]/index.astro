---
import { contactCta, contactPlacement } from '@podbor/site-kit/contact-control';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { faqPageSchema, websiteSchema } from '@podbor/site-kit';
import { DEVELOPER } from '@podbor/brands';
import { SITE_NAME, SITE_URL } from '@/utils/constants';
import heroWideImage from '@/assets/hero-mechanic-wide.jpg';
import heroTallImage from '@/assets/hero-mechanic.jpg';
import Shell from '@/layouts/Shell.astro';
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import ServiceList from '@/components/ServiceList.astro';
import SplitSection from '@/components/SplitSection.astro';
import WorksRow from '@/components/WorksRow.astro';
import VisitPanel from '@/components/VisitPanel.astro';
import GarageBay from '@/components/GarageBay.astro';
import CallAction from '@/components/CallAction.astro';
import GarageAddress from '@/components/GarageAddress.astro';
import Faq from '@/components/Faq.astro';
import FinalCta from '@/components/FinalCta.astro';
import HeroContacts from '@/components/HeroContacts.astro';
import CatalogueSearch from '@/components/CatalogueSearch.astro';
import PartsInquiryModal from '@/components/PartsInquiryModal.astro';
import { PARTS_INQUIRY_OPEN_ATTRIBUTE } from '@/scripts/partsList';
import { localeFrom } from '@/i18n/config';
import { featuredWorks } from '@/utils/works';
import { localePaths, PathBuilder } from '@/utils/paths';
import { content } from '@/i18n/content';

export function getStaticPaths() {
  return localePaths();
}

const HERO_MEDIA_SM = '(max-width: 1023px)';
const HERO_MEDIA_LG = '(min-width: 1024px)';
const HERO_SIZES_SM = 'calc(100vw - 2.5rem)';
const HERO_SIZES_LG = '(min-width: 1224px) 532px, calc(46.5vw - 19px)';
const heroWide = await getImage({
  src: heroWideImage,
  widths: [480, 720, 1080, 1440],
  sizes: HERO_SIZES_SM,
  format: 'webp',
});
const heroTall = await getImage({
  src: heroTallImage,
  widths: [560, 800, 1080, 1280],
  sizes: HERO_SIZES_LG,
  format: 'webp',
});
const locale = localeFrom(Astro.url.pathname);
const home = content(locale).home;
const site = content(locale).site;
const pages = content(locale).pages;

const faqSchema = faqPageSchema(home.faq);
const website = websiteSchema({
  name: SITE_NAME,
  url: SITE_URL,
  creator: DEVELOPER,
});
---

<Shell
  title={home.meta.title}
  description={home.meta.description}
  jsonLd={[faqSchema, website]}
  preloadImage={[
    {
      src: heroWide.src,
      srcset: heroWide.srcSet.attribute,
      sizes: HERO_SIZES_SM,
      media: HERO_MEDIA_SM,
    },
    {
      src: heroTall.src,
      srcset: heroTall.srcSet.attribute,
      sizes: HERO_SIZES_LG,
      media: HERO_MEDIA_LG,
    },
  ]}
>
  <section class="wrap pt-3 sm:pt-5">
    <div
      class="grid overflow-hidden rounded-block bg-panel text-panel-fg lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]"
    >
      <picture class="relative block lg:col-start-2 lg:row-start-1">
        <source
          media={HERO_MEDIA_LG}
          srcset={heroTall.srcSet.attribute}
          sizes={HERO_SIZES_LG}
        />
        <img
          src={heroWide.src}
          srcset={heroWide.srcSet.attribute}
          sizes={HERO_SIZES_SM}
          width={heroWideImage.width}
          height={heroWideImage.height}
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="block aspect-[2/1] w-full object-cover sm:aspect-[5/2] lg:absolute lg:inset-0 lg:aspect-auto lg:h-full lg:object-[50%_45%]"
        />
      </picture>

      <div
        class="flex flex-col gap-[1.125rem] p-5 pb-6 sm:p-8 lg:col-start-1 lg:row-start-1 lg:gap-7 lg:px-12 lg:pt-12 lg:pb-10"
        {...contactCta}
      >
        <div class="flex flex-col gap-2 lg:gap-3.5">
          <h1 class="text-hero max-w-[15ch]">{home.hero.heading}</h1>
          <GarageAddress
            layout="line"
            tone="panel"
            class="text-[0.9375rem] lg:text-[1.0625rem]"
          />
        </div>

        <HeroContacts />

        <div
          class="flex flex-col gap-2 border-t border-panel-line/60 pt-5 lg:pt-6"
        >
          <h2 class="text-base leading-snug font-semibold tracking-normal">
            {home.hero.partsHeading}
          </h2>
          <CatalogueSearch
            hint={false}
            onPanel
            submitLabel={home.hero.partsSubmit}
          />
          <p class="text-sm leading-snug text-panel-ink">
            {home.hero.partsHint}{' '}
            <a
              href={PathBuilder.partsInquiry(locale)}
              class="inline-flex min-h-11 items-center font-semibold text-panel-fg underline decoration-panel-line underline-offset-2 transition-colors duration-150 hover:decoration-panel-fg sm:min-h-0"
              {...{ [PARTS_INQUIRY_OPEN_ATTRIBUTE]: '' }}
            >
              {home.hero.partsInquiry}
            </a>
          </p>
        </div>

        <ul
          class="flex flex-wrap gap-x-5 gap-y-1.5 text-[0.8125rem] text-panel-ink lg:text-xs"
        >
          {
            home.hero.badges.map((fact) => (
              <li class="flex items-center gap-1.5 lg:gap-1">
                <Icon name="check" size={12} />
                {fact}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
  <PartsInquiryModal comment="" />

  <section id="services" class="wrap scroll-mt-20 py-band md:py-band-lg">
    <SplitSection>
      <SectionHead
        slot="head"
        eyebrow={home.servicesHead.eyebrow}
        heading={home.servicesHead.heading}
        body={home.servicesHead.body}
      />
      <ServiceList />
      <div slot="aside" class="flex flex-col gap-2 rounded-block bg-shade p-5">
        <h3 class="font-semibold text-ink">{home.problemPrompt.heading}</h3>
        <p class="text-sm leading-relaxed text-muted">
          {home.problemPrompt.body}
        </p>
        <a
          href="#lead"
          data-open-lead-modal
          class="btn btn-secondary mt-2 w-full lg:w-fit"
        >
          {home.problemPrompt.cta}
        </a>
      </div>
    </SplitSection>
  </section>

  <WorksRow
    works={featuredWorks(await getCollection('works'))}
    eyebrow={pages.works.eyebrow}
    heading={home.worksHeading}
  />

  <section
    id="process"
    class="wrap scroll-mt-20 py-band md:py-band-lg"
    {...contactPlacement('visit')}
  >
    <SectionHead
      eyebrow={home.process.eyebrow}
      heading={home.process.heading}
      body={home.process.body}
    />
    <ProcessSteps steps={home.process.steps}>
      <CallAction
        slot="first"
        class="link-underlined inline-flex min-h-11 w-fit items-center gap-1.5 font-semibold text-ink"
        number={false}
      />
    </ProcessSteps>
    <ul
      class="mt-8 flex flex-col gap-2 border-t border-line pt-5 text-sm text-ink-2 sm:flex-row sm:gap-8"
    >
      {
        home.process.promises.map((promise) => (
          <li class="flex items-center gap-2">
            <Icon name="check" size={14} class="shrink-0 text-go" />
            {promise}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap pb-band md:pb-band-lg">
    <div
      class="card grid gap-6 p-6 lg:grid-cols-2 lg:items-center lg:gap-12 lg:p-10"
    >
      <div class="flex flex-col gap-3">
        <span class="eyebrow">{home.accident.eyebrow}</span>
        <h2 class="text-block">{home.accident.heading}</h2>
        <p class="text-base leading-relaxed text-muted">{home.accident.body}</p>
      </div>
      <div class="flex flex-col gap-5">
        <ul class="flex flex-col gap-1.5">
          {
            home.accident.points.map((point) => (
              <li class="flex gap-2 text-sm text-ink-2">
                <Icon name="check" size={12} class="mt-1 shrink-0 text-go" />
                {point}
              </li>
            ))
          }
        </ul>
        <div
          class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-6"
        >
          <a
            href="#lead"
            data-open-lead-modal
            data-lead-service="bodywork-painting"
            class="btn btn-secondary w-full sm:w-fit"
          >
            {home.accident.cta}
          </a>
          <a
            href={PathBuilder.service(locale, 'bodywork-painting')}
            class="link-underlined inline-flex min-h-11 items-center text-sm font-semibold text-ink"
          >
            {home.accident.more}
          </a>
        </div>
      </div>
    </div>
  </section>

  <VisitPanel heading={site.visit.heading} class="pb-band md:pb-band-lg">
    <GarageBay slot="media" />
  </VisitPanel>

  <section class="bg-shade">
    <div class="wrap py-band md:py-band-lg">
      <SplitSection>
        <SectionHead
          slot="head"
          eyebrow={home.faqEyebrow}
          heading={site.common.faqHeading}
        />
        <Faq items={home.faq} class="" />
      </SplitSection>
    </div>
  </section>

  <FinalCta
    eyebrow={home.finalCta.eyebrow}
    heading={home.finalCta.heading}
    body={home.finalCta.body}
  />
</Shell>
