---
import { contactCta } from '@podbor/site-kit/contact-control';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { faqPageSchema, websiteSchema } from '@podbor/site-kit';
import { DEVELOPER } from '@podbor/brands';
import { SITE_NAME, SITE_URL } from '@/utils/constants';
import heroImage from '@/assets/hero-workshop.jpg';
import Shell from '@/layouts/Shell.astro';
import Icon from '@/components/Icon.astro';
import SectionHead from '@/components/SectionHead.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import PriceTable from '@/components/PriceTable.astro';
import Faq from '@/components/Faq.astro';
import LeadForm from '@/components/LeadForm.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import FinalCta from '@/components/FinalCta.astro';
import ContactChannels from '@/components/ContactChannels.astro';
import CatalogueSearch from '@/components/CatalogueSearch.astro';
import { localeFrom } from '@/i18n/config';
import { publishedWorks } from '@/utils/works';
import { localePaths, PathBuilder } from '@/utils/paths';
import { SERVICE_SLUGS } from '@/utils/services';
import { content } from '@/i18n/content';

export function getStaticPaths() {
  return localePaths();
}

const HERO_SIZES =
  '(min-width: 1280px) 20rem, (min-width: 1024px) 18rem, 100vw';
const heroPicture = await getImage({
  src: heroImage,
  widths: [480, 720, 960],
  sizes: HERO_SIZES,
  format: 'webp',
});
const locale = localeFrom(Astro.url.pathname);
const home = content(locale).home;
const site = content(locale).site;
const pages = content(locale).pages;
const services = content(locale).services;
const latestWorks = publishedWorks(await getCollection('works')).slice(0, 3);

const faqSchema = faqPageSchema(home.faq);
const website = websiteSchema({
  name: SITE_NAME,
  url: SITE_URL,
  creator: DEVELOPER,
});
---

<Shell
  title={home.meta.title}
  description={home.meta.description}
  jsonLd={[faqSchema, website]}
  preloadImage={{
    src: heroPicture.src,
    srcset: heroPicture.srcSet.attribute,
    sizes: HERO_SIZES,
  }}
>
  <section class="wrap pt-3 sm:pt-5">
    <div
      class="grid overflow-hidden rounded-block bg-panel text-white lg:grid-cols-[1fr_18rem] xl:grid-cols-[1fr_20rem]"
    >
      <div class="flex flex-col gap-5 p-5 sm:p-8 lg:p-10">
        <h1 class="text-hero max-w-[16ch]">{home.hero.heading}</h1>

        <div class="grid gap-3 md:grid-cols-2" {...contactCta}>
          <div
            class="flex min-w-0 flex-col gap-3 rounded-control bg-panel-2 p-4 sm:p-5"
          >
            <h2 class="text-block font-bold">
              {content(locale).partsSearch.searchHeading}
            </h2>
            <CatalogueSearch hint={false} />
            <p class="text-sm leading-relaxed text-panel-ink">
              {content(locale).partsSearch.label}
            </p>
          </div>

          <div
            class="flex min-w-0 flex-col gap-3 rounded-control bg-panel-2 p-4 sm:p-5"
          >
            <h2 class="text-block font-bold">{home.hero.ctaPrimary}</h2>
            <nav
              aria-label={site.nav.services}
              class="-mx-4 flex gap-2 overflow-x-auto px-4 [scrollbar-width:none] sm:-mx-5 sm:px-5 [&::-webkit-scrollbar]:hidden"
            >
              {
                SERVICE_SLUGS.map((slug) => (
                  <a
                    href={PathBuilder.service(locale, slug)}
                    class="chip bg-white/10 text-white hover:bg-white/20"
                  >
                    {services[slug].name}
                  </a>
                ))
              }
            </nav>
            <div class="mt-auto flex flex-wrap gap-2">
              <button
                type="button"
                data-open-lead-modal
                class="btn btn-primary flex-1 whitespace-nowrap"
              >
                {site.header.cta}
              </button>
              <a
                href={PathBuilder.services(locale)}
                class="btn btn-on-panel flex-1 whitespace-nowrap"
              >
                {home.hero.ctaSecondary}
              </a>
            </div>
          </div>
        </div>

        <p class="max-w-xl leading-relaxed text-panel-ink sm:text-lg">
          {home.hero.lead}
        </p>
        <ContactChannels placement="hero" tone="panel" />
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            home.hero.badges.map((badge) => (
              <li class="flex items-center gap-1.5 text-sm text-panel-ink">
                <Icon name="check" size={12} class="text-signal" />
                {badge}
              </li>
            ))
          }
        </ul>
      </div>

      <img
        src={heroPicture.src}
        srcset={heroPicture.srcSet.attribute}
        sizes={HERO_SIZES}
        width={heroImage.width}
        height={heroImage.height}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[16/10] w-full object-cover lg:aspect-auto lg:h-full"
      />
    </div>

    <ul class="mt-3 grid gap-3 sm:grid-cols-3">
      {
        home.trust.map((item) => (
          <li class="flex flex-col gap-1 rounded-block bg-shade p-5">
            <span class="spec text-2xl font-extrabold tracking-tight text-ink">
              {item.value}
            </span>
            <span class="text-sm leading-snug text-muted">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="services" class="wrap scroll-mt-20 py-band md:py-band-lg">
    <SectionHead
      eyebrow={home.servicesHead.eyebrow}
      heading={home.servicesHead.heading}
      body={home.servicesHead.body}
    />
    <PriceTable />
  </section>

  <section class="wrap pb-band lg:hidden" {...contactCta}>
    <div class="rounded-block bg-shade p-6">
      <h2 class="text-section mb-5">{site.form.heading}</h2>
      <LeadForm compact />
    </div>
  </section>

  <section class="bg-shade">
    <div class="wrap py-band md:py-band-lg">
      <SectionHead
        eyebrow={home.why.eyebrow}
        heading={home.why.heading}
        body={home.why.body}
      />
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          home.why.points.map((point) => (
            <li class="flex gap-3">
              <Icon name="check" size={16} class="mt-1 shrink-0 text-go" />
              <div class="flex flex-col gap-1">
                <h3 class="text-base font-semibold text-ink">{point.title}</h3>
                <p class="text-sm leading-relaxed text-muted">{point.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="process" class="wrap scroll-mt-20 py-band md:py-band-lg">
    <SectionHead
      eyebrow={home.process.eyebrow}
      heading={home.process.heading}
      body={home.process.body}
    />
    <ProcessSteps steps={home.process.steps} />
  </section>

  <section class="wrap pb-band md:pb-band-lg">
    <div class="card grid gap-6 p-6 lg:p-8">
      <div class="flex flex-col gap-3">
        <span class="eyebrow">{home.accident.eyebrow}</span>
        <h2 class="text-section">{home.accident.heading}</h2>
        <p class="text-base leading-relaxed text-muted">{home.accident.body}</p>
        <ul class="flex flex-col gap-1.5 pt-1">
          {
            home.accident.points.map((point) => (
              <li class="flex gap-2 text-sm text-ink-2">
                <Icon name="check" size={12} class="mt-1 shrink-0 text-go" />
                {point}
              </li>
            ))
          }
        </ul>
        <a
          href={PathBuilder.service(locale, 'bodywork-painting')}
          class="btn btn-secondary mt-2 w-fit"
        >
          {home.accident.cta}
        </a>
      </div>
    </div>
  </section>

  {
    latestWorks.length > 0 && (
      <section class="bg-shade">
        <div class="wrap py-band md:py-band-lg">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <SectionHead
              eyebrow={pages.works.eyebrow}
              heading={pages.works.heading}
            />
            <a href={PathBuilder.works(locale)} class="btn btn-secondary w-fit">
              {site.common.allWorks}
            </a>
          </div>
          <WorkGrid works={latestWorks} />
        </div>
      </section>
    )
  }

  <section class="bg-shade">
    <div class="wrap py-band md:py-band-lg">
      <SectionHead eyebrow="FAQ" heading={site.common.faqHeading} />
      <Faq items={home.faq} />
    </div>
  </section>

  <FinalCta
    eyebrow={home.finalCta.eyebrow}
    heading={home.finalCta.heading}
    body={home.finalCta.body}
  />
</Shell>
