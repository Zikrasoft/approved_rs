---
import Shell from '@/layouts/Shell.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';
import { localeFrom } from '@/i18n/config';
import { localePaths, PathBuilder } from '@/utils/paths';
import { VIN_INQUIRY_SERVICE } from '@/utils/services';
import { content } from '@/i18n/content';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFrom(Astro.url.pathname);
const pages = content(locale).pages;
const site = content(locale).site;
const copy = pages.partsInquiry;
---

<Shell title={copy.metaTitle} description={copy.metaDescription}>
  <PageHero
    eyebrow={copy.eyebrow}
    heading={copy.heading}
    lead={copy.lead}
    crumbs={[{ href: PathBuilder.parts(locale), label: site.nav.parts }]}
  />

  <section class="wrap flex flex-col gap-6 py-band md:py-band-lg">
    <p class="max-w-2xl text-base leading-relaxed text-ink-2">
      {copy.sourcingNote}
    </p>

    <div class="card flex flex-col gap-4 p-5 sm:p-6 lg:max-w-xl">
      <h2 class="text-block font-semibold">{copy.formHeading}</h2>
      <LeadForm
        service={VIN_INQUIRY_SERVICE}
        vin={{ label: copy.vinLabel, placeholder: copy.vinPlaceholder }}
        commentLabel={copy.commentLabel}
        commentPlaceholder={copy.commentPlaceholder}
        commentNote={copy.commentNote}
        defaultChannel="whatsapp"
      />
    </div>

    <div class="card flex flex-col gap-3 p-5 lg:max-w-xl">
      <h2 class="text-base font-semibold text-ink">{copy.stepsHeading}</h2>
      <ol class="flex flex-col gap-4">
        {
          copy.steps.map((step, i) => (
            <li class="flex gap-3">
              <span class="spec mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-shade text-xs">
                {i + 1}
              </span>
              <div class="flex flex-col gap-0.5">
                <span class="text-sm font-semibold text-ink">
                  {step.heading}
                </span>
                <span class="text-sm leading-relaxed text-ink-2">
                  {step.body}
                </span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Shell>
