---
import Shell from '@/layouts/Shell.astro';
import Icon from '@/components/Icon.astro';
import ContactChannels from '@/components/ContactChannels.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { getPagesContent } from '@/i18n/content/pages';
import { getSiteContent } from '@/i18n/content/site';
import { localePaths, PathBuilder } from '@/utils/paths';

export function getStaticPaths() {
  return localePaths();
}

const locale = localeFrom(Astro.url.pathname);
const pages = getPagesContent(locale);
const site = getSiteContent(locale);
---

<Shell
  title={pages.thanks.metaTitle}
  description={pages.thanks.metaDescription}
  noindex
>
  <section
    class="wrap grid gap-8 py-band md:py-band-lg lg:grid-cols-[1.2fr_1fr]"
  >
    <div class="flex flex-col gap-4">
      <span class="eyebrow">{pages.thanks.eyebrow}</span>
      <h1 class="text-hero">{pages.thanks.heading}</h1>
      <p class="max-w-xl text-base leading-relaxed text-muted sm:text-lg">
        {pages.thanks.body}
      </p>
      <p class="max-w-xl text-sm text-muted">{pages.thanks.note}</p>
      <a href={PathBuilder.home(locale)} class="btn btn-primary mt-2 w-fit">
        {pages.thanks.cta}
        <Icon name="arrowRight" />
      </a>
    </div>

    <div class="card flex flex-col gap-4 p-5">
      <span class="text-xs text-muted">{site.footer.contactHeading}</span>
      <ContactChannels />
    </div>
  </section>
</Shell>
