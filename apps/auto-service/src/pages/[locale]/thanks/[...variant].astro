---
import { mapRouteUrl } from '@podbor/site-kit';
import Shell from '@/layouts/Shell.astro';
import BackLink from '@/components/BackLink.astro';
import ContactChannels from '@/components/ContactChannels.astro';
import GarageAddress from '@/components/GarageAddress.astro';
import Icon from '@/components/Icon.astro';
import { localeFrom } from '@/i18n/config';
import { localePaths, PathBuilder } from '@/utils/paths';
import { GARAGE_ADDRESS } from '@/utils/constants';
import { content } from '@/i18n/content';

export function getStaticPaths() {
  return localePaths().flatMap(({ params }) => [
    { params: { ...params, variant: undefined } },
    { params: { ...params, variant: 'parts' } },
  ]);
}

const locale = localeFrom(Astro.url.pathname);
const pages = content(locale).pages;
const site = content(locale).site;
const parts = Astro.params.variant === 'parts';
const copy = parts ? { ...pages.thanks, ...pages.thanksParts } : pages.thanks;
const back = parts ? PathBuilder.parts(locale) : PathBuilder.home(locale);
---

<Shell
  title={copy.metaTitle}
  description={copy.metaDescription}
  noindex
  stickyContact={!parts}
>
  <section
    class="wrap grid gap-8 py-band md:py-band-lg lg:grid-cols-[1.2fr_1fr]"
  >
    <div class="flex flex-col gap-4">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1 class="text-hero">{copy.heading}</h1>
      <p class="max-w-xl text-base leading-relaxed text-muted sm:text-lg">
        {copy.body}
      </p>
      {!parts && <p class="max-w-xl text-sm text-muted">{copy.note}</p>}
      <div class="mt-2 flex flex-wrap gap-3">
        <BackLink href={back} label={copy.cta} />
      </div>
    </div>

    <div class="card flex flex-col gap-4 self-start p-5">
      <span class="text-xs text-muted">{site.footer.contactHeading}</span>
      <ContactChannels placement="thanks" numberLabel />
      <div class="flex flex-col gap-3 border-t border-line pt-4">
        <span class="text-xs text-muted">{pages.thanks.visitLabel}</span>
        <GarageAddress layout="block" tone="card" />
        <a
          href={mapRouteUrl(GARAGE_ADDRESS.lat, GARAGE_ADDRESS.lon)}
          target="_blank"
          rel="noopener"
          class="link-underlined inline-flex min-h-11 items-center gap-2 self-start font-semibold text-ink"
        >
          <Icon name="route" size={16} class="shrink-0" />
          {site.visit.route}
        </a>
      </div>
    </div>
  </section>
</Shell>
