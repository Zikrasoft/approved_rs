---
import Shell from '@/layouts/Shell.astro';
import Icon from '@/components/Icon.astro';
import { localeFrom } from '@/i18n/currentLocale';
import { getPagesContent } from '@/i18n/content/pages';
import { PathBuilder } from '@/utils/paths';

const locale = localeFrom(Astro.url.pathname);
const pages = getPagesContent(locale);
---

<Shell
  title={pages.notFound.metaTitle}
  description={pages.notFound.body}
  noindex
>
  <section
    class="wrap flex min-h-[60vh] flex-col justify-center gap-4 py-band md:py-band-lg"
  >
    <span class="spec text-5xl font-semibold text-line-strong">404</span>
    <h1 class="text-hero">{pages.notFound.heading}</h1>
    <p class="max-w-xl text-base leading-relaxed text-muted">
      {pages.notFound.body}
    </p>
    <a href={PathBuilder.home(locale)} class="btn btn-primary mt-2 w-fit">
      {pages.notFound.cta}
      <Icon name="arrowRight" />
    </a>
  </section>
</Shell>
