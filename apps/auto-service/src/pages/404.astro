---
import Shell from '@/layouts/Shell.astro';
import BackLink from '@/components/BackLink.astro';
import CatalogueSearch from '@/components/CatalogueSearch.astro';
import ContactChannels from '@/components/ContactChannels.astro';
import { VIN_INQUIRY_SERVICE } from '@/utils/services';
import { SUPPORTED_LOCALES, localeFrom } from '@/i18n/config';
import { PathBuilder } from '@/utils/paths';
import { content } from '@/i18n/content';
import { contactCta } from '@podbor/site-kit/contact-control';

const locale = localeFrom(Astro.url.pathname);
const { pages, shopCart, site } = content(locale);
---

<Shell
  title={pages.notFound.metaTitle}
  description={pages.notFound.body}
  noindex
>
  <not-found-parts
    class="wrap flex min-h-[60vh] flex-col justify-center gap-4 py-band md:py-band-lg"
    data-parts-paths={SUPPORTED_LOCALES.map(PathBuilder.parts).join(' ')}
    data-part-paths={SUPPORTED_LOCALES.map((locale) =>
      PathBuilder.partNumber(locale, '').slice(0, -1),
    ).join(' ')}
  >
    <span class="spec text-5xl font-medium text-line-strong">404</span>
    <h1 class="text-hero">{pages.notFound.heading}</h1>
    <div class="flex max-w-3xl flex-col gap-4" data-site-body>
      <p class="max-w-xl text-base leading-relaxed text-muted">
        {pages.notFound.body}
      </p>
      <a href={PathBuilder.services(locale)} class="btn btn-primary w-fit">
        {site.common.allServices}
      </a>
      <ContactChannels class="max-w-xl" />
    </div>
    <div
      class="flex max-w-3xl flex-col gap-4"
      data-parts-404
      hidden
      {...contactCta}
    >
      <p class="max-w-xl text-base leading-relaxed text-muted">
        {pages.notFound.partsBody}
      </p>
      <CatalogueSearch large hint={false} />
      <a
        href={PathBuilder.partsInquiry(locale)}
        class="btn btn-secondary w-fit"
      >
        {shopCart.emptyInquiryCta}
      </a>
      <ContactChannels service={VIN_INQUIRY_SERVICE} class="max-w-xl" />
    </div>
    <BackLink
      href={PathBuilder.home(locale)}
      label={pages.notFound.cta}
      class="mt-2"
    />
  </not-found-parts>
</Shell>

<script>
  import { defineNotFoundParts } from '@/scripts/notFoundParts';

  defineNotFoundParts();
</script>
