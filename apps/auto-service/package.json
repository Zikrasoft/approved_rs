{
  "name": "@podbor/auto-service",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:shop": "until curl -sf http://localhost:9009/health >/dev/null; do sleep 1; done; node --env-file-if-exists=.env.local node_modules/astro/bin/astro.mjs dev --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run --passWithNoTests",
    "typecheck": "astro check",
    "gen:og": "node --experimental-strip-types scripts/gen-og.ts"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.9",
    "@fontsource-variable/onest": "5.3.1",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "@podbor/brands": "workspace:*",
    "@podbor/catalog-contract": "workspace:*",
    "@podbor/i18n": "workspace:*",
    "@podbor/lead-capture": "workspace:*",
    "@podbor/lead-crm": "workspace:*",
    "@podbor/site-kit": "workspace:*",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.5",
    "astro": "7.2.10",
    "libphonenumber-js": "1.13.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "jsdom": "30.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vercel": "59.11.7",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
