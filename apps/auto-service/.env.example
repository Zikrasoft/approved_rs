# Site
SITE=https://autohub.rs

# Public contact channels
PUBLIC_PHONE_NUMBER=381110000000
PUBLIC_WHATSAPP_NUMBER=381110000000
PUBLIC_VIBER_NUMBER=381110000000
PUBLIC_TG_MANAGER=autohub_rs

# Telegram bot — the SAME bot as every other brand in this repo. This app only
# ever sends lead cards; the webhook that handles button presses is deployed by
# apps/approved-rs (Telegram allows one webhook URL per bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_OWNER_ID=
TELEGRAM_ADMIN_ID=
TELEGRAM_BOT_USERNAME=

# Lead storage — Vercel Blob. Connect the SAME Blob store as apps/approved-rs
# so every brand's leads land in one data/leads.json and the bot can act on
# them. Leads are separated by their `brand` field, not by file.

# Keystatic CMS (GitHub App)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
