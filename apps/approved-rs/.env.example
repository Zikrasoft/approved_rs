# Site
SITE=https://approved.rs

# WhatsApp / Viber (Public — единый номер для обоих)
PUBLIC_WHATSAPP_NUMBER=381677702100
PUBLIC_VIBER_NUMBER=381677702100

# Threads (Public)
PUBLIC_THREADS_CHANNEL=approved.rs

# CRM bot (Private) — @SerbCRMBot, the operator's bot: cards, statuses, money,
# reminders. The SAME bot in all three projects; its webhook
# (/api/telegram-webhook) and the reminders cron live only here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Registered as the webhook's secret_token (see docs/guides/deploy.md) — verifies
# incoming /api/telegram-webhook calls actually come from Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Numeric Telegram user ids (not @username — get via @userinfobot) of the
# people allowed to use the bot's private-chat menus. Comma-separated if
# someone has more than one Telegram account (e.g. TELEGRAM_OWNER_ID=111,222).
# Each id must send /start to the bot once before it can DM it (Telegram
# blocks bots from initiating a DM).
TELEGRAM_OWNER_ID=
TELEGRAM_ADMIN_ID=
# Bot's own @username (no @, never changes) — used to build the group
# teaser's "Открыть в боте" deep link (t.me/<username>?start=lead_<id>).
# Get it once from @BotFather or a getMe call, not fetched at runtime.
TELEGRAM_BOT_USERNAME=

# Capture bot (Private) — this brand's own visitor-facing bot, @ApprovedRsBot.
# It talks to visitors and writes leads; it never reads, searches or changes
# a status. Its webhook is /api/telegram-capture on this project, registered
# with `scripts/register-webhook.ts capture` (see docs/guides/deploy.md).
TELEGRAM_CAPTURE_BOT_TOKEN=
TELEGRAM_CAPTURE_WEBHOOK_SECRET=

# Lead/deal storage — Vercel Blob (private access). BLOB_READ_WRITE_TOKEN is
# auto-injected once a Blob store is linked to the Vercel project (Storage
# tab); locally, pull it with `vercel env pull`. Nothing to set by hand here.

# Reminders cron (/api/reminders, see vercel.json "crons") — sends the
# owner's postponed-lead ("напомни мне") reminders on their due date.
CRON_SECRET=

# Keystatic CMS (GitHub App)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Content translation (en/sr/es/de) is done by the `translate` job in
# .github/workflows/ci.yml, not at runtime — its OPENAI_API_KEY lives in the
# GitHub repo's Actions secrets (see docs/guides/deploy.md). Nothing to set here.
