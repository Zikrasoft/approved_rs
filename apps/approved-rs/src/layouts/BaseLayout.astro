---
import { jsonLdText } from '@podbor/site-kit';
import type { HeroImageAttrs } from '@/utils/heroImage';
import { OG_SUFFIX, type MetaProps } from '@/utils/seo';
import Header from '@/components/Header.astro';
import IconSprite from '@/components/icons/IconSprite.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import FloatingContactWidget from '@/components/FloatingContactWidget.astro';
import '../styles/global.css';
import { SITE_URL, SITE_NAME } from '@/utils/constants';
import { getAlternateLinks } from '@/i18n/hreflang';
import { getLocale } from '@/i18n/config';
// Logo/heading font: preload so it's ready before first paint (avoids the
// fallback→webfont width jump on every navigation, most visible on the logo).
import logoFontUrl from '@fontsource/unbounded/files/unbounded-latin-700-normal.woff2?url';
// Header nav links (400) and the CTA button (500) — same swap-jump issue, and
// the nav is flex-centred, so a swap slides the whole row sideways. The nav
// renders in the visitor's language, so the subset follows it: preloading the
// Cyrillic file for a Latin-script locale downloads a font nothing uses and
// leaves that locale with the swap this preload exists to prevent.
import navCyrillicUrl from '@fontsource/golos-text/files/golos-text-cyrillic-400-normal.woff2?url';
import navCtaCyrillicUrl from '@fontsource/golos-text/files/golos-text-cyrillic-500-normal.woff2?url';
import navLatinUrl from '@fontsource/golos-text/files/golos-text-latin-400-normal.woff2?url';
import navCtaLatinUrl from '@fontsource/golos-text/files/golos-text-latin-500-normal.woff2?url';

interface Props extends MetaProps {
  schema?: object;
  preloadImage?: HeroImageAttrs;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const locale = getLocale(Astro.currentLocale);

const {
  title,
  description,
  canonical,
  noindex,
  schema,
  preloadImage,
  ogImage = `${SITE_URL}/og${OG_SUFFIX[locale]}.png`,
  ogImageWidth = 1200,
  ogImageHeight = 630,
} = Astro.props;

const OG_LOCALE_MAP: Record<string, string> = {
  ru: 'ru_RU',
  en: 'en_US',
  sr: 'sr_RS',
  es: 'es_ES',
  de: 'de_DE',
};
const alternateLinks = getAlternateLinks(Astro.url.pathname);
const navFontUrl = locale === 'ru' ? navCyrillicUrl : navLatinUrl;
const navCtaFontUrl = locale === 'ru' ? navCtaCyrillicUrl : navCtaLatinUrl;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0b0c" />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={logoFontUrl}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={navFontUrl}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={navCtaFontUrl}
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternateLinks.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE_MAP[locale]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {
      schema && (
        <script type="application/ld+json" set:html={jsonLdText(schema)} />
      )
    }

    <script>
      import { defineAnalytics } from '@podbor/site-kit/browser';
      import { YM_COUNTER_ID } from '@/utils/constants';

      defineAnalytics({ ymCounterId: YM_COUNTER_ID });
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <IconSprite />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingContactWidget />
    <CookieConsent />
    <script is:inline>
      setTimeout(function () {
        document.documentElement.classList.add('anim-settled');
      }, 1600);
    </script>
    <script>
      import {
        isTrackedContactChannel,
        DATA_CONTACT_CHANNEL,
        DATA_OPEN_LEAD_MODAL,
        DATA_OPEN_PAGE_LEAD_MODAL,
      } from '@/utils/contactChannel';
      import { applyPrimaryContactChannel } from '@podbor/site-kit/contact-preference';
      import { getOrCreateVisitorId } from '@/utils/visitorId';

      applyPrimaryContactChannel();

      document
        .querySelectorAll<HTMLElement>(`[${DATA_CONTACT_CHANNEL}]`)
        .forEach((el) => {
          el.addEventListener('click', () => {
            const channel = el.dataset.contactChannel;
            window.ymReachGoal?.('contact_click', { channel });
            const opensLeadModal =
              el.hasAttribute(DATA_OPEN_LEAD_MODAL) ||
              el.hasAttribute(DATA_OPEN_PAGE_LEAD_MODAL);
            if (isTrackedContactChannel(channel) && !opensLeadModal) {
              const body = new FormData();
              body.set('channel', channel);
              body.set('source_url', location.href);
              body.set('visitor_id', getOrCreateVisitorId());
              navigator.sendBeacon('/api/contact-click', body);
            }
          });
        });
    </script>
  </body>
</html>
