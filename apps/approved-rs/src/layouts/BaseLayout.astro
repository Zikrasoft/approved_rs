---
import { jsonLdText, pageSchema, type PageSchema } from '@podbor/site-kit';
import type { HeroImageAttrs } from '@/utils/heroImage';
import type { MetaProps } from '@/utils/seo';
import { pageHead } from '@/utils/pageHead';
import Header from '@/components/Header.astro';
import IconSprite from '@/components/icons/IconSprite.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import FloatingContactWidget from '@/components/FloatingContactWidget.astro';
import '../styles/global.css';
import { SITE_NAME } from '@/utils/constants';
import { localeFrom } from '@/i18n/config';
import logoFontUrl from '@fontsource/unbounded/files/unbounded-latin-700-normal.woff2?url';
import navCyrillicUrl from '@fontsource/golos-text/files/golos-text-cyrillic-400-normal.woff2?url';
import navCtaCyrillicUrl from '@fontsource/golos-text/files/golos-text-cyrillic-500-normal.woff2?url';
import navLatinUrl from '@fontsource/golos-text/files/golos-text-latin-400-normal.woff2?url';
import navCtaLatinUrl from '@fontsource/golos-text/files/golos-text-latin-500-normal.woff2?url';

interface Props extends MetaProps {
  schema?: PageSchema;
  preloadImage?: HeroImageAttrs;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const locale = localeFrom(Astro.url.pathname);

const {
  noindex,
  schema,
  preloadImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
} = Astro.props;

const { title, description, canonical, alternates, ogLocale, ogImage } =
  pageHead(locale, Astro.url.pathname, Astro.props);
const navFontUrl = locale === 'ru' ? navCyrillicUrl : navLatinUrl;
const navCtaFontUrl = locale === 'ru' ? navCtaCyrillicUrl : navCtaLatinUrl;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0b0c" />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={logoFontUrl}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={navFontUrl}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={navCtaFontUrl}
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {
      schema && (
        <script
          type="application/ld+json"
          set:html={jsonLdText(pageSchema(schema, canonical))}
        />
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <IconSprite />
    <Header />
    <language-suggestion hidden>
      <div class="bg-text text-bg">
        <div
          class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-2 sm:px-6"
        >
          <a
            data-lang-link
            href="#"
            class="rounded-sm bg-accent-strong px-3.5 py-2 text-sm font-semibold text-on-accent no-underline transition-colors hover:bg-accent-hover"
          ></a>
          <button
            type="button"
            data-lang-dismiss
            class="ml-auto flex size-9 shrink-0 items-center justify-center rounded-sm text-xl leading-none opacity-55 transition-opacity hover:opacity-100"
            >&times;</button
          >
        </div>
      </div>
    </language-suggestion>
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingContactWidget />
    <CookieConsent />
    <script is:inline>
      setTimeout(function () {
        document.documentElement.classList.add('anim-settled');
      }, 1600);
    </script>
    <script>
      import {
        bootSiteKit,
        getOrCreateVisitorId,
        markFieldValidity,
      } from '@podbor/site-kit/browser';
      import {
        detectVisitorCountry,
        visitorChannel,
      } from '@podbor/site-kit/contact-preference';
      import { defineLeadForm } from '@podbor/lead-crm/lead-form';
      import { YM_COUNTER_ID } from '@/utils/metrika';

      bootSiteKit({
        ymCounterId: YM_COUNTER_ID,
        analytics: !import.meta.env.DEV,
      });
      defineLeadForm({
        visitorId: getOrCreateVisitorId,
        markFieldValidity,
        preferredChannel: visitorChannel,
        visitorCountry: detectVisitorCountry,
      });
    </script>
  </body>
</html>
