---
import ServicePageLayout from './ServicePageLayout.astro';
import StepsList from '@/components/StepsList.astro';
import Faq from '@/components/Faq.astro';
import MarketNotes from '@/components/MarketNotes.astro';
import type { CountryNote } from '@/i18n/content/services';
import { content } from '@/i18n/content';
import { servicesView } from '@/i18n/content/services';
import { generateServiceSchema, placeholderOgImage } from '@/utils/seo';
import { SITE_URL, SITE_NAME } from '@/utils/constants';
import { PathBuilder } from '@/utils/paths';
import type { Locale } from '@/i18n/config';
import type { VehicleImportSpoke } from '@/utils/vehicleImportCrossSell';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale: Locale;
  slug: VehicleImportSpoke;
  metaTitle: string;
  metaDescription: string;
  title: string;
  titleHighlight: string;
  description: string;
  ctaLabel: string;
  breadcrumbLabel: string;
  hubBreadcrumbLabel: string;
  parentBreadcrumb?: { label: string; href: string };
  casesHeading: string;
  cases?: CollectionEntry<'cases'>[];
  steps: { n: string; text: string }[];
  destinationsNote: string;
  areaServed: string | string[];
  notes?: { heading: string; pointsLabel: string; note: CountryNote };
}

const {
  locale,
  slug,
  metaTitle,
  metaDescription,
  title,
  titleHighlight,
  description,
  ctaLabel,
  breadcrumbLabel,
  hubBreadcrumbLabel,
  parentBreadcrumb,
  casesHeading,
  cases,
  steps,
  destinationsNote,
  areaServed,
  notes,
} = Astro.props;

const meta = {
  title: `${metaTitle} | ${SITE_NAME}`,
  description: metaDescription,
  ogImage: placeholderOgImage(SITE_URL, locale),
};
const closing = servicesView(locale)['vehicle-import'].closing;
const schema = generateServiceSchema(`${title} ${titleHighlight}`, areaServed);
---

<ServicePageLayout
  {meta}
  {schema}
  {title}
  {titleHighlight}
  {description}
  {ctaLabel}
  formService={`vehicle-import-${slug}`}
  currentCountry="rs"
  leadCountry={slug}
  currentService="vehicle-import"
  showCountryCrossLinks={false}
  {casesHeading}
  {cases}
  {closing}
  breadcrumbs={[
    { label: hubBreadcrumbLabel, href: PathBuilder.vehicleImportHub(locale) },
    ...(parentBreadcrumb ? [parentBreadcrumb] : []),
    { label: breadcrumbLabel },
  ]}
>
  <StepsList {steps} />
  <p class="mt-6 text-sm leading-relaxed text-muted">{destinationsNote}</p>
  <slot />

  <Fragment slot="extra">
    {
      notes && (
        <MarketNotes
          heading={notes.heading}
          pointsLabel={notes.pointsLabel}
          note={notes.note}
        />
      )
    }
    <Faq items={content(locale).faq['vehicle-import']} />
  </Fragment>
</ServicePageLayout>
