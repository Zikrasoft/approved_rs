---
import type { ImageMetadata } from 'astro';
import { heroImageAttrs } from '@/utils/heroImage';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ClosingBand from '@/components/ClosingBand.astro';
import StatBlock from '@/components/StatBlock.astro';
import closingImage from '@/assets/closing.jpg';
import { getHomeContent } from '@/i18n/content/home';
import LeadForm from '@/components/LeadForm.astro';
import LeadFormModal from '@/components/LeadFormModal.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import CasesGrid from '@/components/CasesGrid.astro';
import ChipLinks from '@/components/ChipLinks.astro';
import type { MetaProps } from '@/utils/seo';
import type { CollectionEntry } from 'astro:content';
import { SITE_NAME } from '@/utils/constants';
import { getActiveCountries } from '@/utils/geo';
import {
  SERVICES,
  isCountryScopedServiceSlug,
  type ServiceSlug,
} from '@/utils/labels';
import { toCaseItem } from '@/utils/cases';
import { getI18n } from '@/i18n/getI18n';
import { getLocale } from '@/i18n/config';
import { PathBuilder } from '@/utils/paths';
import { DATA_OPEN_PAGE_LEAD_MODAL } from '@/utils/contactChannel';

interface Props {
  meta: MetaProps;
  schema?: object;
  title: string;
  titleHighlight?: string;
  description: string;
  ctaLabel?: string;
  formService: string;
  currentCountry: string;
  // The "deal identity" shown in the hero watermark and sent as the lead's
  // country field — defaults to currentCountry, but vehicle-import pages need to
  // diverge: currentCountry stays a real country code (so the "other
  // services" cross-links below still resolve to a valid /vehicle-sourcing/{cc}/
  // etc.), while leadCountry carries the actual corridor ('de'/'eu'/'china')
  // so sales sees the right source in the Telegram notification instead of
  // a misleading "RS" on every vehicle-import lead.
  leadCountry?: string;
  currentService: ServiceSlug;
  cases?: CollectionEntry<'cases'>[];
  casesHeading?: string;
  city?: string;
  // Passed straight through to LeadForm — see its own prop doc. Left
  // undefined for pages happy with LeadForm's sourcing-flavored default.
  commentLabel?: string;
  commentPlaceholder?: string;
  showCountryCrossLinks?: boolean;
  breadcrumbs?: { label: string; href?: string }[];
  // Present on the four service hubs, absent on the country/city pages —
  // they keep the ghost country code as their own identity instead.
  image?: ImageMetadata;
  imageAlt?: string;
  // Closing band copy. Its photograph, stats and alt text are the same brand
  // assets the homepage closes on, so only the words travel per service.
  closing?: {
    eyebrow: string;
    line1: string;
    line2: string;
    accentWord: string;
    text: string;
  };
}

const {
  meta,
  schema,
  title,
  titleHighlight,
  description,
  ctaLabel,
  formService,
  currentCountry,
  leadCountry = currentCountry,
  currentService,
  cases = [],
  casesHeading,
  city,
  showCountryCrossLinks = true,
  breadcrumbs,
  commentLabel,
  commentPlaceholder,
  image,
  imageAlt,
  closing,
} = Astro.props;

const hero = image ? await heroImageAttrs(image) : undefined;
const locale = getLocale(Astro.currentLocale);
const items = cases.map((c) => toCaseItem(c, locale));
const t = getI18n(locale);
const h = getHomeContent(locale);
const countryCount = String(getActiveCountries().length);
const heroStats = [
  h.statClients,
  { value: countryCount, label: h.statCountries.label },
  h.statYears,
];
---

<BaseLayout {...meta} schema={schema} preloadImage={hero}>
  <section
    class:list={[
      'relative border-b overflow-hidden border-default',
      image ? 'photo-hero' : 'hero-grid',
    ]}
  >
    {
      image ? (
        <div class="photo-hero-shot">
          <img
            src={hero!.src}
            srcset={hero!.srcset}
            sizes={hero!.sizes}
            width={hero!.width}
            height={hero!.height}
            alt={imageAlt ?? title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover"
          />
          <span class="photo-hero-veil" />
        </div>
      ) : (
        <>
          <div
            class="absolute inset-0 pointer-events-none"
            style="background: radial-gradient(ellipse 50% 60% at 0% 50%, var(--color-ambient-glow) 0%, transparent 60%), radial-gradient(ellipse 40% 50% at 100% 0%, var(--color-accent-subtle) 0%, transparent 55%);"
          />
          <span
            class="deco-word"
            style="font-size: clamp(7rem, 18vw, 16rem); bottom: -1rem; right: -1%; opacity: 0.8;"
          >
            {leadCountry.toUpperCase()}
          </span>
        </>
      )
    }

    <div
      class:list={[
        'relative max-w-6xl mx-auto px-6',
        image ? 'photo-hero-body' : 'py-band md:py-band-lg',
      ]}
    >
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">
        <div class="lg:col-span-3">
          {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
          <span class="eyebrow fade-up fade-up-1">{SITE_NAME}</span>
          <h1
            class="font-display font-bold mb-5 leading-none fade-up fade-up-2 tracking-[-0.045em] text-primary"
            style="font-size: clamp(2.1rem, 5.6vw, 4.4rem); font-weight: 700;"
          >
            {title}{
              titleHighlight && (
                <>
                  <>
                    <br />
                    <span class="text-accent">{titleHighlight}</span>
                  </>
                </>
              )
            }
          </h1>
          <p
            class="text-base max-w-lg mb-2 leading-relaxed fade-up fade-up-3 text-muted"
          >
            {description}
          </p>
          <div class="fade-up fade-up-4">
            <ContactCTA label={ctaLabel} openModal compact />
          </div>
          <div
            class="grid grid-cols-3 gap-3 sm:gap-6 mt-8 pt-8 border-t fade-up fade-up-5 border-default"
          >
            {
              heroStats.map((stat) => (
                <StatBlock value={stat.value} label={stat.label} />
              ))
            }
          </div>
          <div class="fade-up fade-up-5 pt-8"><slot /></div>
        </div>
        <div class="lg:col-span-2 fade-up fade-up-3">
          <LeadForm
            service={formService}
            country={leadCountry}
            city={city}
            {commentLabel}
            {commentPlaceholder}
          />
        </div>
      </div>
    </div>
  </section>

  <slot name="extra" />

  <LeadFormModal
    triggerAttr={DATA_OPEN_PAGE_LEAD_MODAL}
    service={formService}
    country={leadCountry}
    city={city}
    {commentLabel}
    {commentPlaceholder}
  />

  <slot name="cases"><CasesGrid {items} heading={casesHeading ?? ''} /></slot>

  <div class="max-w-6xl mx-auto px-6 pb-16 pt-4">
    {
      showCountryCrossLinks && isCountryScopedServiceSlug(currentService) && (
        <ChipLinks
          label={t.common.alsoWorkingInLabel}
          items={getActiveCountries()
            .filter((c) => c.code !== currentCountry)
            .map((c) => ({
              href: PathBuilder.service(locale, currentService, c.code),
              text: c[locale].name,
            }))}
        />
      )
    }
    <ChipLinks
      label={t.common.otherServicesLabel}
      items={SERVICES.filter((s) => s.slug !== currentService).map((s) => ({
        href: PathBuilder.sectionRoot(locale, s.slug),
        text: t.nav[s.slug],
      }))}
    />
  </div>

  {
    closing && (
      <ClosingBand
        image={closingImage}
        imageAlt={h.ctaPhotoAlt}
        eyebrow={closing.eyebrow}
        line1={closing.line1}
        line2={closing.line2}
        accentWord={closing.accentWord}
        text={closing.text}
        ctaLabel={ctaLabel ?? h.ctaTelegramLabel}
        openModal
        stats={[
          h.ctaStatClients,
          { value: countryCount, label: h.ctaStatCountries.label },
          h.ctaStatYears,
          h.ctaStatResponse,
        ]}
      />
    )
  }
</BaseLayout>
