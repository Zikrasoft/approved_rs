---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseCard from './CaseCard.astro';
import CaseCategoryTabs from './CaseCategoryTabs.astro';
import PageHero from './PageHero.astro';
import ClosingBand from './ClosingBand.astro';
import closingImage from '@/assets/closing.jpg';
import { getHomeContent } from '@/i18n/content/home';
import type { CaseCardProps } from './CaseCard.astro';
import { getPagesContent } from '@/i18n/content/pages';
import { getI18n } from '@/i18n/getI18n';
import { getLocale } from '@/i18n/config';
import type { CasesTabKind } from '@/utils/labels';

interface Props {
  active: CasesTabKind;
  items: CaseCardProps[];
  counts: Record<CasesTabKind, number>;
  meta: { title: string; description: string; canonical: string };
}

const { active, items, counts, meta } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const cs = getPagesContent(locale).casesShared;
const t = getI18n(locale);
const h = getHomeContent(locale);
const intro = cs.tabIntros[active];
---

<BaseLayout {...meta}>
  <PageHero
    decoWord="CASES"
    title={t.nav.cases}
    subtitle={cs.heroSubtitle}
    breadcrumbs={[{ label: t.nav.cases }]}
  />

  <section class="max-w-6xl mx-auto px-6 py-band md:py-band-lg">
    <CaseCategoryTabs {active} {counts} />

    {
      intro && (
        <p class="text-base max-w-2xl mt-8 mb-10 leading-relaxed text-muted">
          {intro}
        </p>
      )
    }

    {
      items.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {items.map((item, j) => (
            <div
              style={`animation: fadeUp 0.75s ${0.05 + 0.07 * j}s cubic-bezier(0.16,1,0.3,1) both;`}
            >
              <CaseCard {...item} />
            </div>
          ))}
        </div>
      ) : (
        <p class="text-sm text-muted">{cs.emptyState}</p>
      )
    }
  </section>

  <ClosingBand
    image={closingImage}
    imageAlt={h.ctaPhotoAlt}
    eyebrow={cs.closingHeading}
    line1={cs.closingLine1}
    line2={cs.closingLine2}
    accentWord={cs.closingLine3}
    text={cs.closingText}
    ctaLabel={h.ctaTelegramLabel}
    stats={[
      h.ctaStatClients,
      h.ctaStatYears,
      h.ctaStatResponse,
      { value: String(items.length), label: t.nav.cases.toLowerCase() },
    ]}
  />
</BaseLayout>
