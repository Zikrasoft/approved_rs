---
import { localeFrom } from '@/i18n/config';
import { formatPrice, type CasePrice } from '@/utils/price';

interface Props {
  price: CasePrice;
  class?: string;
}
const { price, class: className } = Astro.props;
const locale = localeFrom(Astro.url.pathname);
---

<p class={className}>{formatPrice(price, locale)}</p>
