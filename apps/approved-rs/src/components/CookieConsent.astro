---
import { getLocale } from '@/i18n/config';
import { getI18n } from '@/i18n/getI18n';
import { PathBuilder } from '@/utils/paths';
import { COOKIE_POLICY_VERSION } from '@/utils/constants';

const locale = getLocale(Astro.currentLocale);
const cc = getI18n(locale).common.cookie;
---

<cookie-consent
  data-policy-version={COOKIE_POLICY_VERSION}
  hidden
  aria-live="polite"
  class="fixed inset-x-0 top-0 z-(--z-overlay) border-b border-default bg-surface sm:top-auto sm:bottom-0 sm:border-t sm:border-b-0"
>
  <div
    class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 pt-[max(0.5rem,env(safe-area-inset-top))] pb-2 sm:px-6 sm:pt-2 sm:pb-[max(0.5rem,env(safe-area-inset-bottom))]"
  >
    <p class="min-w-0 flex-1 text-xs leading-snug text-secondary">
      {cc.notice}
      {' '}{cc.more}{' '}
      <a href={PathBuilder.privacy(locale)} class="underline text-muted"
        >{cc.policyLink}</a
      >.
    </p>
    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        data-consent-decline
        class="rounded-sm border border-default px-3 py-2 text-xs font-medium text-primary"
      >
        {cc.decline}
      </button>
      <button
        type="button"
        data-consent-accept
        class="rounded-sm border border-accent-strong bg-accent-strong px-3 py-2 text-xs font-medium text-on-accent"
      >
        {cc.accept}
      </button>
    </div>
  </div>
</cookie-consent>

<script>
  import { defineCookieConsent } from '@podbor/site-kit/browser';
  defineCookieConsent();
</script>
