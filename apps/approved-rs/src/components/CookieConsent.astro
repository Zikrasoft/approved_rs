---
import { getLocale } from '@/i18n/config';
import { getI18n } from '@/i18n/getI18n';
import { PathBuilder } from '@/utils/paths';
import { COOKIE_POLICY_VERSION } from '@/utils/constants';

const locale = getLocale(Astro.currentLocale);
const cc = getI18n(locale).common.cookie;
---

<cookie-consent
  data-policy-version={COOKIE_POLICY_VERSION}
  hidden
  class="fixed bottom-4 left-4 right-4 sm:right-auto sm:max-w-sm z-50 rounded-sm border border-default bg-surface p-5 shadow-lg"
>
  <p class="text-sm leading-relaxed text-secondary mb-4">
    {cc.notice}
    {' '}{cc.more}{' '}
    <a href={PathBuilder.privacy(locale)} class="underline text-muted"
      >{cc.policyLink}</a
    >.
  </p>
  <div class="flex gap-3">
    <button
      data-consent-decline
      class="px-4 py-2 rounded-sm border text-xs font-medium border-default text-primary"
    >
      {cc.decline}
    </button>
    <button
      data-consent-accept
      class="px-4 py-2 rounded-sm border text-xs font-medium border-accent bg-accent text-on-accent"
    >
      {cc.accept}
    </button>
  </div>
</cookie-consent>

<script>
  import {
    CONSENT_EVENT,
    defineCookieConsent,
    type ConsentDetail,
  } from '@podbor/site-kit/browser';

  defineCookieConsent();

  document.addEventListener(CONSENT_EVENT, (event) => {
    if ((event as CustomEvent<ConsentDetail>).detail.analytics)
      window.loadAnalytics?.();
  });
</script>
