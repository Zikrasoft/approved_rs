---
import { getLocale } from '@/i18n/config';
import { getI18n } from '@/i18n/getI18n';
import { PathBuilder } from '@/utils/paths';
import { COOKIE_POLICY_VERSION } from '@/utils/constants';

const locale = getLocale(Astro.currentLocale);
const cc = getI18n(locale).common.cookie;
---

<div
  id="cookie-consent"
  data-policy-version={COOKIE_POLICY_VERSION}
  hidden
  class="fixed bottom-4 left-4 right-4 sm:right-auto sm:max-w-sm z-50 rounded-sm border border-default p-5 shadow-lg"
  style="background: var(--color-surface);"
>
  <p class="text-sm leading-relaxed text-secondary mb-4">
    {cc.notice}
    {' '}{cc.more}{' '}
    <a href={PathBuilder.privacy(locale)} class="underline text-accent"
      >{cc.policyLink}</a
    >.
  </p>
  <div class="flex gap-3">
    <button
      id="cookie-accept"
      class="px-4 py-2 rounded-sm text-xs font-medium bg-accent text-on-accent"
    >
      {cc.accept}
    </button>
    <button
      id="cookie-decline"
      class="px-4 py-2 rounded-sm text-xs font-medium text-muted"
    >
      {cc.decline}
    </button>
  </div>
</div>

<script>
  import { readConsent, saveConsent } from '@podbor/site-kit/browser';

  const el = document.getElementById('cookie-consent');
  const version = el?.dataset.policyVersion ?? '';

  function answer(analytics: boolean) {
    saveConsent(analytics, version);
    if (analytics) window.loadAnalytics?.();
    if (el) el.hidden = true;
  }

  function open() {
    if (el) el.hidden = false;
  }

  if (el) {
    const stored = readConsent(version);
    if (stored) {
      if (stored.analytics) window.loadAnalytics?.();
    } else {
      open();
    }

    document
      .getElementById('cookie-accept')
      ?.addEventListener('click', () => answer(true));
    document
      .getElementById('cookie-decline')
      ?.addEventListener('click', () => answer(false));

    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element | null)?.closest(
        '[data-cookie-settings]',
      );
      if (!trigger) return;
      event.preventDefault();
      open();
    });
  }
</script>
