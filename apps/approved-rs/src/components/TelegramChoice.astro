---
import { X } from '@lucide/astro';
import {
  TELEGRAM_CHOICE_ATTRIBUTE,
  TELEGRAM_CHOICE_SELECTOR,
} from '@podbor/site-kit/contact-control';
import { localeFrom } from '@/i18n/config';
import { getI18n } from '@/i18n/getI18n';
import { contactControl } from '@/utils/contactLinks';

const locale = localeFrom(Astro.url.pathname);
const { common, telegramChoice: copy } = getI18n(locale);
const tile = contactControl({ channel: 'telegram', onThanks: false, locale });
const managerHref = tile.attrs[TELEGRAM_CHOICE_ATTRIBUTE];
const options = [
  {
    attribute: 'data-telegram-choice-bot',
    href: tile.href,
    title: copy.bot,
    hint: copy.botHint,
    tone: 'border-accent-border bg-accent-subtle',
  },
  {
    attribute: 'data-telegram-choice-manager',
    href: managerHref,
    title: copy.manager,
    hint: copy.managerHint,
    tone: 'border-border-strong',
  },
];
---

{
  managerHref && (
    <telegram-choice trigger={TELEGRAM_CHOICE_SELECTOR}>
      <dialog
        aria-labelledby="telegram-choice-heading"
        class="m-0 mt-auto w-full max-w-none border-0 border-t border-border-strong bg-surface p-0 pb-[env(safe-area-inset-bottom)] text-text backdrop:bg-bg/60 backdrop:backdrop-blur-xs sm:m-auto sm:w-[90vw] sm:max-w-[24rem] sm:border"
      >
        <div class="flex items-start justify-between gap-4 p-5 pb-3">
          <h2 id="telegram-choice-heading" class="text-lg font-semibold">
            {copy.heading}
          </h2>
          <button
            type="button"
            data-modal-close
            aria-label={common.closeLabel}
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xs border border-border-strong text-muted transition-colors duration-200 hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:h-8 sm:w-8"
          >
            <X size={16} />
          </button>
        </div>
        <ul class="flex flex-col gap-2 p-5 pt-2">
          {options.map(({ attribute, href, title, hint, tone }) => (
            <li>
              <a
                {...{ [attribute]: '' }}
                href={href}
                target="_blank"
                rel="noopener"
                data-modal-close
                class:list={[
                  tone,
                  'flex min-h-11 flex-col gap-1 rounded-xs border px-4 py-3 transition-colors duration-200 hover:border-accent focus-visible:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
                ]}
              >
                <span class="font-medium">{title}</span>
                <span class="text-sm leading-snug text-muted">{hint}</span>
              </a>
            </li>
          ))}
        </ul>
      </dialog>
    </telegram-choice>
  )
}

<script>
  import { defineTelegramChoice } from '@podbor/site-kit/browser';

  defineTelegramChoice();
</script>
