---
import FormField from './FormField.astro';
import Button from './Button.astro';
import TelegramIcon from './icons/TelegramIcon.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import ViberIcon from './icons/ViberIcon.astro';
import { Phone, ChevronDown } from '@lucide/astro';
import { HONEYPOT_FIELD, SERVICE_FIELD } from '@podbor/lead-crm';
import { phoneCountryOptions } from '@podbor/lead-crm/phone';
import { content } from '@/i18n/content';
import { localeFrom, DISPLAY_LOCALE } from '@/i18n/config';
import { phoneCountryShortlist } from '@/utils/geo';
import { PathBuilder } from '@/utils/paths';
import { DATA_DEFAULT_SERVICE } from '@/utils/contactChannel';

interface Props {
  service?: string;
  country?: string;
  city?: string;
  commentLabel?: string;
  commentPlaceholder?: string;
}

const {
  service = '',
  country = '',
  city = '',
  commentLabel,
  commentPlaceholder,
} = Astro.props;
const sourceUrl = Astro.url.href;
const locale = localeFrom(Astro.url.pathname);
const lf = content(locale).leadForm;

const defaultPhoneCountry = 'RS';
const displayLocale = DISPLAY_LOCALE[locale];
const shortlist = phoneCountryShortlist();
const countryOptions = phoneCountryOptions(displayLocale).filter(
  (country) =>
    shortlist.has(country.iso) || country.iso === defaultPhoneCountry,
);

const uid = crypto.randomUUID().slice(0, 8);
const panelIds = {
  telegram: `contact-panel-telegram-${uid}`,
  phone: `contact-panel-phone-${uid}`,
};
const errorIds = {
  telegram: `contact-error-telegram-${uid}`,
  phone: `contact-error-phone-${uid}`,
  consent: `consent-error-${uid}`,
};

const channelTabs = [
  {
    tab: 'telegram',
    panel: 'telegram',
    label: lf.telegramTab,
    Icon: TelegramIcon,
  },
  {
    tab: 'whatsapp',
    panel: 'phone',
    label: lf.whatsappTab,
    Icon: WhatsAppIcon,
  },
  {
    tab: 'viber',
    panel: 'phone',
    label: lf.viberTab,
    Icon: ViberIcon,
  },
  {
    tab: 'phone',
    panel: 'phone',
    label: lf.phoneTab,
    Icon: Phone,
  },
] as const;

const fieldClass =
  'form-field py-3 rounded-sm text-sm outline-none bg-page border border-border-strong text-primary font-sans';
const errorClass = 'mt-[0.3rem] font-sans text-[0.72rem] text-[#dc2626]';
---

<div
  class="rounded-sm p-7 bg-surface-glass border border-border-strong backdrop-blur-[12px] in-[dialog]:min-h-0 in-[dialog]:overflow-y-auto in-[dialog]:overscroll-contain in-[dialog]:max-sm:flex-1 in-[dialog]:max-sm:rounded-none in-[dialog]:max-sm:border-0"
>
  <div class="mb-6">
    <h2 class="font-display text-2xl leading-snug text-primary mb-1">
      {lf.headingLine1}<br /><em>{lf.headingEmphasis}</em>
    </h2>
    <p class="text-xs text-muted">{lf.subtext}</p>
  </div>

  <lead-form class="contents">
    <form
      method="POST"
      action="/api/leads"
      data-lead-form
      {...{ [DATA_DEFAULT_SERVICE]: service }}
      class="ym-hide-content ym-disable-keys"
    >
      <input type="hidden" name="locale" value={locale} />
      <div class="hidden" aria-hidden="true">
        <label>
          {HONEYPOT_FIELD}
          <input
            type="text"
            name={HONEYPOT_FIELD}
            tabindex="-1"
            autocomplete="off"
          />
        </label>
      </div>
      <input type="hidden" name={SERVICE_FIELD} value={service} />
      <input type="hidden" name="country" value={country} />
      <input type="hidden" name="city" value={city} />
      <input
        type="hidden"
        name="source_url"
        value={sourceUrl}
        data-source-url
      />
      <input type="hidden" name="visitor_id" data-visitor-id />

      <div class="mb-5">
        <label
          class="block text-xs font-medium mb-2 tracking-[0.14em] uppercase text-muted"
        >
          {lf.contactLabel}<span class="text-accent ml-0.5">*</span>
        </label>

        <div
          class="grid grid-cols-2 gap-1 p-1 mb-2 rounded-sm bg-page border border-border-strong"
          role="tablist"
        >
          {
            channelTabs.map((tab, index) => (
              <button
                type="button"
                data-tab={tab.tab}
                data-panel={tab.panel}
                title={tab.label}
                aria-label={tab.label}
                class="flex min-w-0 items-center justify-center gap-2 rounded-sm px-2 py-2.5 text-[0.8125rem] font-medium text-muted cursor-pointer transition-colors duration-200 motion-reduce:transition-none hover:text-text-2 aria-selected:bg-surface-2 aria-selected:text-text aria-selected:shadow-[inset_0_-2px_0_var(--color-accent)]"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={panelIds[tab.panel]}
              >
                <tab.Icon size={16} />
                <span class="truncate">{tab.label}</span>
              </button>
            ))
          }
        </div>

        <div id={panelIds.telegram} data-panel="telegram" role="tabpanel">
          <input
            type="text"
            data-telegram
            data-field="telegram"
            autocomplete="username"
            aria-describedby={errorIds.telegram}
            placeholder={lf.telegramPlaceholder}
            class={`${fieldClass} w-full px-4`}
          />
          <p
            id={errorIds.telegram}
            class={errorClass}
            aria-live="polite"
            data-error-telegram
            hidden
          >
            {lf.errorTelegramFormat}
          </p>
        </div>

        <div id={panelIds.phone} data-panel="phone" role="tabpanel" hidden>
          <div class="flex gap-2">
            <div class="relative min-w-0 max-w-[min(14rem,45%)] shrink-0">
              <select
                data-country
                data-display-locale={displayLocale}
                class={`${fieldClass} max-w-full pl-2 pr-6 appearance-none cursor-pointer overflow-hidden text-ellipsis`}
              >
                {
                  countryOptions.map((c) => (
                    <option
                      value={c.iso}
                      data-dial={c.dial}
                      data-dial-primary={c.primary ? '' : undefined}
                      selected={c.iso === defaultPhoneCountry}
                    >
                      {c.flag} +{c.dial} {c.name}
                    </option>
                  ))
                }
              </select>
              <ChevronDown
                size={14}
                class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-muted"
              />
            </div>
            <input
              type="tel"
              name="phone_number"
              autocomplete="tel"
              data-phone
              data-field="phone"
              aria-describedby={errorIds.phone}
              inputmode="tel"
              placeholder="060 123 4567"
              class={`${fieldClass} min-w-0 flex-1 px-4`}
            />
          </div>
          <p
            id={errorIds.phone}
            class={errorClass}
            aria-live="polite"
            data-error-phone
            hidden
          >
            {lf.errorPhoneInvalid}
          </p>
        </div>

        <input type="hidden" name="contact" />
        <input type="hidden" name="contact_channel" value="telegram" />
      </div>

      <FormField
        name="name"
        field="name"
        autocomplete="name"
        label={lf.nameLabel}
        placeholder={lf.namePlaceholder}
      />

      <FormField
        name="comment"
        label={commentLabel ?? lf.commentLabel}
        placeholder={commentPlaceholder ?? lf.commentPlaceholder}
        type="textarea"
      />

      <div>
        <label class="flex items-start gap-3 mb-3 cursor-pointer text-muted">
          <input
            type="checkbox"
            name="consent"
            required
            aria-describedby={errorIds.consent}
            data-consent
            data-field="consent"
            class="mt-0.5 shrink-0 w-4 h-4 cursor-pointer accent-accent"
          />
          <span class="text-xs leading-relaxed">
            {lf.consentBefore}<a
              href={PathBuilder.privacy(locale)}
              target="_blank"
              class="underline text-muted">{lf.consentLinkText}</a
            >
          </span>
        </label>
        <p
          id={errorIds.consent}
          class={`${errorClass} mb-3`}
          aria-live="polite"
          data-error-consent
          hidden
        >
          {lf.consentError}
        </p>
        <p class={`${errorClass} mb-3`} role="alert" data-error-submit hidden>
          {lf.errorSubmit}
        </p>

        <Button
          type="submit"
          class="w-full py-3.5 justify-center tracking-[0.06em]"
        >
          <span data-submit-label>{lf.submitLabel}</span>
        </Button>
      </div>
    </form>
  </lead-form>
</div>
