---
import FormField from './FormField.astro';
import Button from './Button.astro';
import TelegramIcon from './icons/TelegramIcon.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import ViberIcon from './icons/ViberIcon.astro';
import { Phone, ChevronDown } from '@lucide/astro';
import { HONEYPOT_FIELD, SERVICE_FIELD } from '@podbor/lead-crm';
import { phoneCountryOptions } from '@podbor/lead-crm/phone';
import { getLeadFormContent } from '@/i18n/content/leadForm';
import { getLocale, DISPLAY_LOCALE } from '@/i18n/config';
import { phoneCountryShortlist } from '@/utils/geo';
import { PathBuilder } from '@/utils/paths';

interface Props {
  service?: string;
  country?: string;
  city?: string;
  commentLabel?: string;
  commentPlaceholder?: string;
}

const {
  service = '',
  country = '',
  city = '',
  commentLabel,
  commentPlaceholder,
} = Astro.props;
const sourceUrl = Astro.url.href;
const locale = getLocale(Astro.currentLocale);
const lf = getLeadFormContent(locale);

const defaultPhoneCountry = 'RS';
const displayLocale = DISPLAY_LOCALE[locale];
const shortlist = phoneCountryShortlist();
const countryOptions = phoneCountryOptions(displayLocale).filter(
  (country) =>
    shortlist.has(country.iso) || country.iso === defaultPhoneCountry,
);

const uid = crypto.randomUUID().slice(0, 8);
const telegramPanelId = `contact-panel-telegram-${uid}`;
const phonePanelId = `contact-panel-phone-${uid}`;

const fieldClass =
  'form-field py-3 rounded-sm text-sm outline-none bg-page border border-border-strong text-primary font-sans';
---

<div
  class="lead-form-card rounded-sm p-7 bg-surface-glass border border-border-strong backdrop-blur-[12px]"
>
  <div class="mb-6">
    <h2 class="font-display text-2xl leading-snug text-primary mb-1">
      {lf.headingLine1}<br /><em>{lf.headingEmphasis}</em>
    </h2>
    <p class="text-xs text-muted">{lf.subtext}</p>
  </div>

  <form
    method="POST"
    action="/api/leads"
    novalidate
    data-lead-form
    data-err-tg-required={lf.errorTelegramRequired}
    data-err-tg-format={lf.errorTelegramFormat}
    data-err-phone-required={lf.errorPhoneRequired}
    data-err-phone-invalid={lf.errorPhoneInvalid}
    class="ym-hide-content ym-disable-keys"
  >
    <input type="hidden" name="locale" value={locale} />
    <div class="hidden" aria-hidden="true">
      <label>
        {HONEYPOT_FIELD}
        <input
          type="text"
          name={HONEYPOT_FIELD}
          tabindex="-1"
          autocomplete="off"
        />
      </label>
    </div>
    <input type="hidden" name={SERVICE_FIELD} value={service} />
    <input type="hidden" name="country" value={country} />
    <input type="hidden" name="city" value={city} />
    <input type="hidden" name="source_url" value={sourceUrl} />
    <input type="hidden" name="visitor_id" />

    <div class="mb-5 contact-field">
      <label
        class="block text-xs font-medium mb-2 tracking-[0.14em] uppercase text-muted"
      >
        {lf.contactLabel}<span class="text-accent ml-0.5">*</span>
      </label>

      <div
        class="contact-tabs relative flex gap-1 p-1 mb-2 rounded-sm bg-page border border-border-strong"
        role="tablist"
      >
        <button
          type="button"
          data-tab="telegram"
          data-panel="telegram"
          title={lf.telegramTab}
          aria-label={lf.telegramTab}
          class="pill-tab relative z-10 flex items-center justify-center flex-1 py-2 rounded-sm cursor-pointer"
          role="tab"
          aria-selected="true"
          aria-controls={telegramPanelId}
        >
          <TelegramIcon size={16} />
          <span class="pill-tab-label">{lf.telegramTab}</span>
        </button>
        <button
          type="button"
          data-tab="whatsapp"
          data-panel="phone"
          title={lf.whatsappTab}
          aria-label={lf.whatsappTab}
          class="pill-tab relative z-10 flex items-center justify-center flex-1 py-2 rounded-sm cursor-pointer"
          role="tab"
          aria-selected="false"
          aria-controls={phonePanelId}
        >
          <WhatsAppIcon size={16} />
          <span class="pill-tab-label">{lf.whatsappTab}</span>
        </button>
        <button
          type="button"
          data-tab="viber"
          data-panel="phone"
          title={lf.viberTab}
          aria-label={lf.viberTab}
          class="pill-tab relative z-10 flex items-center justify-center flex-1 py-2 rounded-sm cursor-pointer"
          role="tab"
          aria-selected="false"
          aria-controls={phonePanelId}
        >
          <ViberIcon size={16} />
          <span class="pill-tab-label">{lf.viberTab}</span>
        </button>
        <button
          type="button"
          data-tab="phone"
          data-panel="phone"
          title={lf.phoneTab}
          aria-label={lf.phoneTab}
          class="pill-tab relative z-10 flex items-center justify-center flex-1 py-2 rounded-sm cursor-pointer"
          role="tab"
          aria-selected="false"
          aria-controls={phonePanelId}
        >
          <Phone size={15} />
          <span class="pill-tab-label">{lf.phoneTab}</span>
        </button>
      </div>

      <div
        id={telegramPanelId}
        class="contact-panel"
        data-panel="telegram"
        role="tabpanel"
      >
        <input
          type="text"
          data-contact-telegram
          data-field="telegram"
          name="contact"
          placeholder="@username"
          class={`${fieldClass} w-full px-4`}
        />
      </div>

      <div
        id={phonePanelId}
        class="contact-panel hidden"
        data-panel="phone"
        role="tabpanel"
      >
        <div class="flex gap-2">
          <div class="relative min-w-0 max-w-[min(14rem,45%)] shrink-0">
            <select
              data-contact-phone-country
              data-display-locale={displayLocale}
              class={`${fieldClass} max-w-full pl-2 pr-6 appearance-none cursor-pointer overflow-hidden text-ellipsis`}
            >
              {
                countryOptions.map((c) => (
                  <option
                    value={c.iso}
                    data-dial={c.dial}
                    data-dial-primary={c.primary ? '' : undefined}
                    selected={c.iso === defaultPhoneCountry}
                  >
                    {c.flag} +{c.dial} {c.name}
                  </option>
                ))
              }
            </select>
            <ChevronDown
              size={14}
              class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-muted"
            />
          </div>
          <input
            type="tel"
            data-contact-phone-number
            data-field="phone"
            inputmode="tel"
            placeholder="060 123 4567"
            class={`${fieldClass} min-w-0 flex-1 px-4`}
          />
        </div>
      </div>

      <input type="hidden" name="contact" />
      <input type="hidden" name="contact_channel" value="telegram" />
    </div>

    <FormField
      name="name"
      field="name"
      label={lf.nameLabel}
      placeholder={lf.namePlaceholder}
    />

    <FormField
      name="comment"
      label={commentLabel ?? lf.commentLabel}
      placeholder={commentPlaceholder ?? lf.commentPlaceholder}
      type="textarea"
    />

    <div>
      <label
        class="flex items-start gap-3 mb-3 cursor-pointer text-muted consent-label"
      >
        <input
          type="checkbox"
          name="consent"
          data-field="consent"
          class="mt-0.5 shrink-0 w-4 h-4 cursor-pointer accent-accent"
        />
        <span class="text-xs leading-relaxed">
          {lf.consentBefore}<a
            href={PathBuilder.privacy(locale)}
            target="_blank"
            class="underline text-muted">{lf.consentLinkText}</a
          >
        </span>
      </label>
      <p class="field-error consent-error mb-3" style="display:none">
        {lf.consentError}
      </p>

      <Button
        type="submit"
        class="lead-btn w-full py-3.5 justify-center tracking-[0.06em]"
      >
        {lf.submitLabel}
      </Button>
    </div>
  </form>
</div>

<script>
  import type { CountryCode } from 'libphonenumber-js/min';
  import { composeE164 } from '@podbor/lead-crm/compose-e164';
  import {
    bindPhoneCountry,
    fillCountrySelect,
  } from '@podbor/lead-crm/phone-input';
  import {
    deferSubmitUntilKit,
    loadPhoneKit,
    phoneKit,
  } from '@podbor/lead-crm/phone-kit';
  import {
    isTrackedContactChannel,
    detectVisitorCountry,
    preferredContactChannel,
    type TrackedContactChannel,
  } from '@/utils/contactChannel';
  import { markFieldValidity } from '@podbor/site-kit/browser';
  import { getOrCreateVisitorId } from '@/utils/visitorId';

  // A page can have more than one LeadForm instance (e.g. a page-level form
  // plus the header's "Оставить заявку" modal) — Astro only emits this
  // <script> once per page regardless, so it must initialize every card.
  function initAllLeadForms() {
    document
      .querySelectorAll<HTMLElement>('.lead-form-card')
      .forEach((card) => {
        const form = card.querySelector<HTMLFormElement>('form');
        if (form && !form.dataset.validated) {
          form.dataset.validated = '1';
          initLeadForm(form);
        }
      });
  }
  initAllLeadForms();

  function initLeadForm(form: HTMLFormElement) {
    const visitorIdInput = form.querySelector<HTMLInputElement>(
      'input[type="hidden"][name="visitor_id"]',
    );

    const errTgRequired = form.dataset.errTgRequired!;
    const errTgFormat = form.dataset.errTgFormat!;
    const errPhoneRequired = form.dataset.errPhoneRequired!;
    const errPhoneInvalid = form.dataset.errPhoneInvalid!;

    function fieldWrap(input: HTMLElement) {
      return input.closest('.mb-5') || input.parentElement!;
    }

    function setError(input: HTMLElement, msg: string) {
      input.classList.add('has-error');
      markFieldValidity(input, false);
      const wrap = fieldWrap(input);
      let err = wrap.querySelector('.field-error');
      if (!err) {
        err = document.createElement('p');
        err.className = 'field-error';
        wrap.appendChild(err);
      }
      err.textContent = msg;
    }

    function clearError(input: HTMLElement) {
      input.classList.remove('has-error');
      markFieldValidity(input, true);
      const err = fieldWrap(input).querySelector('.field-error');
      if (err) err.remove();
    }

    // ── Contact switcher (Telegram / Phone) ──
    const contactField = form.querySelector('.contact-field')!;
    const tabs = contactField.querySelectorAll<HTMLButtonElement>('.pill-tab');
    const panels = contactField.querySelectorAll<HTMLElement>('.contact-panel');
    const hiddenContact = form.querySelector<HTMLInputElement>(
      'input[type="hidden"][name="contact"]',
    )!;
    const hiddenChannel = form.querySelector<HTMLInputElement>(
      'input[type="hidden"][name="contact_channel"]',
    )!;
    const tgInput = contactField.querySelector<HTMLInputElement>(
      '[data-contact-telegram]',
    )!;
    const phoneCountry = contactField.querySelector<HTMLSelectElement>(
      '[data-contact-phone-country]',
    )!;
    const phoneNumber = contactField.querySelector<HTMLInputElement>(
      '[data-contact-phone-number]',
    )!;
    const consent = form.querySelector<HTMLInputElement>('[name="consent"]')!;
    const consentErr = form.querySelector<HTMLElement>('.consent-error');

    // progressive enhancement: the Telegram field ships with name="contact"
    // so the form still submits something if this script never runs (ad
    // blocker, disabled JS, failed dynamic import). Once we're here, JS is
    // confirmed working, so hand control to the hidden field exclusively —
    // otherwise the two same-named fields would collide on submit.
    tgInput.removeAttribute('name');

    // WhatsApp/Viber/phone-call all collect the same shape of data (a phone
    // number) — they share the "phone" panel and its validation, and only
    // differ in which channel gets recorded for staff to reach back out on.
    const PANEL_FOR: Record<TrackedContactChannel, 'telegram' | 'phone'> = {
      telegram: 'telegram',
      whatsapp: 'phone',
      viber: 'phone',
      phone: 'phone',
    };
    let activeTab: TrackedContactChannel = 'telegram';

    const detectedCountry = detectVisitorCountry();
    if (detectedCountry) phoneCountry.value = detectedCountry.toUpperCase();

    bindPhoneCountry(phoneCountry, phoneNumber);

    const expandCountries = () =>
      loadPhoneKit().then(() => {
        const kit = phoneKit();
        if (kit)
          fillCountrySelect(
            phoneCountry,
            kit.countryOptions(phoneCountry.dataset.displayLocale ?? 'ru'),
          );
      });

    function dialCode() {
      return phoneCountry.selectedOptions[0]?.dataset.dial ?? '';
    }

    // ponytail: re-mask from raw digits on every keystroke instead of a
    // caret-aware stateful mask — simpler, good enough for a lead form.
    function formatPhone() {
      const kit = phoneKit();
      if (!kit) return;
      const value = phoneNumber.value;
      if (value.trim().startsWith('+')) {
        const digits = '+' + value.replace(/[^\d]/g, '');
        phoneNumber.value = new kit.AsYouType().input(digits);
        return;
      }
      const raw = value.replace(/[^\d]/g, '');
      phoneNumber.value = new kit.AsYouType(
        phoneCountry.value as CountryCode,
      ).input(raw);
    }

    function syncContact() {
      hiddenChannel.value = activeTab;
      if (activeTab === 'telegram') {
        hiddenContact.value = tgInput.value.trim();
      } else if (phoneKit()) {
        const parsed = phoneKit()!.parse(
          phoneNumber.value,
          phoneCountry.value as CountryCode,
        );
        hiddenContact.value = parsed ? parsed.number : phoneNumber.value.trim();
      } else {
        hiddenContact.value = composeE164(phoneNumber.value.trim(), dialCode());
      }
    }

    // Shared by the click handler below and the region-based auto-select
    // right after it — same tab-activation work either way, only whether
    // focus jumps into the newly-shown field differs (auto-selecting on
    // page load shouldn't steal focus or pop the mobile keyboard the way a
    // real click should).
    function selectTab(tab: HTMLButtonElement, focusField: boolean) {
      activeTab = isTrackedContactChannel(tab.dataset.tab)
        ? tab.dataset.tab
        : 'telegram';
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      const panel = PANEL_FOR[activeTab];
      panels.forEach((p) =>
        p.classList.toggle('hidden', p.dataset.panel !== panel),
      );
      clearError(tgInput);
      clearError(phoneNumber);
      syncContact();
      if (focusField) (panel === 'telegram' ? tgInput : phoneNumber).focus();
    }

    form.addEventListener('pointerenter', () => void expandCountries(), {
      once: true,
    });

    tabs.forEach((tab) => {
      tab.addEventListener('click', (event) => {
        selectTab(tab, event.isTrusted);
        if (PANEL_FOR[activeTab] === 'phone') void expandCountries();
      });
    });

    const preferredChannel = preferredContactChannel(
      detectedCountry,
      document.documentElement.lang,
    );
    if (preferredChannel !== 'telegram') {
      const preferredTab = Array.from(tabs).find(
        (t) => t.dataset.tab === preferredChannel,
      );
      if (preferredTab) selectTab(preferredTab, false);
    }

    tgInput.addEventListener('input', () => {
      clearError(tgInput);
      syncContact();
    });
    tgInput.addEventListener('blur', () => {
      const v = tgInput.value.trim();
      if (v && !v.startsWith('@')) {
        tgInput.value = '@' + v;
        syncContact();
      }
    });
    phoneNumber.addEventListener('input', () => {
      formatPhone();
      clearError(phoneNumber);
      syncContact();
    });
    phoneCountry.addEventListener('change', (event) => {
      // if the field holds international "+..." text, the user picking a
      // different country is overriding the auto-detect — drop the stale
      // text instead of silently re-showing a number for the old country.
      if (phoneNumber.value.trim().startsWith('+')) phoneNumber.value = '';
      formatPhone();
      syncContact();
      if (event.isTrusted) phoneNumber.focus();
    });

    form.addEventListener(
      'focusin',
      () => {
        expandCountries().then(() => {
          // Re-masking would rewrite the field and drop the caret to the end,
          // and on the slow connection this lazy load exists for the visitor
          // is already typing by now.
          if (phoneNumber !== document.activeElement) formatPhone();
          syncContact();
        });
      },
      { once: true },
    );

    form.addEventListener('submit', (e) => {
      if (deferSubmitUntilKit(form)) {
        e.preventDefault();
        return;
      }
      const kit = phoneKit();
      // Read at send time, not at init: a visitor who refuses after the page
      // renders would otherwise still post the id baked into the field.
      if (visitorIdInput) visitorIdInput.value = getOrCreateVisitorId();

      const isTelegram = activeTab === 'telegram';
      const contactInput = isTelegram ? tgInput : phoneNumber;
      const typed = contactInput.value.trim();
      if (isTelegram && typed && !typed.startsWith('@')) {
        tgInput.value = '@' + typed;
      }
      syncContact();

      let ok = true;
      if (!typed) {
        setError(contactInput, isTelegram ? errTgRequired : errPhoneRequired);
        ok = false;
      } else if (kit && !kit.isValidContact(hiddenContact.value, activeTab)) {
        setError(contactInput, isTelegram ? errTgFormat : errPhoneInvalid);
        ok = false;
      } else clearError(contactInput);

      if (consentErr) consentErr.style.display = consent.checked ? 'none' : '';
      markFieldValidity(consent, consent.checked);
      if (!consent.checked) ok = false;

      if (!ok) {
        e.preventDefault();
        return;
      }

      // Native form submit → full-page navigation to /thanks/ once the
      // server redirects, so there's no "success" handler to clear this —
      // the button just leaves the page. The timeout is only a safety net
      // for the rare case the browser never navigates (e.g. offline).
      const submitBtn = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      );
      submitBtn?.classList.add('is-loading');
      submitBtn?.setAttribute('disabled', 'true');
      // is-loading hides the label visually (see global.css) — aria-busy is
      // what actually tells a screen reader the button is doing something,
      // since the hidden label alone drops it from the accessible name.
      submitBtn?.setAttribute('aria-busy', 'true');
      setTimeout(() => {
        submitBtn?.classList.remove('is-loading');
        submitBtn?.removeAttribute('disabled');
        submitBtn?.removeAttribute('aria-busy');
      }, 10000);
    });

    if (consentErr) {
      consent.addEventListener('change', () => {
        consentErr.style.display = consent.checked ? 'none' : '';
        markFieldValidity(consent, consent.checked);
      });
    }

    syncContact();
  }
</script>

<style>
  /* Tabs size to their own content, so growing the active tab's label is what
     animates every width in the row — no measuring, no JS. */
  .contact-tabs :global(.pill-tab) {
    flex: 1 1 auto;
    min-width: 0;
    color: var(--color-muted);
    transition:
      color 0.25s,
      background-color 0.25s;
  }

  .contact-tabs :global(.pill-tab[aria-selected='true']) {
    color: var(--color-text);
    background-color: var(--color-surface-2);
    /* inset, not a border: a real border would change the row's height */
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  .contact-tabs :global(.pill-tab:hover:not([aria-selected='true'])) {
    color: var(--color-text-2);
  }

  .pill-tab-label {
    max-width: 0;
    margin-left: 0;
    overflow: hidden;
    opacity: 0;
    white-space: nowrap;
    font-size: 0.8125rem;
    font-weight: 500;
    transition:
      max-width 0.32s var(--ease-spring),
      margin-left 0.32s var(--ease-spring),
      opacity 0.2s ease-out;
  }

  :global(.pill-tab[aria-selected='true']) .pill-tab-label {
    max-width: 6rem;
    margin-left: 0.5rem;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-tabs :global(.pill-tab),
    .pill-tab-label {
      transition: none;
    }
  }
</style>
