---
import type { HTMLAttributes } from 'astro/types';
import { formatPhone } from '@podbor/site-kit/format-phone';
import {
  COPY_PHONE_DIGITS_ATTRIBUTE,
  COPY_PHONE_NUMBER_ATTRIBUTE,
  COPY_PHONE_STATUS_ATTRIBUTE,
} from '@podbor/site-kit/browser';
import { getI18n } from '@/i18n/getI18n';
import { localeFrom } from '@/i18n/config';
import { PHONE_NUMBER } from '@/utils/constants';

interface Props extends Omit<HTMLAttributes<'button'>, 'type' | 'class'> {
  copy?: boolean;
}

const { copy, ...tracking } = Astro.props;
const digits = formatPhone(PHONE_NUMBER);
const { copyPhone } = getI18n(localeFrom(Astro.url.pathname));
---

{
  copy ? (
    <copy-phone
      class="group relative inline-flex"
      {...{ [COPY_PHONE_NUMBER_ATTRIBUTE]: `+${PHONE_NUMBER}` }}
    >
      <button
        {...tracking}
        type="button"
        class="cursor-copy whitespace-nowrap rounded-sm decoration-accent-border decoration-dotted underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <span class="sr-only">{copyPhone.label}</span>{' '}
        <span
          class="select-text group-has-[[aria-live]:not(:empty)]:invisible"
          {...{ [COPY_PHONE_DIGITS_ATTRIBUTE]: '' }}
        >
          {digits}
        </span>
      </button>
      <span
        aria-live="polite"
        class="pointer-events-none absolute inset-0 flex items-center whitespace-nowrap font-medium text-accent empty:invisible empty:opacity-0 motion-safe:transition-opacity motion-safe:duration-200"
        {...{ [COPY_PHONE_STATUS_ATTRIBUTE]: copyPhone.copied }}
      />
    </copy-phone>
  ) : (
    <span class="whitespace-nowrap">{digits}</span>
  )
}

<script>
  import { defineCopyPhone } from '@podbor/site-kit/browser';

  defineCopyPhone();
</script>
