---
import { ChevronDown } from '@lucide/astro';

interface Props {
  id: string;
  align?: 'left' | 'right';
  minWidth?: string;
  menuRole?: 'menu' | 'listbox';
  triggerClass?: string;
  active?: boolean;
}

const {
  id,
  align = 'left',
  minWidth = '9.5rem',
  menuRole = 'menu',
  triggerClass = '',
  active = false,
} = Astro.props;
---

<div class="dropdown relative">
  <button
    type="button"
    class:list={[
      `dropdown-trigger flex items-center gap-1 rounded-sm text-muted ${triggerClass}`,
      { 'dropdown-trigger-active': active },
    ]}
    aria-haspopup="true"
    popovertarget={id}
  >
    <slot name="trigger" />
    <ChevronDown size={13} class="dropdown-chevron" />
  </button>

  <ul
    id={id}
    popover
    class="dropdown-menu"
    style={`min-width:${minWidth}`}
    data-align={align}
    role={menuRole}
  >
    <slot />
  </ul>
</div>
