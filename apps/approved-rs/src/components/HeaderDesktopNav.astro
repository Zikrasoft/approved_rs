---
import type { Search } from '@lucide/astro';

export interface NavItem {
  href: string;
  label: string;
  slug: string;
  Icon: typeof Search;
  active: boolean;
}

interface Props {
  navItems: NavItem[];
  casesHref: string;
  casesLabel: string;
  casesActive: boolean;
}

const { navItems, casesHref, casesLabel, casesActive } = Astro.props;
---

<nav
  class="hidden xl:flex items-center gap-1 text-sm font-sans font-normal header-nav flex-1 justify-center min-w-0"
>
  {
    navItems.map((item) => (
      <a
        href={item.href}
        class="flex items-center px-1.5 py-1.5 rounded-sm text-muted whitespace-nowrap"
        aria-current={item.active ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))
  }

  <a
    href={casesHref}
    class="px-1.5 py-1.5 text-muted whitespace-nowrap"
    aria-current={casesActive ? 'page' : undefined}>{casesLabel}</a
  >
</nav>

<style>
  .header-nav > a {
    position: relative;
    padding-bottom: 2px;
    transition: color 0.2s;
  }
  .header-nav > a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-spring);
  }
  .header-nav > a:hover {
    color: var(--color-text) !important;
  }
  .header-nav > a:hover::after {
    transform: scaleX(1);
  }
  .header-nav > a[aria-current='page'] {
    color: var(--color-text) !important;
  }
  .header-nav > a[aria-current='page']::after {
    transform: scaleX(1);
  }
</style>
