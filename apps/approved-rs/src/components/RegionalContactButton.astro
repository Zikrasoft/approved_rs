---
import Button from './Button.astro';
import ContactIcon from './ContactIcon.astro';
import { telegramLink } from '@/utils/telegramLink';
import { whatsappLink } from '@/utils/contactLinks';
import { TG_MANAGER, WHATSAPP_NUMBER } from '@/utils/constants';
import { DATA_OPEN_PAGE_LEAD_MODAL } from '@/utils/contactChannel';

interface Props {
  telegramLabel: string;
  whatsappLabel: string;
  manager?: string;
  openModal?: boolean;
  class?: string;
}

const {
  telegramLabel,
  whatsappLabel,
  manager = TG_MANAGER,
  openModal = false,
  class: className,
} = Astro.props;
---

<div data-primary-contact class="contents">
  <Button
    data-primary-channel="telegram"
    data-contact-channel="telegram"
    {...{ [DATA_OPEN_PAGE_LEAD_MODAL]: openModal ? true : undefined }}
    href={openModal ? undefined : telegramLink(manager)}
    target={openModal ? undefined : '_blank'}
    rel={openModal ? undefined : 'noopener'}
    class={className}
  >
    <ContactIcon channel="telegram" size={16} />
    {telegramLabel}
  </Button>
  <Button
    data-primary-channel="whatsapp"
    data-contact-channel="whatsapp"
    {...{ [DATA_OPEN_PAGE_LEAD_MODAL]: openModal ? true : undefined }}
    href={openModal ? undefined : whatsappLink(WHATSAPP_NUMBER)}
    target={openModal ? undefined : '_blank'}
    rel={openModal ? undefined : 'noopener'}
    hidden
    class={className}
  >
    <ContactIcon channel="whatsapp" size={16} />
    {whatsappLabel}
  </Button>
</div>
