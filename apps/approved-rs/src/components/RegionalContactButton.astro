---
import Button from './Button.astro';
import ContactIcon from './ContactIcon.astro';
import { telegramLink, whatsappLink } from '@/utils/contactLinks';
import { getServicesContent } from '@/i18n/content/services';
import { getLocale } from '@/i18n/config';
import { TG_MANAGER, WHATSAPP_NUMBER } from '@/utils/constants';

interface Props {
  manager?: string;
  class?: string;
}

const cc = getServicesContent(getLocale(Astro.currentLocale)).caseChrome;
const { manager = TG_MANAGER, class: className } = Astro.props;
---

<div data-primary-contact class="contents">
  <Button
    data-primary-channel="telegram"
    data-contact-channel="telegram"
    href={telegramLink(manager, cc.messengerPrefill)}
    target="_blank"
    rel="noopener"
    class={className}
  >
    <ContactIcon channel="telegram" size={16} />
    {cc.ctaButtonLabel}
  </Button>
  <Button
    data-primary-channel="whatsapp"
    data-contact-channel="whatsapp"
    href={whatsappLink(WHATSAPP_NUMBER, cc.messengerPrefill)}
    target="_blank"
    rel="noopener"
    hidden
    class={className}
  >
    <ContactIcon channel="whatsapp" size={16} />
    {cc.whatsappButtonLabel}
  </Button>
</div>
