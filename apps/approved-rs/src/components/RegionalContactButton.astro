---
import Button from './Button.astro';
import ContactIcon from './ContactIcon.astro';
import { telegramLink } from '@/utils/telegramLink';
import { whatsappLink } from '@/utils/contactLinks';
import { TG_MANAGER, WHATSAPP_NUMBER } from '@/utils/constants';
import {
  DATA_OPEN_LEAD_MODAL,
  DATA_OPEN_PAGE_LEAD_MODAL,
} from '@/utils/contactChannel';

interface Props {
  telegramLabel: string;
  whatsappLabel: string;
  manager?: string;
  openModal?: boolean;
  class?: string;
}

const {
  telegramLabel,
  whatsappLabel,
  manager = TG_MANAGER,
  openModal = false,
  class: className,
} = Astro.props;

const modalTrigger = openModal
  ? DATA_OPEN_PAGE_LEAD_MODAL
  : DATA_OPEN_LEAD_MODAL;
---

<div data-primary-contact class="contents">
  <Button
    data-primary-channel="telegram"
    data-contact-channel="telegram"
    {...{ [modalTrigger]: 'telegram' }}
    href={telegramLink(manager)}
    target="_blank"
    rel="noopener"
    class={className}
  >
    <ContactIcon channel="telegram" size={16} />
    {telegramLabel}
  </Button>
  <Button
    data-primary-channel="whatsapp"
    data-contact-channel="whatsapp"
    {...{ [modalTrigger]: 'whatsapp' }}
    href={whatsappLink(WHATSAPP_NUMBER)}
    target="_blank"
    rel="noopener"
    hidden
    class={className}
  >
    <ContactIcon channel="whatsapp" size={16} />
    {whatsappLabel}
  </Button>
</div>
