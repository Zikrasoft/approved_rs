---
import ContactControl from './ContactControl.astro';
import ContactIcon from './ContactIcon.astro';
import { servicesView } from '@/i18n/content/services';
import { localeFrom } from '@/i18n/config';

interface Props {
  service?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const cc = servicesView(localeFrom(Astro.url.pathname)).caseChrome;
const { service, variant = 'primary', class: className } = Astro.props;
---

<div data-primary-contact class="contents">
  <ContactControl
    channel="telegram"
    {service}
    {variant}
    data-primary-channel="telegram"
    class={className}
  >
    <ContactIcon channel="telegram" size={16} />
    {cc.ctaButtonLabel}
  </ContactControl>
  <ContactControl
    channel="whatsapp"
    {service}
    {variant}
    data-primary-channel="whatsapp"
    hidden
    class={className}
  >
    <ContactIcon channel="whatsapp" size={16} />
    {cc.whatsappButtonLabel}
  </ContactControl>
</div>
