---
import Button from './Button.astro';
import ContactIcon from './ContactIcon.astro';
import { telegramLink, whatsappLink } from '@/utils/contactLinks';
import { TG_MANAGER, WHATSAPP_NUMBER } from '@/utils/constants';

interface Props {
  telegramLabel: string;
  whatsappLabel: string;
  prefill: string;
  manager?: string;
  class?: string;
}

const {
  telegramLabel,
  whatsappLabel,
  prefill,
  manager = TG_MANAGER,
  class: className,
} = Astro.props;
---

<div data-primary-contact class="contents">
  <Button
    data-primary-channel="telegram"
    data-contact-channel="telegram"
    href={telegramLink(manager, prefill)}
    target="_blank"
    rel="noopener"
    class={className}
  >
    <ContactIcon channel="telegram" size={16} />
    {telegramLabel}
  </Button>
  <Button
    data-primary-channel="whatsapp"
    data-contact-channel="whatsapp"
    href={whatsappLink(WHATSAPP_NUMBER, prefill)}
    target="_blank"
    rel="noopener"
    hidden
    class={className}
  >
    <ContactIcon channel="whatsapp" size={16} />
    {whatsappLabel}
  </Button>
</div>
