---
import Button from './Button.astro';
import ContactIcon from './ContactIcon.astro';
import { messengerHrefs } from '@/utils/messengerHrefs';
import { getServicesContent } from '@/i18n/content/services';
import { getLocale } from '@/i18n/config';

interface Props {
  service?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const locale = getLocale(Astro.currentLocale);
const cc = getServicesContent(locale).caseChrome;
const { service, variant = 'primary', class: className } = Astro.props;
const messenger = messengerHrefs(locale, service);
---

<div data-primary-contact class="contents">
  <Button
    {variant}
    data-primary-channel="telegram"
    data-contact-channel="telegram"
    href={messenger.telegram}
    target="_blank"
    rel="noopener"
    class={className}
  >
    <ContactIcon channel="telegram" size={16} />
    {cc.ctaButtonLabel}
  </Button>
  <Button
    {variant}
    data-primary-channel="whatsapp"
    data-contact-channel="whatsapp"
    href={messenger.whatsapp}
    target="_blank"
    rel="noopener"
    hidden
    class={className}
  >
    <ContactIcon channel="whatsapp" size={16} />
    {cc.whatsappButtonLabel}
  </Button>
</div>
