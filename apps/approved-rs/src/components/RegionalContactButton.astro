---
import ContactControl from './ContactControl.astro';
import ContactIcon from './ContactIcon.astro';
import { getServices } from '@/i18n/content/services';
import { getLocale } from '@/i18n/config';
import type { ContactPlacement } from '@podbor/site-kit';

interface Props {
  placement: ContactPlacement;
  service?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const cc = getServices(getLocale(Astro.currentLocale)).caseChrome;
const {
  placement,
  service,
  variant = 'primary',
  class: className,
} = Astro.props;
---

<div data-primary-contact class="contents">
  <ContactControl
    channel="telegram"
    {placement}
    {service}
    {variant}
    data-primary-channel="telegram"
    class={className}
  >
    <ContactIcon channel="telegram" size={16} />
    {cc.ctaButtonLabel}
  </ContactControl>
  <ContactControl
    channel="whatsapp"
    {placement}
    {service}
    {variant}
    data-primary-channel="whatsapp"
    hidden
    class={className}
  >
    <ContactIcon channel="whatsapp" size={16} />
    {cc.whatsappButtonLabel}
  </ContactControl>
</div>
