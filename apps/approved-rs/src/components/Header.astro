---
import {
  Menu,
  X,
  Send,
  Search,
  Banknote,
  ClipboardCheck,
  Globe,
} from '@lucide/astro';
import SiteLogo from './SiteLogo.astro';
import Button from './Button.astro';
import LeadFormModal from './LeadFormModal.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import LanguageSuggestion from './LanguageSuggestion.astro';
import HeaderDesktopNav from './HeaderDesktopNav.astro';
import HeaderMobileMenu from './HeaderMobileMenu.astro';
import ContactControl from './ContactControl.astro';
import ContactIcon from './ContactIcon.astro';
import { getNavItems, type ServiceSlug } from '@/utils/labels';
import { navCurrent } from '@podbor/site-kit';
import { getI18n } from '@/i18n/getI18n';
import { localeFrom } from '@/i18n/config';
import { PathBuilder } from '@/utils/paths';
import { leadModalTrigger } from '@/utils/contactChannel';
import { servicesView } from '@/i18n/content/services';
import { contactRegion } from '@podbor/site-kit/contact-control';

const locale = localeFrom(Astro.url.pathname);
const t = getI18n(locale);
const callLabel = servicesView(locale).caseChrome.callButtonLabel;
const casesHref = PathBuilder.casesVehicleSourcing(locale);
const casesCurrent = navCurrent(
  Astro.url.pathname,
  PathBuilder.sectionRoot(locale, 'cases'),
);

const SERVICE_ICONS: Record<ServiceSlug, typeof Search> = {
  'vehicle-sourcing': Search,
  'vehicle-import': Globe,
  'vehicle-buyback': Banknote,
  'vehicle-inspection': ClipboardCheck,
};

const navItems = getNavItems(locale).map((item) => ({
  ...item,
  Icon: SERVICE_ICONS[item.slug],
  current: navCurrent(
    Astro.url.pathname,
    PathBuilder.sectionRoot(locale, item.slug),
  ),
}));
---

<approved-menu
  class="group contents"
  data-desktop-media="(min-width: 1280px)"
  data-lock-scroll
>
  <header
    class="sticky top-0 z-50 border-b bg-header-glass border-default backdrop-blur-[16px]"
  >
    <div
      class="relative max-w-6xl xl:max-w-[90rem] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3 xl:gap-4"
    >
      <SiteLogo />

      <HeaderDesktopNav
        navItems={navItems}
        casesHref={casesHref}
        casesLabel={t.nav.cases}
        casesCurrent={casesCurrent}
      />

      <div class="flex items-center gap-1.5 shrink-0 self-stretch">
        <div
          class="contents xl:relative xl:flex xl:items-center xl:self-stretch"
        >
          <div class="hidden xl:block">
            <LanguageSwitcher />
          </div>
          <LanguageSuggestion />
        </div>

        <div class="contents" {...contactRegion('header')}>
          <ContactControl
            channel="phone"
            showNumber
            aria-label={callLabel}
            class="flex items-center justify-center size-9 pointer-coarse:min-h-11 rounded-sm border border-border-strong text-secondary no-underline"
            plainClass="flex items-center px-1.5 text-sm font-medium text-secondary"
          >
            <ContactIcon channel="phone" size={16} />
          </ContactControl>
        </div>

        <Button
          href={PathBuilder.contacts(locale)}
          {...leadModalTrigger()}
          aria-label={t.header.ctaShort}
          class="h-9 px-3 xl:px-4 py-2"
        >
          <Send size={13} />
          <span class="hidden min-[360px]:inline min-[1440px]:hidden">
            {t.header.ctaShort}
          </span>
          <span class="hidden min-[1440px]:inline">{t.header.ctaLong}</span>
        </Button>

        <button
          data-menu-button
          class="xl:hidden flex items-center justify-center w-9 h-9 rounded-sm border border-border-strong text-secondary"
          aria-label={t.header.menuLabel}
          data-close-label={t.header.menuCloseLabel}
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="group-data-[open]:hidden"><Menu size={18} /></span>
          <span class="hidden group-data-[open]:block"><X size={18} /></span>
        </button>
      </div>
    </div>

    <LeadFormModal />
  </header>

  <HeaderMobileMenu
    casesHref={casesHref}
    casesLabel={t.nav.cases}
    casesCurrent={casesCurrent}
    languageLabel={t.header.languageLabel}
  />
</approved-menu>

<script>
  import { defineMenuToggle } from '@podbor/site-kit/browser';

  defineMenuToggle('approved-menu');
</script>
