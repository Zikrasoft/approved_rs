---
interface Props {
  title: string;
  size?: 'xl' | 'lg';
  class?: string;
}

const { title, size = 'xl', class: className } = Astro.props;
---

<div class:list={['section-heading', className]}>
  <span class="accent-line"></span>
  <h2
    class:list={[
      'font-display font-bold tracking-[-0.04em] leading-[1.05]',
      size === 'xl'
        ? 'text-[clamp(1.85rem,6.5vw,2.6rem)]'
        : 'text-[clamp(1.6rem,5.5vw,2.15rem)]',
    ]}
  >
    {title}
  </h2>
</div>
