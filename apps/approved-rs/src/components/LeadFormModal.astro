---
import { X } from '@lucide/astro';
import LeadForm from './LeadForm.astro';
import { getLocale } from '@/i18n/config';
import { getI18n } from '@/i18n/getI18n';
import type {
  DATA_OPEN_LEAD_MODAL,
  DATA_OPEN_PAGE_LEAD_MODAL,
} from '@/utils/contactChannel';

interface Props {
  triggerAttr: typeof DATA_OPEN_LEAD_MODAL | typeof DATA_OPEN_PAGE_LEAD_MODAL;
  service?: string;
  country?: string;
  city?: string;
  commentLabel?: string;
  commentPlaceholder?: string;
}

const {
  triggerAttr,
  service = '',
  country = '',
  city = '',
  commentLabel,
  commentPlaceholder,
} = Astro.props;
const locale = getLocale(Astro.currentLocale);
const closeLabel = getI18n(locale).common.closeLabel;
---

<approved-modal trigger={`[${triggerAttr}]`}>
  <dialog class="lead-modal">
    <button
      type="button"
      data-modal-close
      aria-label={closeLabel}
      class="lead-modal-close"
    >
      <X size={16} />
    </button>
    <LeadForm
      service={service}
      country={country}
      city={city}
      {commentLabel}
      {commentPlaceholder}
    />
  </dialog>
</approved-modal>

<style>
  .lead-modal {
    background: transparent;
    border: none;
    padding: 0;
    max-width: 26rem;
    width: 90vw;
    max-height: 90dvh;
    overflow: hidden;
    margin: auto;
  }
  .lead-modal[open] {
    display: flex;
    flex-direction: column;
  }
  .lead-modal :global(.lead-form-card) {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  @media (max-width: 639px) {
    .lead-modal {
      width: 100%;
      max-width: none;
      height: 100dvh;
      max-height: none;
      margin: 0;
    }
    .lead-modal :global(.lead-form-card) {
      flex: 1;
      border: none;
      border-radius: 0;
    }
  }
  .lead-modal::backdrop {
    background: rgba(13, 15, 20, 0.6);
    backdrop-filter: blur(4px);
  }
  .lead-modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 2px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-muted);
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .lead-modal-close:hover {
    border-color: var(--color-accent) !important;
    color: var(--color-accent) !important;
  }
</style>

<script>
  import { GOALS, reachGoal } from '@podbor/site-kit/browser';
  import {
    defineModalDialog,
    MODAL_OPEN_EVENT,
    type ModalOpenDetail,
  } from '@podbor/site-kit/browser';
  import {
    DATA_OPEN_LEAD_MODAL,
    DATA_OPEN_PAGE_LEAD_MODAL,
  } from '@/utils/contactChannel';

  defineModalDialog('approved-modal');

  document.addEventListener(MODAL_OPEN_EVENT, (event) => {
    const host = event.target as HTMLElement;
    const { trigger } = (event as CustomEvent<ModalOpenDetail>).detail;
    const tab =
      trigger.getAttribute(DATA_OPEN_LEAD_MODAL) ??
      trigger.getAttribute(DATA_OPEN_PAGE_LEAD_MODAL);
    const tabButton = tab
      ? host.querySelector<HTMLElement>(
          `.pill-tab[data-tab="${CSS.escape(tab)}"]`,
        )
      : null;
    if (tabButton) tabButton.click();
    host.querySelector<HTMLInputElement>('[data-field="name"]')?.focus();
    reachGoal(GOALS.leadModalOpen, {
      tab: tabButton ? tab : 'default',
    });
  });
</script>
