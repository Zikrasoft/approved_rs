---
import { X } from '@lucide/astro';
import LeadForm from './LeadForm.astro';
import { getLocale } from '@/i18n/config';
import { getI18n } from '@/i18n/getI18n';
import {
  DATA_OPEN_LEAD_MODAL,
  DATA_PAGE_LEAD_MODAL,
} from '@/utils/contactChannel';

interface Props {
  page?: boolean;
  service?: string;
  country?: string;
  city?: string;
  commentLabel?: string;
  commentPlaceholder?: string;
}

const {
  page = false,
  service = '',
  country = '',
  city = '',
  commentLabel,
  commentPlaceholder,
} = Astro.props;
const locale = getLocale(Astro.currentLocale);
const closeLabel = getI18n(locale).common.closeLabel;
---

<approved-modal
  trigger={`[${DATA_OPEN_LEAD_MODAL}]`}
  {...page ? { [DATA_PAGE_LEAD_MODAL]: '' } : {}}
>
  <dialog
    class="m-0 h-dvh max-h-none w-full max-w-none flex-col overflow-hidden border-0 bg-transparent p-0 backdrop:bg-bg/60 backdrop:backdrop-blur-xs open:flex sm:m-auto sm:h-fit sm:max-h-[90dvh] sm:w-[90vw] sm:max-w-[26rem]"
  >
    <button
      type="button"
      data-modal-close
      aria-label={closeLabel}
      class="absolute top-5 right-5 z-1 flex h-11 w-11 items-center sm:h-8 sm:w-8 justify-center rounded-xs border border-border-strong bg-surface text-muted transition-colors duration-200 hover:border-accent hover:text-accent"
    >
      <X size={16} />
    </button>
    <LeadForm
      service={service}
      country={country}
      city={city}
      {commentLabel}
      {commentPlaceholder}
    />
  </dialog>
</approved-modal>

<script>
  import { GOALS, reachGoal } from '@podbor/site-kit/browser';
  import {
    defineModalDialog,
    MODAL_OPEN_EVENT,
    type ModalOpenDetail,
  } from '@podbor/site-kit/browser';
  import { SERVICE_FIELD } from '@podbor/lead-crm/fields';
  import {
    DATA_DEFAULT_SERVICE,
    DATA_LEAD_SERVICE,
    DATA_OPEN_LEAD_MODAL,
    DATA_PAGE_LEAD_MODAL,
  } from '@/utils/contactChannel';

  if (document.querySelector(`[${DATA_PAGE_LEAD_MODAL}]`))
    document
      .querySelectorAll(`approved-modal:not([${DATA_PAGE_LEAD_MODAL}])`)
      .forEach((modal) => modal.removeAttribute('trigger'));

  defineModalDialog('approved-modal');

  document.addEventListener(MODAL_OPEN_EVENT, (event) => {
    const host = event.target as HTMLElement;
    const { trigger } = (event as CustomEvent<ModalOpenDetail>).detail;
    const tab = trigger.getAttribute(DATA_OPEN_LEAD_MODAL);
    const tabButton = tab
      ? host.querySelector<HTMLElement>(`[data-tab="${CSS.escape(tab)}"]`)
      : null;
    if (tabButton) tabButton.click();
    const form = host.querySelector<HTMLFormElement>('[data-lead-form]');
    const service = form?.querySelector<HTMLInputElement>(
      `input[type="hidden"][name="${SERVICE_FIELD}"]`,
    );
    if (form && service) {
      service.value =
        trigger.getAttribute(DATA_LEAD_SERVICE) ??
        form.getAttribute(DATA_DEFAULT_SERVICE) ??
        '';
    }
    host
      .querySelector<HTMLInputElement>(
        '[data-panel]:not([data-tab]):not([hidden]) input',
      )
      ?.focus();
    reachGoal(GOALS.leadModalOpen, {
      tab: tabButton ? tab : 'default',
      service: service?.value || 'none',
    });
  });
</script>
