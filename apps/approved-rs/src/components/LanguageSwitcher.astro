---
import { Check } from '@lucide/astro';
import { LOCALE_CHOICE_ATTRIBUTE } from '@podbor/site-kit';
import {
  LOCALE_NAME,
  SUPPORTED_LOCALES,
  localeFrom,
  type Locale,
} from '@/i18n/config';
import { swapLocale } from '@/utils/paths';
import CountryPlate from './CountryPlate.astro';
import Dropdown from './Dropdown.astro';

interface Props {
  variant?: 'dropdown' | 'inline';
}
const { variant = 'dropdown' } = Astro.props;

const currentLocale = localeFrom(Astro.url.pathname);
const pathname = Astro.url.pathname;

const LOCALE_META: Record<Locale, { code: string; native: string }> = {
  ru: { code: 'RU', native: LOCALE_NAME.ru },
  en: { code: 'EN', native: LOCALE_NAME.en },
  sr: { code: 'SR', native: LOCALE_NAME.sr },
  es: { code: 'ES', native: LOCALE_NAME.es },
  de: { code: 'DE', native: LOCALE_NAME.de },
};
const current = LOCALE_META[currentLocale];
---

<approved-locale-choice>
  {
    variant === 'inline' ? (
      <div class="lang-switcher-inline grid grid-cols-3 gap-1.5">
        {SUPPORTED_LOCALES.map((locale) => {
          const meta = LOCALE_META[locale];
          const active = locale === currentLocale;
          return (
            <a
              href={swapLocale(pathname, locale)}
              {...{ [LOCALE_CHOICE_ATTRIBUTE]: locale }}
              class:list={[
                'dropdown-option lang-chip group justify-center gap-2 px-3 py-2 rounded-sm text-sm',
                { 'dropdown-option-active': active },
              ]}
            >
              <CountryPlate code={locale} />
              <span>{meta.native}</span>
            </a>
          );
        })}
      </div>
    ) : (
      <Dropdown
        align="right"
        minWidth="9.5rem"
        menuRole="listbox"
        triggerClass="px-2.5 py-1.5"
      >
        <Fragment slot="trigger">
          <CountryPlate code={currentLocale} />
          <span class="text-sm">{current.code}</span>
        </Fragment>
        {SUPPORTED_LOCALES.map((locale) => {
          const meta = LOCALE_META[locale];
          const active = locale === currentLocale;
          return (
            <li role="option" aria-selected={active}>
              <a
                href={swapLocale(pathname, locale)}
                {...{ [LOCALE_CHOICE_ATTRIBUTE]: locale }}
                class:list={[
                  'dropdown-option group gap-2.5 px-3 py-2 rounded-sm text-sm',
                  { 'dropdown-option-active': active },
                ]}
              >
                <CountryPlate code={locale} />
                <span class="flex-1">{meta.native}</span>
                {active && <Check size={14} class="text-accent shrink-0" />}
              </a>
            </li>
          );
        })}
      </Dropdown>
    )
  }
</approved-locale-choice>

<style>
  approved-locale-choice {
    display: contents;
  }

  /* Inline variant only: .dropdown-option is transparent until hover/active,
     which is fine inside a popover (the trigger already announced "this is
     a menu") but not on its own in a flat row — without a border each
     locale reads as plain flag+code text, not a pressable choice. */
  .lang-chip {
    border: 1px solid var(--color-border);
  }
  .lang-chip.dropdown-option-active {
    border-color: var(--color-accent-border);
  }
</style>

<script>
  import { defineLocaleChoice } from '@podbor/site-kit/browser';

  defineLocaleChoice('approved-locale-choice');
</script>
