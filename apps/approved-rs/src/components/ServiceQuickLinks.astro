---
import { Search, Globe, Banknote, ClipboardCheck } from '@lucide/astro';
import type { Search as IconType } from '@lucide/astro';
import { getNavItems, type ServiceSlug } from '@/utils/labels';
import { navCurrent } from '@podbor/site-kit';
import { getLocale } from '@/i18n/config';
import { getI18n } from '@/i18n/getI18n';
import { PathBuilder } from '@/utils/paths';

interface Props {
  // The burger menu has room for a 2x2 grid; the homepage band sits above the
  // hero and must not cost it a third of the first screen.
  variant?: 'grid' | 'strip';
}

const { variant = 'grid' } = Astro.props;
const locale = getLocale(Astro.currentLocale);

const SERVICE_ICONS: Record<ServiceSlug, typeof IconType> = {
  'vehicle-sourcing': Search,
  'vehicle-import': Globe,
  'vehicle-buyback': Banknote,
  'vehicle-inspection': ClipboardCheck,
};

const hints = getI18n(locale).navHint;
const items = getNavItems(locale).map((item) => ({
  ...item,
  Icon: SERVICE_ICONS[item.slug],
  hint: hints[item.slug],
  current: navCurrent(
    Astro.url.pathname,
    PathBuilder.sectionRoot(locale, item.slug),
  ),
}));
---

{
  variant === 'strip' ? (
    <div class="service-strip flex gap-2 overflow-x-auto">
      {items.map((item) => (
        <a
          href={item.href}
          class="mobile-service-card inline-flex shrink-0 items-center gap-2 rounded-full border border-default px-3.5 py-2 text-secondary"
          aria-current={item.current}
        >
          {item.Icon && <item.Icon size={16} />}
          <span class="whitespace-nowrap text-sm">{item.label}</span>
        </a>
      ))}
    </div>
  ) : (
    <div class="service-rows">
      {items.map((item) => (
        <a
          href={item.href}
          class="mobile-service-row flex flex-col gap-0.5 py-4 no-underline"
          aria-current={item.current}
        >
          <span class="font-display text-[1.45rem] font-bold leading-tight tracking-[-0.03em] text-primary">
            {item.label}
          </span>
          <span class="text-[0.9rem] leading-snug text-muted">{item.hint}</span>
        </a>
      ))}
    </div>
  )
}

<style>
  /* edge-to-edge scroll with the band's own padding preserved at both ends */
  .service-strip {
    scrollbar-width: none;
    margin-inline: -1.5rem;
    padding-inline: 1.5rem;
  }
  .service-strip::-webkit-scrollbar {
    display: none;
  }

  .service-rows > a + a {
    border-top: 1px solid var(--color-border);
  }
  .mobile-service-row {
    transition: color 0.2s;
  }
  .mobile-service-row:active span:first-child,
  .mobile-service-row[aria-current] span:first-child {
    color: var(--color-accent);
  }

  .mobile-service-card {
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .mobile-service-card:active {
    background-color: var(--color-accent-subtle);
    border-color: var(--color-accent-border);
    color: var(--color-accent) !important;
  }
  .mobile-service-card[aria-current] {
    background-color: var(--color-accent-subtle);
    border-color: var(--color-accent-border);
    color: var(--color-text) !important;
  }
  .mobile-service-card[aria-current] svg {
    color: var(--color-accent);
  }
</style>
