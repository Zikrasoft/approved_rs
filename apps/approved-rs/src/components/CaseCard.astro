---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Car } from '@lucide/astro';
import Price from './Price.astro';

interface Props {
  href: string;
  image?: ImageMetadata;
  imageAlt: string;
  badges: string[];
  car: string;
  year?: number;
  price?: { value: string; currency?: string };
}
export type CaseCardProps = Props;

const { href, image, imageAlt, badges, car, year, price } = Astro.props;
---

<a
  href={href}
  class="case-card group flex h-full flex-col rounded-sm overflow-hidden no-underline glow-border bg-surface border border-default"
>
  {
    image ? (
      <div class="overflow-hidden h-52">
        <Image
          src={image}
          alt={imageAlt}
          format="webp"
          width={400}
          height={208}
          class="w-full h-full object-cover transition-transform duration-400 ease-out group-hover:scale-105"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="h-52 flex flex-col items-center justify-center gap-4 relative overflow-hidden bg-surface-2">
        <div
          class="absolute inset-0"
          style="background: radial-gradient(ellipse 70% 60% at 50% 50%, var(--color-ambient-glow) 0%, transparent 70%);"
        />
        <div
          class="absolute inset-0 opacity-40"
          style="background-image: linear-gradient(var(--color-grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--color-grid-line) 1px, transparent 1px); background-size: 20px 20px;"
        />
        <Car size={48} stroke-width={1.2} class="relative text-accent-mid" />
        <p class="text-xs font-medium tracking-[0.18em] uppercase relative text-accent-mid">
          {imageAlt}
        </p>
      </div>
    )
  }

  <div class="p-6 flex flex-col flex-1 gap-3">
    <div class="flex items-center justify-between">
      <div class="flex flex-wrap gap-1.5">
        {
          badges.map((badge) => (
            <span class="text-xs tracking-[0.16em] uppercase font-semibold text-accent">
              {badge}
            </span>
          ))
        }
      </div>
      <span class="case-arrow text-xs text-muted">→</span>
    </div>
    <h3 class="font-display text-lg leading-snug text-primary">
      {car}
      {
        year && (
          <span class="ml-1.5 text-sm font-normal text-muted">{year}</span>
        )
      }
    </h3>
    <div class="mt-auto pt-1">
      {
        price && (
          <Price
            price={price}
            class="font-display text-xl font-bold text-accent"
          />
        )
      }
    </div>
  </div>
</a>

<style>
  .case-card {
    transition:
      border-color 0.3s,
      box-shadow 0.3s,
      transform 0.3s;
  }
  .case-card:hover {
    border-color: var(--color-accent-mid) !important;
    box-shadow:
      0 0 0 1px var(--color-accent-subtle),
      0 12px 40px var(--color-ambient-glow);
    transform: translateY(-4px);
  }
  .case-card:hover .case-arrow {
    transform: translateX(4px);
    color: var(--color-accent) !important;
  }
  .case-arrow {
    transition:
      transform 0.3s,
      color 0.3s;
  }
</style>
