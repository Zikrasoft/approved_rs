---
import Button from './Button.astro';
import ContactIcon from './ContactIcon.astro';
import RegionalContactButton from './RegionalContactButton.astro';
import { phoneLink, viberLink } from '@/utils/contactLinks';
import { messengerHrefs } from '@/utils/messengerHrefs';
import { getServicesContent } from '@/i18n/content/services';
import { getLocale } from '@/i18n/config';
import { TG_MANAGER, VIBER_NUMBER, PHONE_NUMBER } from '@/utils/constants';
import { PathBuilder } from '@/utils/paths';
import { contactPlacement, navCurrent } from '@podbor/site-kit';
import { formatPhone } from '@podbor/site-kit/format-phone';
import { callbackTrigger, leadModalTrigger } from '@/utils/contactChannel';

interface Props {
  manager?: string;
  label?: string;
  compact?: boolean;
}

const locale = getLocale(Astro.currentLocale);
const cc = getServicesContent(locale).caseChrome;
const { manager = TG_MANAGER, label, compact = false } = Astro.props;
const telegramAriaLabel = label ?? cc.ctaButtonLabel;

const messenger = messengerHrefs(locale, manager);
const onThanks =
  navCurrent(Astro.url.pathname, PathBuilder.thanks(locale)) === 'page';
const placement = onThanks ? 'thanks' : compact ? 'hero' : 'bar';
---

<div
  class="flex flex-col gap-3 my-8"
  data-contact-cta
  {...contactPlacement(placement)}
>
  {
    compact ? (
      <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3">
        <RegionalContactButton
          {manager}
          class="gap-2.5 px-6 py-3 tracking-[0.03em] w-full sm:w-auto justify-center"
        />
        {label && (
          <Button
            variant="secondary"
            href={PathBuilder.contacts(locale)}
            {...leadModalTrigger()}
            class="gap-2.5 px-6 py-3 tracking-[0.03em] w-full sm:w-auto justify-center bg-surface lg:hidden"
          >
            {label}
          </Button>
        )}
        <Button
          variant="secondary"
          href={phoneLink(PHONE_NUMBER)}
          data-contact-channel="phone"
          class="gap-2.5 px-6 py-3 tracking-[0.03em] w-full sm:w-auto justify-center pointer-fine:hidden!"
        >
          <ContactIcon channel="phone" size={15} />
          {cc.callButtonLabel}
        </Button>
        {!label && (
          <Button
            variant="secondary"
            data-contact-channel="callback"
            {...callbackTrigger()}
            class="gap-2.5 px-6 py-3 tracking-[0.03em] w-full sm:w-auto justify-center pointer-coarse:hidden!"
          >
            <ContactIcon channel="phone" size={15} />
            {cc.callbackButtonLabel}
          </Button>
        )}
      </div>
    ) : (
      <>
        <div class="contact-bar">
          <a
            data-contact-channel="telegram"
            href={messenger.telegram}
            target="_blank"
            rel="noopener"
            aria-label={telegramAriaLabel}
            class="contact-cell"
          >
            <ContactIcon channel="telegram" size={17} />
            <span>Telegram</span>
          </a>

          <a
            data-contact-channel="whatsapp"
            href={messenger.whatsapp}
            target="_blank"
            rel="noopener"
            aria-label={cc.whatsappButtonLabel}
            class="contact-cell"
          >
            <ContactIcon channel="whatsapp" size={17} />
            <span>WhatsApp</span>
          </a>

          <a
            data-contact-channel="viber"
            href={viberLink(VIBER_NUMBER)}
            aria-label={cc.viberButtonLabel}
            class="contact-cell"
          >
            <ContactIcon channel="viber" size={17} />
            <span>Viber</span>
          </a>

          {onThanks ? (
            <>
              <a
                data-contact-channel="phone"
                href={phoneLink(PHONE_NUMBER)}
                aria-label={cc.callButtonLabel}
                class="contact-cell pointer-fine:hidden!"
              >
                <ContactIcon channel="phone" size={16} />
                <span>{cc.callbackShortLabel}</span>
              </a>
              <span class="contact-cell pointer-coarse:hidden!">
                <ContactIcon channel="phone" size={16} />
                <span class="whitespace-nowrap">
                  {formatPhone(PHONE_NUMBER)}
                </span>
              </span>
            </>
          ) : (
            <button
              type="button"
              data-contact-channel="callback"
              aria-label={cc.callbackButtonLabel}
              {...callbackTrigger()}
              class="contact-cell"
            >
              <ContactIcon channel="phone" size={16} />
              <span>{cc.callbackShortLabel}</span>
            </button>
          )}
        </div>

        <Button
          variant="secondary"
          href={phoneLink(PHONE_NUMBER)}
          data-contact-channel="phone"
          class="gap-2.5 px-6 py-3 tracking-[0.03em] w-full justify-center bg-surface pointer-fine:hidden!"
        >
          <ContactIcon channel="phone" size={15} />
          {cc.callButtonLabel}
        </Button>
      </>
    )
  }
</div>

<style>
  .contact-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .contact-bar {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .contact-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 0.75rem;
    background-color: var(--color-surface);
    color: var(--color-text-2);
    font-size: 0.8125rem;
    font-weight: 500;
    font-family: var(--font-sans);
    text-decoration: none;
    text-align: center;
    line-height: 1.2;
    border: none;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  span.contact-cell {
    cursor: text;
    user-select: text;
  }
  a.contact-cell:hover,
  a.contact-cell:focus-visible,
  button.contact-cell:hover,
  button.contact-cell:focus-visible {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }
  .contact-cell:focus-visible {
    outline: 2px solid var(--color-on-accent);
    outline-offset: -3px;
  }
</style>
