---
import Button from './Button.astro';
import ContactIcon from './ContactIcon.astro';
import RegionalContactButton from './RegionalContactButton.astro';
import ContactControl from './ContactControl.astro';
import { servicesView } from '@/i18n/content/services';
import { getI18n } from '@/i18n/getI18n';
import { getLocale } from '@/i18n/config';
import { PathBuilder } from '@/utils/paths';
import { navCurrent } from '@podbor/site-kit';
import { contactRegion } from '@podbor/site-kit/contact-control';
import { callbackTrigger, leadModalTrigger } from '@/utils/contactChannel';

interface Props {
  service?: string;
  label?: string;
  compact?: boolean;
}

const locale = getLocale(Astro.currentLocale);
const cc = servicesView(locale).caseChrome;
const t = getI18n(locale);
const { service, label, compact = false } = Astro.props;
const telegramAriaLabel = label ?? cc.ctaButtonLabel;

const onThanks =
  navCurrent(Astro.url.pathname, PathBuilder.thanks(locale)) === 'page';
const placement = onThanks ? 'thanks' : compact ? 'hero' : 'bar';
---

<div class="flex flex-col gap-3 my-6 sm:my-8" {...contactRegion(placement)}>
  {
    compact ? (
      <div class="flex flex-wrap gap-3">
        <Button
          href={PathBuilder.contacts(locale)}
          {...leadModalTrigger()}
          class="gap-2.5 px-6 py-3 tracking-[0.03em] w-full sm:w-auto justify-center"
        >
          {label ?? t.header.ctaLong}
        </Button>
        <RegionalContactButton
          variant="secondary"
          {placement}
          {service}
          class="gap-2.5 px-4 sm:px-6 py-3 tracking-[0.03em] flex-auto whitespace-nowrap sm:flex-none sm:w-auto justify-center lg:flex-none"
        />
        <ContactControl
          channel="phone"
          {placement}
          variant="secondary"
          class="gap-2.5 px-4 sm:px-6 py-3 tracking-[0.03em] flex-auto whitespace-nowrap sm:flex-none sm:w-auto justify-center"
        >
          <ContactIcon channel="phone" size={15} />
          {cc.callButtonLabel}
        </ContactControl>
      </div>
    ) : (
      <>
        <div class="contact-bar">
          <ContactControl
            channel="telegram"
            {placement}
            {service}
            aria-label={telegramAriaLabel}
            class="contact-cell"
          >
            <ContactIcon channel="telegram" size={17} />
            <span>Telegram</span>
          </ContactControl>

          <ContactControl
            channel="whatsapp"
            {placement}
            {service}
            aria-label={cc.whatsappButtonLabel}
            class="contact-cell"
          >
            <ContactIcon channel="whatsapp" size={17} />
            <span>WhatsApp</span>
          </ContactControl>

          <ContactControl
            channel="viber"
            {placement}
            aria-label={cc.viberButtonLabel}
            class="contact-cell"
          >
            <ContactIcon channel="viber" size={17} />
            <span>Viber</span>
          </ContactControl>

          {onThanks ? (
            <ContactControl
              channel="phone"
              {placement}
              aria-label={cc.callButtonLabel}
              class="contact-cell"
            >
              <ContactIcon channel="phone" size={16} />
              <span>{cc.callbackShortLabel}</span>
              <ContactIcon slot="plain" channel="phone" size={16} />
            </ContactControl>
          ) : (
            <button
              type="button"
              aria-label={cc.callbackButtonLabel}
              {...callbackTrigger()}
              class="contact-cell"
            >
              <ContactIcon channel="phone" size={16} />
              <span>{cc.callbackShortLabel}</span>
            </button>
          )}
        </div>

        <ContactControl
          channel="phone"
          {placement}
          variant="secondary"
          class="gap-2.5 px-6 py-3 tracking-[0.03em] w-full justify-center bg-surface"
        >
          <ContactIcon channel="phone" size={15} />
          {cc.callButtonLabel}
        </ContactControl>
      </>
    )
  }
</div>

<style>
  .contact-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .contact-bar {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .contact-bar :global(.contact-cell) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 0.75rem;
    background-color: var(--color-surface);
    color: var(--color-text-2);
    font-size: 0.8125rem;
    font-weight: 500;
    font-family: var(--font-sans);
    text-decoration: none;
    text-align: center;
    line-height: 1.2;
    border: none;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .contact-bar :global(span.contact-cell) {
    cursor: text;
    user-select: text;
  }
  .contact-bar :global(a.contact-cell:hover),
  .contact-bar :global(a.contact-cell:focus-visible),
  .contact-bar :global(button.contact-cell:hover),
  .contact-bar :global(button.contact-cell:focus-visible) {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }
  .contact-bar :global(.contact-cell:focus-visible) {
    outline: 2px solid var(--color-on-accent);
    outline-offset: -3px;
  }
</style>
