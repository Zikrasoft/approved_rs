---
import Button from './Button.astro';
import ContactIcon from './ContactIcon.astro';
import RegionalContactButton from './RegionalContactButton.astro';
import { phoneLink, viberLink } from '@/utils/contactLinks';
import { messengerHrefs } from '@/utils/messengerHrefs';
import { getServicesContent } from '@/i18n/content/services';
import { getLocale } from '@/i18n/config';
import { TG_MANAGER, VIBER_NUMBER, PHONE_NUMBER } from '@/utils/constants';
import { PathBuilder } from '@/utils/paths';
import { callbackTrigger, leadModalTrigger } from '@/utils/contactChannel';

interface Props {
  manager?: string;
  label?: string;
  openModal?: boolean;
  compact?: boolean;
  direct?: boolean;
}

const locale = getLocale(Astro.currentLocale);
const cc = getServicesContent(locale).caseChrome;
const {
  manager = TG_MANAGER,
  label,
  openModal = false,
  compact = false,
  direct = false,
} = Astro.props;
const telegramAriaLabel = label ?? cc.ctaButtonLabel;

const messenger = messengerHrefs(locale, manager);
---

<div class="flex flex-col gap-3 my-8" data-contact-cta>
  {
    compact ? (
      <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3">
        <RegionalContactButton
          {manager}
          class="gap-2.5 px-6 py-3 tracking-[0.03em] w-full sm:w-auto justify-center"
        />
        {label && !direct && (
          <Button
            variant="secondary"
            href={PathBuilder.contacts(locale)}
            {...leadModalTrigger(openModal)}
            class="gap-2.5 px-6 py-3 tracking-[0.03em] w-full sm:w-auto justify-center bg-surface"
          >
            {label}
          </Button>
        )}
        <Button
          variant="secondary"
          href={phoneLink(PHONE_NUMBER)}
          data-contact-channel="phone"
          class="gap-2.5 px-6 py-3 tracking-[0.03em] w-full sm:w-auto justify-center bg-surface"
        >
          <ContactIcon channel="phone" size={15} />
          {cc.callButtonLabel}
        </Button>
      </div>
    ) : (
      <>
        <div class="contact-bar">
          <a
            data-contact-channel="telegram"
            href={messenger.telegram}
            target="_blank"
            rel="noopener"
            aria-label={telegramAriaLabel}
            class="contact-cell"
          >
            <ContactIcon channel="telegram" size={17} />
            <span>Telegram</span>
          </a>

          <a
            data-contact-channel="whatsapp"
            href={messenger.whatsapp}
            target="_blank"
            rel="noopener"
            aria-label={cc.whatsappButtonLabel}
            class="contact-cell"
          >
            <ContactIcon channel="whatsapp" size={17} />
            <span>WhatsApp</span>
          </a>

          <a
            data-contact-channel="viber"
            href={viberLink(VIBER_NUMBER)}
            aria-label={cc.viberButtonLabel}
            class="contact-cell"
          >
            <ContactIcon channel="viber" size={17} />
            <span>Viber</span>
          </a>

          {direct ? (
            <a
              data-contact-channel="phone"
              href={phoneLink(PHONE_NUMBER)}
              aria-label={cc.callButtonLabel}
              class="contact-cell"
            >
              <ContactIcon channel="phone" size={16} />
              <span>{cc.callbackShortLabel}</span>
            </a>
          ) : (
            <button
              type="button"
              data-contact-channel="callback"
              aria-label={cc.callbackButtonLabel}
              {...callbackTrigger(openModal)}
              class="contact-cell"
            >
              <ContactIcon channel="phone" size={16} />
              <span>{cc.callbackShortLabel}</span>
            </button>
          )}
        </div>

        <Button
          variant="secondary"
          href={phoneLink(PHONE_NUMBER)}
          data-contact-channel="phone"
          class="gap-2.5 px-6 py-3 tracking-[0.03em] w-full justify-center bg-surface"
        >
          <ContactIcon channel="phone" size={15} />
          {cc.callButtonLabel}
        </Button>
      </>
    )
  }
</div>

<style>
  .contact-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .contact-bar {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .contact-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 0.75rem;
    background-color: var(--color-surface);
    color: var(--color-text-2);
    font-size: 0.8125rem;
    font-weight: 500;
    font-family: var(--font-sans);
    text-decoration: none;
    text-align: center;
    line-height: 1.2;
    border: none;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .contact-cell:hover,
  .contact-cell:focus-visible {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }
  .contact-cell:focus-visible {
    outline: 2px solid var(--color-on-accent);
    outline-offset: -3px;
  }
</style>
