<language-suggestion
  hidden
  role="region"
  class="absolute top-full right-4 z-10 mt-2 w-[min(19rem,calc(100vw-2rem))] rounded-sm border border-border-strong bg-surface p-4 pt-3 pr-1.5 text-text shadow-[0_12px_28px_-8px_rgba(0,0,0,0.5)] transition-[opacity,translate] duration-200 group-data-[open]:hidden motion-safe:starting:-translate-y-1 motion-safe:starting:opacity-0 sm:right-6 xl:right-auto xl:left-1/2 xl:-translate-x-1/2 print:hidden"
>
  <span
    aria-hidden="true"
    class="absolute -top-[7px] right-3 size-3 rotate-45 border-t border-l border-border-strong bg-surface xl:right-auto xl:left-1/2 xl:-translate-x-1/2"
  ></span>
  <div class="flex items-start gap-1">
    <p data-lang-prompt class="flex-1 pt-2 text-sm text-text-2 text-pretty"></p>
    <button
      type="button"
      data-lang-dismiss
      class="-mt-1 flex size-11 shrink-0 items-center justify-center rounded-sm text-xl leading-none text-muted transition-colors hover:text-text"
      >&times;</button
    >
  </div>
  <a
    data-lang-link
    href="#"
    class="mt-2 inline-flex rounded-sm bg-accent-strong px-4 py-2 text-sm font-semibold text-on-accent no-underline transition-colors hover:bg-accent-hover"
  ></a>
</language-suggestion>
