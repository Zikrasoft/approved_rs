---
import { LayoutGrid, ChevronRight, Globe } from '@lucide/astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ServiceQuickLinks from './ServiceQuickLinks.astro';

interface Props {
  casesHref: string;
  casesLabel: string;
  casesCurrent?: 'page' | 'true';
  languageLabel: string;
}

const { casesHref, casesLabel, casesCurrent, languageLabel } = Astro.props;
---

<div
  id="mobile-menu"
  data-menu
  class="xl:hidden invisible fixed inset-0 z-40 flex flex-col justify-between overflow-y-auto bg-header-mobile px-2 pb-10 pt-20 opacity-0 backdrop-blur-xl transition-[opacity,visibility] duration-200 group-data-[open]:visible group-data-[open]:opacity-100"
  inert
>
  <div>
    <nav class="max-w-6xl mx-auto px-6 py-5 flex flex-col gap-4 mobile-nav">
      <ServiceQuickLinks />

      <!-- Same row shape/border as a service card above, so it reads as one
           more tappable destination — not a stray line of text. -->
      <a
        href={casesHref}
        class="mobile-list-row flex items-center gap-3 py-3.5 px-4 rounded-sm border border-default text-secondary"
        aria-current={casesCurrent}
      >
        <LayoutGrid size={18} class="shrink-0 text-muted" />
        <span class="flex-1 text-sm">{casesLabel}</span>
        <ChevronRight size={16} class="shrink-0 text-muted" />
      </a>

      <!-- Language is a setting, not a destination — kept in its own tinted
           block instead of a stray row. The "Язык" label makes the flag row's
           job explicit; flags alone read as decoration, not as a control. -->
      <div class="prefs-group flex flex-col gap-3 p-4 rounded-sm bg-surface-2">
        <div class="flex items-center gap-2 text-xs font-medium text-muted">
          <Globe size={14} />
          {languageLabel}
        </div>
        <LanguageSwitcher variant="inline" />
      </div>
    </nav>
  </div>
</div>

<style>
  .mobile-list-row {
    transition:
      background-color 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }
  .mobile-list-row:active {
    background-color: var(--color-accent-subtle);
    border-color: var(--color-accent-border);
    transform: translateX(0.25rem);
  }
  .mobile-list-row[aria-current] {
    background-color: var(--color-accent-subtle);
    border-color: var(--color-accent-border);
    color: var(--color-text);
  }
  .mobile-list-row[aria-current] svg {
    color: var(--color-accent);
  }
</style>
