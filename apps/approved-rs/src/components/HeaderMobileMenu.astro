---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ServiceQuickLinks from './ServiceQuickLinks.astro';
import ContactIcon from './ContactIcon.astro';
import { PHONE_NUMBER } from '@/utils/constants';
import { getLocale } from '@/i18n/config';
import { getServicesContent } from '@/i18n/content/services';
import { phoneLink } from '@/utils/contactLinks';

interface Props {
  casesHref: string;
  casesLabel: string;
  casesCurrent?: 'page' | 'true';
  languageLabel: string;
}

const { casesHref, casesLabel, casesCurrent, languageLabel } = Astro.props;
const callLabel = getServicesContent(getLocale(Astro.currentLocale)).caseChrome
  .callButtonLabel;
---

<div
  id="mobile-menu"
  data-menu
  class="xl:hidden invisible fixed inset-0 z-40 flex flex-col overflow-y-auto bg-header-mobile pb-8 pt-20 opacity-0 backdrop-blur-xl transition-[opacity,visibility] duration-200 group-data-[open]:visible group-data-[open]:opacity-100"
  inert
>
  <nav class="mobile-nav flex w-full max-w-6xl flex-1 flex-col px-6">
    <ServiceQuickLinks />

    <a
      href={casesHref}
      class="mobile-service-row border-t border-default py-4 no-underline"
      aria-current={casesCurrent}
    >
      <span
        class="font-display text-[1.45rem] font-bold leading-tight tracking-[-0.03em] text-primary"
        >{casesLabel}</span
      >
    </a>

    <a
      href={phoneLink(PHONE_NUMBER)}
      data-contact-channel="phone"
      class="mt-auto flex items-center justify-center gap-2.5 rounded-sm border border-accent-border bg-accent-subtle py-3.5 text-accent no-underline"
    >
      <ContactIcon channel="phone" size={15} />
      <span class="text-sm font-medium">{callLabel}</span>
    </a>

    <p class="mt-6 mb-2 text-xs text-muted">{languageLabel}</p>
    <LanguageSwitcher variant="inline" />
  </nav>
</div>

<style>
  .mobile-service-row:active span,
  .mobile-service-row[aria-current] span {
    color: var(--color-accent);
  }
</style>
