---
import { SITE_NAME } from '@/utils/constants';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  decoWord: string;
  title: string;
  subtitle?: string;
  eyebrow?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  decoWord,
  title,
  subtitle,
  eyebrow = SITE_NAME,
  breadcrumbs,
} = Astro.props;
---

<section class="hero-grid relative border-b overflow-hidden border-default">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 50% 60% at 5% 50%, var(--color-ambient-glow) 0%, transparent 60%);"
  >
  </div>
  <span
    class="deco-word text-[clamp(6rem,18vw,15rem)] bottom-[-1rem] right-[-1%] opacity-80"
    >{decoWord}</span
  >
  <div class="relative max-w-6xl mx-auto px-6 py-band md:py-band-lg">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    {eyebrow && <span class="eyebrow fade-up fade-up-1">{eyebrow}</span>}
    <h1
      class="font-display mb-3 fade-up fade-up-2 tracking-[-0.045em] text-[clamp(1.95rem,5vw,3.7rem)] font-bold"
    >
      {title}
    </h1>
    {
      subtitle && (
        <p class="text-base fade-up fade-up-3 text-muted">{subtitle}</p>
      )
    }
    <slot />
  </div>
</section>
