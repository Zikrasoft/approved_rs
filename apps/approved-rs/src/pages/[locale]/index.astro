---
// No getStaticPaths — resolved per-request so it can read
// Astro.locals.suggestedCountry (set by middleware) for the geo banner.
export const prerender = false;
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import GeoBanner from '@/components/GeoBanner.astro';
import ServiceQuickLinks from '@/components/ServiceQuickLinks.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import CaseCatalogue from '@/components/CaseCatalogue.astro';
import CountryPlate from '@/components/CountryPlate.astro';
import InspectionMap from '@/components/InspectionMap.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import LeadForm from '@/components/LeadForm.astro';
import StatBlock from '@/components/StatBlock.astro';
import ClosingBand from '@/components/ClosingBand.astro';
import { getCollection } from 'astro:content';
import { getActiveCountries } from '@/utils/geo';
import {
  SITE_URL,
  SITE_NAME,
  TG_MANAGER,
  SOCIAL_SAME_AS,
  CHINA_NAME,
} from '@/utils/constants';
import { generateOrganizationSchema } from '@/utils/seo';
import { telegramLink } from '@/utils/telegramLink';
import { getHomeContent } from '@/i18n/content/home';
import { getI18n } from '@/i18n/getI18n';
import { PathBuilder } from '@/utils/paths';
import { SLUG } from '@/utils/labels';
import { EU_SPOKE_COUNTRIES } from '@/utils/vehicleImportCrossSell';
import { getLocale } from '@/i18n/config';
import heroImage from '@/assets/hero-delivery.jpg';
import closingImage from '@/assets/closing.jpg';

const locale = getLocale(Astro.params.locale);
const h = getHomeContent(locale);
const t = getI18n(locale);
const meta = {
  title: `${h.metaTitle} | ${SITE_NAME}`,
  description: h.metaDescription,
  canonical: `${SITE_URL}${PathBuilder.home(locale)}`,
};

const allCases = await getCollection('cases');
const published = allCases
  .filter((c) => c.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const catalogueCases = published.slice(0, 6);
const countries = getActiveCountries();

const schema = generateOrganizationSchema({
  url: SITE_URL,
  description: meta.description,
  // Autopodbor's own markets plus China — vehicle-import sources cars from there
  // too, even though it's not a countries.json market in its own right.
  areaServed: [...countries.map((c) => c[locale].name), CHINA_NAME[locale]],
  sameAs: SOCIAL_SAME_AS,
  contactUrl: telegramLink(TG_MANAGER),
});

// One connected story instead of a flat service list — each stop is a real
// page, but the copy makes clear this is one journey (and where you can
// jump in if you're not starting from zero).
const journey = [
  {
    href: PathBuilder.vehicleSourcingHub(locale),
    title: h.journey[0].title,
    desc: h.journey[0].desc,
    aside: countries.map((c) => c[locale].name).join(' · '),
  },
  {
    href: PathBuilder.vehicleImportHub(locale),
    title: h.journey[1].title,
    desc: h.journey[1].desc,
    aside: CHINA_NAME[locale],
  },
  {
    href: PathBuilder.sectionRoot(locale, SLUG.INSPECTION),
    title: h.journey[2].title,
    desc: h.journey[2].desc,
    aside: h.journey[2].note,
  },
  {
    href: PathBuilder.sectionRoot(locale, SLUG.BUYBACK),
    title: h.journey[3].title,
    desc: h.journey[3].desc,
    aside: h.journey[3].note,
  },
];

const euSources = EU_SPOKE_COUNTRIES.flatMap((code) => {
  const country = countries.find((c) => c.code === code);
  return country
    ? [
        {
          name: country[locale].name,
          href: PathBuilder.vehicleImportSpoke(locale, code),
        },
      ]
    : [];
});

// Every country we work in, with the cases already closed there — the count is
// derived, so a new case changes the number without anyone editing copy.
const geoCells = countries.map((country) => ({
  href: PathBuilder.service(locale, 'vehicle-sourcing', country.code),
  name: country[locale].name,
  cases: published.filter((c) => c.data.country === country.code).length,
}));
---

<BaseLayout {...meta} schema={schema}>
  <section id="quick-links-band" class="xl:hidden border-b border-default">
    <div class="max-w-6xl mx-auto px-6 py-3">
      <ServiceQuickLinks variant="strip" />
    </div>
  </section>

  {
    Astro.locals.suggestedCountry && (
      <GeoBanner detected={Astro.locals.suggestedCountry} />
    )
  }

  <section class="photo-hero relative border-b border-default">
    <div class="photo-hero-shot">
      <Image
        src={heroImage}
        alt={h.heroPhotoAlt}
        format="webp"
        widths={[640, 1024, 1600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover"
      />
      <span class="photo-hero-veil"></span>
    </div>

    <div class="photo-hero-body relative max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
        <div class="lg:col-span-3">
          <h1
            class="hero-headline font-display font-bold mb-8 fade-up fade-up-2 text-primary"
          >
            <span class="block">{h.heroLine1}</span>{' '}
            <span class="block">{h.heroLine2}</span>{' '}
            <span class="block text-accent">{h.heroLine3}</span>
          </h1>
          <p
            class="text-base leading-relaxed mb-10 max-w-md fade-up fade-up-3 text-secondary"
          >
            {h.heroSubtext}
          </p>
          <div class="fade-up fade-up-4">
            <ContactCTA compact />
          </div>
          <div
            class="grid grid-cols-3 gap-3 sm:gap-6 mt-8 pt-8 border-t fade-up fade-up-5 border-default"
          >
            <StatBlock
              value={h.statClients.value}
              label={h.statClients.label}
            />
            <StatBlock
              value={String(countries.length)}
              label={h.statCountries.label}
            />
            <StatBlock value={h.statYears.value} label={h.statYears.label} />
          </div>
        </div>

        <div class="hidden lg:block lg:col-span-2 fade-up fade-up-3">
          <div class="rounded-sm border border-border-strong bg-surface">
            <LeadForm />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-default">
    <div class="max-w-6xl mx-auto px-6 py-band md:py-band-lg">
      <SectionHeading title={h.journeyHeading} />
      <p class="text-base max-w-xl mt-4 mb-12 leading-relaxed text-muted">
        {h.journeySubtext}
      </p>

      <div class="border-t border-default">
        {
          journey.map((step) => (
            <a href={step.href} class="svc-row">
              <span class="svc-name font-display font-bold text-primary">
                {step.title}
              </span>
              <span class="text-[0.97rem] leading-relaxed text-muted max-w-[54ch]">
                {step.desc}
              </span>
              <span class="svc-aside text-sm">{step.aside}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-default">
    <div class="max-w-6xl mx-auto px-6 py-band md:py-band-lg">
      <SectionHeading title={h.origin.heading} />
      <p class="text-base max-w-xl mt-4 mb-10 leading-relaxed text-muted">
        {h.origin.note}
      </p>

      <div class="grid gap-5 md:grid-cols-2">
        <article class="origin-card group">
          <h3
            class="origin-title font-display font-bold text-primary flex items-center gap-2.5"
          >
            <CountryPlate code="eu" size="md" />
            {h.origin.euTitle}
          </h3>
          <p class="text-[0.97rem] leading-relaxed text-muted">
            {h.origin.euText}
          </p>
          <p class="flex flex-wrap gap-2">
            {
              euSources.map((source) => (
                <a href={source.href} class="chip">
                  {source.name}
                </a>
              ))
            }
          </p>
          <a
            href={PathBuilder.vehicleImportSpoke(locale, 'eu')}
            class="origin-cta text-accent">{h.origin.euCta}</a
          >
        </article>

        <article class="origin-card group">
          <h3
            class="origin-title font-display font-bold text-primary flex items-center gap-2.5"
          >
            <CountryPlate code="cn" size="md" />
            {h.origin.chinaTitle}
          </h3>
          <p class="text-[0.97rem] leading-relaxed text-muted">
            {h.origin.chinaText}
          </p>
          <p class="flex flex-wrap gap-2">
            {h.origin.chinaTags.map((tag) => <span class="chip">{tag}</span>)}
          </p>
          <a
            href={PathBuilder.vehicleImportSpoke(locale, 'china')}
            class="origin-cta text-accent">{h.origin.chinaCta}</a
          >
        </article>
      </div>

      <div class="geo-grid mt-5">
        {
          geoCells.map((cell) => (
            <a href={cell.href} class="geo-cell">
              <span class="font-display font-bold text-primary">
                {cell.name}
              </span>
              {cell.cases > 0 && (
                <span class="text-sm text-muted tabular-nums">
                  {cell.cases} <span class="sr-only">{t.nav.cases}</span>
                </span>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    catalogueCases.length > 0 && (
      <CaseCatalogue
        cases={catalogueCases}
        locale={locale}
        content={h.catalogue}
        viewAllHref={PathBuilder.casesVehicleSourcing(locale)}
      />
    )
  }

  <InspectionMap
    content={h.inspection}
    findingLabel={h.findingLabel}
    ctaHref={PathBuilder.sectionRoot(locale, SLUG.INSPECTION)}
  />

  <section class="border-b border-default">
    <div class="max-w-6xl mx-auto px-6 py-band md:py-band-lg">
      <SectionHeading title={h.whyUsHeading} />
      <p class="text-base max-w-md text-muted mt-4 mb-12 leading-relaxed">
        {h.whyUsSubtext}
      </p>
      <div class="grid gap-8 md:grid-cols-3 md:gap-10">
        {
          h.trustCards.map((card) => (
            <div class="term">
              <h3 class="font-display text-lg font-bold mb-2 text-primary">
                {card.title}
              </h3>
              <p class="text-[0.95rem] leading-relaxed text-muted">
                {card.text}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Mobile-only lead form: desktop keeps it in the hero sidebar, mobile
       moves it here so the page explains the business before asking for
       contact details. -->
  <section class="lg:hidden border-b border-default">
    <div class="max-w-6xl mx-auto px-6 py-band">
      <LeadForm />
    </div>
  </section>

  <ClosingBand
    image={closingImage}
    imageAlt={h.ctaPhotoAlt}
    eyebrow={h.ctaEyebrow}
    line1={h.ctaHeading.line1}
    line2={h.ctaHeading.line2}
    accentWord={h.ctaHeading.accentWord}
    text={h.ctaSubtext}
    ctaLabel={h.ctaTelegramLabel}
    stats={[
      h.ctaStatClients,
      { value: String(countries.length), label: h.ctaStatCountries.label },
      h.ctaStatYears,
      h.ctaStatResponse,
    ]}
  />
</BaseLayout>

<style>
  .hero-headline {
    font-size: clamp(2.4rem, 6.5vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.2rem;
    font-size: 0.82rem;
    color: var(--color-text-2);
    text-decoration: none;
  }
  .hero-tag:hover {
    color: var(--color-text);
  }
  @media (max-width: 380px) {
    .hero-headline {
      font-size: 2.2rem;
    }
  }

  .svc-row {
    display: grid;
    gap: 0.3rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
  }
  @media (min-width: 860px) {
    .svc-row {
      grid-template-columns: 15rem 1fr 13rem;
      gap: 2.4rem;
      align-items: baseline;
    }
  }
  .svc-name {
    font-size: clamp(1.3rem, 3.2vw, 1.8rem);
    letter-spacing: -0.045em;
  }
  .svc-row:hover .svc-name {
    color: var(--color-accent);
  }
  .svc-aside {
    color: var(--color-muted);
  }
  @media (min-width: 860px) {
    .svc-aside {
      text-align: right;
    }
  }

  .origin-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.6rem 1.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 2px;
  }
  .origin-title {
    font-size: clamp(1.3rem, 3.4vw, 1.6rem);
    letter-spacing: -0.045em;
  }
  .origin-cta {
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
  }
  .origin-cta:hover {
    text-decoration: underline;
  }

  .geo-grid {
    display: grid;
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
  }
  @media (min-width: 640px) {
    .geo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .geo-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .geo-cell {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 1.2rem;
    background-color: var(--color-bg);
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .geo-cell:hover {
    background-color: var(--color-surface);
  }

  .term {
    border-top: 2px solid var(--color-accent);
    padding-top: 0.9rem;
  }
</style>
