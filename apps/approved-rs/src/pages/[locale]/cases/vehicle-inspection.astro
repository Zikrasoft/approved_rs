---
import CasesTabPage from '@/components/CasesTabPage.astro';
import { toCaseItem } from '@/utils/cases';
import { getPublishedCasesByService } from '@/utils/casesQueries';
import { buildCasesTabPageData } from '@/utils/casesTabPage';
import { withLocales } from '@/utils/paths';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params;
const { meta, items, counts } = await buildCasesTabPageData(
  locale,
  'casesVehicleInspection',
  async () =>
    (await getPublishedCasesByService('vehicle-inspection')).map((c) =>
      toCaseItem(c, locale),
    ),
);
---

<CasesTabPage active="vehicle-inspection" {items} {counts} {meta} />
