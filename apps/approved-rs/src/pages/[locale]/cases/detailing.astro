---
import CasesTabPage from '@/components/CasesTabPage.astro';
import { toDetailingCaseItem } from '@/utils/cases';
import { getPublishedDetailingCases } from '@/utils/casesQueries';
import { buildCasesTabPageData } from '@/utils/casesTabPage';
import { withLocales, PathBuilder } from '@/utils/paths';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params;
const { meta, items, counts } = await buildCasesTabPageData(
  locale,
  'casesDetailing',
  PathBuilder.casesDetailing(locale),
  async () =>
    (await getPublishedDetailingCases()).map((c) =>
      toDetailingCaseItem(c, locale),
    ),
);
---

<CasesTabPage active="detailing" {items} {counts} {meta} />
