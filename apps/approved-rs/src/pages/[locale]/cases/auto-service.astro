---
import CasesTabPage from '@/components/CasesTabPage.astro';
import { toAutoserviceCaseItem } from '@/utils/cases';
import { getPublishedAutoserviceCases } from '@/utils/casesQueries';
import { buildCasesTabPageData } from '@/utils/casesTabPage';
import { withLocales, PathBuilder } from '@/utils/paths';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params;
const { meta, items, counts } = await buildCasesTabPageData(
  locale,
  'casesAutoService',
  PathBuilder.casesAutoService(locale),
  async () =>
    (await getPublishedAutoserviceCases()).map((c) =>
      toAutoserviceCaseItem(c, locale),
    ),
);
---

<CasesTabPage active="auto-service" {items} {counts} {meta} />
