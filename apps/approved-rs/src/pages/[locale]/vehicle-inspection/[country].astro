---
import { canonicalUrl } from '@/utils/pageHead';
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import StepsList from '@/components/StepsList.astro';
import Faq from '@/components/Faq.astro';
import MarketNotes from '@/components/MarketNotes.astro';
import { getCountryPaths, withLocales, PathBuilder } from '@/utils/paths';
import { getCountry } from '@/utils/geo';
import {
  generateMeta,
  ogImageFor,
  generateServiceSchema,
  buildLocation,
} from '@/utils/seo';
import { SITE_URL } from '@/utils/constants';
import { getCollection } from 'astro:content';
import { content } from '@/i18n/content';
import { servicesView } from '@/i18n/content/services';

export const getStaticPaths = () => withLocales(getCountryPaths());

const { locale, country: countryCode } = Astro.params;
const country = getCountry(countryCode!)!;
const sc = servicesView(locale)['vehicle-inspection'];
const location = buildLocation(locale, country);
const countryNote = sc.countryNoteFor(country.code);
const meta = {
  ...generateMeta('vehicle-inspection', {
    country,
    locale: locale,
  }),
  ogImage: ogImageFor(SITE_URL, 'vehicle-inspection', locale),
};
const cases = (await getCollection('cases'))
  .filter(
    (c) =>
      c.data.published &&
      c.data.country === countryCode &&
      c.data.service === 'vehicle-inspection',
  )
  .slice(0, 3);
const schema = generateServiceSchema(
  `${sc.title} ${location}`,
  country[locale].name,
  canonicalUrl(locale, Astro.url.pathname),
);
---

<ServicePageLayout
  {meta}
  {schema}
  {cases}
  title={sc.title}
  titleHighlight={location}
  description={sc.description}
  ctaLabel={sc.ctaLabel}
  formService="vehicle-inspection"
  currentCountry={countryCode!}
  currentService="vehicle-inspection"
  casesHeading={sc.casesHeading}
  breadcrumbs={[
    {
      label: country[locale].name,
      href: PathBuilder.service(locale, 'vehicle-sourcing', countryCode!),
    },
    { label: sc.breadcrumbLabel },
  ]}
  closing={sc.closing}
>
  <StepsList steps={sc.steps} />
  <p class="mt-6 text-sm leading-relaxed text-muted">
    {sc.extraLine}
  </p>

  <Fragment slot="extra">
    {
      countryNote && (
        <MarketNotes
          heading={sc.countryNotesHeadingFor(location)}
          pointsLabel={sc.countryNotesPointsLabel}
          note={countryNote}
        />
      )
    }
    <Faq items={content(locale).faq['vehicle-inspection']} />
  </Fragment>
</ServicePageLayout>
