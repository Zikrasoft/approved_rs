---
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import Faq from '@/components/Faq.astro';
import heroPhoto from '@/assets/service-import.jpg';
import PageSection from '@/components/PageSection.astro';
import StepsList from '@/components/StepsList.astro';
import IncludedGrid from '@/components/IncludedGrid.astro';
import { content } from '@/i18n/content';
import { servicesView } from '@/i18n/content/services';
import { withLocales, PathBuilder } from '@/utils/paths';
import { getCountry } from '@/utils/geo';
import CountryPlate from '@/components/CountryPlate.astro';
import { generateServiceSchema, placeholderOgImage } from '@/utils/seo';
import { getCollection } from 'astro:content';
import {
  SITE_URL,
  SITE_NAME,
  CHINA_NAME,
  VEHICLE_IMPORT_EU_SOURCE_CODES,
} from '@/utils/constants';
import type { VehicleImportSpoke } from '@/utils/vehicleImportCrossSell';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params;
const sc = servicesView(locale)['vehicle-import'];
const pc = sc.hub;
const meta = {
  title: `${pc.metaTitle} | ${SITE_NAME}`,
  description: pc.metaDescription,
  ogImage: placeholderOgImage(SITE_URL, locale),
};
const sourceNames = [
  getCountry('de')![locale].name,
  ...VEHICLE_IMPORT_EU_SOURCE_CODES.map(
    (code) => getCountry(code)![locale].name,
  ),
  CHINA_NAME[locale],
];
const schema = generateServiceSchema(
  `${pc.title} ${pc.titleHighlight}`,
  sourceNames,
);

const cases = (await getCollection('cases'))
  .filter((c) => c.data.published && c.data.service === 'vehicle-import')
  .slice(0, 6);

const cards: {
  slug: VehicleImportSpoke;
  title: string;
  text: string;
  code: string;
}[] = [
  {
    slug: 'eu',
    title: pc.euCardTitle,
    text: pc.euCardText,
    code: 'eu',
  },
  {
    slug: 'china',
    title: pc.chinaCardTitle,
    text: pc.chinaCardText,
    code: 'cn',
  },
];
---

<ServicePageLayout
  {meta}
  {schema}
  {cases}
  title={pc.title}
  titleHighlight={pc.titleHighlight}
  description={pc.description}
  ctaLabel={pc.ctaLabel}
  formService="vehicle-import"
  currentCountry="rs"
  currentService="vehicle-import"
  showCountryCrossLinks={false}
  casesHeading={pc.casesHeading}
  breadcrumbs={[{ label: pc.breadcrumbLabel }]}
  image={heroPhoto}
  imageAlt={pc.heroPhotoAlt}
  closing={sc.closing}
>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
    {
      cards.map((card) => (
        <a
          href={PathBuilder.vehicleImportSpoke(locale, card.slug)}
          class="import-card group glow-border flex flex-col p-6 rounded-sm border bg-surface border-default no-underline"
        >
          <p class="font-display text-xl font-bold mb-2 text-primary flex items-center gap-2.5">
            <CountryPlate code={card.code} size="md" />
            {card.title}
          </p>
          <p class="text-sm leading-relaxed mb-4 text-muted">{card.text}</p>
          <span class="mt-auto text-xs font-medium tracking-wide uppercase text-accent">
            {pc.exploreLabel} →
          </span>
        </a>
      ))
    }
  </div>

  <Fragment slot="extra">
    <PageSection title={pc.processHeading} lead={pc.processLead}>
      <StepsList steps={pc.processSteps} />
    </PageSection>

    <IncludedGrid
      heading={pc.includedHeading}
      lead={pc.includedLead}
      items={pc.included}
    />

    <Faq items={content(locale).faq['vehicle-import']} />
  </Fragment>
</ServicePageLayout>

<style>
  .import-card {
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .import-card:hover {
    background-color: var(--color-surface-2);
    border-color: var(--color-accent) !important;
  }
</style>
