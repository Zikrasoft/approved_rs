---
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import CountryPill from '@/components/CountryPill.astro';
import Faq from '@/components/Faq.astro';
import PageSection from '@/components/PageSection.astro';
import StepsList from '@/components/StepsList.astro';
import IncludedGrid from '@/components/IncludedGrid.astro';
import MarketCompare from '@/components/MarketCompare.astro';
import heroPhoto from '@/assets/service-sourcing.jpg';
import { getFaq } from '@/i18n/content/faq';
import { getServicesContent } from '@/i18n/content/services';
import { withLocales, PathBuilder } from '@/utils/paths';
import { getActiveCountries } from '@/utils/geo';
import { compareItemsFor } from '@/utils/compareItems';
import { generateServiceSchema, placeholderOgImage } from '@/utils/seo';
import { getCollection } from 'astro:content';
import { SITE_URL, SITE_NAME } from '@/utils/constants';
import type { Locale } from '@/i18n/config';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params as { locale: Locale };
const pc = getServicesContent(locale)['vehicle-sourcing'].hub;
const countries = getActiveCountries();
const meta = {
  title: `${pc.metaTitle} | ${SITE_NAME}`,
  description: pc.metaDescription,
  canonical: `${SITE_URL}${PathBuilder.vehicleSourcingHub(locale)}`,
  ogImage: placeholderOgImage(SITE_URL, locale),
};
const schema = generateServiceSchema(
  pc.title,
  countries.map((c) => c[locale].name),
  meta.canonical,
);

const sc = getServicesContent(locale)['vehicle-sourcing'];
const compareItems = compareItemsFor(
  locale,
  'vehicle-sourcing',
  sc.countryNoteFor,
  pc.compareLinkFor,
);

const cases = (await getCollection('cases'))
  .filter((c) => c.data.published && c.data.service === 'vehicle-sourcing')
  .slice(0, 6);
---

<ServicePageLayout
  {meta}
  {schema}
  {cases}
  title={pc.title}
  titleHighlight={pc.titleHighlight}
  description={pc.description}
  ctaLabel={pc.ctaLabel}
  formService="vehicle-sourcing"
  currentCountry="rs"
  currentService="vehicle-sourcing"
  showCountryCrossLinks={false}
  casesHeading={pc.casesHeading}
  breadcrumbs={[{ label: pc.breadcrumbLabel }]}
  image={heroPhoto}
  imageAlt={pc.heroPhotoAlt}
  closing={sc.closing}
>
  <p class="text-xs tracking-widest uppercase mb-4 font-medium text-muted">
    {pc.chooseCountryLabel}
  </p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    {countries.map((c) => <CountryPill country={c} locale={locale} />)}
  </div>

  <Fragment slot="extra">
    <PageSection title={pc.processHeading} lead={pc.processLead}>
      <StepsList steps={pc.processSteps} />
    </PageSection>

    <IncludedGrid
      heading={pc.includedHeading}
      lead={pc.includedLead}
      items={pc.included}
    />

    <MarketCompare
      heading={pc.compareHeading}
      lead={pc.compareLead}
      hint={pc.compareHint}
      pointsLabel={sc.countryNotesPointsLabel}
      items={compareItems}
    />

    <Faq items={getFaq(locale)['vehicle-sourcing']} />
  </Fragment>
</ServicePageLayout>
