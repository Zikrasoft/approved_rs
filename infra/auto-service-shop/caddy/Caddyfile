(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}

{$API_HOST} {
	import common

	request_body {
		max_size 1MB
	}

	redir /app https://{$ADMIN_HOST}/app
	redir /app/* https://{$ADMIN_HOST}{uri}

	@unexposed path /admin /admin/* /auth/user /auth/user/* /hooks/payment /hooks/payment/*
	handle @unexposed {
		respond 404
	}

	handle {
		reverse_proxy medusa:9000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

{$ADMIN_HOST} {
	import common

	request_body {
		max_size 25MB
	}

	redir / /app

	@guarded {
		not {
			path /auth/session /admin/invites/accept /auth/user/emailpass/update
			header Authorization "Bearer *"
		}
	}
	basic_auth @guarded {
		{$ADMIN_BASIC_AUTH_USER} {$ADMIN_BASIC_AUTH_HASH}
	}

	handle {
		reverse_proxy medusa:9000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

{$MEDIA_HOST} {
	import common

	@read method GET HEAD
	handle @read {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy {$MEDIA_ORIGIN} {
			header_up Host {upstream_hostport}
			header_down -X-Amz-Request-Id
			header_down -X-Amz-Id-2
			header_down -X-Amz-Server-Side-Encryption
			header_down -X-Amz-Version-Id
		}
	}

	handle {
		respond 405
	}
}

(site) {
	encode zstd gzip
	import sites/{args[0]}.caddy

	root * /srv/sites/{args[0]}/current/client

	handle /_image {
		respond 404
	}

	@page file {path}/index.html
	rewrite @page {file_match.relative}

	@file {
		file {path}
		not path */
	}
	handle @file {
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "public, max-age=0, must-revalidate"
		file_server
	}

	handle {
		reverse_proxy site-{args[0]}:4321 {
			header_up X-Request-Id {http.request.uuid}
		}
	}
}

(www) {
	redir https://{args[0]}{uri} permanent
}

{$CARLAB_HOST} {
	import site auto-service
}

www.{$CARLAB_HOST} {
	import www {$CARLAB_HOST}
}

{$DETAILS_HOST} {
	import site detailing
}

www.{$DETAILS_HOST} {
	import www {$DETAILS_HOST}
}

{$APPROVED_HOST} {
	import site approved-rs
}

www.{$APPROVED_HOST} {
	import www {$APPROVED_HOST}
}
