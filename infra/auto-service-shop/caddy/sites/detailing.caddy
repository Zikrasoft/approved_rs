header {
	defer
	Content-Security-Policy "frame-ancestors 'self'"
	Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://mc.yandex.ru https://mc.yandex.com https://yastatic.net https://connect.facebook.net https://www.googleadservices.com https://googleads.g.doubleclick.net; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://mc.yandex.ru https://mc.yandex.com wss://mc.yandex.ru wss://mc.yandex.com https://www.facebook.com https://connect.facebook.net https://*.doubleclick.net https://www.google.com https://www.googleadservices.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://www.google.com https://mc.yandex.ru https://mc.yandex.com https://td.doubleclick.net https://www.googletagmanager.com blob:; object-src 'none'; base-uri 'self'; form-action 'self'; report-uri /api/csp-report"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	Strict-Transport-Security "max-age=63072000; includeSubDomains"
	-Server
}
@redirect0 path_regexp redirect0 `^\/services(?:\/((?:[^\/]+?)(?:\/(?:[^\/]+?))*))?$`
redir @redirect0 /sr/services/{re.redirect0.1}{?query} 308
@redirect1 path_regexp redirect1 `^\/works(?:\/((?:[^\/]+?)(?:\/(?:[^\/]+?))*))?$`
redir @redirect1 /sr/works/{re.redirect1.1}{?query} 308
@redirect2 path_regexp redirect2 `^\/contact$`
redir @redirect2 /sr/contact/{?query} 308
@redirect3 path_regexp redirect3 `^\/contact\/$`
redir @redirect3 /sr/contact/{?query} 308
@redirect4 path_regexp redirect4 `^\/thanks$`
redir @redirect4 /sr/thanks/{?query} 308
@redirect5 path_regexp redirect5 `^\/thanks\/$`
redir @redirect5 /sr/thanks/{?query} 308
@redirect6 path_regexp redirect6 `^\/privacy$`
redir @redirect6 /sr/privacy/{?query} 308
@redirect7 path_regexp redirect7 `^\/privacy\/$`
redir @redirect7 /sr/privacy/{?query} 308
@redirect8 path_regexp redirect8 `^\/about$`
redir @redirect8 /sr/about/{?query} 308
@redirect9 path_regexp redirect9 `^\/about\/$`
redir @redirect9 /sr/about/{?query} 308
