{
  "uid": "carlab-shop",
  "title": "CarLab shop",
  "tags": ["carlab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Errors by cause (store.error)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (reason) (count_over_time({service=\"medusa\", event=\"store.error\"} | json reason=\"reason\" [$__auto]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Latest errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"medusa\", event=\"store.error\"} | json route=\"route\", status=\"status\", cause=\"cause\" | line_format \"{{.route}} {{.status}} {{.cause}}\""
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests by route",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (route) (count_over_time({service=\"medusa\", event=\"store.request\"} | json route=\"route\" [$__auto]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 latency by route",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service=\"medusa\", event=\"store.request\"} | json route=\"route\", duration_ms=\"duration_ms\" | unwrap duration_ms [$__auto]) by (route)",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests by outcome",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (outcome) (count_over_time({service=\"medusa\", event=\"store.request\"} | json outcome=\"outcome\" [$__auto]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Searches by intent",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (intent) (count_over_time({service=\"medusa\", event=\"search\"} | json intent=\"intent\" [$__auto]))",
          "legendFormat": "{{intent}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Zero-result search rate",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"medusa\", event=\"search\"} | json zero=\"zero\" | zero=\"true\" [$__range])) / sum(count_over_time({service=\"medusa\", event=\"search\"} [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "VIN unresolved rate",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"medusa\", event=\"vin.lookup\"} | json outcome=\"outcome\" | outcome=\"unresolved\" [$__range])) / sum(count_over_time({service=\"medusa\", event=\"vin.lookup\"} [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top zero-result queries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(20, sum by (query) (count_over_time({service=\"medusa\", event=\"search\"} | json zero=\"zero\", query=\"query\" | zero=\"true\" | query!=\"\" [$__range])))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Unresolved VINs by reason",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (reason) (count_over_time({service=\"medusa\", event=\"vin.lookup\"} | json outcome=\"outcome\", reason=\"reason\" | outcome=\"unresolved\" [$__auto]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Unresolved VIN codes by make",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(20, sum by (make, code) (count_over_time({service=\"medusa\", event=\"vin.lookup\"} | json outcome=\"outcome\", make=\"make\", code=\"code\" | outcome=\"unresolved\" [$__range])))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Inquiries, checkouts and order hand-offs by outcome",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (event, outcome) (count_over_time({service=\"medusa\", event=~\"storefront.lead|storefront.checkout|order.handoff\"} | json outcome=\"outcome\" [$__auto]))",
          "legendFormat": "{{event}} {{outcome}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Storefront search outcome",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (route, outcome) (count_over_time({service=\"medusa\", event=\"storefront.search\"} | json route=\"route\", outcome=\"outcome\" [$__auto]))",
          "legendFormat": "{{route}} {{outcome}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Cart actions by outcome",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (action, outcome) (count_over_time({service=\"medusa\", event=\"storefront.cart\"} | json action=\"action\", outcome=\"outcome\" [$__auto]))",
          "legendFormat": "{{action}} {{outcome}}"
        }
      ]
    }
  ]
}
