---
import type { Locale } from '../i18n/config';

const locale = (Astro.currentLocale ?? 'ru') as Locale;

const COOKIE_TEXT: Record<Locale, { notice: string; more: string; policyLink: string; accept: string; decline: string }> = {
  ru: {
    notice: 'Мы используем аналитические cookies (Google Analytics), чтобы понимать, как посетители используют сайт.',
    more: 'Подробнее в',
    policyLink: 'политике конфиденциальности',
    accept: 'Принять',
    decline: 'Отклонить',
  },
  en: {
    notice: 'We use analytics cookies (Google Analytics) to understand how visitors use the site.',
    more: 'Learn more in our',
    policyLink: 'privacy policy',
    accept: 'Accept',
    decline: 'Decline',
  },
  sr: {
    notice: 'Koristimo analitičke kolačiće (Google Analytics) da bismo razumeli kako posetioci koriste sajt.',
    more: 'Više informacija u',
    policyLink: 'politici privatnosti',
    accept: 'Prihvati',
    decline: 'Odbij',
  },
};
const cc = COOKIE_TEXT[locale];
---

<div
  id="cookie-consent"
  hidden
  class="fixed bottom-4 left-4 right-4 sm:left-auto sm:right-6 sm:max-w-sm z-50 rounded-sm border border-default p-5 shadow-lg"
  style="background: var(--color-surface);"
>
  <p class="text-sm leading-relaxed text-secondary mb-4">
    {cc.notice}
    {' '}{cc.more}{' '}
    <a href={`/${locale}/privacy/`} class="underline text-accent">{cc.policyLink}</a>.
  </p>
  <div class="flex gap-3">
    <button
      id="cookie-accept"
      class="px-4 py-2 rounded-sm text-xs font-medium border border-accent-border text-accent"
    >
      {cc.accept}
    </button>
    <button
      id="cookie-decline"
      class="px-4 py-2 rounded-sm text-xs font-medium text-muted"
    >
      {cc.decline}
    </button>
  </div>
</div>

<script is:inline>
  function initCookieConsent() {
    var consent;
    try { consent = localStorage.getItem('cookie_consent'); } catch (e) {}
    if (consent) return;

    var el = document.getElementById('cookie-consent');
    if (!el) return;
    el.hidden = false;

    document.getElementById('cookie-accept').addEventListener('click', function () {
      try { localStorage.setItem('cookie_consent', 'granted'); } catch (e) {}
      if (window.loadAnalytics) window.loadAnalytics();
      el.hidden = true;
    });

    document.getElementById('cookie-decline').addEventListener('click', function () {
      try { localStorage.setItem('cookie_consent', 'denied'); } catch (e) {}
      el.hidden = true;
    });
  }
  initCookieConsent();
</script>
