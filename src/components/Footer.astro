---
import SiteLogo from './SiteLogo.astro';
import ContactIcon from './ContactIcon.astro';
import { getNavItems } from '@/utils/labels';
import { getI18n } from '@/i18n/getI18n';
import { getLocale } from '@/i18n/config';
import { getServicesContent } from '@/i18n/content/services';
import { SITE_NAME, DEFAULT_COUNTRY, TG_MANAGER, WHATSAPP_NUMBER, VIBER_NUMBER, THREADS_CHANNEL } from '@/utils/constants';
import { telegramLink, DEFAULT_TG_MESSAGE } from '@/utils/telegramLink';
import { whatsappLink, viberLink } from '@/utils/contactLinks';
const year = new Date().getFullYear();
const locale = getLocale(Astro.currentLocale);
const t = getI18n(locale);
const cc = getServicesContent(locale).caseChrome;
const message = DEFAULT_TG_MESSAGE[locale];
---

<footer class="mt-24 border-t border-default">
  <div class="max-w-6xl mx-auto px-6 pt-14 pb-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">

      <!-- Brand -->
      <div class="lg:col-span-2">
        <div class="mb-3">
          <SiteLogo size="sm" />
        </div>
        <p class="text-sm leading-relaxed max-w-xs mb-6 text-muted">
          {t.footer.tagline}
        </p>
        <div class="flex flex-wrap gap-2">
          <a
            data-contact-channel="telegram"
            href={telegramLink(TG_MANAGER, message)}
            target="_blank"
            rel="noopener"
            class="footer-tg inline-flex items-center gap-2 px-4 py-2 rounded-sm text-xs font-medium no-underline border border-accent-border text-accent"
          >
            <ContactIcon channel="telegram" size={14} />
            {t.footer.contactManagerLabel}
          </a>
          <a
            data-contact-channel="whatsapp"
            href={whatsappLink(WHATSAPP_NUMBER, message)}
            target="_blank"
            rel="noopener"
            aria-label={cc.whatsappButtonLabel}
            class="footer-tg inline-flex items-center gap-2 px-3 py-2 rounded-sm text-xs font-medium no-underline border border-accent-border text-accent"
          >
            <ContactIcon channel="whatsapp" size={14} />
          </a>
          <a
            data-contact-channel="viber"
            href={viberLink(VIBER_NUMBER)}
            target="_blank"
            rel="noopener"
            aria-label={cc.viberButtonLabel}
            class="footer-tg inline-flex items-center gap-2 px-3 py-2 rounded-sm text-xs font-medium no-underline border border-accent-border text-accent"
          >
            <ContactIcon channel="viber" size={14} />
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <p class="text-xs font-semibold tracking-[0.16em] uppercase mb-4 text-muted">{t.footer.servicesHeading}</p>
        <nav class="flex flex-col gap-2.5 text-sm footer-nav text-secondary">
          {getNavItems(locale, DEFAULT_COUNTRY).map(item => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>

      <!-- Company -->
      <div>
        <p class="text-xs font-semibold tracking-[0.16em] uppercase mb-4 text-muted">{t.footer.companyHeading}</p>
        <nav class="flex flex-col gap-2.5 text-sm footer-nav text-secondary">
          <a href={`/${locale}/cases/autopodbor/`}>{t.nav.cases}</a>
          <a href={`/${locale}/contacts/`}>{t.nav.contacts}</a>
          <a href={`/${locale}/privacy/`}>{t.footer.privacyLabel}</a>
        </nav>
        <div class="mt-6 space-y-1.5">
          <p class="text-xs text-muted">{t.footer.coverageLine}</p>
          <p class="text-xs text-muted">{t.footer.hoursLine}</p>
        </div>
      </div>

    </div>

    <!-- Bottom -->
    <div class="pt-6 border-t border-default flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <p class="text-xs text-muted">© {year} {SITE_NAME} — {t.footer.copyrightSuffix}</p>
      <a
        href={`https://www.threads.com/@${THREADS_CHANNEL}`}
        target="_blank"
        rel="noopener"
        class="footer-channel text-xs no-underline text-muted"
      >
        {t.footer.channelLinkLabel}
        <span class="footer-channel-arrow inline-block text-[0.85em] transition-transform duration-200">→</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-nav a { transition: color 0.2s; }
  .footer-nav a:hover { color: var(--color-text) !important; }

  .footer-tg { transition: background-color 0.2s, border-color 0.2s; }
  .footer-tg:hover { background-color: var(--color-accent-subtle); border-color: var(--color-accent) !important; }

  .footer-channel { transition: color 0.2s; }
  .footer-channel:hover { color: var(--color-accent) !important; }
  .footer-channel:hover .footer-channel-arrow { transform: translateX(3px); }
</style>
