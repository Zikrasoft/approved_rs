---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from './CaseCard.astro';
import CaseCategoryTabs from './CaseCategoryTabs.astro';
import PageHero from './PageHero.astro';
import type { CaseCardProps } from './CaseCard.astro';

interface Props {
  active: 'autopodbor' | 'autoservice';
  items: CaseCardProps[];
  otherCount: number;
  meta: { title: string; description: string; canonical: string };
}

const { active, items, otherCount, meta } = Astro.props;
const autopodborCount = active === 'autopodbor' ? items.length : otherCount;
const autoserviceCount = active === 'autoservice' ? items.length : otherCount;
---

<BaseLayout {...meta}>
  <PageHero decoWord="CASES" title="Кейсы" subtitle="Реальные автомобили, реальные цены, реальные истории" />

  <section class="max-w-6xl mx-auto px-6 py-16" transition:animate="fade">
    <CaseCategoryTabs {active} {autopodborCount} {autoserviceCount} />

    {items.length > 0
      ? <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {items.map((item, j) => (
            <div style={`animation: fadeUp 0.75s ${0.05 + 0.07 * j}s cubic-bezier(0.16,1,0.3,1) both;`}>
              <CaseCard {...item} />
            </div>
          ))}
        </div>
      : <p class="text-sm text-muted">Кейсы скоро появятся.</p>
    }
  </section>
</BaseLayout>
