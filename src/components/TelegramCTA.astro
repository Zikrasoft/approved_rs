---
import { Send } from '@lucide/astro';
import Button from './Button.astro';
import ThreadsButton from './ThreadsButton.astro';
import { telegramLink } from '../utils/telegramLink';
import { getServicesContent } from '../i18n/content/services';
import type { Locale } from '../i18n/config';

interface Props {
  manager?: string;
  label?: string;
  openModal?: boolean;
  text?: string;
}

const locale = (Astro.currentLocale ?? 'ru') as Locale;
const {
  manager = import.meta.env.PUBLIC_TG_MANAGER!,
  label = getServicesContent(locale).caseChrome.ctaButtonLabel,
  openModal = false,
  text,
} = Astro.props;
---

<div class="flex flex-col sm:flex-row gap-3 my-8">
  <Button
    data-open-page-lead-modal={openModal ? true : undefined}
    href={openModal ? undefined : telegramLink(manager, text)}
    target={openModal ? undefined : '_blank'}
    rel={openModal ? undefined : 'noopener'}
    class="gap-2.5 px-6 py-3 tracking-[0.03em] w-full sm:w-auto justify-center"
  >
    <Send size={15} />
    {label}
  </Button>

  <ThreadsButton />
</div>
