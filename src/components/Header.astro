---
import { Menu, X, Send, Sun, Moon, Search, Wrench, Banknote, ClipboardCheck } from '@lucide/astro';
import SiteLogo from './SiteLogo.astro';
import Button from './Button.astro';
import LeadFormModal from './LeadFormModal.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getNavItems, isNavItemActive, SERVICES } from '@/utils/labels';
import { getI18n } from '@/i18n/getI18n';
import { getLocale } from '@/i18n/config';
import { DEFAULT_COUNTRY } from '@/utils/constants';
import { getActiveCountries } from '@/utils/geo';

const locale = getLocale(Astro.currentLocale);
const t = getI18n(locale);
// Country only sits at a fixed position (segment 2) on the 3 country-scoped
// service pages (/ru/autopodbor/de/...) — everywhere else (contacts, cases,
// the home page) there's no country in the URL at all, so fall back to the
// default rather than misreading an unrelated segment as a country code.
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const isServicePage = SERVICES.some(s => s.slug === pathSegments[1]);
const urlCountry = isServicePage ? pathSegments[2] : undefined;
const navCountry = getActiveCountries().some(c => c.code === urlCountry) ? urlCountry! : DEFAULT_COUNTRY;
const isHome = Astro.url.pathname === `/${locale}/` || Astro.url.pathname === `/${locale}`;

// Record (not `as const` + cast) so a slug added to labels.ts without a
// matching entry here degrades to a missing icon instead of a broken build.
const SERVICE_ICONS: Record<string, typeof Search> = {
  autopodbor: Search,
  autoservice: Wrench,
  vykup: Banknote,
  proverka: ClipboardCheck,
};

// Computed once and shared by the desktop and mobile nav below (both used
// to call getNavItems()/isNavItemActive() separately for the same country).
const navItems = getNavItems(locale, navCountry).map(item => ({
  ...item,
  Icon: SERVICE_ICONS[item.slug],
  active: isNavItemActive(item, locale, navCountry, Astro.url.pathname),
}));
---

<header class="sticky top-0 z-50 border-b bg-header-glass border-default backdrop-blur-[16px]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3 lg:gap-6">

    <SiteLogo />

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-0.5 xl:gap-2 text-sm font-sans font-normal header-nav flex-1 justify-center min-w-0">
      {navItems.map(item => (
        <a href={item.href} class="flex items-center gap-1.5 px-1.5 xl:px-2.5 py-1.5 rounded-sm text-muted whitespace-nowrap" aria-current={item.active ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a href={`/${locale}/cases/autopodbor/`} class="px-1.5 xl:px-2.5 py-1.5 text-muted whitespace-nowrap" aria-current={Astro.url.pathname.includes('/cases/') ? 'page' : undefined}>{t.nav.cases}</a>
      <a href={`/${locale}/contacts/`} class="px-1.5 xl:px-2.5 py-1.5 text-muted whitespace-nowrap" aria-current={Astro.url.pathname === `/${locale}/contacts/` ? 'page' : undefined}>{t.nav.contacts}</a>
    </nav>

    <div class="flex items-center gap-1.5 xl:gap-2 shrink-0">
      <!-- Language switcher: desktop only, grouped with theme toggle (both are
           preference controls, not nav destinations) — mobile gets its own
           row inside #mobile-menu -->
      <div class="hidden lg:block">
        <LanguageSwitcher />
      </div>

      <!-- Theme toggle: desktop only — mobile gets its own row inside #mobile-menu -->
      <button
        class="theme-toggle-btn theme-btn hidden lg:flex items-center justify-center w-9 h-9 rounded-sm border border-border-strong bg-surface text-muted"
        aria-label={t.header.themeToggleLabel}
        title={t.header.themeToggleLabel}
      >
        <!-- Sun: shown when dark (click → light) -->
        <span class="theme-icon-sun hidden"><Sun size={16} /></span>
        <!-- Moon: shown when light (click → dark) -->
        <span class="theme-icon-moon"><Moon size={16} /></span>
      </button>

      <!-- CTA: always visible, full text only once there's room (xl) —
           the lg breakpoint is where desktop nav first turns on and is
           already tight with 6 nav links + lang switcher + theme toggle. -->
      <Button type="button" data-open-lead-modal class="px-3 xl:px-4 py-2">
        <Send size={13} />
        <span class="xl:hidden">{t.header.ctaShort}</span>
        <span class="hidden xl:inline">{t.header.ctaLong}</span>
      </Button>

      <!-- Mobile burger -->
      <button
        id="burger"
        class="lg:hidden flex items-center justify-center w-9 h-9 rounded-sm border border-border-strong text-secondary"
        aria-label={t.header.menuLabel}
        aria-expanded={isHome ? 'true' : 'false'}
      >
        <span id="burger-open" class:list={{ hidden: isHome }}><Menu size={18} /></span>
        <span id="burger-close" class:list={{ hidden: !isHome }}><X size={18} /></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu: open by default on the homepage -->
  <div
    id="mobile-menu"
    class:list={['lg:hidden border-t bg-header-mobile border-default', { 'menu-open': isHome }]}
    aria-hidden={isHome ? undefined : 'true'}
    inert={isHome ? undefined : true}
  >
    <div class="overflow-hidden">
      <nav class="max-w-6xl mx-auto px-6 py-5 flex flex-col gap-0 mobile-nav">
        <div class="grid grid-cols-2 gap-2 mb-4">
          {navItems.map(item => (
            <a href={item.href} class="mobile-service-card flex flex-col items-center justify-center gap-2 py-5 rounded-sm border border-default text-secondary" aria-current={item.active ? 'page' : undefined}>
              {item.Icon && <item.Icon size={20} />}
              <span class="text-sm">{item.label}</span>
            </a>
          ))}
        </div>
        <a href={`/${locale}/cases/autopodbor/`} class="text-secondary">{t.nav.cases}</a>
        <a href={`/${locale}/contacts/`} class="text-secondary">{t.nav.contacts}</a>
        <div class="py-3"><LanguageSwitcher variant="inline" /></div>
        <button type="button" class="theme-toggle-btn flex items-center gap-2 w-full py-[0.85rem] text-secondary">
          <span class="theme-icon-sun hidden"><Sun size={16} /></span>
          <span class="theme-icon-moon"><Moon size={16} /></span>
          {t.header.themeToggleMobileLabel}
        </button>
      </nav>
    </div>
  </div>

  <LeadFormModal id="lead-modal" triggerAttr="data-open-lead-modal" />
</header>

<style>
  .header-nav a {
    position: relative;
    padding-bottom: 2px;
    transition: color 0.2s;
  }
  .header-nav a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-spring);
  }
  .header-nav a:hover { color: var(--color-text) !important; }
  .header-nav a:hover::after { transform: scaleX(1); }
  .header-nav a[aria-current="page"] { color: var(--color-text) !important; }
  .header-nav a[aria-current="page"]::after { transform: scaleX(1); }

  .theme-btn { transition: border-color 0.2s, color 0.2s, background-color 0.2s; }
  .theme-btn:hover {
    border-color: var(--color-accent) !important;
    color: var(--color-accent) !important;
  }

  .mobile-nav > a {
    display: block;
    padding: 0.85rem 0;
    font-size: 1rem;
    font-weight: 400;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.2s, transform 0.2s;
  }
  .mobile-nav > a:last-of-type { border-bottom: none; }
  .mobile-nav > a:hover { color: var(--color-text) !important; transform: translateX(0.5rem); }

  .mobile-service-card { transition: background-color 0.2s, border-color 0.2s; }
  .mobile-service-card:active,
  .mobile-service-card[aria-current="page"] {
    background-color: var(--color-accent-subtle);
    border-color: var(--color-accent-border);
    color: var(--color-accent) !important;
  }

  /* Grid-rows collapse: animates real layout height (not just a visual
     clip), so closing actually shrinks the sticky header smoothly instead
     of snapping via display:none. Scoped under lg's breakpoint so it never
     fights the lg:hidden utility's display:none on desktop. */
  @media (max-width: 1023px) {
    #mobile-menu {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 750ms var(--ease-spring),
        opacity 650ms var(--ease-spring);
      pointer-events: none;
    }
    #mobile-menu.menu-open {
      grid-template-rows: 1fr;
      opacity: 1;
      pointer-events: auto;
    }
    #mobile-menu.no-anim {
      transition: none;
    }
  }
</style>

<script is:inline>
  function updateThemeIcons() {
    var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    document.querySelectorAll('.theme-icon-sun').forEach(function (el) { el.classList.toggle('hidden', !isDark); });
    document.querySelectorAll('.theme-icon-moon').forEach(function (el) { el.classList.toggle('hidden', isDark); });
  }

  function initHeader() {
    // Guard against double init: Vite/Astro HMR can re-run this inline
    // script on the same live DOM (e.g. after editing this file) without a
    // full page reload. Without this, every listener below (theme toggle,
    // OS-theme listener, burger/menu/scroll) stacks a second copy on top of
    // the first, and a single click/scroll fires both in the same tick —
    // e.g. the theme flips twice (looks like the button "stopped working"),
    // or the menu opens then immediately closes (looks like it toggles on
    // its own).
    if (document.body.dataset.headerInit) return;
    document.body.dataset.headerInit = '1';

    /* ── Theme toggle: one in the desktop bar, one in the mobile menu ── */
    updateThemeIcons();
    document.querySelectorAll('.theme-toggle-btn').forEach(function (toggle) {
      toggle.addEventListener('click', function () {
        var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (isDark) {
          document.documentElement.removeAttribute('data-theme');
          try { localStorage.setItem('theme', 'light'); } catch (e) {}
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
          try { localStorage.setItem('theme', 'dark'); } catch (e) {}
        }
        updateThemeIcons();
      });
    });

    /* ── Mobile burger ── */
    var burger = document.getElementById('burger');
    var menu   = document.getElementById('mobile-menu');
    var open   = document.getElementById('burger-open');
    var close  = document.getElementById('burger-close');

    // The menu's own grid-rows open animation (750ms, see <style> below)
    // nudges the browser's scroll-anchoring by a few px with no real user
    // scroll involved — ignoreScrollCloseUntil tells the scroll listener
    // below to sit out that window instead of treating it as a real scroll
    // and closing the menu it was just asked to open.
    let ignoreScrollCloseUntil = 0;

    function openMenu() {
      if (!menu || !burger) return;
      ignoreScrollCloseUntil = Date.now() + 900;
      menu.classList.add('menu-open');
      menu.removeAttribute('aria-hidden');
      menu.inert = false;
      burger.setAttribute('aria-expanded', 'true');
      open  && open.classList.add('hidden');
      close && close.classList.remove('hidden');
    }

    function closeMenu(instant) {
      if (!menu || !burger) return;
      if (instant) menu.classList.add('no-anim');
      menu.classList.remove('menu-open');
      menu.setAttribute('aria-hidden', 'true');
      menu.inert = true;
      burger.setAttribute('aria-expanded', 'false');
      open  && open.classList.remove('hidden');
      close && close.classList.add('hidden');
      if (instant) {
        // Force the closed state to paint before re-enabling the
        // transition, so it doesn't animate a state that was never visible.
        menu.offsetHeight;
        requestAnimationFrame(function () { menu.classList.remove('no-anim'); });
      }
    }

    if (burger && menu) {
      burger.addEventListener('click', function () {
        burger.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
      });
      menu.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { closeMenu(); });
      });

      // Close the mobile menu when the "Оставить заявку" button opens the
      // lead modal (LeadFormModal.astro owns the modal itself, this just
      // keeps the burger menu from staying open behind it).
      document.querySelectorAll('[data-open-lead-modal]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (burger.getAttribute('aria-expanded') === 'true') closeMenu();
        });
      });

      // Reset menu state if the viewport grows into desktop, so it doesn't
      // reappear pre-opened if the user shrinks back to mobile later.
      try {
        window.matchMedia('(min-width: 1024px)').addEventListener('change', function (e) {
          if (e.matches) closeMenu();
        });
      } catch (e) {}

      // Header is sticky, so a menu left open pins to the top and eats the
      // viewport — close it whenever it's open and the user scrolls past a
      // small threshold (the home page's default-open state, but also any
      // page where the burger was opened by hand). Checks the live
      // aria-expanded state each time rather than closing once and
      // detaching, so it keeps working for every open on every page.
      //
      // The mobile menu's own open animation triggers a 'scroll' event or
      // two on its own (scroll-anchoring compensating for the layout
      // change, not real user scrolling) — without the guard below, opening
      // the menu while already scrolled past the threshold made this
      // handler close it again almost immediately, so the menu looked
      // impossible to open once scrolled down.
      window.addEventListener('scroll', function () {
        if (Date.now() < ignoreScrollCloseUntil) return;
        if (window.scrollY <= 60) return;
        if (burger.getAttribute('aria-expanded') === 'true') closeMenu();
      }, { passive: true });

      // Browsers restore the previous scroll position on reload — if that
      // lands us already past the threshold, the menu (pre-opened by SSR)
      // would otherwise flash open for a frame and then visibly snap shut.
      // Correct it instantly, before that ever paints. This script runs
      // early (top of <body>), before some browsers finish restoring the
      // scroll position, so the check may fire too soon and miss — a
      // same-frame backstop catches that case too.
      function correctForRestoredScroll() {
        if (window.scrollY > 60 && burger.getAttribute('aria-expanded') === 'true') closeMenu(true);
      }
      correctForRestoredScroll();
      requestAnimationFrame(correctForRestoredScroll);
    }

    // Follow OS theme changes live, but only while the user hasn't picked one explicitly.
    try {
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
        if (localStorage.getItem('theme')) return;
        if (e.matches) document.documentElement.setAttribute('data-theme', 'dark');
        else document.documentElement.removeAttribute('data-theme');
        updateThemeIcons();
      });
    } catch (e) {}
  }

  initHeader();
</script>
