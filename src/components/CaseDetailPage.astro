---
// Shared by auto-service-belgrade/[slug].astro and detailing-belgrade/[slug].astro
// — same layout, translation-fallback logic, gallery, promo/channel banners,
// and CTA. The two kinds only differ in a handful of derived values (deco
// word, breadcrumb, canonical path, which "what we do" list feeds the work
// badges) — CASE_DETAIL_CONFIG below is the single place that mapping lives,
// so callers just pass `promoKind` instead of re-deriving all of it.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import CaseGallery from '@/components/CaseGallery.astro';
import PromoBanner from '@/components/PromoBanner.astro';
import ChannelBanner from '@/components/ChannelBanner.astro';
import { render, type CollectionEntry } from 'astro:content';
import { SITE_URL, SITE_NAME } from '@/utils/constants';
import { excerptFromMarkdown, generateArticleSchema } from '@/utils/seo';
import { getPromoBanners } from '@/i18n/content/promoBanners';
import { getServicesContent, type ServicesContent } from '@/i18n/content/services';
import { getLocale, type Locale } from '@/i18n/config';
import { getI18n } from '@/i18n/getI18n';
import { PathBuilder } from '@/utils/paths';
import { marked } from 'marked';

type CaseDetailKind = 'auto-service' | 'detailing';

const CASE_DETAIL_CONFIG: Record<CaseDetailKind, {
  decoWord: string;
  navKey: 'auto-service-belgrade' | 'detailing-belgrade';
  hub: (locale: Locale) => string;
  buildCanonical: (locale: Locale, caseId: string) => string;
  whatWeDo: (sc: ServicesContent) => { key: string; label: string }[];
}> = {
  'auto-service': {
    decoWord: 'SERVICE',
    navKey: 'auto-service-belgrade',
    hub: PathBuilder.autoServiceBelgrade,
    buildCanonical: PathBuilder.autoServiceCase,
    whatWeDo: sc => sc.autoServiceBelgrade.whatWeDo,
  },
  detailing: {
    decoWord: 'DETAILING',
    navKey: 'detailing-belgrade',
    hub: PathBuilder.detailingBelgrade,
    buildCanonical: PathBuilder.detailingCase,
    whatWeDo: sc => sc.detailingBelgrade.whatWeDo,
  },
};

interface Props {
  case: CollectionEntry<'autoserviceCases'> | CollectionEntry<'detailingCases'>;
  promoKind: CaseDetailKind;
}

const { case: c, promoKind } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getI18n(locale);
const sc = getServicesContent(locale);
const cc = sc.caseChrome;
const config = CASE_DETAIL_CONFIG[promoKind];
const workLabels = Object.fromEntries(config.whatWeDo(sc).map(w => [w.key, w.label]));
const decoWord = config.decoWord;
const breadcrumbLabel = t.nav[config.navKey];
const breadcrumbHref = config.hub(locale);
const canonical = `${SITE_URL}${config.buildCanonical(locale, c.id)}`;

// Body is written in ru; en/sr get an optional title+body translation right
// on the same entry's `translations` field. No translation yet → fall back
// to the ru original rather than leaving the page half-broken.
const translation = locale === 'en' ? c.data.translations?.en : locale === 'sr' ? c.data.translations?.sr : undefined;

const title = translation?.title ?? c.data.title;
const car = c.data.car ?? title;
const year = c.data.car ? c.data.year : undefined;
const carYear = [car, year].filter(Boolean).join(' ');
const { Content } = await render(c);
const translatedHtml = translation ? await marked.parse(translation.body) : null;
const banners = getPromoBanners(locale, promoKind);

const hook = excerptFromMarkdown(translation?.body ?? c.body ?? '');
const imageUrl = c.data.image ? `${SITE_URL}${c.data.image.src}` : undefined;

const meta = {
  title: `${title} | ${SITE_NAME}`,
  description: hook ? `${hook} ${carYear}.`.trim() : `${carYear}. ${cc.realCaseFallback}`,
  canonical,
  // Real car photo makes a more compelling share preview than the generic template.
  ogImage: imageUrl,
  ogImageWidth: c.data.image?.width,
  ogImageHeight: c.data.image?.height,
};

const schema = generateArticleSchema({
  headline: title,
  description: meta.description,
  image: imageUrl,
  datePublished: c.data.date,
  url: canonical,
});
---

<BaseLayout {...meta} {schema}>
  <section class="hero-grid relative border-b overflow-hidden border-default">
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 50% 60% at 0% 50%, var(--color-ambient-glow) 0%, transparent 60%), radial-gradient(ellipse 40% 50% at 100% 0%, var(--color-accent-subtle) 0%, transparent 55%);"></div>
    <span class="deco-word" style="font-size: clamp(7rem, 18vw, 16rem); bottom: -1rem; right: -1%; opacity: 0.8;">{decoWord}</span>

    <div class="relative max-w-6xl mx-auto px-6 py-16 md:py-24">
      <Breadcrumbs items={[{ label: breadcrumbLabel, href: breadcrumbHref }, { label: title }]} />

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
        <div class="lg:col-span-3">
          <div class="flex flex-wrap gap-2 mb-6">
            {c.data.servicesApplied.map(s => (
              <span class="text-xs tracking-widest uppercase font-medium px-3 py-1 rounded-sm border text-accent border-accent">
                {workLabels[s] ?? s}
              </span>
            ))}
          </div>

          <span class="eyebrow fade-up fade-up-1">{SITE_NAME}</span>
          <h1 class="font-display font-bold mb-5 leading-none fade-up fade-up-2 tracking-[-0.03em] text-primary" style="font-size: clamp(2.6rem, 5vw, 4.4rem);">{title}</h1>

          <div class="grid grid-cols-2 gap-6 max-w-sm fade-up fade-up-3">
            {c.data.car && (
              <div>
                <p class="text-xs tracking-wide uppercase mb-1 font-medium text-muted">{cc.autoLabel}</p>
                <p class="text-sm font-medium text-primary">{c.data.car}</p>
              </div>
            )}
            {year && (
              <div>
                <p class="text-xs tracking-wide uppercase mb-1 font-medium text-muted">{cc.yearLabel}</p>
                <p class="text-sm font-medium text-primary">{year}</p>
              </div>
            )}
          </div>
        </div>

        {c.data.image && (
          <div class="lg:col-span-2 fade-up fade-up-3 overflow-hidden border md:rounded-sm aspect-[4/3] border-default">
            <Image
              src={c.data.image}
              alt={car}
              format="webp"
              class="w-full h-full object-cover"
            />
          </div>
        )}
      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-6">
    <!-- Content -->
    <div class="py-12 prose-custom">
      {translatedHtml
        ? <div class="leading-relaxed text-base text-primary [&>p]:mb-5 [&>p:last-child]:mb-0" set:html={translatedHtml} />
        : <div class="leading-relaxed text-base text-primary [&>p]:mb-5 [&>p:last-child]:mb-0"><Content /></div>
      }
    </div>

    <!-- More photos -->
    <CaseGallery images={c.data.gallery} name={car} />

    <!-- SEO banner -->
    <PromoBanner label={cc.usefulInfoLabel} {banners} />

    <!-- Channel promo -->
    <ChannelBanner />

    <!-- CTA -->
    <div class="py-10 border-t mb-16 border-default">
      <p class="text-xs tracking-widest uppercase mb-2 font-medium text-accent">{cc.ctaEyebrow}</p>
      <h2 class="font-display text-3xl font-bold mb-6">{cc.ctaHeading}</h2>
      <ContactCTA label={cc.ctaButtonLabel} />
    </div>
  </div>
</BaseLayout>
