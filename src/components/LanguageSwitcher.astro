---
import { SUPPORTED_LOCALES, type Locale } from '../i18n/config';

const currentLocale = (Astro.currentLocale ?? 'ru') as Locale;
const segments = Astro.url.pathname.split('/').filter(Boolean);
const rest = segments.slice(1).join('/');

const LABELS: Record<Locale, string> = { ru: 'RU', en: 'EN', sr: 'SR' };
---

<div class="lang-switcher flex items-center gap-1 text-xs font-medium">
  {SUPPORTED_LOCALES.map(locale => (
    <a
      href={`/${locale}/${rest}`}
      aria-current={locale === currentLocale ? 'page' : undefined}
      class="px-1.5 py-1 rounded-sm text-muted"
    >{LABELS[locale]}</a>
  ))}
</div>

<style>
  .lang-switcher a[aria-current="page"] { color: var(--color-text) !important; font-weight: 600; }
  .lang-switcher a:hover { color: var(--color-text) !important; }
</style>
