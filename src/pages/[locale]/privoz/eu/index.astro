---
import PrivozSpokeLayout from '@/layouts/PrivozSpokeLayout.astro';
import ChipLinks from '@/components/ChipLinks.astro';
import { getServicesContent } from '@/i18n/content/services';
import { withLocales } from '@/utils/paths';
import { getActiveCountries, getCountry } from '@/utils/geo';
import { PRIVOZ_EU_SOURCE_CODES } from '@/utils/constants';
import type { Locale } from '@/i18n/config';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params as { locale: Locale };
const sc = getServicesContent(locale);
const pc = sc.privoz.eu;

// Explicit whitelist (PRIVOZ_EU_SOURCE_CODES), not "every active country
// except rs/de" — de/index.astro is Germany's own dedicated spoke now
// (distinct search intent, confirmed by SEO research), and deriving this
// list by exclusion would silently pull in any future destination-only
// country (e.g. Portugal) as a claimed EU sourcing market.
const sourceCountries = getActiveCountries().filter(c => (PRIVOZ_EU_SOURCE_CODES as readonly string[]).includes(c.code));
const areaServed = sourceCountries.map(c => c[locale].name);
---

<PrivozSpokeLayout
  {locale}
  slug="eu"
  metaTitle={pc.metaTitle}
  metaDescription={pc.metaDescription}
  title={pc.title}
  titleHighlight={pc.titleHighlight}
  description={pc.description}
  ctaLabel={pc.ctaLabel}
  breadcrumbLabel={pc.breadcrumbLabel}
  hubBreadcrumbLabel={sc.privoz.hub.breadcrumbLabel}
  casesHeading={pc.casesHeading}
  steps={pc.steps}
  destinationsNote={pc.destinationsNote}
  {areaServed}
>
  <ChipLinks
    label={pc.sourceCountriesLabel}
    items={[
      { href: `/${locale}/privoz/de/`, text: getCountry('de')![locale].name },
      ...sourceCountries.map(c => ({ text: c[locale].name })),
      { text: pc.sourceMoreLabel },
    ]}
  />
</PrivozSpokeLayout>
