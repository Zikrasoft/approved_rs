---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TelegramCTA from '@/components/TelegramCTA.astro';
import PageHero from '@/components/PageHero.astro';
import Faq from '@/components/Faq.astro';
import { SITE_URL, SITE_NAME } from '@/utils/constants';
import { getFaq } from '@/i18n/content/faq';
import { getPagesContent } from '@/i18n/content/pages';
import { getI18n } from '@/i18n/getI18n';
import { withLocales } from '@/utils/paths';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params;
const p = getPagesContent(locale).contacts;
const t = getI18n(locale);
const meta = {
  title: `${p.metaTitle} | ${SITE_NAME}`,
  description: p.metaDescription,
  canonical: `${SITE_URL}/${locale}/contacts/`,
};

const info = p.info;
const steps = p.steps;
---

<BaseLayout {...meta}>

  <PageHero decoWord="CONTACT" title={p.heroTitle} subtitle={p.heroSubtitle} breadcrumbs={[{ label: t.nav.contacts }]} />

  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">

      <div class="fade-up fade-up-1">
        <TelegramCTA />
        <div class="mt-8">
          {info.map((item, i) => (
            <div class="flex justify-between items-center py-4 border-b border-default anim-inline" style={`--anim-delay: ${0.15 + i * 0.08}s`}>
              <span class="text-sm text-muted">{item.label}</span>
              <span class="text-sm font-medium text-secondary">{item.value}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="fade-up fade-up-2 rounded-sm p-8 border border-t-2 bg-surface border-border-strong border-t-accent">
        <span class="eyebrow">{p.workEyebrow}</span>
        <div class="space-y-6">
          {steps.map((step, i) => (
            <div class="flex gap-4 anim-inline" style={`--anim-delay: ${0.2 + i * 0.1}s`}>
              <div class="step-circle shrink-0 !mb-0">{step.n}</div>
              <p class="text-sm leading-relaxed pt-2.5 text-muted">{step.text}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <Faq items={getFaq(locale).general} />

</BaseLayout>
