---
import ServicePageLayout from '../../../../layouts/ServicePageLayout.astro';
import ChipLinks from '../../../../components/ChipLinks.astro';
import Faq from '../../../../components/Faq.astro';
import { getCityPaths, withLocales } from '../../../../utils/paths';
import { getCountry, getCitiesForCountry } from '../../../../utils/geo';
import { generateMeta, generateServiceSchema, buildLocation } from '../../../../utils/seo';
import { getCollection } from 'astro:content';
import { SITE_URL } from '../../../../utils/constants';
import { getFaq } from '../../../../i18n/content/faq';
import { getServicesContent } from '../../../../i18n/content/services';
import { TrendingUp, History, UserCheck, BadgeCheck } from '@lucide/astro';
import type { Locale } from '../../../../i18n/config';

export const getStaticPaths = () => withLocales(getCityPaths());

const { locale, country: countryCode } = Astro.params;
const { city } = Astro.props;
const country = getCountry(countryCode!)!;
const sc = getServicesContent(locale as Locale).cityAutopodbor;
const cityLocation = buildLocation(locale as Locale, undefined, city);
const countryLocation = buildLocation(locale as Locale, country);
const meta = generateMeta('autopodbor', { country, city, baseUrl: SITE_URL, path: `/${locale}/${countryCode}/${city.slug}/autopodbor/`, locale: locale as Locale });
const cases = (await getCollection('cases')).filter(c => c.data.published && c.data.country === countryCode && c.data.service === 'autopodbor').slice(0, 3);
const schema = generateServiceSchema(`Автоподбор в ${city.ru.nameLocative}`, city.ru.name, meta.canonical);

// DEKRA/TÜV are German-specific certification bodies — only true for country: 'de'.
// Other countries get the generic claim instead of an invented local equivalent.
const WHY_CITY = [
  { Icon: TrendingUp, text: sc.reason1 },
  { Icon: History,    text: sc.reason2 },
  { Icon: UserCheck,  text: sc.reason3For(cityLocation) },
  { Icon: BadgeCheck, text: countryCode === 'de' ? sc.reason4Dekra : sc.reason4Generic },
];
---

<ServicePageLayout
  {meta} {schema} {cases}
  title={sc.title}
  titleHighlight={cityLocation}
  description={sc.descriptionFor(cityLocation, (country[locale as Locale] as { nameGenitive?: string; name: string }).nameGenitive ?? country[locale as Locale].name)}
  ctaLabel={getServicesContent(locale as Locale).autopodbor.ctaLabel}
  formService="autopodbor"
  currentCountry={countryCode!}
  currentService="autopodbor"
  city={city.slug}
  casesHeading={sc.casesHeadingFor((country[locale as Locale] as { nameGenitive?: string; name: string }).nameGenitive ?? country[locale as Locale].name)}
  breadcrumbs={[
    { label: country[locale as Locale].name, href: `/${locale}/${countryCode}/autopodbor/` },
    { label: city[locale as Locale].name },
  ]}
>
  <div>
    <h2 class="font-display text-xl font-bold mb-4 text-primary">{sc.whyCityHeadingFor(city[locale as Locale].name)}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {WHY_CITY.map(item => (
        <div class="flex items-center gap-3 p-4 rounded-sm border bg-surface border-default">
          <span class="flex items-center justify-center w-9 h-9 rounded-sm shrink-0 bg-accent-subtle text-accent">
            <item.Icon size={18} />
          </span>
          <p class="text-sm leading-relaxed text-muted">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
  <ChipLinks
    label={sc.otherCitiesLabelFor(countryLocation)}
    items={getCitiesForCountry(countryCode!)
      .filter(c => c.slug !== city.slug)
      .map(c => ({ href: `/${locale}/${countryCode}/${c.slug}/autopodbor/`, text: c[locale as Locale].name }))}
  />

  <Fragment slot="extra">
    <Faq items={[...getFaq(locale).autopodbor, getFaq(locale).cityExpert]} />
  </Fragment>
</ServicePageLayout>
