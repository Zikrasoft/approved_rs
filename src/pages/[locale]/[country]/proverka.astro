---
export const prerender = true;
import ServicePageLayout from '../../../layouts/ServicePageLayout.astro';
import StepsList from '../../../components/StepsList.astro';
import Faq from '../../../components/Faq.astro';
import { getCountryPaths, withLocales } from '../../../utils/paths';
import { getCountry } from '../../../utils/geo';
import { generateMeta, generateServiceSchema } from '../../../utils/seo';
import { SITE_URL } from '../../../utils/constants';
import { FAQ_PROVERKA } from '../../../utils/faq';

export const getStaticPaths = () => withLocales(getCountryPaths());

const { locale, country: countryCode } = Astro.params;
const country = getCountry(countryCode!)!;
const meta = generateMeta('proverka', { country, baseUrl: SITE_URL, path: `/${locale}/${countryCode}/proverka/` });
const schema = generateServiceSchema(`Проверка авто в ${country.nameLocative}`, country.name, meta.canonical);
---

<ServicePageLayout
  {meta} {schema}
  title="Проверка авто"
  titleHighlight={`в ${country.nameLocative}`}
  description="Независимая проверка автомобиля перед покупкой. Выезд эксперта, диагностика, отчёт — без обязательства покупки."
  ctaLabel="Заказать проверку"
  formService="inspection"
  currentCountry={countryCode!}
  currentService="proverka"
  breadcrumbs={[
    { label: country.name, href: `/${locale}/${countryCode}/autopodbor/` },
    { label: 'Проверка авто' },
  ]}
>
  <StepsList steps={[
    { n: '01', text: 'Кузов и лакокрасочное покрытие — наличие ремонта или ДТП' },
    { n: '02', text: 'Ходовая, подвеска, тормоза' },
    { n: '03', text: 'Двигатель, коробка, трансмиссия' },
    { n: '04', text: 'Электроника и история обслуживания по VIN' },
    { n: '05', text: 'Юридическая чистота — залог, запрет регистрации, ДТП' },
  ]} />
  <p class="mt-6 text-sm leading-relaxed text-muted">
    Работаем и в других странах Европы, включая Португалию, — уточните при заявке.
  </p>

  <Fragment slot="extra">
    <Faq items={FAQ_PROVERKA} />
  </Fragment>
</ServicePageLayout>
