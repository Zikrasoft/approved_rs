---
export const prerender = true;
import ServicePageLayout from "../../../layouts/ServicePageLayout.astro";
import StepsList from "../../../components/StepsList.astro";
import Faq from "../../../components/Faq.astro";
import { getCountryPaths, withLocales } from "../../../utils/paths";
import { getCountry } from "../../../utils/geo";
import { generateMeta, generateServiceSchema } from "../../../utils/seo";
import { getCollection } from "astro:content";
import { SITE_URL } from "../../../utils/constants";
import { getFaq } from "../../../i18n/content/faq";
import type { Locale } from "../../../i18n/config";

export const getStaticPaths = () => withLocales(getCountryPaths());

const { locale, country: countryCode } = Astro.params;
const country = getCountry(countryCode!)!;
const meta = generateMeta("vykup", {
    country,
    baseUrl: SITE_URL,
    path: `/${locale}/${countryCode}/vykup/`,
    locale: locale as Locale,
});
const cases = (await getCollection("cases"))
    .filter(
        (c) =>
            c.data.published &&
            c.data.country === countryCode &&
            c.data.service === "buyout",
    )
    .slice(0, 3);
const schema = generateServiceSchema(
    `Выкуп авто в ${country.ru.nameLocative}`,
    country.ru.name,
    meta.canonical,
);
const isSerbia = countryCode === "rs";
const description = isSerbia
    ? `Выкупаем автомобили на русских номерах ниже рыночной цены — машина может находиться в любой стране Европы. Также выкупаем авто на сербских номерах в Сербии и Черногории. Оценка онлайн, оформление за 1 день, перевод в день сделки.`
    : `Выкупаем автомобили на русских номерах ниже рыночной цены — машина может находиться в любой стране Европы, включая ${country.ru.nameAccusative}. Оценка онлайн, оформление за 1 день, перевод в день сделки.`;
---

<ServicePageLayout
    {meta}
    {schema}
    {cases}
    title="Выкуп авто"
    titleHighlight={`в ${country.ru.nameLocative}`}
    {description}
    ctaLabel="Получить оценку"
    formService="buyout"
    currentCountry={countryCode!}
    currentService="vykup"
    casesHeading="Кейсы выкупа"
    breadcrumbs={[
        { label: country.ru.name, href: `/${locale}/${countryCode}/autopodbor/` },
        { label: "Выкуп авто" },
    ]}
>
    <StepsList
        steps={[
            { n: "01", text: "Отправляете фото и описание автомобиля" },
            {
                n: "02",
                text: "Оцениваем онлайн по фото за 1 час — ниже рыночной цены",
            },
            {
                n: "03",
                text: isSerbia
                    ? "Встречаемся на осмотр — русские номера (в любой стране Европы) или сербские номера (Сербия, Черногория)"
                    : "Встречаемся на осмотр — русские номера, машина может быть в любой стране Европы",
            },
            { n: "04", text: "Оформляем сделку, деньги в день подписания" },
        ]}
    />

    <Fragment slot="extra">
        <Faq items={getFaq(locale).vykup} />
    </Fragment>
</ServicePageLayout>
