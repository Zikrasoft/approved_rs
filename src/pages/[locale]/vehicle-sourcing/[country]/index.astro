---
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import StepsList from '@/components/StepsList.astro';
import ChipLinks from '@/components/ChipLinks.astro';
import CountryPill from '@/components/CountryPill.astro';
import Faq from '@/components/Faq.astro';
import { getFaq } from '@/i18n/content/faq';
import { getServicesContent } from '@/i18n/content/services';
import { getCountryPaths, withLocales, PathBuilder } from '@/utils/paths';
import { getCountry, getActiveCountries, getCitiesForCountry } from '@/utils/geo';
import { generateMeta, generateServiceSchema, buildLocation } from '@/utils/seo';
import { getVehicleImportCrossSellSpokes } from '@/utils/vehicleImportCrossSell';
import { getCollection } from 'astro:content';
import { SITE_URL } from '@/utils/constants';

export const getStaticPaths = () => withLocales(getCountryPaths());

const { locale, country: countryCode } = Astro.params;
const country = getCountry(countryCode!)!;
const sc = getServicesContent(locale)['vehicle-sourcing'];
const location = buildLocation(locale, country);
const meta = generateMeta('vehicle-sourcing', { country, baseUrl: SITE_URL, path: PathBuilder.service(locale, 'vehicle-sourcing', countryCode!), locale: locale });
const cases = (await getCollection('cases')).filter(c => c.data.published && c.data.country === countryCode && c.data.service === 'vehicle-sourcing').slice(0, 3);
const schema = generateServiceSchema(`${sc.title} ${location}`, country[locale].name, meta.canonical);

// Link text reuses each spoke's own title instead of new strings.
const vehicleImportContent = getServicesContent(locale)['vehicle-import'];
const vehicleImportCrossSellLinks = getVehicleImportCrossSellSpokes(countryCode!).map(slug => ({
  href: PathBuilder.vehicleImportSpoke(locale, slug),
  text: vehicleImportContent[slug].title,
}));
---

<ServicePageLayout
  {meta} {schema} {cases}
  title={sc.title}
  titleHighlight={location}
  description={sc.descriptionFor(location)}
  ctaLabel={sc.ctaLabel}
  formService="vehicle-sourcing"
  currentCountry={countryCode!}
  currentService="vehicle-sourcing"
  casesHeading={sc.casesHeadingFor(location)}
  breadcrumbs={[{ label: sc.breadcrumbLabelFor(location) }]}
>
  <StepsList steps={sc.stepsFor(location)} />
  <p class="mt-6 text-sm leading-relaxed text-muted">
    {sc.deliveryLineFor(sc.deliveryDestinations.join(', '))}
  </p>
  <ChipLinks label={sc.citiesLabel} items={getCitiesForCountry(countryCode!).map(city => ({ href: PathBuilder.vehicleSourcingCity(locale, countryCode!, city.slug), text: city[locale].name }))} />
  <ChipLinks label={sc.crossSellLabel} items={vehicleImportCrossSellLinks} />
  <div class="mt-12 pt-8 border-t border-default">
    <p class="text-xs tracking-widest uppercase mb-4 font-medium text-muted">{sc.alsoInLabel}</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {getActiveCountries().filter(c => c.code !== countryCode).map(c => <CountryPill country={c} locale={locale} />)}
    </div>
  </div>

  <Fragment slot="extra">
    <Faq items={getFaq(locale)['vehicle-sourcing']} />
  </Fragment>
</ServicePageLayout>
