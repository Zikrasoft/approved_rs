---
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import { Sticker } from '@lucide/astro';
import ChipLinks from '@/components/ChipLinks.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import WhatWeDoList from '@/components/WhatWeDoList.astro';
import CasesGrid from '@/components/CasesGrid.astro';
import { generateServiceSchema, ogImageFor } from '@/utils/seo';
import { SITE_URL, SITE_NAME } from '@/utils/constants';
import { getCountry } from '@/utils/geo';
import { toDetailingCaseItem } from '@/utils/cases';
import { getPublishedDetailingCases } from '@/utils/casesQueries';
import { getServicesContent } from '@/i18n/content/services';
import { withLocales, PathBuilder, sourcingChipItems } from '@/utils/paths';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params;
const db = getServicesContent(locale).detailingBelgrade;
const meta = {
  title: `${db.metaTitle} | ${SITE_NAME}`,
  description: db.metaDescription,
  canonical: `${SITE_URL}${PathBuilder.detailingBelgrade(locale)}`,
  // ponytail: no dedicated OG asset yet (gen-og.mjs has no detailing-belgrade
  // variant) — reuses auto-service-belgrade's image as a placeholder, same
  // Belgrade-service visual category. Swap once a real asset exists.
  ogImage: ogImageFor(SITE_URL, 'auto-service-belgrade', locale),
};
const schema = generateServiceSchema(`${db.title} ${db.titleHighlight}`, getCountry('rs')![locale].name, meta.canonical);

// Keyed by DETAILING_SERVICES (src/utils/labels.ts) — add an icon here
// alongside each new services.ts whatWeDo entry as more services launch.
const ICONS = { wrap: Sticker } as const;
const WHAT_WE_DO = db.whatWeDo.map(item => ({ ...item, Icon: ICONS[item.key] }));

const items = (await getPublishedDetailingCases()).map((c) => toDetailingCaseItem(c, locale));
---

<ServicePageLayout
  {meta} {schema}
  title={db.title}
  titleHighlight={db.titleHighlight}
  description={db.description}
  ctaLabel={db.ctaLabel}
  formService="detailing-belgrade"
  currentCountry="rs"
  currentService="detailing-belgrade"
  city="belgrade"
  showCountryCrossLinks={false}
  breadcrumbs={[{ label: db.breadcrumbLabel }]}
>
  <SectionHeading title={db.whatWeDoHeading} size="lg" class="mb-8 mt-6" />
  <WhatWeDoList items={WHAT_WE_DO} />
  <ChipLinks label={db.alsoSourcingLabel} items={sourcingChipItems(locale)} />

  <Fragment slot="cases">
    <CasesGrid {items} heading={db.worksHeading} topBorder />
  </Fragment>
</ServicePageLayout>
