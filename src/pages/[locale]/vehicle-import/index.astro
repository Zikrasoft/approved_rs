---
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import Faq from '@/components/Faq.astro';
import { getFaq } from '@/i18n/content/faq';
import { getServicesContent } from '@/i18n/content/services';
import { withLocales, PathBuilder } from '@/utils/paths';
import { getCountry } from '@/utils/geo';
import { generateServiceSchema, placeholderOgImage } from '@/utils/seo';
import { getCollection } from 'astro:content';
import { SITE_URL, SITE_NAME, CHINA_NAME, PRIVOZ_EU_SOURCE_CODES } from '@/utils/constants';
import type { VehicleImportSpoke } from '@/utils/vehicleImportCrossSell';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params;
const pc = getServicesContent(locale)['vehicle-import'].hub;
const meta = {
  title: `${pc.metaTitle} | ${SITE_NAME}`,
  description: pc.metaDescription,
  canonical: `${SITE_URL}${PathBuilder.vehicleImportHub(locale)}`,
  ogImage: placeholderOgImage(SITE_URL, locale),
};
// Explicit — every real spoke this hub fans out to (Germany + the EU
// whitelist + China), not "every active country" — countries.json can grow
// with destination-only markets (e.g. Portugal) that aren't sourcing spokes.
const sourceNames = [
  getCountry('de')![locale].name,
  ...PRIVOZ_EU_SOURCE_CODES.map(code => getCountry(code)![locale].name),
  CHINA_NAME[locale],
];
const schema = generateServiceSchema(`${pc.title} ${pc.titleHighlight}`, sourceNames, meta.canonical);

const cases = (await getCollection('cases'))
  .filter(c => c.data.published && c.data.service === 'vehicle-import')
  .slice(0, 6);

// Germany isn't its own hub card anymore — it lives one level down, inside
// the Europe spoke's source-country chips (see eu/index.astro) — since the
// /eu/de/ URL move already nests it under "Europe" there.
const cards: { slug: VehicleImportSpoke; title: string; text: string }[] = [
  { slug: 'eu', title: pc.euCardTitle, text: pc.euCardText },
  { slug: 'china', title: pc.chinaCardTitle, text: pc.chinaCardText },
];
---

<ServicePageLayout
  {meta} {schema} {cases}
  title={pc.title}
  titleHighlight={pc.titleHighlight}
  description={pc.description}
  formService="vehicle-import"
  currentCountry="rs"
  currentService="vehicle-import"
  showCountryCrossLinks={false}
  casesHeading={pc.casesHeading}
  breadcrumbs={[{ label: pc.breadcrumbLabel }]}
>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
    {cards.map(card => (
      <a href={PathBuilder.vehicleImportSpoke(locale, card.slug)} class="import-card glow-border flex flex-col p-6 rounded-sm border bg-surface border-default no-underline">
        <p class="font-display text-xl font-bold mb-2 text-primary">{card.title}</p>
        <p class="text-sm leading-relaxed mb-4 text-muted">{card.text}</p>
        <span class="mt-auto text-xs font-medium tracking-wide uppercase text-accent">{pc.exploreLabel} →</span>
      </a>
    ))}
  </div>

  <Fragment slot="extra">
    <Faq items={getFaq(locale)['vehicle-import']} />
  </Fragment>
</ServicePageLayout>

<style>
  .import-card { transition: background-color 0.2s, border-color 0.2s; }
  .import-card:hover { background-color: var(--color-surface-2); border-color: var(--color-accent) !important; }
</style>
