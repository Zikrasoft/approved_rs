---
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import StepsList from '@/components/StepsList.astro';
import Faq from '@/components/Faq.astro';
import { getCountryPaths, withLocales } from '@/utils/paths';
import { getCountry } from '@/utils/geo';
import { generateMeta, generateServiceSchema, buildLocation } from '@/utils/seo';
import { SITE_URL } from '@/utils/constants';
import { getFaq } from '@/i18n/content/faq';
import { getServicesContent } from '@/i18n/content/services';
import type { Locale } from '@/i18n/config';

export const getStaticPaths = () => withLocales(getCountryPaths());

const { locale, country: countryCode } = Astro.params;
const country = getCountry(countryCode!)!;
const sc = getServicesContent(locale as Locale).proverka;
const location = buildLocation(locale as Locale, country);
const meta = generateMeta('proverka', { country, baseUrl: SITE_URL, path: `/${locale}/proverka/${countryCode}/`, locale: locale as Locale });
const schema = generateServiceSchema(`${sc.title} ${location}`, country[locale as Locale].name, meta.canonical);
---

<ServicePageLayout
  {meta} {schema}
  title={sc.title}
  titleHighlight={location}
  description={sc.description}
  ctaLabel={sc.ctaLabel}
  formService="inspection"
  currentCountry={countryCode!}
  currentService="proverka"
  breadcrumbs={[
    { label: country[locale as Locale].name, href: `/${locale}/autopodbor/${countryCode}/` },
    { label: sc.breadcrumbLabel },
  ]}
>
  <StepsList steps={sc.steps} />
  <p class="mt-6 text-sm leading-relaxed text-muted">
    {sc.extraLine}
  </p>

  <Fragment slot="extra">
    <Faq items={getFaq(locale).proverka} />
  </Fragment>
</ServicePageLayout>
