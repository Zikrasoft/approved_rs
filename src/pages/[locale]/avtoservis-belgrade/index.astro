---
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import { SearchCheck, Droplet, Wrench, Cog, ClipboardCheck, MapPin } from '@lucide/astro';
import CasesGrid from '@/components/CasesGrid.astro';
import ChipLinks from '@/components/ChipLinks.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import { generateServiceSchema, OG_SUFFIX } from '@/utils/seo';
import { SITE_URL, SITE_NAME } from '@/utils/constants';
import { toAutoserviceCaseItem } from '@/utils/cases';
import { getPublishedAutoserviceCases } from '@/utils/casesQueries';
import { getActiveCountries, getCountry } from '@/utils/geo';
import Faq from '@/components/Faq.astro';
import { getFaq } from '@/i18n/content/faq';
import { getServicesContent } from '@/i18n/content/services';
import { withLocales } from '@/utils/paths';
import type { Locale } from '@/i18n/config';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params;
const bc = getServicesContent(locale as Locale).avtoservisBelgrade;
const meta = {
  title: `${bc.metaTitle} | ${SITE_NAME}`,
  description: bc.metaDescription,
  canonical: `${SITE_URL}/${locale}/avtoservis-belgrade/`,
  ogImage: `${SITE_URL}/og/autoservice${OG_SUFFIX[locale as Locale]}.png`,
};
const schema = generateServiceSchema(`${bc.title} ${bc.titleHighlight}`, getCountry('rs')![locale as Locale].name, meta.canonical);

const items = (await getPublishedAutoserviceCases()).map((c) => toAutoserviceCaseItem(c, locale));

const ICONS = { diagnostics: SearchCheck, maintenance: Droplet, suspension: Wrench, engine: Cog, prepurchase: ClipboardCheck } as const;
const WHAT_WE_DO = bc.whatWeDo.map(item => ({ ...item, Icon: ICONS[item.key] }));
---

<ServicePageLayout
  {meta} {schema}
  title={bc.title}
  titleHighlight={bc.titleHighlight}
  description={bc.description}
  ctaLabel={bc.ctaLabel}
  formService="autoservice"
  currentCountry="rs"
  currentService="autoservice"
  city="belgrade"
  showCountryCrossLinks={false}
  breadcrumbs={[{ label: bc.breadcrumbLabel }]}
>
  <SectionHeading title={bc.whatWeDoHeading} size="lg" class="mb-8 mt-6" />
  <div class="space-y-4">
    {WHAT_WE_DO.map(item => (
      <div class="flex gap-4 p-4 rounded-sm border bg-surface border-default">
        <item.Icon size={20} class="shrink-0 text-accent" />
        <div>
          <p class="text-sm font-medium mb-0.5 text-primary">{item.label}</p>
          <p class="text-xs leading-relaxed text-muted">{item.desc}</p>
        </div>
      </div>
    ))}
  </div>
  <ChipLinks label={bc.alsoSourcingLabel} items={getActiveCountries().filter(c => c.code !== 'rs').map(c => ({ href: `/${locale}/autopodbor/${c.code}/`, text: c[locale as Locale].name }))} />

  <Fragment slot="extra">
    <section class="border-t border-default">
      <div class="max-w-6xl mx-auto px-6 py-16">
        <SectionHeading title={bc.howToFindHeading} size="lg" class="mb-10" />
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-5">
          <div class="lg:col-span-2 glow-border flex flex-col h-72 lg:h-[26rem] p-7 rounded-sm border bg-surface border-default">
            <span class="flex items-center justify-center w-11 h-11 rounded-sm mb-5 shrink-0 bg-accent-subtle text-accent">
              <MapPin size={20} />
            </span>
            <p class="text-xs tracking-[0.16em] uppercase font-medium mb-2 text-muted">{bc.addressLabel}</p>
            <p class="font-display text-xl font-bold leading-snug text-primary">{bc.streetAddress}</p>
            <p class="text-sm text-muted">{bc.cityCountryLine}</p>
            <Button
              href="https://share.google/PmmBqmEvqnLCQK4i6"
              target="_blank"
              rel="noopener"
              variant="secondary"
              class="mt-auto w-fit px-4 py-2.5 text-xs"
            >
              {bc.mapButtonLabel}
            </Button>
          </div>
          <div class="lg:col-span-3 map-embed glow-border h-72 lg:h-[26rem] rounded-sm overflow-hidden border border-default">
            <iframe
              src={`https://www.google.com/maps?q=${encodeURIComponent('Пека Павловића 39, Београд')}&output=embed`}
              width="100%"
              height="100%"
              class="border-0 block"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={bc.mapIframeTitle}
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  </Fragment>

  <Fragment slot="extra">
    <Faq items={getFaq(locale).autoservice} />
  </Fragment>

  <Fragment slot="cases">
    <CasesGrid {items} heading={bc.worksHeading} topBorder />
  </Fragment>
</ServicePageLayout>

<style>
  /* Google's classic embed iframe has no style API — desaturate it so the
     stock red/green basemap doesn't clash with the site's muted navy palette,
     and roughly invert it in dark mode. ponytail: CSS filter hack, not pixel
     perfect (the pin drifts slightly off pure red), good enough without a
     Maps API key + JS SDK. */
  .map-embed iframe { filter: saturate(0.4) brightness(0.95) contrast(0.95); }
  :global(html[data-theme="dark"]) .map-embed iframe {
    filter: invert(92%) hue-rotate(180deg) saturate(0.4) brightness(0.95) contrast(0.9);
  }
</style>
