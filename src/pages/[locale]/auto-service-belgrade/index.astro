---
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import {
  SearchCheck,
  Droplet,
  Wrench,
  Cog,
  ClipboardCheck,
} from '@lucide/astro';
import CasesGrid from '@/components/CasesGrid.astro';
import ChipLinks from '@/components/ChipLinks.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import WhatWeDoList from '@/components/WhatWeDoList.astro';
import HowToFindUs from '@/components/HowToFindUs.astro';
import { generateServiceSchema, ogImageFor } from '@/utils/seo';
import { SITE_URL, SITE_NAME } from '@/utils/constants';
import { toAutoserviceCaseItem } from '@/utils/cases';
import { getPublishedAutoserviceCases } from '@/utils/casesQueries';
import { getCountry } from '@/utils/geo';
import Faq from '@/components/Faq.astro';
import { getFaq } from '@/i18n/content/faq';
import { getServicesContent } from '@/i18n/content/services';
import { withLocales, PathBuilder, sourcingChipItems } from '@/utils/paths';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params;
const bc = getServicesContent(locale).autoServiceBelgrade;
const meta = {
  title: `${bc.metaTitle} | ${SITE_NAME}`,
  description: bc.metaDescription,
  canonical: `${SITE_URL}${PathBuilder.autoServiceBelgrade(locale)}`,
  ogImage: ogImageFor(SITE_URL, 'auto-service-belgrade', locale),
};
const schema = generateServiceSchema(
  `${bc.title} ${bc.titleHighlight}`,
  getCountry('rs')![locale].name,
  meta.canonical,
);

const items = (await getPublishedAutoserviceCases()).map((c) =>
  toAutoserviceCaseItem(c, locale),
);

const ICONS = {
  diagnostics: SearchCheck,
  maintenance: Droplet,
  suspension: Wrench,
  engine: Cog,
  prepurchase: ClipboardCheck,
} as const;
const WHAT_WE_DO = bc.whatWeDo.map((item) => ({
  ...item,
  Icon: ICONS[item.key],
}));

// Native-script address for Google Maps to geocode — see HowToFindUs.astro.
const MAP_QUERY = 'Пека Павловића 39, Београд';
---

<ServicePageLayout
  {meta}
  {schema}
  title={bc.title}
  titleHighlight={bc.titleHighlight}
  description={bc.description}
  ctaLabel={bc.ctaLabel}
  formService="auto-service-belgrade"
  currentCountry="rs"
  currentService="auto-service-belgrade"
  city="belgrade"
  commentLabel={bc.commentLabel}
  commentPlaceholder={bc.commentPlaceholder}
  showCountryCrossLinks={false}
  breadcrumbs={[{ label: bc.breadcrumbLabel }]}
>
  <SectionHeading title={bc.whatWeDoHeading} size="lg" class="mb-8 mt-6" />
  <WhatWeDoList items={WHAT_WE_DO} />
  <ChipLinks label={bc.alsoSourcingLabel} items={sourcingChipItems(locale)} />

  <Fragment slot="extra">
    <HowToFindUs
      heading={bc.howToFindHeading}
      addressLabel={bc.addressLabel}
      streetAddress={bc.streetAddress}
      cityCountryLine={bc.cityCountryLine}
      mapButtonLabel={bc.mapButtonLabel}
      mapIframeTitle={bc.mapIframeTitle}
      mapQuery={MAP_QUERY}
    />
  </Fragment>

  <Fragment slot="extra">
    <Faq items={getFaq(locale).autoServiceBelgrade} />
  </Fragment>

  <Fragment slot="cases">
    <CasesGrid {items} heading={bc.worksHeading} topBorder />
  </Fragment>
</ServicePageLayout>
