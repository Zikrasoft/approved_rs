---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GeoBanner from "../../components/GeoBanner.astro";
import TelegramCTA from "../../components/TelegramCTA.astro";
import CasesGrid from "../../components/CasesGrid.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import CountryPill from "../../components/CountryPill.astro";
import LeadForm from "../../components/LeadForm.astro";
import {
    Search,
    Wrench,
    Banknote,
    ClipboardCheck,
    Eye,
    Shield,
    MapPin,
} from "@lucide/astro";
import { getCollection } from "astro:content";
import { getActiveCountries } from "../../utils/geo";
import { SITE_URL, SITE_NAME } from "../../utils/constants";
import { generateOrganizationSchema } from "../../utils/seo";
import { telegramLink } from "../../utils/telegramLink";
import StatBlock from "../../components/StatBlock.astro";
import { toCaseItem } from "../../utils/cases";

const { locale } = Astro.params;
const meta = {
    title: `Автоподбор и доставка авто из Европы | ${SITE_NAME}`,
    description:
        "Подберём и привезём автомобиль из Германии, Испании, Сербии и Швейцарии. Проверка, выкуп, доставка. Работаем для русскоязычных по всему миру.",
    canonical: `${SITE_URL}/${locale}/`,
};

const allCases = await getCollection("cases");
const latestCases = allCases.filter((c) => c.data.published).slice(0, 3);
const items = latestCases.map((c) => toCaseItem(c, locale ?? 'ru'));
const countries = getActiveCountries();

const tgManager = import.meta.env.PUBLIC_TG_MANAGER!;
const threadsChannel = import.meta.env.PUBLIC_THREADS_CHANNEL!;

const schema = generateOrganizationSchema({
    url: SITE_URL,
    description: meta.description,
    areaServed: countries.map((c) => c.ru.name),
    sameAs: [`https://t.me/${tgManager}`, `https://www.threads.com/@${threadsChannel}`],
    contactUrl: telegramLink(tgManager),
});

// One connected story instead of a flat service list — each stop is a real
// page, but the copy makes clear this is one journey (and where you can
// jump in if you're not starting from zero).
const journey = [
    {
        href: `/${locale}/de/autopodbor/`,
        Icon: Search,
        title: "Подбор",
        desc: "Находим, проверяем и доставляем автомобиль под ваш бюджет — под ключ, в Германии, Испании, Сербии и Швейцарии.",
    },
    {
        href: `/${locale}/de/proverka/`,
        Icon: ClipboardCheck,
        title: "Проверка",
        desc: "Независимый эксперт осматривает автомобиль перед покупкой — по 100+ пунктам с видео.",
        note: "Нашли машину сами? Закажем проверку отдельно",
    },
    {
        href: `/${locale}/de/vykup/`,
        Icon: Banknote,
        title: "Выкуп",
        desc: "Оформляем выкуп и растаможку автомобиля на иностранных номерах.",
        note: "Машина уже за границей? Поможем её оформить",
    },
    {
        href: `/${locale}/avtoservis-belgrade/`,
        Icon: Wrench,
        title: "Автосервис",
        desc: "Ремонт и обслуживание автомобиля в Белграде — с гарантией качества.",
        note: "Машина уже ваша? Тоже беремся",
    },
];
---

<BaseLayout {...meta} schema={schema}>
    {
        Astro.locals.suggestedCountry && (
            <GeoBanner detected={Astro.locals.suggestedCountry} />
        )
    }

    <!-- ─── Hero ──────────────────────────────────────────── -->
    <section class="hero-grid relative border-b overflow-hidden border-default">
        <div
            class="absolute inset-0 pointer-events-none"
            style="background: radial-gradient(ellipse 55% 60% at 10% 55%, var(--color-ambient-glow) 0%, transparent 65%), radial-gradient(ellipse 45% 40% at 90% 15%, var(--color-accent-subtle) 0%, transparent 60%);"
        >
        </div>

        <div class="relative max-w-6xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
                <div class="lg:col-span-3">
                    <span class="eyebrow fade-up fade-up-1"
                        >Один путь: авто из Европы</span
                    >
                    <h1
                        class="hero-headline font-display font-bold leading-none mb-8 fade-up fade-up-2 text-primary tracking-[-0.03em]"
                    >
                        Найдено.<br />
                        Проверено.<br />
                        <span class="stamp-row inline-flex items-center gap-3 flex-wrap">
                            <em class="text-accent italic">Одобрено.</em>
                            <svg
                                class="stamp-svg shrink-0"
                                viewBox="0 0 200 200"
                                aria-hidden="true"
                            >
                                <defs>
                                    <path
                                        id="stampArc"
                                        d="M 100,100 m -80,0 a 80,80 0 1,1 160,0 a 80,80 0 1,1 -160,0"
                                    ></path>
                                </defs>
                                <circle cx="100" cy="100" r="94" fill="none" stroke="var(--color-stamp-ink)" stroke-width="2.5"></circle>
                                <circle cx="100" cy="100" r="82" fill="none" stroke="var(--color-stamp-ink)" stroke-width="1.5" stroke-dasharray="2 4"></circle>
                                <text font-family="var(--font-sans)" font-size="10" letter-spacing="2" fill="var(--color-stamp-ink)">
                                    <textPath href="#stampArc" startOffset="2%">ПРОВЕРЕНО · ОДОБРЕНО · ПРОВЕРЕНО · ОДОБРЕНО ·</textPath>
                                </text>
                                <path
                                    d="M70,102 l20,20 l40,-45"
                                    fill="none"
                                    stroke="var(--color-stamp-ink)"
                                    stroke-width="9"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                ></path>
                            </svg>
                        </span>
                    </h1>
                    <p
                        class="text-base leading-relaxed mb-10 max-w-md fade-up fade-up-3 text-muted"
                    >
                        Подберём, проверим, оформим и привезём автомобиль из
                        Германии, Испании или Сербии — а потом обслужим его в
                        своём автосервисе. Один путь, одна команда.
                    </p>
                    <div class="fade-up fade-up-4">
                        <TelegramCTA />
                    </div>
                    <div
                        class="grid grid-cols-3 gap-3 sm:gap-6 mt-8 pt-8 border-t fade-up fade-up-5 border-default"
                    >
                        <StatBlock value="200+" label="клиентов" />
                        <StatBlock value="4" label="страны" />
                        <StatBlock value="5 лет" label="на рынке" />
                    </div>
                </div>

                <div class="hidden lg:block lg:col-span-2 fade-up fade-up-3">
                    <LeadForm />
                </div>
            </div>
        </div>
    </section>

    <!-- ─── Journey (services + process, as one story) ─────── -->
    <section class="border-b border-default">
        <div class="max-w-6xl mx-auto px-6 py-20">
            <div class="mb-4">
                <SectionHeading title="Один путь: от поиска до сервиса" />
            </div>
            <p class="text-base max-w-xl mb-14 leading-relaxed text-muted">
                Автоподбор, проверка, выкуп и автосервис — не 4 разных
                услуги, а этапы одного пути вашего автомобиля. Войти можно с
                любого шага.
            </p>

            <div
                class="journey-strip grid grid-cols-1 lg:grid-cols-4 divide-y lg:divide-y-0 lg:divide-x divide-default rounded-sm border border-default bg-surface overflow-hidden anim-inline"
                style="--anim-delay: 0.1s"
            >
                {
                    journey.map((step, i) => {
                        const Icon = step.Icon;
                        const idx = String(i + 1).padStart(2, "0");
                        return (
                            <a
                                href={step.href}
                                class="journey-stop group flex flex-col no-underline p-7 anim-inline"
                                style={`--anim-delay: ${0.3 + i * 0.1}s`}
                            >
                                <div class="flex items-center gap-3 mb-5">
                                    <span class="step-circle step-circle-sm">
                                        {idx}
                                    </span>
                                    <span class="flex items-center justify-center w-9 h-9 rounded-sm shrink-0 bg-accent-subtle text-accent">
                                        <Icon size={16} />
                                    </span>
                                </div>
                                <h3 class="font-display text-xl font-bold mb-2 text-primary">
                                    {step.title}
                                </h3>
                                <p class="text-sm leading-relaxed flex-1 text-muted">
                                    {step.desc}
                                </p>
                                {step.note && (
                                    <p class="text-xs italic mt-3 text-muted">
                                        {step.note}
                                    </p>
                                )}
                                <span class="inline-flex items-center gap-1 mt-5 text-xs font-medium text-accent">
                                    Подробнее
                                    <span class="journey-arrow transition-transform duration-200">
                                        →
                                    </span>
                                </span>
                            </a>
                        );
                    })
                }
            </div>

            <!-- Country strip -->
            <p class="text-xs tracking-widest uppercase mt-14 mb-3 font-medium text-muted">Автоподбор по странам:</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                {countries.map((c) => <CountryPill country={c} locale={locale!} />)}
            </div>

            <!-- Mobile-only lead form: desktop keeps it in the hero sidebar,
                 mobile moves it here so the path explains the business
                 before asking for contact details. -->
            <div class="lg:hidden mt-10">
                <LeadForm />
            </div>
        </div>
    </section>

    <!-- ─── Cases ─────────────────────────────────────────── -->
    <CasesGrid
        items={items}
        heading="Последние кейсы"
        headingSize="xl"
        viewAllHref={`/${locale}/cases/autopodbor/`}
    />

    <!-- ─── Why us ───────────────────────────────────────── -->
    <section class="border-b border-default">
        <div class="max-w-6xl mx-auto px-6 py-20">
            <div class="mb-14">
                <SectionHeading title="Почему выбирают нас" />
                <p class="text-base max-w-md text-muted mt-3 leading-relaxed">
                    Покупка авто из другой страны вызывает вопросы. Вот как мы
                    их снимаем.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div
                    class="trust-card glow-border bg-surface border border-default rounded-sm p-8 anim-inline"
                    style="--anim-delay: 0.08s"
                >
                    <div
                        class="flex items-center justify-center w-11 h-11 rounded-sm mb-6 bg-accent-subtle text-accent"
                    >
                        <Eye size={20} />
                    </div>
                    <h3
                        class="font-display text-xl font-bold mb-3 text-primary"
                    >
                        Полная прозрачность
                    </h3>
                    <p class="text-sm leading-relaxed text-muted">
                        Высылаем подробный чек-лист (100+ пунктов) и видео
                        каждого нюанса: кузов, салон, ходовая. Вы видите
                        автомобиль так, как будто стоите рядом.
                    </p>
                </div>

                <div
                    class="trust-card glow-border bg-surface border border-default rounded-sm p-8 anim-inline"
                    style="--anim-delay: 0.16s"
                >
                    <div
                        class="flex items-center justify-center w-11 h-11 rounded-sm mb-6 bg-accent-subtle text-accent"
                    >
                        <Shield size={20} />
                    </div>
                    <h3
                        class="font-display text-xl font-bold mb-3 text-primary"
                    >
                        Безопасность сделки
                    </h3>
                    <p class="text-sm leading-relaxed text-muted">
                        Поэтапная оплата и понятные условия. Сопровождаем
                        документы на всех этапах: оформление, растаможка,
                        регистрация — без сюрпризов.
                    </p>
                </div>

                <div
                    class="trust-card glow-border bg-surface border border-default rounded-sm p-8 anim-inline"
                    style="--anim-delay: 0.24s"
                >
                    <div
                        class="flex items-center justify-center w-11 h-11 rounded-sm mb-6 bg-accent-subtle text-accent"
                    >
                        <MapPin size={20} />
                    </div>
                    <h3
                        class="font-display text-xl font-bold mb-3 text-primary"
                    >
                        Локальная экспертиза
                    </h3>
                    <p class="text-sm leading-relaxed text-muted">
                        Знаем специфику каждого рынка: автобанные пробеги
                        Германии, особенности кузова испанских авто, нюансы
                        оформления на иностранные номера в Сербии.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ─── Social proof ──────────────────────────────────── -->
    <section class="border-b border-default">
        <div class="max-w-6xl mx-auto px-6 py-20">
            <div class="mb-14">
                <SectionHeading title="Что говорят клиенты" />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <figure
                    class="review-card glow-border bg-surface border border-default rounded-sm p-7 flex flex-col gap-5 anim-inline"
                    style="--anim-delay: 0.08s"
                >
                    <blockquote
                        class="text-sm leading-relaxed text-secondary flex-1"
                    >
                        «Привезли BMW 3 серии из Мюнхена в Белград. Всё чётко —
                        от осмотра до постановки на учёт. Сэкономили кучу нервов
                        на оформлении.»
                    </blockquote>
                    <figcaption class="flex items-center gap-3">
                        <div
                            class="w-9 h-9 rounded-full bg-accent-subtle flex items-center justify-center text-accent font-display font-bold text-sm"
                        >
                            А
                        </div>
                        <div>
                            <p class="text-sm font-medium text-primary">
                                Александр
                            </p>
                            <p class="text-xs text-muted">
                                BMW 320d, Германия → Сербия
                            </p>
                        </div>
                    </figcaption>
                </figure>

                <figure
                    class="review-card glow-border bg-surface border border-default rounded-sm p-7 flex flex-col gap-5 anim-inline"
                    style="--anim-delay: 0.16s"
                >
                    <blockquote
                        class="text-sm leading-relaxed text-secondary flex-1"
                    >
                        «Долго искал Skoda Octavia в хорошем состоянии. Ребята
                        нашли вариант в Испании, проверили независимым экспертом
                        — всё совпало с описанием.»
                    </blockquote>
                    <figcaption class="flex items-center gap-3">
                        <div
                            class="w-9 h-9 rounded-full bg-accent-subtle flex items-center justify-center text-accent font-display font-bold text-sm"
                        >
                            М
                        </div>
                        <div>
                            <p class="text-sm font-medium text-primary">
                                Михаил
                            </p>
                            <p class="text-xs text-muted">
                                Skoda Octavia, Испания → Россия
                            </p>
                        </div>
                    </figcaption>
                </figure>

                <figure
                    class="review-card glow-border bg-surface border border-default rounded-sm p-7 flex flex-col gap-5 anim-inline"
                    style="--anim-delay: 0.24s"
                >
                    <blockquote
                        class="text-sm leading-relaxed text-secondary flex-1"
                    >
                        «Оформление на иностранные номера казалось сложным.
                        Команда провела через каждый шаг — и через месяц я уже
                        ездил. Рекомендую.»
                    </blockquote>
                    <figcaption class="flex items-center gap-3">
                        <div
                            class="w-9 h-9 rounded-full bg-accent-subtle flex items-center justify-center text-accent font-display font-bold text-sm"
                        >
                            Д
                        </div>
                        <div>
                            <p class="text-sm font-medium text-primary">
                                Дмитрий
                            </p>
                            <p class="text-xs text-muted">
                                VW Passat, Германия → Сербия
                            </p>
                        </div>
                    </figcaption>
                </figure>
            </div>
        </div>
    </section>

    <!-- ─── CTA ───────────────────────────────────────────── -->
    <section class="max-w-6xl mx-auto px-6 py-20">
        <div
            class="cta-card relative rounded-sm overflow-hidden bg-surface border border-border-strong"
        >
            <div
                class="absolute inset-0 pointer-events-none"
                style="background: radial-gradient(ellipse 80% 120% at -5% 50%, var(--color-accent-soft) 0%, transparent 55%), radial-gradient(ellipse 50% 60% at 100% 100%, var(--color-ambient-glow) 0%, transparent 60%);"
            >
            </div>
            <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-0">
                <div class="p-10 md:p-16">
                    <span class="eyebrow">Готовы начать?</span>
                    <h2
                        class="font-display font-bold mb-4 leading-[1.1] tracking-[-0.025em]"
                        style="font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 800;"
                    >
                        Расскажите нам<br />о своём<br /><em
                            class="text-accent italic">автомобиле</em
                        >
                    </h2>
                    <p class="text-base mb-2 max-w-sm text-muted leading-[1.7]">
                        Отвечаем в течение 2 часов. Консультация бесплатна.
                    </p>
                    <TelegramCTA label="Написать в Telegram" />
                </div>
                <div
                    class="cta-aside hidden lg:flex items-end justify-end p-10 md:p-16"
                >
                    <div class="grid grid-cols-2 gap-6">
                        <StatBlock value="200+" label="клиентов" />
                        <StatBlock value="4" label="страны" />
                        <StatBlock value="5 лет" label="опыт" />
                        <StatBlock value="2 ч" label="ответ" />
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .hero-headline {
        font-size: clamp(3rem, 6.5vw, 5.2rem);
        font-weight: 800;
    }
    .stamp-svg {
        display: inline-block;
        pointer-events: none;
        opacity: 0.85;
        transform: rotate(-8deg) scale(1);
        animation: stampHit 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.9s both;
        width: clamp(48px, 6vw, 84px);
        aspect-ratio: 1 / 1;
    }
    @media (max-width: 380px) {
        .hero-headline {
            font-size: 2.5rem;
        }
        .stamp-row {
            gap: 0.5rem;
        }
        .stamp-svg {
            width: 36px;
        }
    }
    @keyframes stampHit {
        0% {
            opacity: 0;
            transform: rotate(-24deg) scale(1.5);
        }
        60% {
            opacity: 0.85;
        }
        100% {
            opacity: 0.85;
            transform: rotate(-8deg) scale(1);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .stamp-svg {
            animation: none;
            opacity: 0.85;
            transform: rotate(-8deg) scale(1);
        }
    }
    .journey-stop {
        transition: background-color 0.25s;
    }
    .journey-stop:hover {
        background-color: var(--color-surface-2);
    }
    .journey-stop:hover .journey-arrow {
        transform: translateX(4px);
    }
    .trust-card {
        transition: background-color 0.25s;
    }
    .trust-card:hover {
        background-color: var(--color-surface-2) !important;
    }
    .review-card {
        transition: background-color 0.25s;
    }
</style>
