---
import CasesTabPage from '@/components/CasesTabPage.astro';
import { SITE_URL, SITE_NAME } from '@/utils/constants';
import { toDetailingCaseItem } from '@/utils/cases';
import { getPublishedDetailingCases, getCasesTabCounts } from '@/utils/casesQueries';
import { getPagesContent } from '@/i18n/content/pages';
import { withLocales, PathBuilder } from '@/utils/paths';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params;
const p = getPagesContent(locale).casesDetailing;
const meta = {
  title: `${p.metaTitle} | ${SITE_NAME}`,
  description: p.metaDescription,
  canonical: `${SITE_URL}${PathBuilder.casesDetailing(locale)}`,
};

const items = (await getPublishedDetailingCases()).map((c) => toDetailingCaseItem(c, locale));
const counts = await getCasesTabCounts();
---

<CasesTabPage active="detailing" {items} {counts} {meta} />
