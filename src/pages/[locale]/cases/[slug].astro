---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import Price from '@/components/Price.astro';
import CaseGallery from '@/components/CaseGallery.astro';
import PromoBanner from '@/components/PromoBanner.astro';
import ChannelBanner from '@/components/ChannelBanner.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE_URL, SITE_NAME } from '@/utils/constants';
import { getPromoBanners } from '@/i18n/content/promoBanners';
import { excerptFromMarkdown, generateArticleSchema } from '@/utils/seo';
import { withLocales, PathBuilder } from '@/utils/paths';
import { getServicesContent } from '@/i18n/content/services';
import { getI18n } from '@/i18n/getI18n';
import { getCountry } from '@/utils/geo';
import { CHINA_NAME, CHINA_COUNTRY_CODE } from '@/utils/constants';
import { marked } from 'marked';

export async function getStaticPaths() {
  const cases = await getCollection('cases', c => c.data.published);
  return withLocales(cases.map(c => ({ params: { slug: c.id }, props: { case: c } })));
}

const { locale } = Astro.params;
const cc = getServicesContent(locale).caseChrome;
const t = getI18n(locale);
const { case: c } = Astro.props;

// Case bodies are written in ru; en/sr get an optional title+body
// translation right on the same case entry's `translations` field (filled
// in via Keystatic, plain markdown text — not a second markdoc body, since
// Keystatic only supports one real document body per file). No translation
// yet for this case → fall back to the ru original rather than leaving the
// page half-broken.
const translation = locale === 'en' ? c.data.translations?.en : locale === 'sr' ? c.data.translations?.sr : undefined;

const title = translation?.title ?? c.data.title;
const { Content } = await render(c);
const translatedHtml = translation ? await marked.parse(translation.body) : null;
const banners = getPromoBanners(locale, 'vehicle-sourcing');

const CASES_TAB_PATH: Record<CollectionEntry<'cases'>['data']['service'], string> = {
  'vehicle-sourcing': PathBuilder.casesVehicleSourcing(locale),
  'vehicle-buyback': PathBuilder.casesVehicleBuyback(locale),
  'vehicle-inspection': PathBuilder.casesVehicleInspection(locale),
  'vehicle-import': PathBuilder.casesVehicleImport(locale),
};

// China isn't in countries.json (it's a vehicle-import-only source, not a
// full active market with its own [country] page) — same special case the
// vehicle-import china spoke already handles via CHINA_COUNTRY_CODE.
const countryName = c.data.country
  ? c.data.country === CHINA_COUNTRY_CODE
    ? CHINA_NAME[locale]
    : (getCountry(c.data.country)?.[locale].name ?? c.data.country.toUpperCase())
  : undefined;

const hook = excerptFromMarkdown(translation?.body ?? c.body ?? '');
const canonical = `${SITE_URL}${PathBuilder.case(locale, c.id)}`;
const imageUrl = c.data.image ? `${SITE_URL}${c.data.image.src}` : undefined;

const meta = {
  title: `${title} | ${SITE_NAME}`,
  description: hook ? `${hook} ${c.data.car} ${c.data.year}, ${c.data.price.value} ${c.data.price.currency ?? ''}.`.trim() : `${c.data.car} ${c.data.year}, ${c.data.price.value}. ${cc.realCaseFallback}`,
  canonical,
  // Real car photo makes a more compelling share preview than the generic template.
  ogImage: imageUrl,
  ogImageWidth: c.data.image?.width,
  ogImageHeight: c.data.image?.height,
};

const schema = generateArticleSchema({
  headline: title,
  description: meta.description,
  image: imageUrl,
  datePublished: c.data.date,
  url: canonical,
});
---

<BaseLayout {...meta} {schema}>
  <section class="hero-grid relative border-b overflow-hidden border-default">
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 50% 60% at 0% 50%, var(--color-ambient-glow) 0%, transparent 60%), radial-gradient(ellipse 40% 50% at 100% 0%, var(--color-accent-subtle) 0%, transparent 55%);"></div>
    <span class="deco-word" style="font-size: clamp(7rem, 18vw, 16rem); bottom: -1rem; right: -1%; opacity: 0.8;">CASE</span>

    <div class="relative max-w-6xl mx-auto px-6 py-16 md:py-24">
      <Breadcrumbs items={[{ label: t.nav.cases, href: CASES_TAB_PATH[c.data.service] }, { label: title }]} />

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
        <div class="lg:col-span-3">
          <div class="flex flex-wrap items-center gap-3 mb-6">
            <span class="text-xs tracking-widest uppercase font-medium px-3 py-1 rounded-sm border text-accent border-accent">
              {cc.serviceBadges[c.data.service as keyof typeof cc.serviceBadges] ?? c.data.service}
            </span>
            {countryName && <span class="text-xs text-muted">{countryName}</span>}
          </div>

          <span class="eyebrow fade-up fade-up-1">{SITE_NAME}</span>
          <h1 class="font-display font-bold mb-5 leading-none fade-up fade-up-2 tracking-[-0.03em] text-primary" style="font-size: clamp(2.6rem, 5vw, 4.4rem);">{title}</h1>

          <div class="grid grid-cols-3 gap-6 max-w-sm fade-up fade-up-3">
            <div>
              <p class="text-xs tracking-wide uppercase mb-1 font-medium text-muted">{cc.autoLabel}</p>
              <p class="text-sm font-medium text-primary">{c.data.car}</p>
            </div>
            <div>
              <p class="text-xs tracking-wide uppercase mb-1 font-medium text-muted">{cc.yearLabel}</p>
              <p class="text-sm font-medium text-primary">{c.data.year}</p>
            </div>
            <div>
              <p class="text-xs tracking-wide uppercase mb-1 font-medium text-muted">{cc.priceLabel}</p>
              <Price price={c.data.price} class="text-sm font-bold font-display text-accent" />
            </div>
          </div>
        </div>

        {c.data.image && (
          <div class="lg:col-span-2 fade-up fade-up-3 overflow-hidden border md:rounded-sm aspect-[4/3] border-default">
            <Image
              src={c.data.image}
              alt={c.data.car}
              format="webp"
              class="w-full h-full object-cover"
            />
          </div>
        )}
      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-6">
    <!-- Content -->
    <div class="py-12 prose-custom">
      {translatedHtml
        ? <div class="leading-relaxed text-base text-primary [&>p]:mb-5 [&>p:last-child]:mb-0" set:html={translatedHtml} />
        : <div class="leading-relaxed text-base text-primary [&>p]:mb-5 [&>p:last-child]:mb-0"><Content /></div>
      }
    </div>

    <!-- More photos -->
    <CaseGallery images={c.data.gallery} name={c.data.car} />

    <!-- SEO banner -->
    <PromoBanner label={cc.usefulInfoLabel} {banners} />

    <!-- Channel promo -->
    <ChannelBanner />

    <!-- CTA -->
    <div class="py-10 border-t mb-16 border-default">
      <p class="text-xs tracking-widest uppercase mb-2 font-medium text-accent">{cc.ctaEyebrow}</p>
      <h2 class="font-display text-3xl font-bold mb-6">{cc.ctaHeading}</h2>
      <ContactCTA label={cc.ctaButtonLabel} />
    </div>
  </div>
</BaseLayout>
