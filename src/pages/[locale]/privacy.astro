---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL, SITE_NAME } from '../../utils/constants';
import { telegramLink } from '../../utils/telegramLink';
import { getPagesContent } from '../../i18n/content/pages';
import { withLocales } from '../../utils/paths';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params;
const p = getPagesContent(locale).privacy;
const meta = {
  title: `${p.metaTitle} | ${SITE_NAME}`,
  description: p.metaDescription(SITE_NAME),
  canonical: `${SITE_URL}/${locale}/privacy/`,
};

const sections = p.sections;
---

<BaseLayout {...meta}>
  <section class="border-b border-default">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <span class="accent-line"></span>
      <h1 class="font-display text-5xl font-bold mb-3">{p.heading}</h1>
      <p class="text-sm text-muted">{p.lastUpdated}</p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-16">
    <div class="space-y-10">
      {sections.map((s, i) => (
        <div class="pb-10 border-b border-default anim-inline-fast" style={`--anim-delay: ${0.1 + i * 0.1}s`}>
          <h2 class="font-display text-2xl font-bold mb-4">{s.title}</h2>
          <p class="text-base leading-relaxed text-muted">{s.text}</p>
        </div>
      ))}

      <div>
        <h2 class="font-display text-2xl font-bold mb-4">{p.contactTitle}</h2>
        <p class="text-base leading-relaxed text-muted">
          {p.contactBefore}
          <a
            href={telegramLink(import.meta.env.PUBLIC_TG_MANAGER!)}
            class="underline transition-colors text-accent"
          >
            {p.contactLinkText}
          </a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
