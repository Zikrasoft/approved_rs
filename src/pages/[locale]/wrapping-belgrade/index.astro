---
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import { Car, Bike, Motorbike, Sailboat } from '@lucide/astro';
import ChipLinks from '@/components/ChipLinks.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import WhatWeDoList from '@/components/WhatWeDoList.astro';
import { generateServiceSchema, ogImageFor } from '@/utils/seo';
import { SITE_URL, SITE_NAME } from '@/utils/constants';
import { getCountry } from '@/utils/geo';
import { getServicesContent } from '@/i18n/content/services';
import { withLocales, PathBuilder, sourcingChipItems } from '@/utils/paths';

export const getStaticPaths = () => withLocales([{ params: {} }]);

const { locale } = Astro.params;
const wb = getServicesContent(locale).wrappingBelgrade;
const meta = {
  title: `${wb.metaTitle} | ${SITE_NAME}`,
  description: wb.metaDescription,
  canonical: `${SITE_URL}${PathBuilder.wrappingBelgrade(locale)}`,
  // ponytail: no dedicated OG asset yet (gen-og.mjs has no wrapping-belgrade
  // variant) — reuses auto-service-belgrade's image as a placeholder, same
  // Belgrade-service visual category. Swap once a real asset exists.
  ogImage: ogImageFor(SITE_URL, 'auto-service-belgrade', locale),
};
const schema = generateServiceSchema(`${wb.title} ${wb.titleHighlight}`, getCountry('rs')![locale].name, meta.canonical);

const ICONS = { car: Car, motorcycle: Motorbike, bicycle: Bike, yacht: Sailboat } as const;
const WHAT_WE_DO = wb.whatWeDo.map(item => ({ ...item, Icon: ICONS[item.key] }));
---

<ServicePageLayout
  {meta} {schema}
  title={wb.title}
  titleHighlight={wb.titleHighlight}
  description={wb.description}
  ctaLabel={wb.ctaLabel}
  formService="wrapping-belgrade"
  currentCountry="rs"
  currentService="wrapping-belgrade"
  city="belgrade"
  showCountryCrossLinks={false}
  breadcrumbs={[{ label: wb.breadcrumbLabel }]}
>
  <SectionHeading title={wb.whatWeDoHeading} size="lg" class="mb-8 mt-6" />
  <WhatWeDoList items={WHAT_WE_DO} />
  <ChipLinks label={wb.alsoSourcingLabel} items={sourcingChipItems(locale)} />
</ServicePageLayout>
