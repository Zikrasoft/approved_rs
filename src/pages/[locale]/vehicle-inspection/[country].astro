---
import ServicePageLayout from '@/layouts/ServicePageLayout.astro';
import StepsList from '@/components/StepsList.astro';
import Faq from '@/components/Faq.astro';
import { getCountryPaths, withLocales, PathBuilder } from '@/utils/paths';
import { getCountry } from '@/utils/geo';
import { generateMeta, generateServiceSchema, buildLocation } from '@/utils/seo';
import { getCollection } from 'astro:content';
import { SITE_URL } from '@/utils/constants';
import { getFaq } from '@/i18n/content/faq';
import { getServicesContent } from '@/i18n/content/services';

export const getStaticPaths = () => withLocales(getCountryPaths());

const { locale, country: countryCode } = Astro.params;
const country = getCountry(countryCode!)!;
const sc = getServicesContent(locale)['vehicle-inspection'];
const location = buildLocation(locale, country);
const meta = generateMeta('vehicle-inspection', { country, baseUrl: SITE_URL, path: PathBuilder.service(locale, 'vehicle-inspection', countryCode!), locale: locale });
const cases = (await getCollection('cases'))
  .filter(c => c.data.published && c.data.country === countryCode && c.data.service === 'vehicle-inspection')
  .slice(0, 3);
const schema = generateServiceSchema(`${sc.title} ${location}`, country[locale].name, meta.canonical);
---

<ServicePageLayout
  {meta} {schema} {cases}
  title={sc.title}
  titleHighlight={location}
  description={sc.description}
  ctaLabel={sc.ctaLabel}
  formService="vehicle-inspection"
  currentCountry={countryCode!}
  currentService="vehicle-inspection"
  casesHeading={sc.casesHeading}
  breadcrumbs={[
    { label: country[locale].name, href: PathBuilder.service(locale, 'vehicle-sourcing', countryCode!) },
    { label: sc.breadcrumbLabel },
  ]}
>
  <StepsList steps={sc.steps} />
  <p class="mt-6 text-sm leading-relaxed text-muted">
    {sc.extraLine}
  </p>

  <Fragment slot="extra">
    <Faq items={getFaq(locale)['vehicle-inspection']} />
  </Fragment>
</ServicePageLayout>
