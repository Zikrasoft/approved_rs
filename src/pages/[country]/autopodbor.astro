---
export const prerender = true;
import ServicePageLayout from '../../layouts/ServicePageLayout.astro';
import StepsList from '../../components/StepsList.astro';
import ChipLinks from '../../components/ChipLinks.astro';
import CountryPill from '../../components/CountryPill.astro';
import { getCountryPaths } from '../../utils/paths';
import { getCountry, getActiveCountries, getCitiesForCountry } from '../../utils/geo';
import { generateMeta, generateServiceSchema } from '../../utils/seo';
import { getCollection } from 'astro:content';
import { SITE_URL, DELIVERY_DESTINATIONS_ACCUSATIVE } from '../../utils/constants';

export const getStaticPaths = getCountryPaths;

const { country: countryCode } = Astro.params;
const country = getCountry(countryCode!)!;
const meta = generateMeta('autopodbor', { country, baseUrl: SITE_URL, path: `/${countryCode}/autopodbor/` });
const cases = (await getCollection('cases')).filter(c => c.data.published && c.data.country === countryCode && c.data.service === 'autopodbor').slice(0, 3);
const schema = generateServiceSchema(`Автоподбор в ${country.nameLocative}`, country.name, meta.canonical);
---

<ServicePageLayout
  {meta} {schema} {cases}
  title="Автоподбор под ключ"
  titleHighlight={`в ${country.nameLocative}`}
  description={`Подберём автомобиль в ${country.nameLocative} с полной проверкой, оформим сделку и привезём до вашего города под ключ — включая растаможку.`}
  ctaLabel="Оставить заявку"
  formService="autopodbor"
  currentCountry={countryCode!}
  currentService="autopodbor"
  casesHeading={`Кейсы: автоподбор в ${country.nameLocative}`}
>
  <StepsList steps={[
    { n: '01', text: 'Оставляете заявку с требованиями — бюджет, марка, пробег' },
    { n: '02', text: `Ищем варианты в ${country.nameLocative} по вашим критериям` },
    { n: '03', text: 'Независимый эксперт осматривает и проверяет автомобиль' },
    { n: '04', text: 'Сопровождаем сделку, помогаем с документами и оформлением' },
    { n: '05', text: 'Доставляем автомобиль до вашего города — под ключ, включая растаможку' },
  ]} />
  <p class="mt-6 text-sm leading-relaxed text-muted">
    Доставляем в {DELIVERY_DESTINATIONS_ACCUSATIVE.join(', ')} — и в любую другую страну, обсудим при заявке.
  </p>
  <ChipLinks label="Города:" items={getCitiesForCountry(countryCode!).map(city => ({ href: `/${countryCode}/${city.slug}/autopodbor/`, text: city.name }))} />
  <div class="mt-12 pt-8 border-t border-default">
    <p class="text-xs tracking-widest uppercase mb-4 font-medium text-muted">Также подбираем в:</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {getActiveCountries().filter(c => c.code !== countryCode).map(c => <CountryPill country={c} />)}
    </div>
  </div>
</ServicePageLayout>
