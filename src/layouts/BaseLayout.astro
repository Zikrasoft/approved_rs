---
import type { MetaProps } from '@/utils/seo';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import FloatingContactWidget from '@/components/FloatingContactWidget.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import { SITE_URL, SITE_NAME, YM_COUNTER_ID } from '@/utils/constants';
import { getAlternateLinks } from '@/i18n/hreflang';
import { getLocale } from '@/i18n/config';
// Logo/heading font: preload so it's ready before first paint (avoids the
// fallback→webfont width jump on every navigation, most visible on the logo).
import logoFontUrl from '@fontsource/playfair-display/files/playfair-display-latin-700-normal.woff2?url';
// ".RS" badge next to the logo uses this weight — same swap-jump issue.
import tldFontUrl from '@fontsource/outfit/files/outfit-latin-600-normal.woff2?url';

interface Props extends MetaProps {
  schema?: object;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const locale = getLocale(Astro.currentLocale);
// og.png is the ru default (kept unsuffixed for backward-compatible URLs);
// en/sr variants are generated by scripts/gen-og.mjs as og-en.png/og-sr.png.
const OG_SUFFIX: Record<string, string> = { ru: '', en: '-en', sr: '-sr' };

const {
  title, description, canonical, noindex, schema,
  ogImage = `${SITE_URL}/og${OG_SUFFIX[locale]}.png`,
  ogImageWidth = 1200,
  ogImageHeight = 630,
} = Astro.props;

const OG_LOCALE_MAP: Record<string, string> = { ru: 'ru_RU', en: 'en_US', sr: 'sr_RS' };
const alternateLinks = getAlternateLinks(Astro.url.pathname);
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" as="font" type="font/woff2" href={logoFontUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={tldFontUrl} crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map(link => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE_MAP[locale]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Google tag (gtag.js) + Yandex.Metrika — both loaded only after cookie consent, see CookieConsent.astro -->
    <script>
      import { YM_COUNTER_ID } from '@/utils/constants';
      import { ymReachGoal } from '@/utils/metrika';

      (window as any).dataLayer = (window as any).dataLayer || [];
      function gtag(...args: unknown[]) { (window as any).dataLayer.push(args); }
      // Module scripts don't leak top-level declarations onto `window` the
      // way classic/inline scripts do — explicit assignment needed so other
      // scripts (e.g. the contact-click tracker below) can still call it.
      (window as any).gtag = gtag;
      (window as any).ymReachGoal = ymReachGoal;

      (window as any).loadAnalytics = function () {
        if ((window as any).__gaLoaded) return;
        (window as any).__gaLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-M17GZT849M';
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', 'G-M17GZT849M');

        (function(m: any,e: Document,t: string,r: string,i: string,k?: any,a?: any){
          m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=Date.now();
          for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
          k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
        })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=' + YM_COUNTER_ID, 'ym');
        (window as any).ym(YM_COUNTER_ID, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", accurateTrackBounce:true, trackLinks:true});
      };
      try {
        if (localStorage.getItem('cookie_consent') === 'granted') (window as any).loadAnalytics();
      } catch (e) {}
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Prevent flash of wrong theme: explicit choice wins, otherwise follow OS preference.
         Runs before body paint since it's in <head>, so data-theme is set on
         <html> before anything renders. -->
    <script is:inline>
      try {
        var stored = localStorage.getItem('theme');
        var wantsDark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (wantsDark) document.documentElement.setAttribute('data-theme', 'dark');
        else document.documentElement.removeAttribute('data-theme');
      } catch (e) {}
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingContactWidget />
    <CookieConsent />
    <Analytics />
    <SpeedInsights />
    <script is:inline>
      // Safety net: if CSS animations fail to run (slow connection, power-save mode),
      // force all animated elements visible after 1.6s (covers longest fade-up-6 delay).
      setTimeout(function () {
        document.querySelectorAll('.fade-up,.anim-inline,.anim-inline-fast').forEach(function (el) {
          el.style.opacity = '1';
          el.style.transform = 'none';
          el.style.animation = 'none';
        });
      }, 1600);
    </script>
    <script>
      import { isTrackedContactChannel, DATA_CONTACT_CHANNEL, DATA_OPEN_LEAD_MODAL, DATA_OPEN_PAGE_LEAD_MODAL } from '@/utils/contactChannel';
      import { ymReachGoal } from '@/utils/metrika';

      // Which contact channel people actually pick, site-wide — every
      // Telegram/WhatsApp/Viber/callback/call touchpoint carries
      // data-contact-channel, tracked here once instead of per component.
      // gtag() only queues into dataLayer; the real GA script (and any
      // network call) still waits on cookie consent, same as everywhere else.
      //
      // Channels that leave the site to actually contact someone also get
      // logged server-side via a beacon — same lead-notification pipeline as
      // the form, so staff see these the same way and can follow up if the
      // visitor doesn't message/call first. 'callback' is excluded: it just
      // opens the lead-request modal, which becomes a real заявка through
      // /api/leads.ts if submitted — beaconing the click too would double-count it.
      // Same reason for the data-open-*-lead-modal check below: ContactCTA's
      // "Telegram" button sometimes opens that same modal instead of actually
      // linking to Telegram (its data-contact-channel is only there for the
      // gtag label in that case), so it's excluded exactly like 'callback' is.
      // Clicking tel:/https: links is a real navigation, can't await a fetch
      // first, so this fires a beacon instead of blocking.
      document.querySelectorAll<HTMLElement>(`[${DATA_CONTACT_CHANNEL}]`).forEach((el) => {
        el.addEventListener('click', () => {
          const channel = el.dataset.contactChannel;
          (window as any).gtag?.('event', 'contact_click', { channel });
          ymReachGoal('contact_click', { channel });
          const opensLeadModal = el.hasAttribute(DATA_OPEN_LEAD_MODAL) || el.hasAttribute(DATA_OPEN_PAGE_LEAD_MODAL);
          if (isTrackedContactChannel(channel) && !opensLeadModal) {
            const body = new FormData();
            body.set('channel', channel);
            body.set('source_url', location.href);
            navigator.sendBeacon('/api/contact-click', body);
          }
        });
      });
    </script>
  </body>
</html>
