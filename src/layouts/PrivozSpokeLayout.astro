---
// Shared shell for the 3 privoz spokes (de/eu/china) — same meta shape,
// schema wrapping, ServicePageLayout props, and StepsList/destinationsNote/
// Faq structure on all three; only the source data and one slot's worth of
// page-specific content (a cross-link paragraph, or the EU source chips)
// actually differ per spoke.
import ServicePageLayout from './ServicePageLayout.astro';
import StepsList from '@/components/StepsList.astro';
import Faq from '@/components/Faq.astro';
import { getFaq } from '@/i18n/content/faq';
import { generateServiceSchema, placeholderOgImage } from '@/utils/seo';
import { SITE_URL, SITE_NAME } from '@/utils/constants';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  slug: 'de' | 'eu' | 'china';
  metaTitle: string;
  metaDescription: string;
  title: string;
  titleHighlight: string;
  description: string;
  ctaLabel: string;
  breadcrumbLabel: string;
  hubBreadcrumbLabel: string;
  casesHeading: string;
  steps: { n: string; text: string }[];
  destinationsNote: string;
  areaServed: string | string[];
}

const {
  locale, slug, metaTitle, metaDescription, title, titleHighlight, description,
  ctaLabel, breadcrumbLabel, hubBreadcrumbLabel, casesHeading, steps, destinationsNote, areaServed,
} = Astro.props;

const meta = {
  title: `${metaTitle} | ${SITE_NAME}`,
  description: metaDescription,
  canonical: `${SITE_URL}/${locale}/privoz/${slug}/`,
  ogImage: placeholderOgImage(SITE_URL, locale),
};
const schema = generateServiceSchema(`${title} ${titleHighlight}`, areaServed, meta.canonical);
---

<ServicePageLayout
  {meta} {schema}
  {title} {titleHighlight} {description} {ctaLabel}
  formService={`privoz-${slug}`}
  currentCountry="rs"
  leadCountry={slug}
  currentService="privoz"
  showCountryCrossLinks={false}
  {casesHeading}
  breadcrumbs={[{ label: hubBreadcrumbLabel, href: `/${locale}/privoz/` }, { label: breadcrumbLabel }]}
>
  <StepsList {steps} />
  <p class="mt-6 text-sm leading-relaxed text-muted">{destinationsNote}</p>
  <slot />

  <Fragment slot="extra">
    <Faq items={getFaq(locale).privoz} />
  </Fragment>
</ServicePageLayout>
