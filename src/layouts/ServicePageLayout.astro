---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import LeadForm from '@/components/LeadForm.astro';
import LeadFormModal from '@/components/LeadFormModal.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import CasesGrid from '@/components/CasesGrid.astro';
import ChipLinks from '@/components/ChipLinks.astro';
import type { MetaProps } from '@/utils/seo';
import type { CollectionEntry } from 'astro:content';
import { SITE_NAME } from '@/utils/constants';
import { getActiveCountries } from '@/utils/geo';
import { SERVICES, isCountryScopedServiceSlug, type ServiceSlug } from '@/utils/labels';
import { toCaseItem } from '@/utils/cases';
import { getI18n } from '@/i18n/getI18n';
import { getLocale } from '@/i18n/config';
import { PathBuilder } from '@/utils/paths';
import { DATA_OPEN_PAGE_LEAD_MODAL } from '@/utils/contactChannel';

interface Props {
  meta: MetaProps;
  schema?: object;
  title: string;
  titleHighlight?: string;
  description: string;
  ctaLabel?: string;
  formService: string;
  currentCountry: string;
  // The "deal identity" shown in the hero watermark and sent as the lead's
  // country field — defaults to currentCountry, but vehicle-import pages need to
  // diverge: currentCountry stays a real country code (so the "other
  // services" cross-links below still resolve to a valid /vehicle-sourcing/{cc}/
  // etc.), while leadCountry carries the actual corridor ('de'/'eu'/'china')
  // so sales sees the right source in the Telegram notification instead of
  // a misleading "RS" on every vehicle-import lead.
  leadCountry?: string;
  currentService: ServiceSlug;
  cases?: CollectionEntry<'cases'>[];
  casesHeading?: string;
  city?: string;
  // Belgrade-only Автосервис isn't offered in the other countries — showing
  // "Также работаем в: {other countries}" there would be a false claim.
  showCountryCrossLinks?: boolean;
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  meta, schema, title, titleHighlight, description, ctaLabel,
  formService, currentCountry, leadCountry = currentCountry, currentService,
  cases = [], casesHeading, city,
  showCountryCrossLinks = true,
  breadcrumbs,
} = Astro.props;

const locale = getLocale(Astro.currentLocale);
const items = cases.map(c => toCaseItem(c, locale));
const t = getI18n(locale);
---

<BaseLayout {...meta} schema={schema}>

  <section class="hero-grid relative border-b overflow-hidden border-default">
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 50% 60% at 0% 50%, var(--color-ambient-glow) 0%, transparent 60%), radial-gradient(ellipse 40% 50% at 100% 0%, var(--color-accent-subtle) 0%, transparent 55%);"></div>
    <span class="deco-word" style="font-size: clamp(7rem, 18vw, 16rem); bottom: -1rem; right: -1%; opacity: 0.8;">{leadCountry.toUpperCase()}</span>

    <div class="relative max-w-6xl mx-auto px-6 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">
        <div class="lg:col-span-3">
          {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
          <span class="eyebrow fade-up fade-up-1">{SITE_NAME}</span>
          <h1 class="font-display font-bold mb-5 leading-none fade-up fade-up-2 tracking-[-0.03em] text-primary"
            style="font-size: clamp(3rem, 6.5vw, 5.2rem); font-weight: 800;">
            {title}{titleHighlight && <><br /><em class="text-accent italic">{titleHighlight}</em></>}
          </h1>
          <p class="text-base max-w-lg mb-2 leading-relaxed fade-up fade-up-3 text-muted">{description}</p>
          <div class="fade-up fade-up-4"><ContactCTA label={ctaLabel} openModal compact /></div>
          <div class="fade-up fade-up-5 pt-2"><slot /></div>
        </div>
        <div class="lg:col-span-2 fade-up fade-up-3">
          <LeadForm service={formService} country={leadCountry} city={city} />
        </div>
      </div>
    </div>
  </section>

  <slot name="extra" />

  <LeadFormModal id="page-lead-modal" triggerAttr={DATA_OPEN_PAGE_LEAD_MODAL} service={formService} country={leadCountry} city={city} />

  <slot name="cases"><CasesGrid {items} heading={casesHeading ?? ''} /></slot>

  <div class="max-w-6xl mx-auto px-6 pb-16 pt-4">
    {showCountryCrossLinks && isCountryScopedServiceSlug(currentService) && (
      <ChipLinks label={t.common.alsoWorkingInLabel} items={getActiveCountries().filter(c => c.code !== currentCountry).map(c => ({ href: PathBuilder.service(locale, currentService, c.code), text: c[locale].name }))} />
    )}
    <ChipLinks label={t.common.otherServicesLabel} items={SERVICES.filter(s => s.slug !== currentService).map(s => ({ href: PathBuilder.service(locale, s.slug, currentCountry), text: t.nav[s.slug] }))} />
  </div>

</BaseLayout>
