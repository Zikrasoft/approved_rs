{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**", ".vercel/output/**", ".medusa/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@podbor/shop-catalog#test": { "dependsOn": ["build"] },
    "@podbor/i18n#test": { "dependsOn": ["build"] },
    "@podbor/brands#test": { "dependsOn": ["build"] },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
