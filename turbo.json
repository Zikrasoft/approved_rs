{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**", ".vercel/output/**", ".medusa/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@podbor/i18n#test": { "dependsOn": ["build"] },
    "@podbor/brands#test": { "dependsOn": ["build"] },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@podbor/medusa#build": {
      "env": [
        "DATABASE_*",
        "JWT_SECRET",
        "COOKIE_SECRET",
        "STORE_CORS",
        "ADMIN_CORS",
        "AUTH_CORS",
        "TYPESENSE_*",
        "PORT"
      ]
    },
    "@podbor/medusa#typecheck": {
      "dependsOn": ["build"],
      "env": [
        "DATABASE_*",
        "JWT_SECRET",
        "COOKIE_SECRET",
        "STORE_CORS",
        "ADMIN_CORS",
        "AUTH_CORS",
        "TYPESENSE_*",
        "PORT"
      ]
    },
    "@podbor/medusa#test": {
      "env": [
        "DATABASE_*",
        "JWT_SECRET",
        "COOKIE_SECRET",
        "STORE_CORS",
        "ADMIN_CORS",
        "AUTH_CORS",
        "TYPESENSE_*",
        "PORT",
        "DB_HOST",
        "DB_PORT",
        "DB_USERNAME",
        "DB_PASSWORD"
      ]
    },
    "lint": {}
  }
}
