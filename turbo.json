{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**", ".medusa/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "shop:prepare": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev:shop": {
      "dependsOn": ["^build", "@podbor/auto-service-shop#shop:prepare"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@podbor/i18n#test": { "dependsOn": ["build"] },
    "@podbor/brands#test": { "dependsOn": ["build"] },
    "@podbor/lead-crm#test": { "dependsOn": ["build"] },
    "@podbor/catalog-contract#test": { "dependsOn": ["build"] },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@podbor/auto-service#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"],
      "env": [
        "MEDUSA_BACKEND_URL",
        "MEDUSA_PUBLISHABLE_KEY",
        "SHOP_OPEN",
        "SHOP_PREVIEW_TOKEN",
        "CATALOGUE_SHRINK_GUARD",
        "CATALOGUE_SHRINK_ALLOWED"
      ]
    },
    "@podbor/auto-service-shop#build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_*",
        "JWT_SECRET",
        "COOKIE_SECRET",
        "STORE_CORS",
        "ADMIN_CORS",
        "AUTH_CORS",
        "TYPESENSE_*",
        "PORT"
      ]
    },
    "@podbor/auto-service-shop#test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_*",
        "JWT_SECRET",
        "COOKIE_SECRET",
        "STORE_CORS",
        "ADMIN_CORS",
        "AUTH_CORS",
        "TYPESENSE_*",
        "PORT",
        "SHOP_SHARDS",
        "DB_HOST",
        "DB_PORT",
        "DB_USERNAME",
        "DB_PASSWORD"
      ]
    },
    "@podbor/auto-service-shop#test:slow": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "DATABASE_*",
        "JWT_SECRET",
        "COOKIE_SECRET",
        "STORE_CORS",
        "ADMIN_CORS",
        "AUTH_CORS",
        "TYPESENSE_*",
        "PORT",
        "DB_HOST",
        "DB_PORT",
        "DB_USERNAME",
        "DB_PASSWORD"
      ]
    },
    "lint": {}
  }
}
